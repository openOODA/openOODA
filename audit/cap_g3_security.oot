## Prove commands (re-runnable)

```bash
cd /home/jeryd/Projects/openOODA/ooda
O=./oodac/oodac
TMP=${TMPDIR:-$HOME/.cache/ooda-tmp}/cap_g3_probe
mkdir -p "$TMP"

# C1 check DENY
cat > "$TMP/fsread_write.oo" <<'EOF'
pub fn main(fs: &FsReadCap) {
    let _ = write_file(fs, "/tmp/cap_g3_pwn", "PWNED");
}
EOF
$O check "$TMP/fsread_write.oo"   # expect rc=1

# C2 emit skip-check PWN (strip dead seccomp_init for gcc)
$O emit-c "$TMP/fsread_write.oo" 2>/dev/null \
  | sed '/static inline void oo_seccomp_init/,/^}/d' \
  > "$TMP/fsread_write.c"
gcc -O0 -Iruntime runtime/chs_rt.c "$TMP/fsread_write.c" -o "$TMP/fsread_write.bin" \
  -lm -lpthread -ldl
OODA_FS_WRITEDIR=/tmp "$TMP/fsread_write.bin"
# expect file /tmp/cap_g3_pwn == PWNED on pre-CAP-G3 host

# C3–C6 runtime token matrix
# (see audit session rt_wrong_grants.c pattern)

# C7 ambient
cat > "$TMP/pure.oo" <<'EOF'
pub fn main() { let x = 1; }
EOF
$O emit-c "$TMP/pure.oo" 2>/dev/null | sed -n '/^int main/,/^}/p'
# expect full grant_fs/sys/env/net/… bag

# Host inject honesty
strings oodac/oodac | grep 'long long fs = oo_cap_grant'
