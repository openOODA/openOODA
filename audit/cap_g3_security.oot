pub fn main(fs: &FsReadCap) { let _ = write_file(fs, "/tmp/cap_g3_pwn", "PWNED"); }
EOF
$O check "$TMP/fsread_write.oo"   # expect rc=1

# C2 emit skip-check PWN
$O emit-c "$TMP/fsread_write.oo" 2>/dev/null | sed '/oo_seccomp_init/,/^}/d' > "$TMP/fsread_write.c"
gcc -O0 -Iruntime runtime/chs_rt.c "$TMP/fsread_write.c" -o "$TMP/fsread_write.bin" -lm -lpthread -ldl
OODA_FS_WRITEDIR=/tmp "$TMP/fsread_write.bin" # file /tmp/cap_g3_pwn == PWNED on pre-CAP-G3 host
