# Pass 2 (byte-identity check)
env -i PATH=/usr/bin:/bin HOME=$HOME timeout 60 ooda run scripts/lsp_complete_smoke.oo
env -i PATH=/usr/bin:/bin HOME=$HOME timeout 60 ooda run scripts/lsp_session_smoke.oo
env -i PATH=/usr/bin:/bin HOME=$HOME timeout 60 ooda run scripts/lsp_redteam_fuzz.oo
