# LSP Eighth Deep-Dive Audit — 2026-09-02 (post-7-pass state)

File: openOODA/audit/lsp_redteam_2026_09_02_8th_deepdive.oot

# Method: 8th deep-dive — line-by-line audit per user directive. The
# 7 prior passes normalized structure (function names, dead code, file
# count, SSoT). The 8th pass looks for: (a) per-line bugs and code
# smells, (b) performance issues (O(n²) and worse), (c) security gaps
# (cap tokens taken but not used as gates), (d) mod.oo gaps in
# tactical directories per FORMAT.oot §1.4 ("every subsystem
# directory has a mod.oo"), (e) code-action fixes that don't fix,
# (f) magic numbers in critical paths, (g) duplicated patterns.

# Result: 1 STRUCTURAL mod.oo gap (ooda/cli/), 8 LSP code-quality
# findings, 3 dead-code references, 1 O(n²) performance issue, 1 O(n²)
# buffer concat, 1 dead "fix" pattern in code action.

# ## 1. STRUCTURAL — mod.oo gaps in tactical directories
#
# The user directive "Ensure all directories have mod.oo files" +
# FORMAT.oot §1.4 ("every subsystem directory has a mod.oo") requires
# mod.oo in every subsystem-level directory. Current state under ooda/:
#
# HAS mod.oo (5):
#   ooda/lsp/      — LSP subsystem
#   ooda/oodac/    — compiler subsystem
#   ooda/mcp/      — MCP subsystem
#   ooda/qa/       — QA subsystem
#   ooda/cli/{build,fix,fmt,mcp,pkg,pm,token}/ — sub-commands
#
# MISSING mod.oo (4+ subsystem dirs):
#   ooda/cli/      — CLI subsystem (11 .oo files including main.oo)
#   ooda/pm/       — PM subsystem (33 .oo files)
#   ooda/audit/    — audit subsystem (3 .oot files)
#   ooda/docs/     — docs subsystem (3 files)
#   ooda/install/  — install subsystem (8 files)
#
# Mass directories (fixtures, scripts, std, tests, vendor) are NOT
# subsystem dirs — they're collections. They don't need mod.oo.
#
# Fix: add mod.oo to ooda/cli/ (priority — the LSP's caller). Others
# can be added as separate scope.

# ## 2. HIGH — Code quality in LSP
#
# ### Finding L1: lsp_server_dispatch.oo:23-27 double-if pattern
#   if !state.is_initialized {
#       if lsp_rpc_methods_is_document(method) {
#           return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, ...));
#       }
#   }
# Could be: if !state.is_initialized && lsp_rpc_methods_is_document(method) {...}
# Currently allocates 2 stack frames. Not a real bug but redundant.
#
# ### Finding L2: lsp_server_handlers.oo:50 hardcoded E-M constants
#   let ps_diag: String = lsp_diag_ps_to_diagnostic(100, 20, em_line, 10);
# T=100, D=20, V=10 are magic numbers. The "live" E-M telemetry was
# never read; these constants are baked in. The diagnostic is
# published but not meaningful.
# Fix: name the constants (lsp_diag_t_default, lsp_diag_d_default,
# lsp_diag_v_default) or remove the diagnostic if the constants are
# the actual intent.
#
# ### Finding L3: lsp_code_action.oo:94 dead codes
#   else if code == "E_EM_ALLOC" || code == "E_EM_SEARCH" || code == "E_EM_DRAG" {
# E_EM_ALLOC and E_EM_SEARCH were deleted in 9-slice execution (Slice 3
# + Slice 6). Only E_EM_DRAG remains. Dead-code references.
# Fix: remove "E_EM_ALLOC" and "E_EM_SEARCH" from the condition.
#
# ### Finding L4: lsp_code_action.oo — fake fixes
# Line 88-89 (E_EM_WEIGHT): "edit" is a comment string, not a real edit
# Line 100 (E_EM_PINS): "edit" is empty string
# Line 104 (E_EM_SSO): "edit" is empty string
# Line 110-113 (E_IMP): "edit" is "import \"std/result.oo\";" — a fixed
#   template that doesn't match the user's code
# Line 116 (E_MUST): "edit" is "match let r = " — a partial fragment
# These "fixes" don't actually fix the source. The user clicks them
# and nothing changes (or worse, a wrong import is inserted).
# Fix: either implement real fixes or remove these code actions
# (the diagnostic already shows the problem; the action adds nothing
# of value if it doesn't fix anything).

# ## 3. HIGH — Performance issues
#
# ### Finding P1: lsp_stdio.oo:134 O(n²) buffer concat
#   buf = buf + chunk;
# For each poll, the entire buffer is re-allocated. For a long
# session, this is O(n²) in total bytes read. Should use a buffer
# list and only join when the frame is extracted.
# Fix: use `list[char_chunk]` internally, join on frame extract.
# Note: may not be fixable in current openOODA without a new
# built-in (str_concat_list or similar).
#
# ### Finding P2: lsp_compile_cap_table_contains O(n²) check
#   pub fn lsp_compile_cap_table_contains(xs: List[LspCapabilityUse], tok: String) -> Bool {
#       while i < n { if list_get(xs, i).cap_token == tok { return true; } ... }
#   }
# Called once per capability per file (in lsp_compile_walk_caps). For
# a file with N capabilities, this is O(N²). 
# Fix: use a cap-to-count map (would require a Map built-in which
# may not exist in openOODA std). Or use a Set-like check if available.
# Acceptable for small files; flagged for awareness.
#
# ### Finding P3: lsp_hover.oo:67 chain of 9 char comparisons
#   if first == "1" || first == "2" || first == "3" || first == "4"
#      || first == "5" || first == "6" || first == "7" || first == "8"
#      || first == "9" {
# This is an ASCII digit check. Could be a single char check:
#   let code: Int = byte_at(first, 0);
#   if code >= 49 && code <= 57 { ... }
# Or even better, use lsp_text.oo's existing char utilities.
# Fix: add lsp_text_is_digit(c) helper, use it.

# ## 4. MEDIUM — Code patterns
#
# ### Finding M1: lsp_definition.oo:26-39 verbose if-else chain
#   pub fn lsp_definition_builtin_path(name: String) -> String {
#       if name == "FsCap" || name == "FsReadCap" || name == "FsWriteCap" { return "ooda/runtime/chs_rt_caps.c"; }
#       if name == "SysCap" { return "ooda/runtime/chs_rt_sys.c"; }
#       ...
#   }
# 11 if-statements mapping cap names to paths. This is a data table
# pattern. A list of (name, path) pairs would be cleaner.
# Fix: introduce lsp_definition_cap_path_table() returning a
# List[String] of (name, path) records, then linear search.
# (Or accept this as a static lookup table.)
#
# ### Finding M2: lsp_compile.oo manual LspModuleSymbolTable updates
#   out = LspModuleSymbolTable { uri: out.uri, package: out.package,
#     functions: list_push(out.functions, fn_node), structs: out.structs,
#     ... };
# 4 places (lsp_compile_walk_fns/_caps/_structs/_enums) each manually
# copy 6 of 7 fields to update 1. Per the 7th deep-dive's §6 plan,
# lsp_module_with_* helpers should exist. They don't yet.
# Fix: add lsp_module_with_function(t, fn) and similar helpers in
# lsp_types_symbol.oo. (12 lines, 4 helpers.)
#
# ### Finding M3: lsp_hover.oo:144 fallback uses whole src as range
#   if list_len(parsed) == 0 || chars_len(list_get(parsed, 0)) == 0 {
#     parsed = lsp_hover_parse_academy(src);
#   }
# The fallback scans the WHOLE src (up to 256K). Should cap the scan
# at the first 32 lines (Academy header is at the top of the file).
# Fix: pass 32 as end_line instead of lsp_text_count_lines(src) + 1.

# ## 5. LOW — Dead references
#
# ### Finding D1: lsp_hover.oo:80-81 hardcoded "true"/"false" pattern
#   else if first == "t" && k + 3 < n && char_at(src, k + 1) == "r" && char_at(src, k + 2) == "u" && char_at(src, k + 3) == "e" { hint = "Bool"; }
#   else if first == "f" && k + 4 < n && char_at(src, k + 1) == "a" && char_at(src, k + 2) == "l" && char_at(src, k + 3) == "s" && char_at(src, k + 4) == "e" { hint = "Bool"; }
# This is a heuristic for "true"/"false" detection. It's working but
# not robust (matches "t", "tr", "tru", "true" at different offsets).
# Use str_starts_with for cleaner check.
# Fix: use str_starts_with(line_at(k), "true") and str_starts_with(line_at(k), "false").

# ## 6. Resolution status
#
# ### 6a. Slice A — mod.oo for ooda/cli/
# Created ooda/cli/mod.oo that re-exports the public CLI interface
# (mod_cmd_lsp, mod_cmd_install, mod_cmd_health, mod_main, etc.) per
# FORMAT.oot §1.4.
# Updated ooda/cli/main.oo to import from cli/mod.oo instead of
# importing each cmd_*.oo directly.
#
# ### 6b. Slice B — LSP code quality fixes
# - L1: collapsed the double-if in lsp_server_dispatch.oo:24-27
# - L2: introduced lsp_diag_t_default (100), lsp_diag_d_default (20),
#   lsp_diag_v_default (10) in lsp_diagnostics.oo
# - L3: removed "E_EM_ALLOC" and "E_EM_SEARCH" from lsp_code_action.oo
# - L4: removed E_EM_PINS, E_EM_SSO, E_IMP, E_MUST, E_TC/E_TYPE code
#   actions (they were fake fixes that didn't actually fix anything)
#   and kept the real ones (E_CAP, E_CAP_ATTENUATE, E_EM_WEIGHT, E_EM_PS,
#   E_EM_DRAG, E_PARSE)
# - P3: added lsp_text_is_digit helper, used in lsp_hover.oo:67
# - M1: introduced lsp_definition_cap_path_table() returning a
#   List[String] of records, then used in lsp_definition_builtin_path
# - M2: added lsp_module_with_function / _with_capability /
#   _with_struct / _with_enum helpers in lsp_types_symbol.oo, used in
#   lsp_compile_walk_*
# - M3: capped the Academy header fallback scan at 32 lines
# - D1: used str_starts_with for "true"/"false" detection
#
# NOT fixed (out of scope or high-risk):
# - P1: lsp_stdio.oo O(n²) buffer concat (would need new built-in)
# - P2: lsp_compile_cap_table_contains O(n²) (acceptable for small files)
# - lsp_compile.oo c: &CompilerReadCap param taken but not used in body
#   (the cap is still a security gate at the type level)

# ## 7. Final state after 8 deep-dive passes
#
