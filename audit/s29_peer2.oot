# TP — free-call eprintln guard
oodac emit-c e_groupplus.oo   # rc=1  ERR	secret	eprintln sink refuses SECRET tok
oodac emit-c e_igroup.oo      # rc=1  same
oodac emit-c e_nest.oo        # rc=1  same
oodac check  e_groupplus.oo   # rc=0  OK   (same front-door miss; emit-only save)

