```
// CRIT 2.3 / HIGH 6.1: env + OS/mmap sinks (cap-first → scan a1/a2)
if sink == "setenv" || sink == "env_set" || sink == "unsetenv" || sink == "mmap"
    || sink == "mprotect" || sink == "shmat" || sink == "pwrite" || sink == "sendfile"
    || sink == "splice" || sink == "tee" {
    if a1 != "" { c_secret_refuse_sink_resolved(env, sink, a1); }
    if a2 != "" { c_secret_refuse_sink_resolved(env, sink, a2); }
}
```

