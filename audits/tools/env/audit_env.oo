// # Audit Env - Root Resolution From The Environment
//
// Logline: Resolve the audit roots and the fleet identity from the environment with the documented absolute defaults.
//
// Setup: EnvCap only. Every root has an OODA_ prefixed override and the documented absolute default.
//
// Beats:
//   1. Read one environment value with a fallback.
//   2. Resolve the core, repository, and log roots.
//   3. Resolve the operating system, application, home, and lint roots.

import "std/fs/process/env.oo";

pub fn audit_env_or(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    if v == "" { return fallback; }
    return v;
}

pub fn audit_core_root(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_CORE", "/Projects/openOODA-core");
}

pub fn audit_repo_root(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_ROOT", "/Projects/openOODA/openOODA");
}

pub fn audit_log_dir(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_LOGS", "/Projects/openOODA/openOODA/audits/logs");
}

pub fn audit_os_root(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_OS", "/Projects/openOODA-OS");
}

pub fn audit_apps_root(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_APPS", "/Projects/openOODA-apps");
}

pub fn audit_home(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_HOME", "/home/ubermetroid");
}

pub fn audit_lint_bin(env: &EnvCap) -> String {
    return audit_env_or(env, "OODA_AUDIT_LINT", "/home/ubermetroid/.local/bin/lint-oo-size");
}
