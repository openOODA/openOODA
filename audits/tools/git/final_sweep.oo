// # Final Sweep - Independent Re Verification Sweep
//
// Logline: Verify and test every given repository twice and compare the two test runs.
//
// Setup: ProcessCap, FsReadCap, FsWriteCap, and EnvCap. The sweep log is the final sweep log of the audit tree.
//
// Beats:
//   1. Truncate the final sweep log.
//   2. Verify and test every repository twice.
//   3. Report the determinism verdict and close the sweep.

import "tools/env/audit_env.oo";
import "sweep_core.oo";

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: &EnvCap) -> Int {
    let repos: List[String] = sys_args(p);
    let root: String = audit_repo_root(e);
    let out: String = root + "/audits/mcode3-final-sweep.log";
    return sweep_run(p, fr, fw, e, out, repos);
}
