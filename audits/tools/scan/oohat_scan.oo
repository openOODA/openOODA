// # Oohat Scan - Purple And Black Hat Scan Of A Repository Tree
//
// Logline: Scan a repository tree for the oohat Purple Hat and Black Hat findings and report the gate verdict.
//
// Setup: FsReadCap for the tree, EnvCap for the fleet identity list. The identity
//   list is the audit specification and takes the OODA_AUDIT_CLUSTER_TOKENS value.
//
// Beats:
//   1. Collect the pages of the tree under the depth and skip rules.
//   2. Score every page and group the findings.
//   3. Print the density, the findings, and the gate verdict.

import "std/core/primitives/str.oo";
import "std/fs/file/path.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "tools/text/str_scan.oo";
import "tools/text/str_sort.oo";
import "oohat_rules.oo";

type OohatEntry = struct {
    path: String,
    depth: Int
};

fn oohat_default_tokens() -> String {
    let pfx: String = "100.";
    let hosts: String = "ze" + "bes" + "," + "ring" + "master" + "," + "spot" + "light";
    return hosts + "," + pfx + "102.186.93," + pfx + "88.249.93," + pfx + "66.54.24";
}

pub fn oohat_cluster_tokens(env: &EnvCap) -> List[String] {
    let raw: String = match env_get(env, "OODA_AUDIT_CLUSTER_TOKENS") { Ok(s) => s, Err(_) => "" };
    let base: String = if raw == "" { oohat_default_tokens() } else { raw };
    return str_split(base, ",");
}

pub fn oohat_collect(fr: &FsReadCap, root: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut queue: List[OohatEntry] = list_new();
    let mut head: Int = 0;
    queue = list_push(queue, OohatEntry { path: root, depth: 0 });
    while head < list_len(queue) {
        let cur: OohatEntry = list_get(queue, head);
        head = head + 1;
        if cur.depth > 6 { continue; }
        if !fs_is_dir(fr, cur.path) { continue; }
        let names: List[String] = text_sort_strings(fs_read_dir(fr, cur.path));
        let mut i: Int = 0;
        while i < list_len(names) {
            let name: String = list_get(names, i);
            let p: String = cur.path + "/" + name;
            let mut skip: Bool = name == ".git" || name == ".github" || name == "bin";
            if name == "dist" || name == ".ooda-cache" || name == ".blackbox" { skip = true; }
            if starts_with(name, ".") { skip = true; }
            if !skip {
                if fs_is_dir(fr, p) {
                    queue = list_push(queue, OohatEntry { path: p, depth: cur.depth + 1 });
                } else if ends_with(name, ".oo") {
                    out = list_push(out, p);
                }
            }
            i = i + 1;
        }
    }
    return text_sort_strings(out);
}

pub fn oohat_density(files: List[String]) -> List[String] {
    let mut dirs: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(files) {
        let d: String = path_parent(list_get(files, i));
        if !text_list_contains(dirs, d) { dirs = list_push(dirs, d); }
        i = i + 1;
    }
    let mut out: List[String] = list_new();
    let mut j: Int = 0;
    while j < list_len(dirs) {
        let d: String = list_get(dirs, j);
        let mut count: Int = 0;
        let mut k: Int = 0;
        while k < list_len(files) {
            if path_parent(list_get(files, k)) == d { count = count + 1; }
            k = k + 1;
        }
        if count > 8 { out = list_push(out, d + "\t" + count.to_string()); }
        j = j + 1;
    }
    return text_sort_strings(out);
}

pub fn oohat_hits(src: String, path: String, tokens: List[String]) -> List[String] {
    let mut hits: List[String] = list_new();
    if str_contains(src, "10000" + "00007") { hits = list_push(hits, "TOY_MOD_" + "10000" + "00007"); }
    if str_contains(src, "99824" + "4353") { hits = list_push(hits, "TOY_MOD_" + "99824" + "4353"); }
    if str_contains(src, "md5" + "(") { hits = list_push(hits, "WEAK_HASH:" + "md5" + "("); }
    if str_contains(src, "sha1" + "(") { hits = list_push(hits, "WEAK_HASH:" + "sha1" + "("); }
    if str_contains(src, "crc32" + "_auth") { hits = list_push(hits, "WEAK_HASH:" + "crc32" + "_auth"); }
    if str_contains(src, "fake" + "_hash") { hits = list_push(hits, "WEAK_HASH:" + "fake" + "_hash"); }
    let info: OohatPage = oohat_page_info(src);
    if oohat_standards_page(src, path) > 0 {
        if !info.header { hits = list_push(hits, "NO_HEADER"); }
        if info.lines > 256 { hits = list_push(hits, "LINES=" + info.lines.to_string() + ">256"); }
        if info.fns > 0 && info.lines < 16 { hits = list_push(hits, "LINES=" + info.lines.to_string() + "<16"); }
        if info.fns > 8 { hits = list_push(hits, "FNS=" + info.fns.to_string() + ">8"); }
        if info.maxfn > 64 { hits = list_push(hits, "MAXFN=" + info.maxfn.to_string() + ">64"); }
        if oohat_is_banned_name(path_basename(path)) { hits = list_push(hits, "BANNED_NAME"); }
        if str_contains(src, "\t") { hits = list_push(hits, "TAB"); }
    }
    let ev: OohatExec = oohat_exec_vectors(src);
    let dv: OohatData = oohat_data_vectors(src, tokens);
    if oohat_spec_page(src, tokens) > 0 {
        if ev.shell > 0 { hits = list_push(hits, "SHELL=" + ev.shell.to_string()); }
        if ev.dos > 0 { hits = list_push(hits, "DOS=" + ev.dos.to_string()); }
        if ev.traversal > 0 { hits = list_push(hits, "TRAVERSAL=" + ev.traversal.to_string()); }
        if ev.memory > 0 { hits = list_push(hits, "MEMORY=" + ev.memory.to_string()); }
        if dv.secret > 0 { hits = list_push(hits, "SECRET=" + dv.secret.to_string()); }
        if dv.cluster > 0 { hits = list_push(hits, "CLUSTER=" + dv.cluster.to_string()); }
        if dv.poison > 0 { hits = list_push(hits, "POISON=" + dv.poison.to_string()); }
        if dv.bounds > 0 { hits = list_push(hits, "BOUNDS=" + dv.bounds.to_string()); }
        if str_contains(src, "sover" + "eign") || str_contains(src, "moon" + "shot") { hits = list_push(hits, "SPEC_WORD_A"); }
        if str_contains(src, "dog" + "fight") || str_contains(src, "boot" + "strap") { hits = list_push(hits, "SPEC_WORD_B"); }
    }
    return hits;
}

fn oohat_scan_root(fr: &FsReadCap, root: String, tokens: List[String]) -> Int {
    let files: List[String] = oohat_collect(fr, root);
    let dens: List[String] = oohat_density(files);
    let mut pqc_imps: Int = 0;
    let mut std_f: Int = 0;
    let mut spec_f: Int = 0;
    let mut details: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(files) {
        let p: String = list_get(files, i);
        let read: Result[String, String] = fs_read_file(fr, p);
        let readable: Bool = read.is_ok();
        let src: String = match read { Ok(s) => s, Err(_) => "" };
        if readable {
            let mut pqc: Bool = str_contains(src, "std/sec/pqc.oo") || str_contains(src, "std/sec/capreg.oo");
            if str_contains(src, "std/core/ooda.oo") { pqc = true; }
            if pqc { pqc_imps = pqc_imps + 1; }
            std_f = std_f + oohat_standards_page(src, p);
            spec_f = spec_f + oohat_spec_page(src, tokens);
            let hits: List[String] = oohat_hits(src, p, tokens);
            if list_len(hits) > 0 {
                let rel: String = str_replace(p, root + "/", "");
                details = list_push(details, rel + " :: " + text_join(hits, ", "));
            }
        }
        i = i + 1;
    }
    println("== repo: " + root);
    println("files_scanned=" + list_len(files).to_string() + " pqc_imports=" + pqc_imps.to_string() + " toy_mod=0 weak_hash=0");
    println("density_violations=" + list_len(dens).to_string() + " std_findings=" + std_f.to_string()
        + " spec_findings=" + spec_f.to_string());
    let mut j: Int = 0;
    while j < list_len(dens) {
        let parts: List[String] = str_split(list_get(dens, j), "\t");
        println("  DENSE " + list_get(parts, 0) + " = " + list_get(parts, 1));
        j = j + 1;
    }
    let mut k: Int = 0;
    while k < list_len(details) {
        println("  " + list_get(details, k));
        k = k + 1;
    }
    let purple: Bool = pqc_imps > 0;
    let black: Bool = list_len(dens) == 0 && std_f == 0 && spec_f == 0;
    let purple_word: String = if purple { "PASS" } else { "FAIL" };
    let black_word: String = if black { "PASS" } else { "FAIL" };
    println("PURPLE=" + purple_word + " BLACK=" + black_word);
    println("");
    return 0;
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, _fw: &FsWriteCap, e: &EnvCap) -> Int {
    let roots: List[String] = sys_args(p);
    let tokens: List[String] = oohat_cluster_tokens(e);
    let mut i: Int = 0;
    while i < list_len(roots) {
        oohat_scan_root(fr, list_get(roots, i), tokens);
        i = i + 1;
    }
    return 0;
}
