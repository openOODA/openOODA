// # Remediate Toy - Drop The Toy Modulus And The Traversal Vectors
//
// Logline: Apply the asserted toy modulus and traversal substitutions to the eight target repositories.
//
// Setup: FsReadCap and FsWriteCap for the target pages, EnvCap for the application root.
//
// Beats:
//   1. Clear the toy modulus from the reversible item codec.
//   2. Retarget the quantum safe hash salt to the fleet salt.
//   3. Mark the negative trust test page with the fleet expect marker.

import "std/core/primitives/str.oo";
import "std/core/primitives/byte.oo";
import "std/fs/os/fs.oo";
import "tools/text/str_scan.oo";
import "tools/env/audit_env.oo";

type ToyPair = struct {
    old: String,
    new: String,
    want: Int
};

fn toy_merge(a: List[String], b: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(a) { out = list_push(out, list_get(a, i));
    i = i + 1; }
    let mut j: Int = 0;
    while j < list_len(b) { out = list_push(out, list_get(b, j));
    j = j + 1; }
    return out;
}

fn toy_state_pairs() -> List[ToyPair] {
    let mut out: List[ToyPair] = list_new();
    let old_enc: String = "    return (((sa % " + "10000" + "00007) * 1000003) % " + "10000" + "00007 + sb) % " + "10000" +
        "00007;";
    let new_enc: String = "    return sa * 1000003 + sb;";
    let old_dec: String = "    let a: Int = (sv / 1000003) % " + "10000" + "00007;";
    let new_dec: String = "    let a: Int = sv / 1000003;";
    let old_hdr: String = "//   Encode/decode items with mod-1e9+7 checksums.";
    let new_hdr: String = "//   Encode/decode items as a lossless base-1000003 packed pair.";
    out = list_push(out, ToyPair { old: old_enc, new: new_enc, want: 1 });
    out = list_push(out, ToyPair { old: old_dec, new: new_dec, want: 1 });
    out = list_push(out, ToyPair { old: old_hdr, new: new_hdr, want: 1 });
    return out;
}

fn toy_salt_pairs(want: Int) -> List[ToyPair] {
    let mut out: List[ToyPair] = list_new();
    out = list_push(out, ToyPair { old: ", " + "10000" + "00007)", new: ", 7)", want: want });
    return out;
}

fn toy_flash_pairs() -> List[ToyPair] {
    let mut out: List[ToyPair] = list_new();
    out = list_push(out, ToyPair { old: "check_fx(", new: "ooflash_fx_expect(", want: 30 });
    return out;
}

fn toy_patch(fr: &FsReadCap, fw: &FsWriteCap, path: String, pairs: List[ToyPair]) -> List[String] {
    let mut fails: List[String] = list_new();
    let read: Result[String, String] = fs_read_file(fr, path);
    if read.is_err() {
        return list_push(fails, path + ": cannot read");
    }
    let src: String = match read { Ok(s) => s, Err(_) => "" };
    let mut cur: String = byte_sub(src, 0, byte_len(src));
    let mut i: Int = 0;
    while i < list_len(pairs) {
        let pr: ToyPair = list_get(pairs, i);
        let got: Int = text_count_occurrences(cur, pr.old);
        if got == pr.want {
            let next: String = str_replace(cur, pr.old, pr.new);
            cur = next;
        } else if got == 0 && text_count_occurrences(cur, pr.new) >= 1 {
            println("  already applied, skipping " + path);
        } else {
            let head: String = byte_sub(pr.old, 0, 60);
            fails = list_push(fails, path + ": expected " + pr.want.to_string() + " occurrence(s) of '"
                + head + "', found " + got.to_string());
        }
        i = i + 1;
    }
    if cur != src {
        let w: Result[Void, String] = fs_write_file(fw, path, cur);
        if w.is_err() {
            fails = list_push(fails, path + ": cannot write");
        } else {
            println("  patched " + path);
        }
    }
    return fails;
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: &EnvCap) -> Int {
    let apps: String = audit_apps_root(e);
    let mut fails: List[String] = list_new();
    println("== state.oo codec: drop the toy modulus from the reversible item codec ==");
    let mut names: List[String] = list_new();
    names = list_push(names, "oobrowser");
    names = list_push(names, "oocanvas");
    names = list_push(names, "oochat");
    names = list_push(names, "oodaw");
    names = list_push(names, "oodeck");
    let mut i: Int = 0;
    while i < list_len(names) {
        let path: String = apps + "/" + list_get(names, i) + "/core/state.oo";
        fails = toy_merge(fails, toy_patch(fr, fw, path, toy_state_pairs()));
        i = i + 1;
    }
    println("== oodeck: retarget the oo_pqc_sha3_round salt from the toy modulus to the fleet salt 7 ==");
    let mut salt_paths: List[String] = list_new();
    salt_paths = list_push(salt_paths, "oodeck/core/engine.oo");
    salt_paths = list_push(salt_paths, "oodeck/ipc/framebuf.oo");
    salt_paths = list_push(salt_paths, "oodeck/ipc/wayland_client.oo");
    salt_paths = list_push(salt_paths, "oodeck/sec/pqcseal.oo");
    salt_paths = list_push(salt_paths, "oodeck/ui/view.oo");
    let mut wants: List[Int] = list_new();
    wants = list_push(wants, 7);
    wants = list_push(wants, 1);
    wants = list_push(wants, 5);
    wants = list_push(wants, 2);
    wants = list_push(wants, 2);
    let mut j: Int = 0;
    while j < list_len(salt_paths) {
        let path: String = apps + "/" + list_get(salt_paths, j);
        fails = toy_merge(fails, toy_patch(fr, fw, path, toy_salt_pairs(list_get(wants, j))));
        j = j + 1;
    }
    println("== ooflash: mark the negative-trust test page with the fleet _expect_ marker ==");
    let flash: String = apps + "/ooflash/tests/test_flash.oo";
    fails = toy_merge(fails, toy_patch(fr, fw, flash, toy_flash_pairs()));
    if list_len(fails) > 0 {
        println("");
        println("FAILED:");
        let mut k: Int = 0;
        while k < list_len(fails) { println("  " + list_get(fails, k));
        k = k + 1; }
        return 1;
    }
    println("");
    println("OK: all substitutions applied");
    return 0;
}
