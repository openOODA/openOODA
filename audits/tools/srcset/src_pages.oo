// # Src Set Pages - Declared Source Set Helpers
//
// Logline: Locate the declared source set of a Makefile and list the committed pages of a repository.
//
// Setup: FsReadCap for the Makefile and the repository tree. Pure string work for the source set line.
//
// Beats:
//   1. Name the fifteen target repositories.
//   2. Split a source set value on whitespace.
//   3. Locate the source set line and rewrite its value.
//   4. Collect the committed pages of a repository.

import "oostd/core/primitives/str.oo";
import "oostd/core/primitives/byte.oo";
import "oostd/fs/os/fs.oo";
import "tools/text/str_scan.oo";
import "tools/text/str_sort.oo";

type SrcLine = struct {
    start: Int,
    end: Int,
    value: String
};

pub fn srcset_repos() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "ooaid");
    out = list_push(out, "ooaudiod");
    out = list_push(out, "oodevd");
    out = list_push(out, "oodnsd");
    out = list_push(out, "oofs-ext4");
    out = list_push(out, "oofs-tmp");
    out = list_push(out, "oohealthd");
    out = list_push(out, "ooimage");
    out = list_push(out, "ooinit");
    out = list_push(out, "oologd");
    out = list_push(out, "oonetd");
    out = list_push(out, "oopolicyd");
    out = list_push(out, "oopowerd");
    out = list_push(out, "oorealm");
    out = list_push(out, "oosession");
    return out;
}

pub fn srcset_split_ws(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = "";
    let n: Int = byte_len(s);
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_get(s, i);
        let is_ws: Bool = b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
        if is_ws {
            if cur != "" { out = list_push(out, cur); }
            cur = "";
        } else {
            cur = cur + byte_sub(s, i, i + 1);
        }
        i = i + 1;
    }
    if cur != "" { out = list_push(out, cur); }
    return out;
}

pub fn srcset_find_src(text: String) -> SrcLine {
    let lines: List[String] = str_split(text, "\n");
    let mut offset: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        if starts_with(line, "SRC := ") {
            let value: String = byte_sub(line, 7, byte_len(line));
            return SrcLine { start: offset + 7, end: offset + byte_len(line), value: value };
        }
        offset = offset + byte_len(line) + 1;
        i = i + 1;
    }
    return SrcLine { start: 0 - 1, end: 0 - 1, value: "" };
}

pub fn srcset_replace_src(text: String, value: String) -> String {
    let line: SrcLine = srcset_find_src(text);
    if line.start < 0 { return text; }
    let head: String = byte_sub(text, 0, line.start);
    let tail: String = byte_sub(text, line.end, byte_len(text));
    return head + value + tail;
}

pub fn srcset_rewrite_src(text: String, names: List[String]) -> String {
    return srcset_replace_src(text, text_join(names, " "));
}

fn srcset_relpath(cur: String, dir: String, name: String) -> String {
    if cur == dir { return name; }
    let tail: String = byte_sub(cur, byte_len(dir) + 1, byte_len(cur));
    return tail + "/" + name;
}

pub fn srcset_collect_pages(fr: &FsReadCap, dir: String, skip: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut queue: List[String] = list_new();
    let mut head: Int = 0;
    queue = list_push(queue, dir);
    while head < list_len(queue) {
        let cur: String = list_get(queue, head);
        head = head + 1;
        let names: List[String] = fs_read_dir(fr, cur);
        let mut i: Int = 0;
        while i < list_len(names) {
            let name: String = list_get(names, i);
            let path: String = cur + "/" + name;
            if fs_is_dir(fr, path) {
                if !text_list_contains(skip, name) { queue = list_push(queue, path); }
            } else if ends_with(name, ".oo") {
                out = list_push(out, srcset_relpath(cur, dir, name));
            }
            i = i + 1;
        }
    }
    return text_sort_strings(out);
}
