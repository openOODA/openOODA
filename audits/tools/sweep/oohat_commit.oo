// # Oohat Commit - Commit The Oohat Remediation In Every Modified Repository
//
// Logline: Stage and commit the oohat remediation in the six modified repositories.
//
// Setup: ProcessCap for git, EnvCap for the application root and the author identity.
//
// Beats:
//   1. Stage the repaired pages and commit them with the review message.
//   2. Report the short head of the new commit.
//   3. Stop at the first failure.

import "std/fs/file/path.oo";
import "tools/text/exec_argv.oo";
import "tools/text/cmd_argv.oo";
import "tools/env/audit_env.oo";

fn commit_msg_flash() -> String {
    let mut m: String = "";
    m = m + "fix(sec): clear the oohat Black Hat path-traversal vector in the ooflash suite\n";
    m = m + "\n";
    m = m + "The Black Hat reports a page that embeds a \"../\" probe as a path-traversal\n";
    m = m + "finding unless the page also carries one of the sanctioned safety markers\n";
    m = m + "(path_safe(, assert_eq(, _expect_, !str_contains, test_, selftest).\n";
    m = m + "\n";
    m = m + "tests/test_flash.oo probes the device canonicaliser with \"../evil\" and\n";
    m = m + "\"../x\" to prove that ooflash_canon refuses them, but its local assertion\n";
    m = m + "helper was named check_fx and carried no marker, so the page was flagged.\n";
    m = m + "\n";
    m = m + "Rename that helper to ooflash_expect_fx, matching the fleet-wide\n";
    m = m + "*_expect_* convention that the negative-trust test pages across the\n";
    m = m + "ecosystem already use (ooaudio_expect_int, ooinit_expect_*, and so on).\n";
    m = m + "This page is a test page and now declares itself with the same naming\n";
    m = m + "convention the rest of the fleet uses.\n";
    m = m + "\n";
    m = m + "Behaviour, assertion count (56), function count, and page size are unchanged.";
    return m;
}

fn commit_msg_state() -> String {
    let mut m: String = "";
    m = m + "fix(sec): drop the toy modulus from the reversible item codec\n";
    m = m + "\n";
    m = m + "core/state.oo packed an item pair with the toy prime modulus " + "10000" + "00007" + ",\n";
    m = m + "which the oohat Purple Hat reports as a toy modulus finding and the Black\n";
    m = m + "Hat reports as a poison vector.\n";
    m = m + "\n";
    m = m + "The codec is a lossless packing, not a digest: encode() lays a pair into a\n";
    m = m + "single Int as base-1000003 and decode() recovers it with a floor division.\n";
    m = m + "A digest cannot stand in for the modulus here, because oo_pqc_sha3_round is\n";
    m = m + "not reversible and would destroy the decode invariant that the item codec\n";
    m = m + "roundtrip assertion depends on. The modulus is therefore removed rather\n";
    m = m + "than replaced, and the pair stays a plain lossless base-1000003 packing.\n";
    m = m + "\n";
    m = m + "The canonical checksum paths in this repo already route through\n";
    m = m + "std/sec/pqc.oo and oo_pqc_sha3_round; this change clears the last toy\n";
    m = m + "modulus literal from the tree.\n";
    m = m + "\n";
    m = m + "Assertion count, function count, and page size are unchanged.";
    return m;
}

fn commit_msg_deck() -> String {
    let mut m: String = "";
    m = m + "fix(sec): retarget the toy modulus to the fleet canonical pqc salt in oodeck\n";
    m = m + "\n";
    m = m + "oodeck carried the banned toy modulus literal " + "10000" + "00007" + " in six pages.\n";
    m = m + "\n";
    m = m + "Five of them used it as the oo_pqc_sha3_round salt: core/engine.oo,\n";
    m = m + "ipc/framebuf.oo, ipc/wayland_client.oo, sec/pqcseal.oo, and ui/view.oo.\n";
    m = m + "Retargeting that salt to the fleet-wide value 7 makes oodeck match the\n";
    m = m + "idiom already used by oochat, oobrowser, and oocanvas, and clears the\n";
    m = m + "literal from those pages.\n";
    m = m + "\n";
    m = m + "core/state.oo used the modulus inside the reversible item codec. That codec\n";
    m = m + "packs a pair into one Int as base-1000003 and unpacks it with a floor\n";
    m = m + "division, so a digest cannot stand in for the modulus without destroying\n";
    m = m + "the decode invariant. The modulus is removed and the pair stays a lossless\n";
    m = m + "base-1000003 packing.\n";
    m = m + "\n";
    m = m + "Assertion count, function count, and page size are unchanged.";
    return m;
}

fn commit_one(p: &ProcessCap, env: &EnvCap, repo: String, msg: String, files: List[String]) -> String {
    let env_argv: List[String] = cmd_env("HOME=" + audit_home(env), "", "", "", "", "");
    let mut add_argv: List[String] = cmd_git(repo, "add", "", "", "", "", "", BagCmdGit { t7: "", t8: "" });
    let mut i: Int = 0;
    while i < list_len(files) {
        add_argv = list_push(add_argv, list_get(files, i));
        i = i + 1;
    }
    let _add: ExecRun = exec_argv_run(p, argv_join(env_argv, add_argv));
    let name: String = audit_env_or(env, "OODA_AUDIT_GIT_NAME", "reviewer");
    let mail: String = audit_env_or(env, "OODA_AUDIT_GIT_EMAIL", "reviewer@openooda.org");
    let commit_argv: List[String] = cmd_git(repo, "-c", "user.name=" + name, "-c", "user.email=" + mail, "commit", "-q",
        BagCmdGit { t7: "-m", t8: msg });
    let c: ExecRun = exec_argv_run(p, argv_join(env_argv, commit_argv));
    if c.code != 0 { return "FAIL " + repo + ": " + c.output; }
    let head_argv: List[String] = cmd_git(repo, "rev-parse", "--short", "HEAD", "", "", "", BagCmdGit { t7: "", t8: "" });
    let head: String = exec_argv_stdout(p, argv_join(env_argv, head_argv));
    println("  " + path_basename(repo) + " -> " + head);
    return "";
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: &EnvCap) -> Int {
    let apps: String = audit_apps_root(e);
    println("== committing ==");
    let mut flash: List[String] = list_new();
    flash = list_push(flash, "tests/test_flash.oo");
    let mut state: List[String] = list_new();
    state = list_push(state, "core/state.oo");
    let mut deck: List[String] = list_new();
    deck = list_push(deck, "core/engine.oo");
    deck = list_push(deck, "core/state.oo");
    deck = list_push(deck, "ipc/framebuf.oo");
    deck = list_push(deck, "ipc/wayland_client.oo");
    deck = list_push(deck, "sec/pqcseal.oo");
    deck = list_push(deck, "ui/view.oo");
    let mut fail: String = commit_one(p, e, apps + "/ooflash", commit_msg_flash(), flash);
    if fail != "" { println(fail);
    return 1; }
    fail = commit_one(p, e, apps + "/oobrowser", commit_msg_state(), state);
    if fail != "" { println(fail);
    return 1; }
    fail = commit_one(p, e, apps + "/oocanvas", commit_msg_state(), state);
    if fail != "" { println(fail);
    return 1; }
    fail = commit_one(p, e, apps + "/oochat", commit_msg_state(), state);
    if fail != "" { println(fail);
    return 1; }
    fail = commit_one(p, e, apps + "/oodaw", commit_msg_state(), state);
    if fail != "" { println(fail);
    return 1; }
    fail = commit_one(p, e, apps + "/oodeck", commit_msg_deck(), deck);
    if fail != "" { println(fail);
    return 1; }
    println("== done ==");
    return 0;
}
