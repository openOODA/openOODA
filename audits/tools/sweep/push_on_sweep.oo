// # Push On Sweep - Push A Repository As Soon As Its Sweep Entry Passes
//
// Logline: Wait for the sweep entry of each repository and push it as soon as its second test run passes.
//
// Setup: ProcessCap for git and the poll delay, FsReadCap and FsWriteCap for the sweep
//   log and the push log, EnvCap for the roots.
//
// Beats:
//   1. Wait for the sweep entry of the repository and its passing marker.
//   2. Fetch the remote head and test whether the repository is already on origin.
//   3. Push the branch and record the outcome.

import "std/core/primitives/str.oo";
import "std/fs/file/path.oo";
import "std/fs/os/fs.oo";
import "tools/text/exec_argv.oo";
import "tools/text/cmd_argv.oo";
import "tools/env/audit_env.oo";

fn push_log(fw: &FsWriteCap, out: String, acc: String, line: String) -> String {
    print(line);
    let next: String = acc + line;
    let _w: Result[Void, String] = fs_write_file(fw, out, next);
    return next;
}

fn push_entry(fr: &FsReadCap, log: String, name: String) -> String {
    let src: String = match fs_read_file(fr, log) { Ok(s) => s, Err(_) => "" };
    let lines: List[String] = str_split(src, "\n");
    let needle: String = "/" + name + " =====";
    let mut entry: String = "";
    let mut inb: Bool = false;
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        if str_contains(line, needle) {
            inb = true;
            entry = "";
        } else {
            if starts_with(line, "===== ") { inb = false; }
            if inb { entry = entry + line + "\n"; }
        }
        i = i + 1;
    }
    return entry;
}

fn push_wait(p: &ProcessCap, fr: &FsReadCap, log: String, name: String) -> Bool {
    let mut waited: Int = 0;
    while waited < 720 {
        let entry: String = push_entry(fr, log, name);
        if str_contains(entry, "TEST RUN2: PASS") { return true; }
        let _s: ExecRun = exec_argv_run(p, cmd_prog("/bin/sleep", "10", "", "", "", ""));
        waited = waited + 1;
    }
    return false;
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: &EnvCap) -> Int {
    let args: List[String] = sys_args(p);
    if list_len(args) < 2 { return 0 - 1; }
    let log: String = list_get(args, 0);
    let root: String = audit_repo_root(e);
    let out: String = root + "/audits/mcode3-push.log";
    let _t: Result[Void, String] = fs_write_file(fw, out, "");
    let env_argv: List[String] = cmd_env("HOME=" + audit_home(e), "", "", "", "", "");
    let mut acc: String = "";
    let mut i: Int = 1;
    while i < list_len(args) {
        let repo: String = list_get(args, i);
        let name: String = path_basename(repo);
        push_wait(p, fr, log, name);
        let ref_argv: List[String] = cmd_git(repo, "symbolic-ref", "--short", "HEAD", "", "", "", "", "");
        let br: String = exec_argv_stdout(p, argv_join(env_argv, ref_argv));
        let _fetch: ExecRun = exec_argv_run(p, argv_join(env_argv, cmd_git(repo, "fetch", "origin", br, "-q", "", "", "", "")));
        let range: String = "origin/" + br + "..HEAD";
        let count_argv: List[String] = cmd_git(repo, "rev-list", "--count", range, "", "", "", "", "");
        let count: String = exec_argv_stdout(p, argv_join(env_argv, count_argv));
        if count == "0" {
            acc = push_log(fw, out, acc, name + ": already on origin\n");
            i = i + 1;
            continue;
        }
        let res: ExecRun = exec_argv_run(p, argv_join(env_argv, cmd_git(repo, "push", "origin", br, "", "", "", "", "")));
        let mut line: String = "";
        if str_contains(res.output, "non-fast-forward") {
            line = name + ": REJECTED (remote moved) -- needs rebase\n";
        } else {
            let head_argv: List[String] = cmd_git(repo, "rev-parse", "--short", "HEAD", "", "", "", "", "");
            let head: String = exec_argv_stdout(p, argv_join(env_argv, head_argv));
            line = name + ": pushed (" + br + ") " + head + "\n";
        }
        acc = push_log(fw, out, acc, line);
        i = i + 1;
    }
    let _done: String = push_log(fw, out, acc, "PUSH PASS DONE\n");
    return 0;
}
