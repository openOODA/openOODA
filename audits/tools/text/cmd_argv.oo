// # Audit Command Argv - Command Builders For The Audit Harnesses
//
// Logline: Build the argv lists that the audit harnesses pass to git, make, and the child environment.
//
// Setup: Imports the argument list helpers. Empty tail values are dropped so the caller can pass a fixed width.
//
// Beats:
//   1. Build an environment prefix that carries KEY=VALUE entries.
//   2. Build a plain program call and a git call inside one repository.
//   3. Build a make call inside one directory.

import "exec_argv.oo";

pub fn cmd_env(v1: String, v2: String, v3: String, v4: String, v5: String, v6: String) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "env");
    out = argv_add(out, v1);
    out = argv_add(out, v2);
    out = argv_add(out, v3);
    out = argv_add(out, v4);
    out = argv_add(out, v5);
    out = argv_add(out, v6);
    return out;
}

pub fn cmd_prog(prog: String, t1: String, t2: String, t3: String, t4: String, t5: String) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, prog);
    out = argv_add(out, t1);
    out = argv_add(out, t2);
    out = argv_add(out, t3);
    out = argv_add(out, t4);
    out = argv_add(out, t5);
    return out;
}

type BagCmdGit = struct {
    t7: String,
    t8: String,
};

pub fn cmd_git(repo: String, t1: String, t2: String, t3: String, t4: String, t5: String, t6: String,
    bag: BagCmdGit) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "git");
    out = list_push(out, "-C");
    out = list_push(out, repo);
    out = argv_add(out, t1);
    out = argv_add(out, t2);
    out = argv_add(out, t3);
    out = argv_add(out, t4);
    out = argv_add(out, t5);
    out = argv_add(out, t6);
    out = argv_add(out, bag.t7);
    out = argv_add(out, bag.t8);
    return out;
}

pub fn cmd_make(dir: String, target: String) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "make");
    out = list_push(out, "-C");
    out = list_push(out, dir);
    out = argv_add(out, target);
    return out;
}
