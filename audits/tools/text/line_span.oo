// # Audit Line Span - Head And Tail Of A Text Block
//
// Logline: Split a text block into lines and return the leading or trailing line window.
//
// Setup: Pure functions only. The runtime string split serves the line cut.
//
// Beats:
//   1. Split a text block into lines and drop the empty tail.
//   2. Return the first lines of a block, each line terminated.
//   3. Return the last lines of a block, each line terminated.


pub fn text_lines(s: String) -> List[String] {
    let parts: List[String] = str_split(s, "\n");
    let n: Int = list_len(parts);
    if n == 0 { return parts; }
    if list_get(parts, n - 1) != "" { return parts; }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n - 1 { out = list_push(out, list_get(parts, i));
    i = i + 1; }
    return out;
}

pub fn text_head_lines(s: String, count: Int) -> String {
    let lines: List[String] = text_lines(s);
    let n: Int = list_len(lines);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n && i < count {
        out = out + list_get(lines, i) + "\n";
        i = i + 1;
    }
    return out;
}

pub fn text_tail_lines(s: String, count: Int) -> String {
    let lines: List[String] = text_lines(s);
    let n: Int = list_len(lines);
    let mut out: String = "";
    let mut i: Int = n - count;
    if i < 0 { i = 0; }
    while i < n {
        out = out + list_get(lines, i) + "\n";
        i = i + 1;
    }
    return out;
}
