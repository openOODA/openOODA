// # Audit Text Scan - Whitespace, Count, And Word Primitives
//
// Logline: Trim text, count occurrences, and match whole words for the audit harnesses.
//
// Setup: Imports the string and byte primitive contracts. Pure functions only.
//
// Beats:
//   1. Trim the leading and trailing whitespace of a text.
//   2. Count the non overlapping occurrences of a needle.
//   3. Match a needle that stands on word boundaries.

import "std/core/primitives/str.oo";
import "std/core/primitives/byte.oo";

pub fn text_trim(s: String) -> String {
    let n: Int = byte_len(s);
    let mut start: Int = 0;
    while start < n && text_byte_is_space(byte_get(s, start)) { start = start + 1; }
    let mut end: Int = n;
    while end > start && text_byte_is_space(byte_get(s, end - 1)) { end = end - 1; }
    if end <= start { return ""; }
    return byte_sub(s, start, end);
}

fn text_byte_is_space(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

pub fn text_byte_is_word(b: Int) -> Bool {
    if b >= 48 && b <= 57 { return true; }
    if b >= 65 && b <= 90 { return true; }
    if b >= 97 && b <= 122 { return true; }
    return b == 95;
}

pub fn text_count_occurrences(s: String, needle: String) -> Int {
    let nl: Int = byte_len(needle);
    if nl == 0 { return 0; }
    let mut count: Int = 0;
    let mut rest: String = s;
    while true {
        let at: Int = index_of(rest, needle);
        if at < 0 { break; }
        count = count + 1;
        rest = byte_sub(rest, at + nl, byte_len(rest));
    }
    return count;
}

pub fn text_find_word(s: String, word: String) -> Bool {
    let wl: Int = byte_len(word);
    if wl == 0 { return false; }
    let sl: Int = byte_len(s);
    let mut base: Int = 0;
    while base <= sl {
        let at: Int = index_of(byte_sub(s, base, sl), word);
        if at < 0 { return false; }
        let abs: Int = base + at;
        let before_ok: Bool = abs == 0 || !text_byte_is_word(byte_get(s, abs - 1));
        let after: Int = abs + wl;
        let after_ok: Bool = after >= sl || !text_byte_is_word(byte_get(s, after));
        if before_ok && after_ok { return true; }
        base = abs + 1;
    }
    return false;
}

pub fn text_arg(argv: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(argv) { return ""; }
    return list_get(argv, i);
}

pub fn text_join(items: List[String], sep: String) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(items) {
        if i > 0 { out = out + sep; }
        out = out + list_get(items, i);
        i = i + 1;
    }
    return out;
}
