// # Audit String Sort - Byte Order Comparison And Stable Insertion Sort
//
// Logline: Order text values by byte order and keep the sorted list stable.
//
// Setup: Imports the byte primitive contract. Pure functions only.
//
// Beats:
//   1. Compare two text values by byte order.
//   2. Insert a value into a sorted list before its first larger neighbour.
//   3. Sort a list of text values and test list membership.

import "std/core/primitives/byte.oo";

pub fn text_byte_cmp(a: String, b: String) -> Int {
    let la: Int = byte_len(a);
    let lb: Int = byte_len(b);
    let mut n: Int = la;
    if lb < n { n = lb; }
    let mut i: Int = 0;
    while i < n {
        let ca: Int = byte_get(a, i);
        let cb: Int = byte_get(b, i);
        if ca < cb { return 0 - 1; }
        if ca > cb { return 1; }
        i = i + 1;
    }
    if la < lb { return 0 - 1; }
    if la > lb { return 1; }
    return 0;
}

fn text_sorted_insert(xs: List[String], value: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut placed: Bool = false;
    let mut i: Int = 0;
    while i < list_len(xs) {
        let cur: String = list_get(xs, i);
        if !placed && text_byte_cmp(value, cur) < 0 {
            out = list_push(out, value);
            placed = true;
        }
        out = list_push(out, cur);
        i = i + 1;
    }
    if !placed { out = list_push(out, value); }
    return out;
}

pub fn text_sort_strings(xs: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(xs) {
        out = text_sorted_insert(out, list_get(xs, i));
        i = i + 1;
    }
    return out;
}

pub fn text_list_contains(xs: List[String], value: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(xs) {
        if list_get(xs, i) == value { return true; }
        i = i + 1;
    }
    return false;
}
