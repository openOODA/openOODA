// # buildbox — OODA-buildbox loop driver (zebes container)
//
// Logline: Front door for the 24/7 build/audit loop: fetch, build, gate, fan-out.
//
// Setup: Runs inside ooda-buildbox as the native entrypoint. Repos under
//   /work/repos, queue under /queue, cache under /cache.
//
// Beats:
//   1. Re-export the loop entrypoint.
//   2. ooda_loop.oo owns fetch/build/gate/fan-out/queue.

import "ooda_loop.oo";

pub fn buildbox_anchor() -> Int {
    return buildbox_ping();
}
