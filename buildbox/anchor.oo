// # buildbox - OODA-buildbox loop driver (zebes container)
//
// Logline: Front door for the 24/7 build, validate, and repair loop.
//
// Setup: Runs inside ooda-buildbox as the native entrypoint. Repos under
//   /work/repos, queue under /queue, cache under /cache.
//
// Beats:
//   1. Re-export the loop entrypoint.
//   2. Re-export the single flight lock, the compiler identity, and the fetch.
//   3. Re-export the fleet inventory, verdict vocabulary, and gate.
//   4. Re-export the redaction engine.

import "ooda_loop.oo";
import "loop/setup.oo";
import "loop/lock.oo";
import "loop/cache.oo";
import "loop/fetch.oo";
import "loop/manifest.oo";
import "loop/run.oo";
import "loop/driver.oo";
import "loop/gh_api.oo";
import "fleet/anchor.oo";
import "redact/anchor.oo";
import "text/anchor.oo";
import "eco/anchor.oo";

pub fn buildbox_anchor() -> Int {
    return buildbox_ping();
}
