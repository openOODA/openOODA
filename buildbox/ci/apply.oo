// # Fleet Apply - Writes The CI Contract And The Parity Gate Into Every Repository
//
// Logline: Applies the workflow file, the parity runner, the case table, and the Makefile patch to one fleet repository.
//
// Setup: Needs FsReadCap to read the repository and FsWriteCap to write the new files.
//
// Beats:
//   1. Write the workflow file.
//   2. Write the parity runner.
//   3. Write the case table and the declared deviations.
//   4. Patch the Makefile.
//   5. Apply the whole contract to one repository.
//
// The harness source is read once and copied into every repository, so every
// repository holds the same parity runner and the runner never drifts.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "ci/template.oo";
import "ci/packages.oo";
import "ci/makefile.oo";
import "ci/release.oo";
import "ci/cases.oo";
import "parity/cases.oo";


pub fn ci_apply_release(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, repo: String, upstream: String) -> Bool {
    let dir: String = repo_dir + "/.github/workflows";
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
    let big: Bool = ci_apply_is_big(fs_r, repo_dir);
    let body: String = ci_release_workflow(repo, upstream, ci_package_of(upstream), ci_package_binary(upstream), big);
    let w: Result[Void, String] = fs_write_file(fs_w, dir + "/release.yml", body);
    if w.is_err() { return false; }
    return true;
}

// The number of lines above which a tool is built the per module way. The
// single unit path holds every page of a tool in one translation unit, and
// the three largest tools of the fleet do not fit in the memory of a runner
// that way.
pub fn ci_apply_big_limit() -> Int {
    return 5000;
}

// Report whether a tool is too big for the single unit build path.
//
// The per module path is the one that does not fit in memory, so it is the
// exception and not the rule. Every other tool is built as one unit, because
// the per module path drops the code of a page named anchor.oo and the
// declaration of a runtime symbol, and a third of the fleet cannot be linked
// that way.
pub fn ci_apply_is_big(fs_r: &FsReadCap, repo_dir: String) -> Bool {
    let files: List[String] = fs_walk(fs_r, repo_dir);
    let mut lines: Int = 0;
    let mut i: Int = 0;
    while i < list_len(files) {
        let p: String = list_get(files, i);
        i = i + 1;
        if !str_ends_with(p, ".oo") { continue; }
        let r: Result[String, String] = fs_read_file(fs_r, p);
        if r.is_err() { continue; }
        let mut n: Int = 1;
        let mut j: Int = 0;
        while j < chars_len(r.val) {
            if char_at(r.val, j) == "\n" { n = n + 1; }
            j = j + 1;
        }
        lines = lines + n;
        if lines > ci_apply_big_limit() { return true; }
    }
    return false;
}

// Write the workflow file of one repository.
pub fn ci_apply_workflow(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, repo: String, upstream: String) -> Bool {
    let dir: String = repo_dir + "/.github/workflows";
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
    let mk_path: String = repo_dir + "/Makefile";
    let package: String = ci_package_of(upstream);
    let binary: String = ci_package_binary(upstream);
    let target: String = ci_mk_workflow_target(fs_r, mk_path);
    let has_build: Bool = ci_apply_has_build(fs_r, mk_path);
    let big: Bool = ci_apply_is_big(fs_r, repo_dir);
    let body: String = ci_workflow(repo, upstream, package, target, binary, has_build, big);
    let w: Result[Void, String] = fs_write_file(fs_w, dir + "/ci.yml", body);
    if w.is_err() { return false; }
    return true;
}

// Write the parity runner of one repository. The runner is two pages: the
// runner itself and the word codec it shares with the generator. Both pages
// are copied, so the runner in a repository reads the case table with the same
// code that wrote it.
pub fn ci_apply_harness(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, harness_dir: String) -> Bool {
    let dir: String = repo_dir + "/qa/parity";
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
    let mut ok: Bool = true;
    let r1: Result[String, String] = fs_read_file(fs_r, harness_dir + "/run.oo");
    if r1.is_ok() {
        let w1: Result[Void, String] = fs_write_file(fs_w, dir + "/run.oo", r1.val);
        if w1.is_err() { ok = false; }
    } else {
        ok = false;
    }
    let r2: Result[String, String] = fs_read_file(fs_r, harness_dir + "/words.oo");
    if r2.is_ok() {
        let w2: Result[Void, String] = fs_write_file(fs_w, dir + "/words.oo", r2.val);
        if w2.is_err() { ok = false; }
    } else {
        ok = false;
    }
    return ok;
}



pub fn ci_apply_has_build(fs_r: &FsReadCap, mk_path: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, mk_path);
    if r.is_err() { return false; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_starts_with(l, "build:") || str_starts_with(l, "build :") { return true; }
        i = i + 1;
    }
    return false;
}

// Apply the whole contract to one repository.
pub fn ci_apply_repo(fs_r: &FsReadCap, fs_w: &FsWriteCap, fleet: String, repo: String, upstream: String,
    harness_dir: String) -> Bool {
    let repo_dir: String = fleet + "/" + repo;
    let mk_path: String = repo_dir + "/Makefile";
    let cases: List[String] = parity_case_collect(fs_r, repo, mk_path, repo_dir + "/qa/parity/deviations.oot");
    let _c: Bool = ci_apply_cases(fs_r, fs_w, repo_dir, repo, upstream, cases);
    let _d: Bool = ci_apply_deviations(fs_r, fs_w, repo_dir, repo);
    let _h: Bool = ci_apply_harness(fs_r, fs_w, repo_dir, harness_dir);
    if ci_apply_has_build(fs_r, mk_path) {
        let _m: Bool = ci_mk_patch(fs_r, fs_w, mk_path);
    }
    let _w: Bool = ci_apply_workflow(fs_r, fs_w, repo_dir, repo, upstream);
    let _r: Bool = ci_apply_release(fs_r, fs_w, repo_dir, repo, upstream);
    return true;
}
