// # Fleet Cases - Writes The Case Table And The Declared Deviations Of A Tool
//
// Logline: Writes the parity case table of one repository and the file of the deviations its owner declares.
//
// Setup: Needs FsReadCap to read the repository and FsWriteCap to write the new files.
//
// Beats:
//   1. Build the case table of one tool.
//   2. Write the case table into the repository.
//   3. Write the file of declared deviations, but only when it is not there.
//
// The deviations are written by the owner of the tool and are not a thing the
// contract may replace, so the file is only written when it is not there yet.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";

// Build the case table of one tool. The table names the upstream tool, the
// tool under test, and one case per line.
pub fn ci_apply_cases_table(repo: String, upstream: String, cases: List[String]) -> String {
    let mut l: List[String] = list_new();
    l = list_push(l, "# Parity cases for " + repo + ".");
    if upstream == "" {
        l = list_push(l, "# This tool has no upstream program. It is an openOODA tool and not a");
        l = list_push(l, "# drop-in replacement, so the parity gate does not run against it.");
    } else {
        l = list_push(l, "# The tool replaces " + upstream + " and must behave the same way.");
    }
    l = list_push(l, "# upstream: " + upstream);
    l = list_push(l, "# tool: dist/" + repo);
    l = list_push(l, "#");
    l = list_push(l, "# A match case must produce the same stdout, the same stderr, and the same");
    l = list_push(l, "# exit code as the upstream tool. A differ case is a declared deviation: the");
    l = list_push(l, "# exit code must still be the same, but the output may differ.");
    l = list_push(l, "#");
    l = list_push(l, "# The upstream tool is the reference. A tool that is not a drop-in");
    l = list_push(l, "# replacement must fix the difference or declare the deviation here.");
    l = list_push(l, "#");
    l = list_push(l, "# The workflow installs the upstream tool. The parity runner reads this table");
    l = list_push(l, "# from the repository root and runs every case with the same arguments");
    l = list_push(l, "# against both tools. A case that the upstream tool does not understand is");
    l = list_push(l, "# skipped, because the upstream cannot be the reference there.");
    l = list_push(l, "#");
    l = list_push(l, "# The cases come from the test recipe of this repository, so they are the");
    l = list_push(l, "# arguments this tool already claims to accept.");
    l = list_push(l, "#");
    l = list_push(l, "# A case may be preceded by an input line. That line names the command that");
    l = list_push(l, "# makes the input of the case and its arguments. The runner pipes that command");
    l = list_push(l, "# into both tools, so a tool that works on a stream is compared on a stream.");
    l = list_push(l, "");
    let mut i: Int = 0;
    while i < list_len(cases) {
        l = list_push(l, list_get(cases, i));
        i = i + 1;
    }
    return text_join_lines(l) + "\n";
}

// Write the release workflow file of one repository. A pushed tag becomes a
// published release through the shared auto release workflow of the openOODA
// repository.

// The header of the file of declared deviations. It is long enough to clear
// the floor of the Page Rule, because a file of a page holds at least sixteen
// lines, and it says what a declared deviation is and what it is not.
pub fn ci_apply_deviations_header(repo: String) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "# Declared deviations of " + repo + ".");
    l = list_push(l, "#");
    l = list_push(l, "# A case line written here is a deviation the owner declares: the exit");
    l = list_push(l, "# code still has to be the same as the upstream tool, but the text of the");
    l = list_push(l, "# answer may differ. Every other case has to match the upstream tool");
    l = list_push(l, "# byte for byte.");
    l = list_push(l, "#");
    l = list_push(l, "# Write the case line as it stands in qa/parity/cases.oot, with its");
    l = list_push(l, "# match word in front of it.");
    l = list_push(l, "#");
    l = list_push(l, "# A deviation is not a way to make the gate pass. The exit code of a");
    l = list_push(l, "# declared case is still compared with the exit code of the upstream");
    l = list_push(l, "# tool, and a case whose exit code differs is a failure that has to be");
    l = list_push(l, "# fixed in the tool. A deviation says that the tool answers the same");
    l = list_push(l, "# question the same way and words the answer its own way.");
    l = list_push(l, "#");
    l = list_push(l, "# The cases come from the test recipe of the repository, so a case line");
    l = list_push(l, "# that is not in the table is a line the recipe does not hold any more.");
    l = list_push(l, "# Such a line is ignored, and it does not change the gate.");
    return l;
}

// Write the file of declared deviations of one repository. The cases the owner
// wrote are kept, and the header is written again, so the file always says
// what a declared deviation is.
pub fn ci_apply_deviations(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, repo: String) -> Bool {
    let dir: String = repo_dir + "/qa/parity";
    let path: String = dir + "/deviations.oot";
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
    let mut l: List[String] = ci_apply_deviations_header(repo);
    let old: Result[String, String] = fs_read_file(fs_r, path);
    if old.is_ok() {
        let lines: List[String] = text_split_lines(old.val);
        let mut i: Int = 0;
        while i < list_len(lines) {
            let line: String = text_trim(list_get(lines, i));
            i = i + 1;
            if str_starts_with(line, "match ") || str_starts_with(line, "differ ") {
                l = list_push(l, line);
            }
        }
    }
    let w: Result[Void, String] = fs_write_file(fs_w, path, text_join_lines(l) + "\n");
    if w.is_err() { return false; }
    return true;
}

// Write the case table of one repository.

pub fn ci_apply_cases(fs_w: &FsWriteCap, repo_dir: String, repo: String, upstream: String, cases: List[String]) -> Bool {
    let dir: String = repo_dir + "/qa/parity";
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
    let body: String = ci_apply_cases_table(repo, upstream, cases);
    let w: Result[Void, String] = fs_write_file(fs_w, dir + "/cases.oot", body);
    if w.is_err() { return false; }
    return true;
}

// Report whether a Makefile declares a build target. A repository without a
// build target is a stub. The workflow fails it closed, so its Makefile keeps
// its own shape and no parity target is wired into it.
