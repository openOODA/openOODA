// # CI Law - The Static Governance Gates Every Tool Of The Fleet Carries
//
// Logline: Holds one canonical body for every static gate of the fleet, so every tool of the fleet carries the same gate and the gate fails closed.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Build the body of the gate of the file law.
//   2. Build the body of the gate of the vocabulary.
//   3. Build the body of the gate of the shape.
//   4. Build the body of the gate of the compiler check.
//   5. Build the body of the gate of the determinism.
//   6. Put the gates into the Makefile of one tool.
//
// The fleet held seventeen shapes of the gate of the file law and three names
// for the gate of the shape. A gate that is written by hand drifts, and a
// gate that is not reachable from the target of the verification never runs.
// The gates of this page are therefore generated and installed by the
// contract, and every tool of the fleet carries the same body.
//
// The gate of the shape holds the size debt of the tool that is already
// there. The debt is named in the variable SIZE_BASELINE of the Makefile. A
// size violation that is not named in that variable is new and fails the
// gate, and a violation that grew fails the gate too. The rule of the
// organization grandfathers the inventory that is already there and fails
// closed on everything that comes after it.

import "std/core/primitives/str.oo";
import "std/core/text/num_buffer.oo";
import "text/lines.oo";
import "ci/parts/law_check.oo";

// The body of the gate of the file law. The gate names the file types that
// no tool of the fleet may hold, the scripts that only the installer may
// hold, the documents that only the readme may hold, and the page names that
// no tool of the fleet may use.
pub fn ci_law_file_law() -> List[String] {
    let skip: String = " -not -path \"./.git/*\" -not -path \"./.github/*\" -not -path \"./dist/*\" -not -path \"./.ooda-cache/*\" -not -path \"./.blackbox/*\" -not -path \"./.agents/*\" -not -path \"./bin/*\"";
    let mut l: List[String] = list_new();
    l = list_push(l, "file-law:");
    l = list_push(l, "\t@forbidden=\"py rs js ts rb pl json yaml toml\"; \\");
    l = list_push(l, "\tviolations=0; \\");
    l = list_push(l, "\tfor ext in $$forbidden; do \\");
    l = list_push(l, "\t\tfound=$$(find . -name \"*.$$ext\"" + skip + " 2>/dev/null | head -3); \\");
    l = list_push(l, "\t\tif [ -n \"$$found\" ]; then echo \"VIOLATION: .$$ext forbidden:\"; echo \"$$found\"; violations=$$((violations+1)); fi; \\");
    l = list_push(l, "\tdone; \\");
    l = list_push(l, "\tfor f in $$(find . -name \"*.sh\"" + skip + " 2>/dev/null); do \\");
    l = list_push(l, "\t\tb=$$(basename \"$$f\"); \\");
    l = list_push(l, "\t\tif [ \"$$b\" != \"install.sh\" ] && [ \"$$b\" != \"uninstall.sh\" ]; then echo \"VIOLATION: .sh forbidden outside install.sh and uninstall.sh: $$f\"; violations=$$((violations+1)); fi; \\");
    l = list_push(l, "\tdone; \\");
    l = list_push(l, "\tfor f in $$(find . -name \"*.md\"" + skip + " 2>/dev/null); do \\");
    l = list_push(l, "\t\tb=$$(basename \"$$f\"); \\");
    l = list_push(l, "\t\tif [ \"$$b\" != \"README.md\" ] && [ \"$$b\" != \"AGENTS.md\" ]; then echo \"VIOLATION: .md forbidden outside README.md and AGENTS.md: $$f\"; violations=$$((violations+1)); fi; \\");
    l = list_push(l, "\tdone; \\");
    l = list_push(l, "\tfor nm in util utils helper helpers common misc shared base core; do \\");
    l = list_push(l, "\t\tfound=$$(find . -name \"$$nm.oo\"" + skip + " 2>/dev/null | head -3); \\");
    l = list_push(l, "\t\tif [ -n \"$$found\" ]; then echo \"VIOLATION: banned page name $$nm.oo:\"; echo \"$$found\"; violations=$$((violations+1)); fi; \\");
    l = list_push(l, "\tdone; \\");
    l = list_push(l, "\tif [ $$violations -gt 0 ]; then echo \"FAIL: file-law violations\"; exit 1; fi; \\");
    l = list_push(l, "\techo \"PASS: file law holds\"");
    l = list_push(l, "");
    return l;
}

// The body of the gate of the vocabulary. The gate reads every kind of file
// that the rule of the organization names, so a banned word that hides in a
// readme or in a manifest is found the same way as one that hides in a page.
pub fn ci_law_vocab() -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "vocab:");
    l = list_push(l, "\t@if grep -riE \"sovereign|pillar [0-9]|stage [0-9]|bootstrap|moonshot|dogfight|combat|fighter|missile|drone|stealth|swarm|hypervisor|supervisor\" --include=\"*.oo\" --include=\"*.oot\" --include=\"*.md\" --include=\"*.pkg\" --include=\"*.yml\" . | grep -v \"/.git/\" | grep -v \"/.ooda-cache/\" | grep -v \"/bin/\" | grep -v \"/dist/\" ; then \\");
    l = list_push(l, "\t\techo \"FAIL: banned vocabulary found\"; exit 1; \\");
    l = list_push(l, "\tfi; \\");
    l = list_push(l, "\techo \"PASS: vocabulary check holds\"");
    l = list_push(l, "");
    return l;
}

// The body of the gate of the shape. The gate reads the number of the
// functions of every page and the length of every function, and it fails
// when a violation is new or when a violation grew. The violations that are
// already there are named in the variable SIZE_BASELINE of the Makefile.
pub fn ci_law_shape() -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "shape:");
    l = list_push(l, "\t@mkdir -p .ooda-cache; : > .ooda-cache/shape.now; \\");
    l = list_push(l, "\tfor f in $$(find . -name \"*.oo\" -not -path \"./.git/*\" -not -path \"./dist/*\" -not -path \"./.ooda-cache/*\" -not -path \"./bin/*\"); do \\");
    l = list_push(l, "\t\tawk '/^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]/ { if (started) { len = NR - start; if (len > 64) print \"FNLEN|\" FILENAME \"|\" fn \"|\" len } started = 1; start = NR; if ($$1 == \"pub\") fn = $$3; else fn = $$2; gsub(/\\(.*/, \"\", fn) } END { if (started) { len = NR - start + 1; if (len > 64) print \"FNLEN|\" FILENAME \"|\" fn \"|\" len } }' \"$$f\" >> .ooda-cache/shape.now; \\");
    l = list_push(l, "\t\tn=$$(grep -cE \"^[[:space:]]*(pub[[:space:]]+)?fn \" \"$$f\" || true); \\");
    l = list_push(l, "\t\tif [ \"$$n\" -gt 8 ]; then echo \"SHAPE|$$f|-|$$n\" >> .ooda-cache/shape.now; fi; \\");
    l = list_push(l, "\tdone; \\");
    l = list_push(l, "\tviolations=0; \\");
    l = list_push(l, "\twhile IFS='|' read -r kind path name value; do \\");
    l = list_push(l, "\t\t[ -z \"$$kind\" ] && continue; \\");
    l = list_push(l, "\t\tbase=$$(printf '%s' \"$(SIZE_BASELINE)\" | tr ';' '\\n' | grep -F \"$$kind|$$path|$$name|\" | head -1); \\");
    l = list_push(l, "\t\tif [ -z \"$$base\" ]; then echo \"VIOLATION: new size violation $$kind|$$path|$$name|$$value\"; violations=$$((violations+1)); \\");
    l = list_push(l, "\t\telse max=$$(printf '%s' \"$$base\" | awk -F'|' '{print $$NF}'); \\");
    l = list_push(l, "\t\t\tif [ \"$$value\" -gt \"$$max\" ]; then echo \"VIOLATION: size violation grew $$kind|$$path|$$name|$$value > $$max\"; violations=$$((violations+1)); fi; \\");
    l = list_push(l, "\t\tfi; \\");
    l = list_push(l, "\tdone < .ooda-cache/shape.now; \\");
    l = list_push(l, "\tif [ $$violations -gt 0 ]; then echo \"FAIL: $$violations new or grown size violations\"; exit 1; fi; \\");
    l = list_push(l, "\techo \"PASS: shape law holds (no new size violations)\"");
    l = list_push(l, "");
    return l;
}

// The body of the gate of the determinism. The gate builds the tool twice
// and compares the two builds, so a build that is not reproducible fails.
pub fn ci_law_det() -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "det: build");
    l = list_push(l, "\t@mkdir -p .ooda-cache");
    l = list_push(l, "\t@$(OODA_COMPILER) build main.oo -o .ooda-cache/det_a > /dev/null");
    l = list_push(l, "\t@$(OODA_COMPILER) build main.oo -o .ooda-cache/det_b > /dev/null");
    l = list_push(l, "\t@cmp -s .ooda-cache/det_a .ooda-cache/det_b && sha256sum .ooda-cache/det_a && echo \"PASS: deterministic build\"");
    l = list_push(l, "");
    return l;
}

// The span of the target of the given name. The answer holds the line of the
// target and the line after the body of the target. The answer holds minus
// one and minus one when the Makefile holds no target of that name.
pub fn ci_law_target_span(lines: List[String], name: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        if str_starts_with(list_get(lines, i), name + ":") {
            let mut j: Int = i + 1;
            while j < list_len(lines) {
                let line: String = list_get(lines, j);
                if line != "" && !str_starts_with(line, "\t") && !str_starts_with(line, " ") { break; }
                j = j + 1;
            }
            out = list_push(out, i);
            out = list_push(out, j);
            return out;
        }
        i = i + 1;
    }
    out = list_push(out, -1);
    out = list_push(out, -1);
    return out;
}

// Put the given body into the lines of a Makefile. A target that is already
// there is replaced, and a target that is not there is added before the
// target of the check. The answer holds the lines.
pub fn ci_law_replace(lines: List[String], name: String, block: List[String]) -> List[String] {
    let span: List[Int] = ci_law_target_span(lines, name);
    let start: Int = list_get(span, 0);
    let stop: Int = list_get(span, 1);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    let mut placed: Bool = false;
    while i < list_len(lines) {
        if start >= 0 && i == start {
            let mut j: Int = 0;
            while j < list_len(block) { out = list_push(out, list_get(block, j)); j = j + 1; }
            i = stop;
            placed = true;
            continue;
        }
        if start < 0 && !placed && str_starts_with(list_get(lines, i), "check:") {
            let mut j: Int = 0;
            while j < list_len(block) { out = list_push(out, list_get(block, j)); j = j + 1; }
            placed = true;
        }
        out = list_push(out, list_get(lines, i));
        i = i + 1;
    }
    if !placed {
        let mut j: Int = 0;
        while j < list_len(block) { out = list_push(out, list_get(block, j)); j = j + 1; }
    }
    return out;
}

// Wire the gates into the target of the verification. The answer holds the
// lines. Every canonical gate always runs, and a gate that the tool held and
// that the canonical set does not name keeps running too. A target of the
// verification that names no gate at all is a fail-open path, because a gate
// that no verification calls never runs.
pub fn ci_law_verify_deps(lines: List[String]) -> List[String] {
    let canon: String = "line-cap file-law academy density check vocab shape";
    let gone: String = " fnlen fn-cap ";
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        if str_starts_with(line, "verify:") {
            let deps: String = text_trim(str_slice(line, 7, chars_len(line)));
            let parts: List[String] = text_split_lines(str_replace(deps, " ", "\n"));
            let mut keep: String = "";
            let mut j: Int = 0;
            while j < list_len(parts) {
                let p: String = text_trim(list_get(parts, j));
                if p != "" && !str_contains(" " + canon + " ", " " + p + " ") && !str_contains(gone, " " + p + " ") && !str_contains(" " + keep + " ", " " + p + " ") {
                    keep = keep + " " + p;
                }
                j = j + 1;
            }
            out = list_push(out, "verify: " + canon + keep);
            i = i + 1;
            continue;
        }
        out = list_push(out, line);
        i = i + 1;
    }
    return out;
}

// Put every canonical gate into the Makefile of one tool and wire the gates
// into the target of the verification. The answer holds the lines. The gates
// of the old shape and of the old length are removed, because the gate of the
// shape replaces both of them.
pub fn ci_law_ensure(lines: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    let mut out: List[String] = ci_law_replace(lines, "fn-cap", empty);
    out = ci_law_replace(out, "fnlen", empty);
    out = ci_law_replace(out, "file-law", ci_law_file_law());
    out = ci_law_replace(out, "vocab", ci_law_vocab());
    out = ci_law_replace(out, "shape", ci_law_shape());
    out = ci_law_replace(out, "check", ci_law_check());
    out = ci_law_replace(out, "det", ci_law_det());
    out = ci_law_verify_deps(out);
    return out;
}
