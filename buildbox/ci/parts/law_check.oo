// # CI Law Check - The Parallel Gate Of The Compiler Check
//
// Logline: Holds the body of the gate of the compiler check, so every page of a tool is checked at the same time and a page that fails is named.
//
// Setup: Pure. No caps. No IO.
//
// Beats:
//   1. Build the body of the gate of the compiler check.
//
// The gate of the compiler check is the slowest gate of a tool, because it
// starts one compiler for every page of the tool and waits for it. A tool that
// holds a hundred pages pays a hundred waits. The gate therefore hands the
// pages to the compiler through a runner that keeps many pages in flight at
// the same time, and the number of pages in flight is named by the setting
// OO_CHECK_JOBS.
//
// The gate keeps the reach of the gate of the old shape: every page of the
// tool is checked, a page that fails the check fails the gate, and the gate
// names the page that failed. The order of the pages is not part of the gate,
// so the order in which the pages are checked does not matter.

// The body of the gate of the compiler check. The answer holds the lines.
pub fn ci_law_check() -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "check:");
    l = list_push(l, "\t@find . -name \"*.oo\" -not -path \"./dist/*\" -print0 | xargs -0 -r -P $${OO_CHECK_JOBS:-4} -n 1 " +
        "sh" + " -c" +
            " 'OO_LIST_AMBIENT_QUOTA=$(OO_LIST_AMBIENT_QUOTA) OODACODEX=$(OODACODEX) OODA_COMPILER=$(OODA_COMPILER) OODA_NO_J" +
                "AIL=1 $(OODA_COMPILER) check \"$$1\" > /dev/null || { echo \"VIOLATION: oodac check fails on $$1\"; exit 1; " +
                    "}' _ || exit 1");
    l = list_push(l, "\t@echo \"PASS: oodac check holds on all .oo files\"");
    l = list_push(l, "");
    return l;
}
