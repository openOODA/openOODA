// # Parity Runner - Compares The Tool Against The Tool It Replaces
// Logline: Runs the upstream tool and the built tool with the same arguments and reports every difference.
// Setup: Needs ProcessCap to run both binaries and FsReadCap to read the case table.
// Beats:
//   1. Read the upstream tool and the tool under test out of the case table.
//   2. Require the upstream tool. A missing upstream tool fails the run.
//   3. Run both tools with the same arguments and compare stdout, stderr, and the exit code.
//
// The case table holds one case per line. A line that starts with "match" is a
// case whose stdout, stderr, and exit code must be identical to the upstream
// tool. A line that starts with "differ" is a declared deviation: the exit
// code must be identical and the output may differ. A line that starts with
// "input" gives the standard input of the case that follows it. The line names
// the command that makes the input and its arguments, and the runner pipes
// that command into both tools. A line that starts with "setup" gives a
// command that prepares the input of the cases that follow it. The command is
// run again before each of the two tools, so both see the same input even when
// one of them changes it.
//
// A line that starts with "persona" gives the persona of the case that
// follows it. The line names the persona word and the upstream program the
// persona must behave like: "persona oounzip unzip". The tool under test
// receives the persona word as its first argument, and the upstream program
// receives the rest of the arguments without it. The persona is the only way
// a consolidated binary answers a program it replaces: the persona is a token,
// never a file, so Rule 1.25 admits no other path to it.
//
// The persona cases live in their own table, qa/parity/personas.oot, and the
// runner reads it after the case table. The generator that rewrites the case
// table from the test recipe never touches that file, so the cases that hold
// a persona against its own upstream survive every regeneration of the fleet.
// A tool without that file has no persona case, and the runner reads nothing
// more.
//
// The runner lives in every tool repository and is the same file everywhere.
// The Academy header keeps all four elements in the first seven lines,
// because the fleet Makefile reads the header of every page with head -7.
// Every word is wrapped in single quotes, so a word that holds a shell
// metacharacter is inert.
//
// The word codec lives on the page words.oo next to this one. The generator
// writes the case table with the writer of that page and this runner reads it
// with the reader of that page, so the two can never drift apart.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "words.oo";

// The count of the three kinds of case. The table of a tool that answers more
// than one program holds one upstream per case, and the count of the personas
// says how many of the cases compared a persona against its own upstream.
type ParityCount = struct {
    matches: Int,
    devs: Int,
    skips: Int,
    fails: Int,
    missing: Int,
    personas: Int,
    used: Int
};

// Run one tool with the given arguments. The stdout and the stderr go to
// files and the standard input is closed, so a tool that reads the input never
// waits for it. The run is bounded by the timeout helper.
fn parity_run(sys: &ProcessCap, tool: String, words: List[String], from: Int, out_path: String, err_path: String, input_words: List[String]) -> Int { let mut secs: String = "10";
    let mut first: Int = from; if list_get(words, from) == "timeout" && from + 1 < list_len(words) {
        secs = list_get(words, from + 1); first = from + 2;
    }
    let mut script: String = "t=''; command -v timeout >/dev/null 2>&1 && t='timeout " + secs + "'; "; if list_len(input_words) > 0 {
        script = script + list_get(input_words, 0); let mut k: Int = 1;
        while k < list_len(input_words) { script = script + " " + parity_quote(list_get(input_words, k));
            k = k + 1; }
        script = script + " | "; }
    script = script + "$t "; script = script + parity_quote(tool);
    let mut i: Int = first; while i < list_len(words) {
        script = script + " " + parity_quote(list_get(words, i)); i = i + 1;
    }
    script = script + " > " + parity_quote(out_path) + " 2> " + parity_quote(err_path); if list_len(input_words) == 0 {
        script = script + " < /dev/null"; }
    let mut argv: List[String] = list_new(); argv = list_push(argv, "-c");
    argv = list_push(argv, script); let r: Result[Int, String] = sys_exec_wait(sys, "sh", argv);
    let mut code: Int = 127; if r.is_ok() { code = r.val; }
    return code; }

// Compare the two results of one case. The returned string is "ok" when the
// case passes, "skip" when the upstream does not know the arguments, and
// otherwise the reason the case fails.
fn parity_compare(fs_r: &FsReadCap, up_rc: Int, oo_rc: Int, kind: String) -> String { let r1: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/up.out");
    let mut up_out: String = ""; if r1.is_ok() { up_out = r1.val; }
    let r2: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/oo.out"); let mut oo_out: String = "";
    if r2.is_ok() { oo_out = r2.val; }
    let r3: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/up.err"); let mut up_err: String = "";
    if r3.is_ok() { up_err = r3.val; }
    let r4: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/oo.err"); let mut oo_err: String = "";
    if r4.is_ok() { oo_err = r4.val; }
    if str_contains(up_err, "unrecognized option") { return "skip"; }
    if str_contains(up_err, "unknown option") { return "skip"; }
    if str_contains(up_err, "invalid option") { return "skip"; }
    if str_contains(up_err, "unrecognized command") { return "skip"; }
    if str_contains(up_err, "invalid argument") { return "skip"; }
    if str_contains(up_err, "illegal option") { return "skip"; }
    // A run that was cut short by the bound did not finish. The upstream
    // cannot be the reference for a case it never completes, so it is skipped.
    if up_rc == 124 { return "skip"; }
    if oo_rc == 124 { return "the tool does not finish"; }
    if up_rc != oo_rc { return "exit code " + int_to_str(up_rc) + " against " + int_to_str(oo_rc); }
    if kind == "match" { if up_out != oo_out { return "stdout differs"; }
        if up_err != oo_err { return "stderr differs"; } }
    return "ok"; }

// Take the input words of the line that names the command that makes the
// input of a case. The empty list means the line names no input, or names a
// command that is not the one that makes an input.
fn parity_input_of(l: String) -> List[String] { let rest: String = parity_trim(str_slice(l, 6, chars_len(l)));
    let in_words: List[String] = parity_words(rest); if list_len(in_words) == 0 { return list_new(); }
    let cmd_name: String = list_get(in_words, 0); if cmd_name != "echo" && cmd_name != "printf" { return list_new(); }
    return in_words; }

// Run the setup commands of the case table. A setup command prepares the
// input of a case: it makes the file the tool reads. The commands are run
// again before the tool runs, so the upstream tool and the tool under test
// both see the same input even when one of them changes it.
//
// Every command is bounded and reads no input, so a preparation that waits
// for the stream does not hold the gate.
fn parity_run_setup(sys: &ProcessCap, setup: List[String]) -> String { let mut notes: String = "";
    let mut i: Int = 0; while i < list_len(setup) {
        let cmd: String = list_get(setup, i); let mut script: String = "if command -v timeout >/dev/null 2>&1; then timeout 10 sh -c ";
        script = script + parity_quote(cmd); script = script + "; else sh -c ";
        script = script + parity_quote(cmd); script = script + "; fi < /dev/null";
        let mut argv: List[String] = list_new(); argv = list_push(argv, "-c");
        argv = list_push(argv, script); let r: Result[Int, String] = sys_exec_wait(sys, "sh", argv);
        let mut code: Int = 0; if r.is_ok() { code = r.val; }
        if code != 0 { notes = notes + "setup failed: " + cmd + "\n"; }
        i = i + 1; }
    return notes; }

// The argument vector of the upstream, with the persona word taken out. The
// upstream program does not answer to a persona: it is the program itself,
// and it never sees the word that names the persona.
fn parity_strip(words: List[String], persona: String) -> List[String] { let mut out: List[String] = list_new();
    let mut i: Int = 0; while i < list_len(words) {
        let w: String = list_get(words, i);
        if persona != "" && i > 0 && w == persona { i = i + 1; continue; }
        out = list_push(out, w); i = i + 1; }
    return out; }

// Find the upstream tool on the runner. The standard places are searched,
// because the process that runs the gate holds a short path and the program
// of the upstream often stands in /usr/sbin, where the path of the gate does
// not reach. The workflow of every repository makes the same search and
// links the program it finds, so the gate and the workflow always compare
// against the same program.
fn parity_find_upstream(sys: &ProcessCap, upstream: String) -> String { let script: String = "for d in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin /usr/games; do "
        + "p=\"$d\"/" + parity_quote(upstream) + "; "
        + "if [ -x \"$p\" ]; then echo \"$p\"; exit 0; fi; done; "
        + "command -v " + parity_quote(upstream) + " 2>/dev/null"; let r: Result[String, String] = sys_exec(sys, "sh", "-c", script);
    if r.is_err() { return ""; }
    let lines: List[String] = parity_lines(r.val); if list_len(lines) == 0 { return ""; }
    let first: String = parity_trim(list_get(lines, 0)); return first;
}

// Run every case of the case table and count the results. A persona line
// names the persona of the case that follows it and the upstream program the
// persona answers to. The persona word is given to the tool under test and
// taken out of the arguments of the upstream program.
fn parity_cases(sys: &ProcessCap, fs_r: &FsReadCap, lines: List[String], upstream: String, tool: String) -> ParityCount { let mut c: ParityCount = ParityCount { matches: 0, devs: 0, skips: 0, fails: 0, missing: 0, personas: 0, used: 0 };
    let mut input_words: List[String] = list_new(); let mut setup: List[String] = list_new();
    let mut p_word: String = ""; let mut p_prog: String = "";
    let mut cached: String = ""; let mut cached_path: String = "";
    let mut i: Int = 0; while i < list_len(lines) {
        let l: String = parity_trim(list_get(lines, i)); i = i + 1;
        if l == "" || str_starts_with(l, "#") { continue; }
        if str_starts_with(l, "input ") { input_words = parity_input_of(l); continue; }
        if str_starts_with(l, "setup ") { let cmd: String = parity_trim(str_slice(l, 6, chars_len(l)));
            if cmd != "" { setup = list_push(setup, cmd); }
            continue; }
        if str_starts_with(l, "persona ") { let rest: String = parity_trim(str_slice(l, 8, chars_len(l)));
            let pw: List[String] = parity_words(rest); if list_len(pw) < 2 { continue; }
            p_word = list_get(pw, 0); p_prog = list_get(pw, 1); continue; }
        let words: List[String] = parity_words(l); if list_len(words) < 2 { continue; }
        let kind: String = list_get(words, 0); if kind != "match" && kind != "differ" { continue; }
        let up_name: String = if p_prog == "" { upstream } else { p_prog };
        if up_name == "" { c.missing = c.missing + 1;
            println("  FAIL " + kind + " [" + l + "] the case names no upstream program");
            p_word = ""; p_prog = ""; continue; }
        if up_name != cached { cached = up_name; cached_path = parity_find_upstream(sys, up_name); }
        if cached_path == "" { c.missing = c.missing + 1;
            println("  FAIL " + kind + " [" + l + "] the upstream " + up_name + " is not installed");
            p_word = ""; p_prog = ""; continue; }
        c.used = c.used + 1;
        let up_words: List[String] = parity_strip(words, p_word);
        let _s1: String = parity_run_setup(sys, setup); let up_rc: Int = parity_run(sys, cached_path, up_words, 1, ".ooda-cache/parity/up.out", ".ooda-cache/parity/up.err", input_words);
        let _s2: String = parity_run_setup(sys, setup); let oo_rc: Int = parity_run(sys, tool, words, 1, ".ooda-cache/parity/oo.out", ".ooda-cache/parity/oo.err", input_words);
        input_words = list_new(); let verdict: String = parity_compare(fs_r, up_rc, oo_rc, kind);
        if verdict == "ok" { if kind == "match" { c.matches = c.matches + 1; } else { c.devs = c.devs + 1; }
            if p_word != "" { c.personas = c.personas + 1; } }
        else if verdict == "skip" { c.skips = c.skips + 1;
        } else { c.fails = c.fails + 1;
            println("  FAIL " + kind + " [" + l + "] " + verdict); }
        p_word = ""; p_prog = ""; }
    return c; }

// Read the case table, run every case, and report the parity result.
pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap) -> Int { let cases_path: String = "qa/parity/cases.oot";
    let r: Result[String, String] = fs_read_file(fs_r, cases_path); if r.is_err() { println("ERR\tparity\tcannot read " + cases_path); return 1; }
    let _d: Result[Void, String] = fs_mkdir_p(fs_w, ".ooda-cache/parity"); let lines: List[String] = parity_lines(r.val);
    let mut upstream: String = ""; let mut tool_rel: String = "";
    let mut i: Int = 0; while i < list_len(lines) {
        let l: String = parity_trim(list_get(lines, i)); if str_starts_with(l, "# upstream:") { upstream = parity_trim(str_slice(l, 11, chars_len(l))); }
        if str_starts_with(l, "# tool:") { tool_rel = parity_trim(str_slice(l, 7, chars_len(l))); }
        i = i + 1; }
    if upstream != "" { let up_path: String = parity_find_upstream(sys, upstream); if up_path == "" {
        println("ERR\tparity\tupstream tool " + upstream + " is not installed. The parity gate cannot pass without it."); return 1; } }
    if tool_rel == "" { println("ERR\tparity\tno tool in " + cases_path); return 1; }
    let tool: String = if str_starts_with(tool_rel, "/") { tool_rel } else { "./" + tool_rel };
    let mut all: List[String] = lines;
    let pr: Result[String, String] = fs_read_file(fs_r, "qa/parity/personas.oot");
    if pr.is_ok() { let pl: List[String] = parity_lines(pr.val); let mut k: Int = 0;
        while k < list_len(pl) { all = list_push(all, list_get(pl, k)); k = k + 1; } }
    let c: ParityCount = parity_cases(sys, fs_r, all, upstream, tool);
    if c.missing > 0 { println("ERR\tparity\t" + int_to_str(c.missing) + " case(s) name an upstream that is not installed."); return 1; }
    if upstream == "" && c.used == 0 { println("SKIP\tparity\tno upstream in " + cases_path + ", the tool names no program to replace, so it has no parity gate"); return 0; }
    let against: String = if upstream == "" { "its persona upstreams" } else { upstream };
    println("PARITY " + tool + " against " + against + " match=" + int_to_str(c.matches)
        + " differ=" + int_to_str(c.devs) + " skip=" + int_to_str(c.skips)
        + " fail=" + int_to_str(c.fails) + " persona=" + int_to_str(c.personas));
    if c.matches == 0 { println("ERR\tparity\tno match case against " + against + "."); return 1; }
    if c.fails > 0 { return 1; }
    return 0; }
