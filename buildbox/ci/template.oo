// # CI Template - The Fail Closed Contract Every Fleet Repository Runs
//
// Logline: Builds the workflow file that every fleet repository runs, so the contract is generated and never hand written.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Build the workflow head.
//   2. Build the checkout steps.
//   3. Build the build steps.
//   4. Build the verify steps.
//   5. Build the parity steps.
//   6. Join the parts into one workflow.
//
// The contract fails closed. A repository without a build target fails. A
// repository whose build produces no binary fails. A repository whose tool
// differs from the tool it replaces fails. A repository whose tool is not
// deterministic across two runs fails.
//
// The build takes the path that fits the tool. A small tool is built as one
// unit, because the per module path drops the code of a page named anchor.oo
// and the declaration of a runtime symbol. The three largest tools of the
// fleet do not fit in the memory of a runner as one unit, so they are built
// the per module way. The contract names the path, so the two paths cannot
// drift apart.

import "std/core/text/num_buffer.oo";
import "text/lines.oo";
import "ci/steps.oo";
import "ci/packages.oo";

// The head of the workflow file.
pub fn ci_head(repo: String) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "name: ci");
    l = list_push(l, "");
    l = list_push(l, "on:");
    l = list_push(l, "  push:");
    l = list_push(l, "    branches: [main]");
    l = list_push(l, "  pull_request:");
    l = list_push(l, "  workflow_dispatch:");
    l = list_push(l, "");
    l = list_push(l, "jobs:");
    l = list_push(l, "  gate:");
    l = list_push(l, "    name: Fleet gate");
    l = list_push(l, "    runs-on: ubuntu-latest");
    l = list_push(l, "    steps:");
    return l;
}

// The checkout steps. The tool, the compiler, the runtime, and the standard
// library are checked out side by side, so the compiler resolves the standard
// library the same way it does in the buildbox. A tool that reads a sibling
// tool gets that sibling checked out beside it.
pub fn ci_checkout(repo: String) -> List[String] {
    let mut l: List[String] = list_new();
    let mut paths: List[String] = list_new();
    paths = list_push(paths, repo);
    paths = list_push(paths, "oodac");
    paths = list_push(paths, "oodar");
    paths = list_push(paths, "std");
    let extras: List[String] = ci_sibling_tools(repo);
    let mut i: Int = 0;
    while i < list_len(extras) { paths = list_push(paths, list_get(extras, i)); i = i + 1; }
    i = 0;
    while i < list_len(paths) {
        let path: String = list_get(paths, i);
        l = list_push(l, "      - uses: actions/checkout@v4");
        l = list_push(l, "        with:");
        if path != repo {
            let org: String = if path == "oodac" || path == "oodar" || path == "std" { "openOODA/" } else { "openOODA-tools/" };
            l = list_push(l, "          repository: " + org + path);
        }
        l = list_push(l, "          path: " + path);
        l = list_push(l, "");
        i = i + 1;
    }
    l = list_push(l, "      - name: Require clang");
    l = list_push(l, "        run: |");
    l = list_push(l, "          if ! command -v clang >/dev/null; then");
    l = list_push(l, "            sudo apt-get update && sudo apt-get install -y clang");
    l = list_push(l, "          fi");
    l = list_push(l, "          command -v clang >/dev/null || { echo \"clang is required to build the tool\"; exit 1; }");
    l = list_push(l, "");
    l = list_push(l, "      - name: Build the oodar runtime");
    l = list_push(l, "        working-directory: ${{ github.workspace }}");
    l = list_push(l, "        run: make -C oodar/scripts -f Makefile modular");
    l = list_push(l, "");
    return l;
}

// The build steps. A repository without a build target fails here. A build
// that produces no binary fails on the next step.
pub fn ci_build(repo: String, big: Bool) -> List[String] {
    let mut l: List[String] = list_new();
    l = list_push(l, "      - name: Require a build target");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        run: |");
    l = list_push(l, "          if ! grep -qE '^build[[:space:]]*:' Makefile; then");
    l = list_push(l, "            echo \"::error::This repository has no build target. The tool is a stub and is tracked in the fleet backlog.\"");
    l = list_push(l, "            exit 1");
    l = list_push(l, "          fi");
    l = list_push(l, "");
    l = list_push(l, "      - name: Build the tool");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        env:");
    l = list_push(l, "          OODA_COMPILER: ${{ github.workspace }}/oodac/bin/oodac");
    l = list_push(l, "          OODA_FS_READDIR: ${{ github.workspace }}");
    l = list_push(l, "          OODA_FS_WRITEDIR: ${{ github.workspace }}");
    l = list_push(l, "          OODA_NO_JAIL: \"1\"");
    if big { l = list_push(l, "          OODA_BUILD_MULTI: \"1\""); }
    l = list_push(l, "        run: make build");
    l = list_push(l, "");
    l = list_push(l, "      - name: Require the tool binary");
    l = list_push(l, "        if: always()");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        run: |");
    l = list_push(l, "          if [ ! -x \"dist/" + repo + "\" ]; then");
    l = list_push(l, "            echo \"::error::dist/" + repo + " was not produced. The tool is not implemented and is tracked in the fleet backlog.\"");
    l = list_push(l, "            exit 1");
    l = list_push(l, "          fi");
    l = list_push(l, "");
    return l;
}

// The verify steps. The tool verifies itself, runs its own tests, and proves
// that it is deterministic across two runs.
pub fn ci_verify(repo: String, big: Bool) -> List[String] {
    let mut l: List[String] = list_new();
    let mut part: List[String] = ci_step_make(repo, "Verify", "make verify", big);
    let mut i: Int = 0;
    while i < list_len(part) { l = list_push(l, list_get(part, i)); i = i + 1; }
    part = ci_step_make(repo, "Test", "make test", big);
    i = 0;
    while i < list_len(part) { l = list_push(l, list_get(part, i)); i = i + 1; }
    l = list_push(l, "      - name: Pure test audit");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        run: |");
    l = list_push(l, "          if make -n pure >/dev/null 2>&1; then");
    l = list_push(l, "            make pure");
    l = list_push(l, "          else");
    l = list_push(l, "            echo \"This repository has no pure target.\"");
    l = list_push(l, "          fi");
    l = list_push(l, "");
    l = list_push(l, "      - name: Double-run determinism");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        run: |");
    l = list_push(l, "          mkdir -p .ooda-cache");
    l = list_push(l, "          ./dist/" + repo + " --version > .ooda-cache/run1.txt 2>&1 || true");
    l = list_push(l, "          ./dist/" + repo + " --version > .ooda-cache/run2.txt 2>&1 || true");
    l = list_push(l, "          cmp -s .ooda-cache/run1.txt .ooda-cache/run2.txt || { echo \"::error::the tool is not deterministic across two runs\"; exit 1; }");
    l = list_push(l, "");
    return l;
}



// The steps that install the upstream tool. The package is installed, then the
// program is looked for in the standard places, because a package may install
// the program under another name or outside the path. The gate fails closed
// when the program is nowhere to be found.
//
// A program the package index of the runner does not carry is installed by the
// command the package table names for it. That command is the way the program
// is published, so the gate compares against the same program every run.
pub fn ci_install_upstream(upstream: String, package: String, binary: String) -> List[String] {
    let mut l: List[String] = list_new();
    let install: String = ci_package_install(upstream);
    l = list_push(l, "      - name: Install the upstream tool");
    l = list_push(l, "        working-directory: ${{ github.workspace }}");
    l = list_push(l, "        run: |");
    l = list_push(l, "          if ! command -v " + upstream + " >/dev/null 2>&1; then");
    if install != "" {
        l = list_push(l, "            " + install);
    } else {
        l = list_push(l, "            sudo apt-get update -qq");
        l = list_push(l, "            sudo apt-get install -y -qq " + package);
    }
    l = list_push(l, "          fi");
    l = list_push(l, "          if ! command -v " + upstream + " >/dev/null 2>&1; then");
    l = list_push(l, "            for cand in " + upstream + " " + binary + "; do");
    l = list_push(l, "              for d in /usr/local/bin /usr/games /usr/bin /bin /usr/sbin /sbin; do");
    l = list_push(l, "                if [ -x \"$d/$cand\" ]; then");
    l = list_push(l, "                  sudo ln -sf \"$d/$cand\" /usr/local/bin/" + upstream);
    l = list_push(l, "                  break 2;");
    l = list_push(l, "                fi");
    l = list_push(l, "              done");
    l = list_push(l, "            done");
    l = list_push(l, "          fi");
    if install != "" {
        l = list_push(l, "          command -v " + upstream + " >/dev/null 2>&1 || { echo \"::error::the upstream tool " + upstream + " is required for the parity gate and the install command did not put it on this runner\"; exit 1; }");
    } else {
        l = list_push(l, "          command -v " + upstream + " >/dev/null 2>&1 || { echo \"::error::the upstream tool " + upstream + " is required for the parity gate and the package " + package + " does not put it on this runner\"; exit 1; }");
    }
    l = list_push(l, "");
    return l;
}

// The parity step. The tool is compared against the upstream tool. A tool
// with no upstream program gets no parity step.
//
// The target is the name of the target that runs the drop-in harness in this
// repository. It is parity for a tool whose parity target is the harness and
// parity-dropin for a tool that kept a parity target of its own.
//
// The upstream is installed before this step, and before the test step,
// because the test target depends on the parity target: a workflow that
// installed the upstream after the test would ask the parity about a program
// the runner does not have yet.
pub fn ci_parity(repo: String, upstream: String, target: String, big: Bool) -> List[String] {
    let mut l: List[String] = list_new();
    if upstream == "" { return l; }
    l = list_push(l, "      - name: Parity against the upstream tool");
    l = list_push(l, "        working-directory: ${{ github.workspace }}/" + repo);
    l = list_push(l, "        env:");
    l = list_push(l, "          OODA_COMPILER: ${{ github.workspace }}/oodac/bin/oodac");
    l = list_push(l, "          OODA_FS_READDIR: ${{ github.workspace }}");
    l = list_push(l, "          OODA_FS_WRITEDIR: ${{ github.workspace }}");
    l = list_push(l, "          OODA_NO_JAIL: \"1\"");
    if big { l = list_push(l, "          OODA_BUILD_MULTI: \"1\""); }
    l = list_push(l, "        run: make " + target);
    l = list_push(l, "");
    return l;
}

// Join the parts into one workflow file. A repository without a build target
// is a stub: it fails closed on the build step and carries no parity step,
// because the parity gate is the contract of a tool that exists.
//
// The upstream is installed right after the build, before the verify and the
// test steps, because the test target depends on the parity target and the
// parity target needs the upstream.
pub fn ci_workflow(repo: String, upstream: String, package: String, target: String, binary: String, has_build: Bool, big: Bool) -> String {
    let mut all: List[String] = ci_head(repo);
    let mut part: List[String] = ci_checkout(repo);
    let mut i: Int = 0;
    while i < list_len(part) { all = list_push(all, list_get(part, i)); i = i + 1; }
    part = ci_build(repo, big);
    i = 0;
    while i < list_len(part) { all = list_push(all, list_get(part, i)); i = i + 1; }
    if has_build && upstream != "" {
        part = ci_install_upstream(upstream, package, binary);
        i = 0;
        while i < list_len(part) { all = list_push(all, list_get(part, i)); i = i + 1; }
    }
    part = ci_verify(repo, big);
    i = 0;
    while i < list_len(part) { all = list_push(all, list_get(part, i)); i = i + 1; }
    if has_build {
        part = ci_parity(repo, upstream, target, big);
        i = 0;
        while i < list_len(part) { all = list_push(all, list_get(part, i)); i = i + 1; }
    }
    return text_join_lines(all) + "\n";
}
