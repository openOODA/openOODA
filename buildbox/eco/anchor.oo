// # Eco Anchor - 5-Organization Ecosystem Orchestration & Release Suite
//
// Logline: Re-exports the shared helpers for the pure .oo ecosystem status, release, ruleset, and doc-sync tools.
//
// Setup: Pure module anchor under buildbox/eco.
//
// Beats:
//   1. Export the shared string, manifest, and capability helpers.
//   2. Keep entrypoints (status.oo, release.oo, rulesets.oo, sync_docs.oo) cleanly decoupled.

import "std/core/primitives/str.oo";
import "eco/manifest_exec.oo";

// Verify that the ecosystem layer mapping table is initialized.
pub fn eco_anchor_ready() -> Bool {
    return eco_org_layer("openOODA-kernel") == "kernel";
}

// The canonical category codes of the ecosystem. The codes come in an upper
// case form and a lower case form, and a code that is not one of them is not
// a category of the fleet.
pub fn eco_valid_category(cat: String) -> Bool {
    let valid: String = "|SH|FS|TX|DA|AR|SE|PR|HW|NT|SC|UI|AI|DF|DT|";
    return str_contains(valid, "|" + cat + "|");
}
