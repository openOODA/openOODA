// # Eco Helpers - Shared Process, String, And File Helpers For Ecosystem Tools
//
// Logline: Provides pure string parsing, padding, and capability-bounded process/file helpers for the 5-organization ecosystem tools.
//
// Setup: Uses ProcessCap, FsReadCap, FsWriteCap, and EnvCap.
//
// Beats:
//   1. Pad strings and parse integers for formatted status tables.
//   2. Read and write key-value fields in ooda.pkg manifests.
//   3. Run child commands with sys_exec and sys_exec_wait.
//   4. Map organization names to canonical layer codes.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";

pub fn eco_pad_right(s: String, width: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < width {
        out = out + " ";
    }
    return out;
}

pub fn eco_pad_left(s: String, width: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < width {
        out = " " + out;
    }
    return out;
}

pub fn eco_org_layer(org: String) -> String {
    if org == "openOODA-kernel" { return "kernel"; }
    if org == "openOODA-OS" { return "os"; }
    if org == "openOODA-DE" { return "de"; }
    if org == "openOODA-tools" { return "tools"; }
    if org == "openOODA" || org == "openOODA-core" { return "core"; }
    if org == "openOODA-apps" { return "apps"; }
    if org == "openOODA-cloud" { return "cloud"; }
    if org == "openOODA-agents" { return "agents"; }
    return "";
}

pub fn eco_pkg_get(fs_r: &FsReadCap, pkg_path: String, key: String) -> String {
    if !path_exists(fs_r, pkg_path) { return ""; }
    let r: Result[String, String] = fs_read_file(fs_r, pkg_path);
    if r.is_err() { return ""; }
    let prefix: String = key + "=";
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = text_trim(list_get(lines, i));
        if str_starts_with(ln, prefix) {
            return text_trim(str_slice(ln, chars_len(prefix), chars_len(ln)));
        }
        i = i + 1;
    }
    return "";
}

pub fn eco_read_trimmed(fs_r: &FsReadCap, path: String) -> String {
    if !path_exists(fs_r, path) { return ""; }
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return ""; }
    return text_trim(r.val);
}

pub fn eco_tail_lines(s: String, max_lines: Int) -> String {
    let lines: List[String] = text_split_lines(s);
    let n: Int = list_len(lines);
    let start: Int = if n > max_lines { n - max_lines } else { 0 };
    let mut out: String = "";
    let mut i: Int = start;
    while i < n {
        out = out + list_get(lines, i) + "\n";
        i = i + 1;
    }
    return out;
}

pub fn eco_count_oo_pages(fs_r: &FsReadCap, repo_dir: String) -> Int {
    let mut total: Int = 0;
    let subdirs: List[String] = list_push(list_push(list_push(list_new(), ""), "/core"), "/tests");
    let mut i: Int = 0;
    while i < list_len(subdirs) {
        let d: String = repo_dir + list_get(subdirs, i);
        i = i + 1;
        if !path_exists(fs_r, d) { continue; }
        let entries: List[String] = fs_read_dir(fs_r, d);
        let mut j: Int = 0;
        while j < list_len(entries) {
            let f: String = list_get(entries, j);
            j = j + 1;
            if str_ends_with(f, ".oo") { total = total + 1; }
        }
    }
    if total >= 6 { return total; }
    let walked: List[String] = fs_walk(fs_r, repo_dir);
    let mut k: Int = 0;
    let mut wcount: Int = 0;
    while k < list_len(walked) {
        let p: String = list_get(walked, k);
        k = k + 1;
        if str_ends_with(p, ".oo") && !str_contains(p, "/.ooda-cache/") && !str_contains(p, "/dist/") && !str_contains(p, "/bin/") {
            wcount = wcount + 1;
        }
    }
    return wcount;
}

pub fn eco_repo_is_usable(fs_r: &FsReadCap, org: String, repo_dir: String) -> Bool {
    if org == "openOODA" || org == "openOODA-core" { return true; }
    let eng: String = eco_read_trimmed(fs_r, repo_dir + "/core/engine.oo");
    let subdirs: List[String] = list_push(list_push(list_push(list_push(list_push(list_new(), ""), "/core"), "/fs"), "/cli"), "/sec");
    let mut combined: String = eco_read_trimmed(fs_r, repo_dir + "/net/serve.oo");
    let mut i: Int = 0;
    while i < list_len(subdirs) {
        let d: String = repo_dir + list_get(subdirs, i);
        i = i + 1;
        if !path_exists(fs_r, d) { continue; }
        let entries: List[String] = fs_read_dir(fs_r, d);
        let mut j: Int = 0;
        while j < list_len(entries) {
            let f: String = list_get(entries, j);
            j = j + 1;
            if str_ends_with(f, ".oo") { combined = combined + "\n" + eco_read_trimmed(fs_r, d + "/" + f); }
        }
    }
    let has_io: Bool = str_contains(combined, "read_file(") || str_contains(combined, "fs_read_file(")
        || str_contains(combined, "fs_write_file(") || str_contains(combined, "fs_read_dir(")
        || str_contains(combined, "fs_is_dir(") || str_contains(combined, "fs_path_exists(")
        || str_contains(combined, "tcp_conn_") || str_contains(combined, "tcp_connect(")
        || str_contains(combined, "oo_path_exists(") || str_contains(combined, "sys_exec(");
    if has_io { return true; }
    if str_contains(eng, "active_items: Int") && str_contains(eng, "1048576") { return false; }
    if str_contains(combined, "[status|verify|inspect]") || str_contains(combined, "status, verify, and inspect") || str_contains(combined, "status|verify|inspect") { return false; }
    return true;
}
