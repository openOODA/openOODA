// # Hawaii Standard Time Stamp
//
// Logline: Pure .oo civil-date conversion that stamps an epoch second count in the Hawaii zone without any host binary.
//
// Setup: Zero ambient authority, zero shell-outs. The civil-date conversion follows the standard days-from-civil inversion, and Hawaii is a fixed UTC-10 offset with no daylight saving.
//
// Beats:
//   1. ql_pad2 renders a two-digit field.
//   2. ql_civil_from_days turns a day count into a civil year, month, and day.
//   3. ql_hst_stamp renders an epoch second count as a Hawaii wall-clock stamp.

fn ql_pad2(n: Int) -> String {
    if n < 0 { return "-" + (0 - n).to_string(); }
    if n < 10 { return "0" + n.to_string(); }
    return n.to_string();
}

// The civil date of a day count since the epoch, as year, month, and day.
fn ql_civil_from_days(z0: Int) -> List[Int] {
    let z: Int = z0 + 719468;
    let era: Int = (if z >= 0 { z } else { z - 146096 }) / 146097;
    let doe: Int = z - era * 146097;
    let yoe: Int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y: Int = yoe + era * 400;
    let doy: Int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp: Int = (5 * doy + 2) / 153;
    let d: Int = doy - (153 * mp + 2) / 5 + 1;
    let m: Int = if mp < 10 { mp + 3 } else { mp - 9 };
    let yy: Int = if m <= 2 { y + 1 } else { y };
    let mut out: List[Int] = list_new();
    out = list_push(out, yy);
    out = list_push(out, m);
    out = list_push(out, d);
    return out;
}

// The Hawaii wall-clock stamp of an epoch second count: UTC-10, no daylight saving.
pub fn ql_hst_stamp(epoch_s: Int) -> String {
    if epoch_s <= 0 { return "1970-01-01 00:00:00 HST"; }
    let day: Int = epoch_s / 86400;
    let rem: Int = epoch_s - day * 86400;
    let c: List[Int] = ql_civil_from_days(day - 10);
    let hh: Int = rem / 3600;
    let mm: Int = (rem - hh * 3600) / 60;
    let ss: Int = rem - hh * 3600 - mm * 60;
    let ys: String = list_get(c, 0).to_string();
    let ms: String = ql_pad2(list_get(c, 1));
    let ds: String = ql_pad2(list_get(c, 2));
    return ys + "-" + ms + "-" + ds + " " + ql_pad2(hh) + ":" + ql_pad2(mm) + ":" + ql_pad2(ss) + " HST";
}
