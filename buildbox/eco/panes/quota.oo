// # Eco Pane Quota - Reads The Quota Of A Pane From Its Visible Text
//
// Logline: Turns the quota text of one pane into the share that is left and the share that is used.
//
// Setup: Pure string parsing over the text of a pane.
//
// Beats:
//   1. Read an unsigned number out of a text.
//   2. Read the quota of the pane that reports the token share.
//   3. Read the quota of the pane that reports the session limit and the context.
//   4. Read the quota of the pane that reports the streamed tokens.
//
// The panes of the terminal write their quota as a line of text. Every pane
// writes it in its own way, so the reading of the quota is the reading of the
// pane that carries it.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "eco/helpers.oo";

// Read the unsigned number at the head of a text. A text that holds no digit
// has no number, and the answer is then -1.
pub fn eco_parse_uint(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut seen: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let idx: Int = str_index_of("0123456789", c);
        if idx >= 0 {
            acc = (acc * 10) + idx;
            seen = true;
        } else if seen {
            break;
        }
        i = i + 1;
    }
    if !seen { return -1; }
    return acc;
}

// The quota of the pane that reports the token share. The pane writes the
// share that is used, and the share that is left is the rest of the hundred.
pub fn eco_pane_quota_tokens(pane_id: String, vis: String) -> String {
    let idx: Int = str_index_of(vis, "tokens (");
    if idx >= 0 {
        let used: Int = eco_parse_uint(str_slice(vis, idx + 8, chars_len(vis)));
        if used >= 0 && used <= 100 {
            let rem: Int = 100 - used;
            return int_to_str(rem) + "|" + int_to_str(used) + "% used (" + int_to_str(rem) + "% rem)";
        }
    }
    if pane_id == "wK:p1" { return "100|shell ready"; }
    return "100|n/a";
}

// The quota of the pane that reports the session limit and the context. The
// share of the context takes over when the session share is empty and the pane
// is still busy.
pub fn eco_pane_quota_session(vis: String) -> String {
    let mut ctx_str: String = "";
    let mut ctx_pct: Int = -1;
    let cidx: Int = str_index_of(vis, "Context ");
    if cidx >= 0 {
        ctx_pct = eco_parse_uint(str_slice(vis, cidx + 8, chars_len(vis)));
        if ctx_pct >= 0 && ctx_pct <= 100 {
            ctx_str = " / Ctx " + int_to_str(ctx_pct) + "% left";
        }
    }
    let idx: Int = str_index_of(vis, "5h ");
    if idx >= 0 {
        let pct: Int = eco_parse_uint(str_slice(vis, idx + 3, chars_len(vis)));
        if pct >= 0 && pct <= 100 {
            let active: Bool = str_contains(vis, "Running ") || str_contains(vis, "Loading ") || str_contains(vis, "tok/s");
            let rem_eff: Int = if pct == 0 && active && ctx_pct > 0 { ctx_pct } else { pct };
            return int_to_str(rem_eff) + "|5h " + int_to_str(pct) + "% rem" + ctx_str;
        }
    }
    return "100|n/a";
}

// The quota of the pane that reports the streamed tokens. The pane writes the
// count in thousands, and the share that is left is the rest of the hundred.
pub fn eco_pane_quota_wh(vis: String) -> String {
    let idx: Int = str_index_of(vis, "[stop]");
    if idx >= 0 {
        let start: Int = if idx > 16 { idx - 16 } else { 0 };
        let win: String = str_slice(vis, start, idx);
        let k_idx: Int = str_index_of(win, "s ");
        if k_idx >= 0 {
            let k: Int = eco_parse_uint(str_slice(win, k_idx + 2, chars_len(win)));
            if k >= 0 {
                let used: Int = k / 10;
                let rem: Int = if used >= 100 { 0 } else { 100 - used };
                return int_to_str(rem) + "|streamed ~" + int_to_str(k) + "k (~" + int_to_str(rem) + "% rem)";
            }
        }
    }
    return "100|n/a";
}

// The quota of one pane, the way the pane writes it. The pane that carries no
// quota of its own has the whole share left.
pub fn eco_parse_pane_quota(pane_id: String, vis: String) -> String {
    let tail: String = eco_tail_lines(vis, 8);
    if pane_id == "wF:p1" || pane_id == "wG:p1" || pane_id == "wK:p1" {
        return eco_pane_quota_tokens(pane_id, vis);
    }
    if pane_id == "wJ:p1" {
        return eco_pane_quota_session(tail);
    }
    if pane_id == "wH:p1" {
        return eco_pane_quota_wh(vis);
    }
    return "100|n/a";
}
