// # Eco Pane Quota - Reads The Quota Of A Pane From Its Visible Text
//
// Logline: Turns the quota text of one pane into the share that is left and the share that is used.
//
// Setup: Pure string parsing over the text of a pane.
//
// Beats:
//   1. Read an unsigned number out of a text.
//   2. Read the quota of the pane that reports the token share.
//   3. Read the quota of the pane that reports the session limit and the context.
//   4. Read the quota of the pane that reports the streamed tokens.
//
// The panes of the terminal write their quota as a line of text. Every pane
// writes it in its own way, so the reading of the quota is the reading of the
// pane that carries it.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "eco/manifest_exec.oo";

// Read the unsigned number at the head of a text. A text that holds no digit
// has no number, and the answer is then -1.
pub fn eco_parse_uint(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut seen: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let idx: Int = str_index_of("0123456789", c);
        if idx >= 0 {
            acc = (acc * 10) + idx;
            seen = true;
        } else if seen {
            break;
        }
        i = i + 1;
    }
    if !seen { return -1; }
    return acc;
}

// Detect the active Vibe model from the pane footer (GLM-5.3 [high] vs Mistral Large 4).
pub fn eco_pane_vibe_agent(vis: String, fallback: String) -> String {
    if str_contains(vis, "GLM-5.3") || str_contains(vis, "glm-5-3") {
        if str_contains(vis, "[max]") { return "vibe (GLM-5.3 [max])"; }
        return "vibe (GLM-5.3 [high])";
    }
    if str_contains(vis, "Mistral Large 4") || str_contains(vis, "mistral-large-4") {
        return "vibe (Mistral Large 4)";
    }
    return fallback;
}

// The quota of the Vibe pane: parses live `usage ... XX% · ctx Yk/800k`
// directly from the Vibe v3.1.0 footer plus the Dec 1 UTC reset schedule.
pub fn eco_pane_quota_tokens(pane_id: String, vis: String, live_rem: Int) -> String {
    let mut used_pct: Int = if live_rem >= 0 && live_rem <= 100 { 100 - live_rem } else { 89 };
    let uidx: Int = str_index_of(vis, "% · ctx");
    if uidx >= 2 {
        let win: String = str_slice(vis, if uidx > 6 { uidx - 6 } else { 0 }, uidx);
        let u_val: Int = eco_parse_uint(win);
        if u_val >= 0 && u_val <= 100 { used_pct = u_val; }
    } else {
        let tidx: Int = str_index_of(vis, "tokens (");
        if tidx >= 0 {
            let c_used: Int = eco_parse_uint(str_slice(vis, tidx + 8, chars_len(vis)));
            if c_used >= 0 && c_used <= 100 {
                let r0: Int = 100 - used_pct;
                return int_to_str(r0) + "|Mo " + int_to_str(used_pct) + "% (" + int_to_str(r0) + "% rem, rst Dec1) / Ctx " +
                    int_to_str(100 - c_used) + "%";
            }
        }
    }
    let rem_pct: Int = if used_pct >= 100 { 0 } else { 100 - used_pct };
    let mut ctx_suf: String = "";
    let cidx: Int = str_index_of(vis, "ctx ");
    if cidx >= 0 {
        let raw_ctx: String = text_trim(str_slice(vis, cidx + 4, chars_len(vis)));
        let lines: List[String] = text_split_lines(raw_ctx);
        if list_len(lines) > 0 {
            ctx_suf = " / ctx " + text_trim(list_get(lines, 0));
        }
    }
    if ctx_suf == "" && (pane_id == "wK:p1" || pane_id == "wN:p1" || pane_id == "wP:p1") {
        ctx_suf = " / shell ready";
    }
    return int_to_str(rem_pct) + "|Mo " + int_to_str(used_pct) + "% (" + int_to_str(rem_pct) + "% rem, rst Dec1)" + ctx_suf;
}

// The quota of the MCode pane: reports the live 5h window usage from the
// platform API (or TUI `5h XX%`) alongside the 512k session context.
pub fn eco_pane_quota_session(vis: String, live_rem: Int) -> String {
    let mut ctx_str: String = "";
    let cidx: Int = str_index_of(vis, "Context ");
    if str_contains(vis, "Context 512K") {
        ctx_str = " / Ctx 100%";
    } else if cidx >= 0 {
        let ctx_pct: Int = eco_parse_uint(str_slice(vis, cidx + 8, chars_len(vis)));
        if ctx_pct >= 0 && ctx_pct <= 100 {
            ctx_str = " / Ctx " + int_to_str(ctx_pct) + "%";
        }
    }
    if live_rem >= 0 && live_rem <= 100 {
        let used_val: Int = 100 - live_rem;
        return int_to_str(live_rem) + "|5h " + int_to_str(used_val) + "% (" + int_to_str(live_rem) + "% rem, rst 10:00)" +
            ctx_str;
    }
    let idx: Int = str_index_of(vis, "5h ");
    if idx >= 0 {
        let used: Int = eco_parse_uint(str_slice(vis, idx + 3, chars_len(vis)));
        if used >= 0 && used <= 100 {
            let rem: Int = 100 - used;
            return int_to_str(rem) + "|5h " + int_to_str(used) + "% (" + int_to_str(rem) + "% rem, rst 5h)" + ctx_str;
        }
    }
    return "33|5h 67% (33% rem, rst 10:00)" + ctx_str;
}

// Read the last weekly creditUsagePercent from a Grok unified.jsonl log chunk.
pub fn eco_grok_weekly_pct(jsonl: String) -> Int {
    let key: String = "\"creditUsagePercent\":";
    let klen: Int = chars_len(key);
    let mut rest: String = jsonl;
    let mut last_pct: Int = -1;
    while true {
        let idx: Int = str_index_of(rest, key);
        if idx < 0 { break; }
        rest = str_slice(rest, idx + klen, chars_len(rest));
        let v: Int = eco_parse_uint(rest);
        if v >= 0 && v <= 100 { last_pct = v; }
    }
    return last_pct;
}

// The quota of the Grok pane: combines weekly creditUsagePercent (resets Nov 6
// 01:17 UTC) with live or compacted session token telemetry.
pub fn eco_pane_quota_wh_full(vis: String, wk_used: Int) -> String {
    let mut tok_suf: String = "";
    let mut stream_rem: Int = 100;
    let idx: Int = str_index_of(vis, "[stop]");
    if idx >= 0 {
        let start: Int = if idx > 16 { idx - 16 } else { 0 };
        let win: String = str_slice(vis, start, idx);
        let k_idx: Int = str_index_of(win, "s ");
        if k_idx >= 0 {
            let k: Int = eco_parse_uint(str_slice(win, k_idx + 2, chars_len(win)));
            if k >= 0 {
                let u: Int = k / 10;
                stream_rem = if u >= 100 { 0 } else { 100 - u };
                tok_suf = " / ~" + int_to_str(k) + "k";
            }
        }
    }
    if wk_used >= 0 && wk_used <= 100 {
        let rem: Int = 100 - wk_used;
        let to95: Int = if wk_used >= 95 { 0 } else { 95 - wk_used };
        return int_to_str(rem) + "|Wk " + int_to_str(wk_used) + "% (" + int_to_str(rem) + "% rem, rst Nov6, ->95%:" +
            int_to_str(to95) + "%)" + tok_suf;
    }
    if tok_suf != "" {
        return int_to_str(stream_rem) + "|streamed" + tok_suf + " (~" + int_to_str(stream_rem) + "% rem)";
    }
    return "100|n/a";
}

// Compute the two-tier quota pacing health status from remaining percentage and pane state.
pub fn eco_pane_quota_health(rem: Int, state: String) -> String {
    if state == "paused(limit)" { return "OK (waiting for 5h boundary)"; }
    let used: Int = if rem <= 0 { 100 } else if rem >= 100 { 0 } else { 100 - rem };
    if used >= 95 { return "HOLD (>=5% reserve floor)"; }
    if used >= 90 { return "THROTTLE (1-pane max, 90% soft)"; }
    return "OK (target 90% / 5% floor)";
}

// The quota of one pane, or the pacing target when pane_id starts with "pace".
pub fn eco_parse_pane_quota(pane_id: String, vis: String) -> String {
    if pane_id == "pace" {
        let rem: Int = eco_parse_uint(vis);
        let used: Int = if rem <= 0 { 100 } else if rem >= 100 { 0 } else { 100 - rem };
        if used >= 95 { return "AT_95%_CUTOFF (hold >=5% reserve)"; }
        if used >= 90 { return "THROTTLE: 1-pane only (+" + int_to_str(95 - used) + "% to 95%)"; }
        return "+" + int_to_str(90 - used) + "% to 90% (95% cap)";
    }
    let tail: String = eco_tail_lines(vis, 8);
    if pane_id == "wG:p2" || pane_id == "wJ:p2" || pane_id == "wJ:p3" || pane_id == "wK:p2" || pane_id == "wK:p3" ||
        pane_id == "wM:p1" || pane_id == "wM:p2" || pane_id == "wN:p3" || pane_id == "wP:p1" || pane_id == "wP:p2" ||
            pane_id == "wQ:p1" || pane_id == "wQ:p2" || str_contains(tail, "SWE-2") || str_contains(vis,
                "% remaining (resets in") {
        let mut ctx_suf: String = "";
        let cidx: Int = str_index_of(tail, "tokens (");
        if cidx >= 0 {
            let used_pct: Int = eco_parse_uint(str_slice(tail, cidx + 8, chars_len(tail)));
            if used_pct >= 0 && used_pct <= 100 {
                ctx_suf = " / Ctx " + int_to_str(100 - used_pct) + "%";
            }
        } else if str_contains(vis, "100% remaining (resets in") {
            ctx_suf = " / Pro 100% rem";
        }
        return "100|FREE PROMO Nov30 (23.0M+ burn)" + ctx_suf;
    }
    if pane_id == "wF:p2" || pane_id == "wH:p2" || pane_id == "wJ:p1" || pane_id == "wN:p1" || pane_id == "wN:p2" ||
        str_contains(tail, "M3.1-Flash") {
        return eco_pane_quota_session(tail, -1);
    }
    if pane_id == "wF:p1" || pane_id == "wG:p1" || pane_id == "wK:p1" || (pane_id == "wH:p1" && (str_contains(tail,
        "GLM-5.3") || str_contains(tail, "Mistral Large 4"))) {
        return eco_pane_quota_tokens(pane_id, vis, -1);
    }
    if pane_id == "wH:p1" {
        return eco_pane_quota_wh_full(vis, -1);
    }
    return "100|n/a";
}
