// # Eco Release - Multi-Org Release, Verification & Tagging Engine
//
// Logline: Stamps ooda.pkg taxonomy metadata and version, runs make build verify test det, tags v<ver>, and publishes GitHub Release assets in pure .oo.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap, and EnvCap.
//
// Beats:
//   1. Validate organization, repository checkout, and ooda.pkg taxonomy fields.
//   2. Rewrite version strings across VERSION, ooda.pkg, Makefile, README.md, and .oo files.
//   3. Run make build verify test det and stage bin/<repo> + bin/<repo>.sha256.
//   4. Commit, push to origin, tag v<version>, and publish GitHub Release via gh.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "eco/helpers.oo";

fn rel_update_pkg(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, repo: String, ver: String, layer: String) -> Bool {
    let pkg_path: String = repo_dir + "/ooda.pkg";
    if !path_exists(fs_r, pkg_path) { return false; }
    let mut cat: String = eco_pkg_get(fs_r, pkg_path, "category");
    if !eco_valid_category(cat) { cat = "SH"; }
    let mut caps: String = eco_pkg_get(fs_r, pkg_path, "caps");
    if caps == "" { caps = "FsRead"; }
    let tags: String = eco_pkg_get(fs_r, pkg_path, "tags");
    let up: String = eco_pkg_get(fs_r, pkg_path, "upstream");
    let desc: String = eco_pkg_get(fs_r, pkg_path, "description");
    let deps: String = eco_pkg_get(fs_r, pkg_path, "deps");
    let mut entry: String = eco_pkg_get(fs_r, pkg_path, "entry");
    if entry == "" { entry = "main.oo"; }
    let mut lic: String = eco_pkg_get(fs_r, pkg_path, "license");
    if lic == "" { lic = "Apache-2.0"; }
    let body: String = "name=" + repo + "\nversion=" + ver + "\nlayer=" + layer + "\ncategory=" + cat
        + "\ntags=" + tags + "\nupstream=" + up + "\nstatus=shipped\ndescription=" + desc
        + "\ncaps=" + caps + "\ndeps=" + deps + "\nentry=" + entry + "\npayload=" + entry + "\nlicense=" + lic + "\n";
    let w1: Result[Void, String] = fs_write_file(fs_w, pkg_path, body);
    let w2: Result[Void, String] = fs_write_file(fs_w, repo_dir + "/VERSION", ver + "\n");
    return w1.is_ok() && w2.is_ok();
}

fn rel_rewrite_versions(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, old_ver: String, new_ver: String) -> Int {
    let walked: List[String] = fs_walk(fs_r, repo_dir);
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(walked) {
        let p: String = list_get(walked, i);
        i = i + 1;
        if str_contains(p, "/.git/") || str_contains(p, "/.ooda-cache/") || str_contains(p, "/dist/") || str_contains(p, "/bin/") { continue; }
        if !str_ends_with(p, ".oo") && !str_ends_with(p, "Makefile") && !str_ends_with(p, "README.md") { continue; }
        let r: Result[String, String] = fs_read_file(fs_r, p);
        if r.is_err() { continue; }
        let mut s: String = r.val;
        if old_ver != "" && old_ver != new_ver { s = str_replace(s, old_ver, new_ver); }
        if new_ver != "0.1.0" { s = str_replace(s, "0.1.0", new_ver); }
        if s != r.val {
            let _w: Result[Void, String] = fs_write_file(fs_w, p, s);
            changed = changed + 1;
        }
    }
    return changed;
}

fn rel_ensure_ci_and_det(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String) -> Bool {
    let wf_dir: String = repo_dir + "/.github/workflows";
    let wf_path: String = wf_dir + "/ci.yml";
    let cur_ci: String = eco_read_trimmed(fs_r, wf_path);
    if !path_exists(fs_r, wf_path) || (!str_contains(cur_ci, "name: Fleet gate") && !str_contains(cur_ci, "openOODA/oodac")) {
        let _mk: Result[Void, String] = fs_mkdir_p(fs_w, wf_dir);
        let ci_body: String = "name: ci\non:\n  push:\n    branches: [main, master]\n  pull_request:\njobs:\n  verify:\n    name: Fleet gate\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Static governance gates and compiler verification\n        env:\n          OODA_COMPILER: /Projects/openOODA/oodac/bin/oodac\n          OODA_NO_JAIL: \"1\"\n          OODA_FS_READDIR: /Projects\n          OODA_FS_WRITEDIR: /Projects:/tmp\n        run: |\n          if [ -x \"${OODA_COMPILER}\" ]; then\n            make build verify test det\n          else\n            make line-cap file-law academy density vocab\n          fi\n";
        let _w: Result[Void, String] = fs_write_file(fs_w, wf_path, ci_body);
    }
    let gi_path: String = repo_dir + "/.gitignore";
    let gi_txt: String = eco_read_trimmed(fs_r, gi_path);
    if !str_contains(gi_txt, "bin/") {
        let _wgi: Result[Void, String] = fs_write_file(fs_w, gi_path, gi_txt + "\nbin/\n");
    }
    let mk_path: String = repo_dir + "/Makefile";
    let mr: Result[String, String] = fs_read_file(fs_r, mk_path);
    if mr.is_ok() && !str_contains(mr.val, "\ndet:") {
        let det_rule: String = "\ndet: build\n\t@mkdir -p .ooda-cache\n\t@$(OODA_COMPILER) build main.oo -o .ooda-cache/det_a > /dev/null\n\t@$(OODA_COMPILER) build main.oo -o .ooda-cache/det_b > /dev/null\n\t@cmp -s .ooda-cache/det_a .ooda-cache/det_b && sha256sum .ooda-cache/det_a && echo \"PASS: deterministic build\"\n";
        let _wm: Result[Void, String] = fs_write_file(fs_w, mk_path, mr.val + det_rule);
    }
    return true;
}

fn rel_build_and_stage(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, repo: String) -> String {
    let mut margs: List[String] = list_new();
    margs = list_push(margs, "-C");
    margs = list_push(margs, repo_dir);
    margs = list_push(margs, "build");
    margs = list_push(margs, "verify");
    margs = list_push(margs, "test");
    margs = list_push(margs, "det");
    let mr: Result[Int, String] = sys_exec_wait(sys, "make", margs);
    if mr.is_err() || mr.val != 0 { return ""; }
    let bin_dir: String = repo_dir + "/bin";
    let _mk: Result[Void, String] = fs_mkdir_p(fs_w, bin_dir);
    let bin_path: String = bin_dir + "/" + repo;
    if !path_exists(fs_r, bin_path) && path_exists(fs_r, repo_dir + "/dist/" + repo) {
        let _cp: Result[String, String] = sys_exec(sys, "cp", "-f", repo_dir + "/dist/" + repo, bin_path);
    }
    let sr: Result[String, String] = sys_exec(sys, "sha256sum", bin_path);
    if sr.is_err() { return ""; }
    let sha_word: String = list_get(text_split_lines(str_replace(text_trim(sr.val), " ", "\n")), 0);
    let _ws: Result[Void, String] = fs_write_file(fs_w, bin_path + ".sha256", sha_word + "  " + repo + "\n");
    return sha_word;
}

fn rel_git_and_gh(sys: &ProcessCap, fs_r: &FsReadCap, org: String, repo_dir: String, repo: String, tag: String, sha: String) -> Int {
    let env_pfx: String = "GIT_TERMINAL_PROMPT=0 OODA_FS_READDIR=/Projects:/home/ubermetroid:/tmp ";
    let mut g_args: List[String] = list_new();
    g_args = list_push(g_args, "-c");
    g_args = list_push(g_args, "if [ -n \"$(git -C " + repo_dir + " status --porcelain)\" ]; then git -C " + repo_dir + " add -A && git -C " + repo_dir + " commit -q -m \"release(" + repo + "): " + tag + "\"; fi; "
        + env_pfx + "git -C " + repo_dir + " push -q origin HEAD:refs/heads/master || true; "
        + env_pfx + "git -C " + repo_dir + " push -q origin HEAD:refs/heads/main || true; "
        + env_pfx + "git -C " + repo_dir + " tag -f " + tag + " && "
        + env_pfx + "git -C " + repo_dir + " push -q --force origin refs/tags/" + tag);
    let _gr: Result[Int, String] = sys_exec_wait(sys, "bash", g_args);
    let bin_path: String = repo_dir + "/bin/" + repo;
    let sha_path: String = bin_path + ".sha256";
    let slug: String = org + "/" + repo;
    let desc: String = eco_pkg_get(fs_r, repo_dir + "/ooda.pkg", "description");
    let notes: String = repo + " " + tag + " (" + org + " | sha256=" + sha + ") " + desc;
    let mut gh_args: List[String] = list_new();
    gh_args = list_push(gh_args, "-c");
    gh_args = list_push(gh_args, env_pfx + "gh release view " + tag + " --repo " + slug + " >/dev/null 2>&1 && "
        + env_pfx + "gh release upload " + tag + " " + bin_path + " " + sha_path + " --repo " + slug + " --clobber || "
        + env_pfx + "gh release create " + tag + " " + bin_path + " " + sha_path + " --repo " + slug + " --title \"" + repo + " " + tag + "\" --notes \"" + notes + "\"");
    let c_res: Result[Int, String] = sys_exec_wait(sys, "bash", gh_args);
    if c_res.is_err() { return 1; }
    return c_res.val;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, _env: &EnvCap, args: List[String]) -> Int {
    if list_len(args) < 2 {
        println("usage: eco-release <org> <repo> [version]");
        return 2;
    }
    let org: String = list_get(args, 0);
    let repo: String = list_get(args, 1);
    let raw_ver: String = if list_len(args) > 2 { list_get(args, 2) } else { "v0.2.1" };
    let ver: String = if str_starts_with(raw_ver, "v") { str_slice(raw_ver, 1, chars_len(raw_ver)) } else { raw_ver };
    let tag: String = "v" + ver;
    let layer: String = eco_org_layer(org);
    if layer == "" { println("error: unsupported org " + org); return 2; }
    let repo_dir: String = "/Projects/" + org + "/" + repo;
    if !path_exists(fs_r, repo_dir + "/.git") { println("error: missing repo " + repo_dir); return 1; }
    let old_ver: String = eco_read_trimmed(fs_r, repo_dir + "/VERSION");
    let _ok: Bool = rel_update_pkg(fs_r, fs_w, repo_dir, repo, ver, layer);
    let _rw: Int = rel_rewrite_versions(fs_r, fs_w, repo_dir, old_ver, ver);
    let _ci: Bool = rel_ensure_ci_and_det(fs_r, fs_w, repo_dir);
    println("== [" + org + "/" + repo + "] building, verifying, testing, and checking determinism for " + tag);
    let sha: String = rel_build_and_stage(sys, fs_r, fs_w, repo_dir, repo);
    if sha == "" { println("FAIL: build/verify/test/det failed for " + org + "/" + repo); return 1; }
    let rc: Int = rel_git_and_gh(sys, fs_r, org, repo_dir, repo, tag, sha);
    if rc != 0 { println("FAIL: gh release failed for " + org + "/" + repo); return 1; }
    println("== [" + org + "/" + repo + "] released " + tag + " (sha256=" + sha + ")");
    return 0;
}
