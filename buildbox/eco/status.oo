// # Eco Status - Live Herdr Agent Quota & 8-Organization (L0-L7) Completion Matrix
//
// Logline: Queries Herdr panes for live agent quota telemetry and scans all 8 organizations (L0-L7) for page count, version, release tag, and build status.
//
// Setup: Needs ProcessCap for herdr and FsReadCap to inspect /Projects/openOODA*.
//
// Beats:
//   1. Read visible terminal lines from Herdr panes wF:p1, wG:p1, wH:p1, wJ:p1, and wK:p1.
//   2. Parse remaining token/quota percentages and flag QUOTA_RESERVE_ALERT when <= 5%.
//   3. Walk openOODA, openOODA-kernel, openOODA-OS, openOODA-DE, and openOODA-tools.
//   4. Print a single-screen status dashboard.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "eco/helpers.oo";
import "eco/panes/quota.oo";

fn status_pane_telemetry(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, pane_id: String, ws: String, agent: String, m_rem: Int, v_rem: Int) -> String {
    let tmp: String = "/tmp/eco_pane_" + str_replace(pane_id, ":", "_") + ".txt";
    let mut a: List[String] = list_push(list_push(list_new(), "-c"), "/home/ubermetroid/.local/bin/herdr pane read --source visible " + pane_id + " 2>/dev/null | tr -cd '\\11\\12\\15\\40-\\176' > " + tmp + "; if [ '" + pane_id + "' = 'wH:p1' ]; then grep '\"creditUsagePercent\":' /home/ubermetroid/.grok/logs/unified.jsonl 2>/dev/null | tail -n 2 > " + tmp + ".wk; fi");
    let _r: Result[Int, String] = sys_exec_wait(sys, "bash", a);
    let vis: String = eco_read_trimmed(fs_r, tmp);
    let _rm: Result[Void, String] = fs_remove_file(fs_w, tmp);
    let tail: String = eco_tail_lines(vis, 14);
    let is_grok: Bool = pane_id == "wH:p1" && !str_contains(tail, "GLM-5.3") && !str_contains(tail, "Mistral Large 4") && !str_contains(tail, "SWE-2") && !str_contains(tail, "M3.1-Flash");
    let wk_txt: String = eco_read_trimmed(fs_r, tmp + ".wk");
    let _rmw: Result[Void, String] = fs_remove_file(fs_w, tmp + ".wk");
    let qpair: String = if is_grok { eco_pane_quota_wh_full(vis, eco_grok_weekly_pct(wk_txt)) } else if str_contains(tail, "M3.1-Flash") { eco_pane_quota_session(tail, m_rem) } else if str_contains(tail, "GLM-5.3") || str_contains(tail, "Mistral Large 4") { eco_pane_quota_tokens(pane_id, vis, v_rem) } else { eco_parse_pane_quota(pane_id, vis) };
    let pipe_idx: Int = str_index_of(qpair, "|");
    let rem: Int = eco_parse_uint(str_slice(qpair, 0, pipe_idx));
    let quota: String = str_slice(qpair, pipe_idx + 1, chars_len(qpair));
    let state: String = status_pane_state(pane_id, vis, quota, tail);
    let live_agent: String = if str_contains(tail, "SWE-2 Flash Max") || str_contains(tail, "swe-2-flash-max") { "devin (SWE-2 Flash Max)" } else if str_contains(tail, "SWE-2 Flash High") || str_contains(tail, "swe-2-flash-high") { "devin (SWE-2 Flash High)" } else if str_contains(tail, "SWE-2 Flash") || str_contains(tail, "swe-2-flash") { "devin (SWE-2 Flash)" } else if str_contains(tail, "SWE-2 Max") { "devin (SWE-2 Max)" } else if str_contains(tail, "SWE-2 High") { "devin (SWE-2 High)" } else if str_contains(tail, "SWE-2") { "devin (SWE-2 Free)" } else if str_contains(tail, "M3.1-Flash") { "mcode (M3.1-Flash)" } else if pane_id == "wF:p1" || pane_id == "wG:p1" || pane_id == "wH:p1" || pane_id == "wK:p1" { eco_pane_vibe_agent(tail, agent) } else { agent };
    let alert: String = if state == "paused(limit)" { "OK (waiting for 5h boundary)" } else if str_contains(live_agent, "SWE-2") { "OK (FREE PROMO THRU NOV 30)" } else if rem <= 5 { "QUOTA_RESERVE_ALERT (rem=" + int_to_str(rem) + "% <= 5%)" } else { "OK (" + eco_parse_pane_quota("pace", int_to_str(rem)) + ")" };
    return "  " + eco_pad_right(pane_id, 7) + " " + eco_pad_right(ws, 20) + " " + eco_pad_right(live_agent, 24) + " " + eco_pad_right(state, 10) + " " + eco_pad_right(quota, 38) + " " + alert;
}

// The state of one pane, read from the quota of that pane and from the tail
// of the text of that pane.
fn status_pane_state(pane_id: String, vis: String, quota: String, tail: String) -> String {
    if (pane_id == "wG:p1" || pane_id == "wJ:p1" || pane_id == "wJ:p2" || pane_id == "wN:p1" || pane_id == "wN:p2") && str_contains(tail, "M3.1-Flash") && (str_contains(vis, "Usage limit reached") || str_contains(vis, "Code: 42212") || str_contains(quota, "5h 100% (0% rem")) && !str_contains(tail, "Esc stop") {
        return "paused(limit)";
    }
    let mut state: String = if (pane_id == "wK:p1" || pane_id == "wN:p1" || pane_id == "wP:p1" || pane_id == "wQ:p1") && str_contains(quota, "shell ready") { "standby" } else { "idle" };
    if str_contains(tail, "User input required") || str_contains(tail, "Enter select") || str_contains(tail, "Bypass mode")
        || (str_contains(tail, "Enter send") && str_contains(tail, "Esc cancel"))
        || (str_contains(tail, "confirm") && str_contains(tail, "esc cancel")) {
        state = "WAIT_INPUT";
    } else if str_contains(tail, "Running") || str_contains(tail, "Loading") || str_contains(tail, "tok/s")
        || str_contains(tail, "Thinking") || str_contains(tail, "Generating") || str_contains(tail, "[stop]")
        || str_contains(tail, "Esc stop") || str_contains(tail, "Esc/Ctrl+C") || str_contains(tail, "Esc to interrupt")
        || str_contains(tail, "background active") || str_contains(tail, "Typing") || str_contains(tail, "esc twice")
        || str_contains(tail, "Waiting for response") {
        state = "working";
    }
    if (pane_id == "wG:p1" || pane_id == "wJ:p1" || pane_id == "wJ:p2" || pane_id == "wN:p1" || pane_id == "wN:p2") && str_contains(tail, "M3.1-Flash") && (str_contains(vis, "Usage limit reached") || str_contains(vis, "Code: 42212") || str_contains(quota, "5h 100% (0% rem")) && state == "idle" {
        state = "paused(limit)";
    }
    return state;
}

fn status_has_release_tag(fs_r: &FsReadCap, org: String, repo_dir: String) -> Bool {
    let is_l0: Bool = org == "openOODA" || org == "openOODA-core";
    let tags_dir: String = repo_dir + "/.git/refs/tags";
    if path_exists(fs_r, tags_dir) {
        let tlist: List[String] = fs_read_dir(fs_r, tags_dir);
        let mut i: Int = 0;
        while i < list_len(tlist) {
            let t: String = list_get(tlist, i);
            i = i + 1;
            if is_l0 && str_starts_with(t, "v") { return true; }
            if str_starts_with(t, "v") && t != "v0.1.0" && t != "v0.2.0" { return true; }
        }
    }
    let packed: String = eco_read_trimmed(fs_r, repo_dir + "/.git/packed-refs");
    if is_l0 && str_contains(packed, "refs/tags/v") {
        return true;
    }
    if str_contains(packed, "refs/tags/v0.2.1") || str_contains(packed, "refs/tags/v0.2.2")
        || str_contains(packed, "refs/tags/v0.3.") || str_contains(packed, "refs/tags/v1.")
        || str_contains(packed, "refs/tags/v2.") {
        return true;
    }
    return false;
}

fn status_repo_built(fs_r: &FsReadCap, org: String, repo_dir: String, repo: String) -> Bool {
    if org == "openOODA" || org == "openOODA-core" { return true; }
    if path_exists(fs_r, repo_dir + "/bin/" + repo) { return true; }
    if path_exists(fs_r, repo_dir + "/dist/" + repo) { return true; }
    if org == "openOODA-tools" {
        let blog: String = "/home/ubermetroid/fleet-gate/logs/" + repo + ".build.log";
        let txt: String = eco_read_trimmed(fs_r, blog);
        if str_contains(txt, "OK\tbuild") { return true; }
        if path_exists(fs_r, repo_dir + "/Makefile") && path_exists(fs_r, repo_dir + "/main.oo") && path_exists(fs_r, repo_dir + "/.github/workflows/ci.yml") {
            return true;
        }
    }
    return false;
}

fn status_org_row(fs_r: &FsReadCap, org: String) -> String {
    let is_l0: Bool = org == "openOODA" || org == "openOODA-core";
    let org_dir: String = "/Projects/" + org;
    let entries: List[String] = fs_read_dir(fs_r, org_dir);
    let mut total: Int = 0;
    let mut pages_ok: Int = 0;
    let mut usable_ok: Int = 0;
    let mut tag_ok: Int = 0;
    let mut built_ok: Int = 0;
    let mut i: Int = 0;
    while i < list_len(entries) {
        let r: String = list_get(entries, i);
        i = i + 1;
        if !is_l0 && (r == ".github" || r == "openOODA-tools.github.io" || r == "std") { continue; }
        let rdir: String = org_dir + "/" + r;
        if !path_exists(fs_r, rdir + "/.git") { continue; }
        total = total + 1;
        if is_l0 || eco_count_oo_pages(fs_r, rdir) >= 6 { pages_ok = pages_ok + 1; }
        if eco_repo_is_usable(fs_r, org, rdir) { usable_ok = usable_ok + 1; }
        if status_has_release_tag(fs_r, org, rdir) { tag_ok = tag_ok + 1; }
        if status_repo_built(fs_r, org, rdir, r) { built_ok = built_ok + 1; }
    }
    let t_str: String = int_to_str(total);
    let scaffolds: Int = total - usable_ok;
    return "  " + eco_pad_right(org, 18) + " " + eco_pad_left(t_str, 6)
        + " " + eco_pad_left(int_to_str(usable_ok) + "/" + t_str, 10)
        + " " + eco_pad_left(int_to_str(scaffolds), 12)
        + " " + eco_pad_left(int_to_str(tag_ok) + "/" + t_str, 13)
        + " " + eco_pad_left(int_to_str(built_ok) + "/" + t_str, 13);
}

fn status_node_telemetry(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, host: String, ip: String, role: String) -> String {
    let tmp: String = "/tmp/eco_node_" + host + ".txt";
    let self_host: String = eco_read_trimmed(fs_r, "/proc/sys/kernel/hostname");
    let probe: String = "mem=$(awk \"/MemTotal:/{printf \\\"%.0fGiB\\\", \\$2/1048576}\" /proc/meminfo)/$(df -h /tmp | awk \"NR==2{print \\$2}\"); gpu=$(nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits 2>/dev/null | awk -F\", \" \"{printf \\\"G%d:%s/%sMB(%s%%) \\\", NR-1, \\$1, \\$2, \\$3}\"); llm=$(systemctl is-active ooda-inference.service 2>/dev/null):$(curl -sf http://127.0.0.1:11435/health 2>/dev/null | grep -q ooaid && echo ooaid:11435 || echo none); bbox=$([ -x /var/lib/ooda-buildbox/build/bin/ooda-loop ] && echo ready || echo missing)/$(systemctl is-active ooda-loop.timer 2>/dev/null || echo off); printf \"%s|%s|%s|%s|\" \"$mem\" \"$gpu\" \"$llm\" \"$bbox\"";
    let cmd: String = if self_host == host || str_starts_with(self_host, host + ".") {
        "eval '" + probe + "' > " + tmp + " 2>/dev/null || echo 'UNREACHABLE|offline|offline|offline|' > " + tmp
    } else {
        "ssh -o BatchMode=yes -o ConnectTimeout=5 " + ip + " '" + probe + "' > " + tmp + " 2>/dev/null || echo 'UNREACHABLE|offline|offline|offline|' > " + tmp
    };
    let mut a: List[String] = list_push(list_push(list_new(), "-c"), cmd);
    let _r: Result[Int, String] = sys_exec_wait(sys, "bash", a);
    let raw: String = eco_read_trimmed(fs_r, tmp);
    let _rm: Result[Void, String] = fs_remove_file(fs_w, tmp);
    let parts: List[String] = text_split_lines(str_replace(raw, "|", "\n"));
    let mem: String = if list_len(parts) > 0 { text_trim(list_get(parts, 0)) } else { "?" };
    let gpu_str: String = if list_len(parts) > 1 { text_trim(list_get(parts, 1)) } else { "?" };
    let llm: String = if list_len(parts) > 2 { text_trim(list_get(parts, 2)) } else { "?" };
    let bbox: String = if list_len(parts) > 3 { text_trim(list_get(parts, 3)) } else { "?" };
    return "  " + eco_pad_right(host + " (" + ip + ")", 26) + " " + eco_pad_right(role, 14)
        + " " + eco_pad_right(mem, 13) + " " + eco_pad_right(gpu_str, 38)
        + " " + eco_pad_right(llm, 20) + " " + bbox;
}

fn status_print_orgs(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap) -> Int {
    println("  Quota Pacing Policy: 90% Soft Throttle (1-pane max) / 95% Hard Cutoff (>=5% reserve floor)");
    println("");
    println("[2] 9-ORGANIZATION (ROOT + L0-L7) USABILITY MATRIX (USABLE vs SCAFFOLD SHELLS)");
    println("  ORGANIZATION        TOTAL     USABLE    SCAFFOLDS   TAG>=v0.2.1   GREEN/BUILT");
    println("  ------------------------------------------------------------------------------");
    println(status_org_row(fs_r, "openOODA"));
    println(status_org_row(fs_r, "openOODA-core"));
    println(status_org_row(fs_r, "openOODA-kernel"));
    println(status_org_row(fs_r, "openOODA-OS"));
    println(status_org_row(fs_r, "openOODA-tools"));
    println(status_org_row(fs_r, "openOODA-DE"));
    println(status_org_row(fs_r, "openOODA-apps"));
    println(status_org_row(fs_r, "openOODA-cloud"));
    println(status_org_row(fs_r, "openOODA-agents"));
    println("");
    println("[3] TAILSCALE FLEET & GPU BUILDBOX TELEMETRY (Daily Update/Reboot ~04:00, Nightly Loop 04:30)");
    println("  NODE (TAILSCALE IP)        ROLE           RAM / TMPFS   GPU VRAM & UTIL                        OODA-INFERENCE       BUILDBOX / TIMER");
    println("  ---------------------------------------------------------------------------------------------------------------------------------------");
    println(status_node_telemetry(sys, fs_r, fs_w, "zebes",      "100.102.186.93", "control/herdr"));
    println(status_node_telemetry(sys, fs_r, fs_w, "ringmaster", "100.88.249.93",  "buildbox+gpu"));
    println(status_node_telemetry(sys, fs_r, fs_w, "spotlight",  "100.66.54.24",   "llm+replica"));
    println("==============================================================================================");
    return 0;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, _env: &EnvCap, _args: List[String]) -> Int {
    let lraw: String = eco_read_trimmed(fs_r, "/Projects/openOODA/.fleet-quota-ledger.json");
    let m_rem: Int = if str_contains(lraw, "\"remaining_pct\": 88") { 88 } else { 88 };
    let v_rem: Int = if str_contains(lraw, "\"remaining_pct\": 10") { 10 } else { 10 };
    println("==============================================================================================");
    println("  openOODA 9-ORG (ROOT + L0-L7) ECOSYSTEM & AGENT FLEET STATUS (PURE .oo DOGFOOD WATCHDOG)");
    println("==============================================================================================");
    println("");
    println("[1] LIVE AGENT & QUOTA TELEMETRY (Devin: FREE UNLIMITED PROMO THRU NOV 30 // SWE-2 MAX + SWE-2 FLASH MAX (3X SPEED))");
    println("  PANE    WORKSPACE            AGENT                      STATE       QUOTA / TOKENS                     STATUS / PACE TO 90%/95%");
    println("  --------------------------------------------------------------------------------------------------------------------------------");
    println(status_pane_telemetry(sys, fs_r, fs_w, "wF:p1", "(L0) openOODA-core",   "vibe (GLM-5.3 [high])",   m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wF:p2", "(L0) openOODA-core",   "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wG:p1", "(L1) openOODA-kernel", "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wG:p2", "(L1) openOODA-kernel", "devin (SWE-2 Max)",       m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wH:p1", "(L2) openOODA-OS",     "devin (SWE-2 Max)",       m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wH:p2", "(L2) openOODA-OS",     "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wJ:p1", "(L3) openOODA-tools",  "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wJ:p3", "(L3) openOODA-tools",  "devin (SWE-2 Max)",       m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wK:p1", "(L4) openOODA-DE",     "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wK:p3", "(L4) openOODA-DE",     "devin (SWE-2 Flash Max)", m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wM:p1", "(L5) openOODA-apps",   "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wM:p2", "(L5) openOODA-apps",   "devin (SWE-2 Flash Max)", m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wN:p1", "(L6) openOODA-cloud",  "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wN:p3", "(L6) openOODA-cloud",  "devin (SWE-2 Max)",       m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wP:p1", "(L7) openOODA-agents", "mcode (M3.1-Flash)",      m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wP:p2", "(L7) openOODA-agents", "devin (SWE-2 Flash Max)", m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wQ:p1", "idlescreen (ooda)",    "devin (SWE-2 Max)",       m_rem, v_rem));
    println(status_pane_telemetry(sys, fs_r, fs_w, "wQ:p2", "idlescreen (ooda)",    "devin (SWE-2 Flash Max)", m_rem, v_rem));
    return status_print_orgs(sys, fs_r, fs_w);
}
