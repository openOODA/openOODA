// # Status CSS - Pure .oo Theme & Responsive Grid Stylesheet For status.openOODA.org
//
// Logline: Emits the complete CSS stylesheet for status.openOODA.org with zero Python dependencies.
//
// Setup: Pure functions returning CSS strings.
//
// Beats:
//   1. Root variables, terminal window, header wordmark, and status badges.
//   2. Burn Hero stage, Ticker grid, SVG chart, and persistent bottom navigation dock.
//   3. 5-GPU hardware grid, Quota remaining graph, and interactive sort bar.
//   4. Contribution heatmap, agent tables, North Star cards, and mission list.

pub fn ss_css_p1() -> String {
    return "    :root {\n"
        + "      --bg-deep: #06080b; --bg-window: rgba(9, 12, 18, 0.88); --bg-bar: #0c1018;\n"
        + "      --bg-titlebar: rgba(11, 15, 23, 0.94); --bg-card: rgba(12, 16, 24, 0.90); --bg-btn: #121824;\n"
        + "      --phosphor: #50fa7b; --accent-rgb: 80, 250, 123;\n"
        + "      --phosphor-dim: rgba(var(--accent-rgb, 80, 250, 123), 0.14);\n"
        + "      --phosphor-glow: rgba(var(--accent-rgb, 80, 250, 123), 0.30);\n"
        + "      --hot: #a2ffbc; --hot-rgb: 162, 255, 188;\n"
        + "      --color-green: var(--phosphor); --color-green-dim: var(--phosphor-dim);\n"
        + "      --color-amber: #ffb000; --color-cyan: #00e5ff; --color-red: #ff5555;\n"
        + "      --color-purple: #bd93f9; --color-pink: #ff79c6;\n"
        + "      --text-primary: #f3f4f6; --text-secondary: #94a3b8; --text-muted: #64748b;\n"
        + "      --border-subtle: #1e2636; --border-accent-color: rgba(var(--accent-rgb, 80, 250, 123), 0.44);\n"
        + "      --font-mono: ui-monospace, SFMono-Regular, \"JetBrains Mono\", Menlo, Consolas, monospace;\n"
        + "    }\n"
        + "    * { box-sizing: border-box; margin: 0; padding: 0; }\n"
        + "    html, body { height: 100%; }\n"
        + "    body.terminal-body { background-color: var(--bg-deep); color: var(--text-primary); font-family: var(--font-mon" +
            "o); line-height: 1.55; overflow: hidden; position: relative; }\n"
        + "    a { color: var(--color-cyan); text-decoration: none; }\n"
        + "    a:hover { color: var(--hot); text-decoration: underline; }\n"
        + "    code { color: var(--color-cyan); font-family: var(--font-mono); }\n"
        + "    .muted { color: var(--text-secondary); }\n"
        + "    .review-canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; dis" +
            "play: block; }\n"
        + "    .terminal-window { position: relative; z-index: 2; display: flex; flex-direction: column; height: 100vh; heigh" +
            "t: 100dvh; background: transparent; }\n"
        + "    .window-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: " +
            "52px; padding: 8px 20px; background: var(--bg-titlebar); border-bottom: 2px solid var(--border-accent-color); bo" +
                "x-shadow: 0 2px 0 0 #000, 0 8px 24px rgba(0, 0, 0, 0.75); backdrop-filter: blur(12px); font-size: 12px; flex" +
                    "-wrap: wrap; flex-shrink: 0; z-index: 95; }\n"
        + "    .header-brand { display: flex; align-items: center; gap: 10px; color: var(--text-primary); font-weight: 800; f" +
            "ont-size: 14px; text-decoration: none; }\n";
}

pub fn ss_css_p2() -> String {
    return "    .crest-emblem { width: 30px; height: 30px; border-radius: 4px; border: 1.5px solid var(--phosphor); box-shado" +
        "w: 2px 2px 0 0 #000, 0 0 10px var(--phosphor-dim); backgrou" +
            "nd: #080b10; image-rendering: pixelated; flex-shrink: 0; }\n"
        + "    .header-wordmark { display: block; width: min(172px, 38vw); height: auto; image-rendering: pixelated; }\n"
        + "    .window-title { color: var(--hot); font-weight: 700; letter-spacing: 0.05em; text-shadow: 0 0 10px var(--phosp" +
            "hor-dim); flex: 1; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n"
        + "    .header-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n"
        + "    .term-badge { display: inline-block; padding: 2px 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.05" +
            "em; border: 1px solid var(--border-accent-color); background: var(--phosphor-dim); color: var(--hot); box-shadow" +
                ": 2px 2px 0 0 #000; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }\n"
        + "    .term-badge-green { color: var(--phosphor); border-color: rgba(80, 250, 123, 0.5); background: rgba(80, 250, 1" +
            "23, 0.12); }\n"
        + "    .term-badge-amber { color: var(--color-amber); border-color: rgba(255, 176, 0, 0.5); background: rgba(255, 176" +
            ", 0, 0.12); }\n"
        + "    .term-badge-cyan { color: var(--color-cyan); border-color: rgba(0, 229, 255, 0.5); background: rgba(0, 229, 25" +
            "5, 0.12); }\n"
        + "    .term-badge-red { color: var(--color-red); border-color: rgba(255, 85, 85, 0.5); background: rgba(255, 85, 85," +
            " 0.14); }\n"
        + "    .term-status-online { color: var(--phosphor); font-wei" +
            "ght: 700; animation: blink-soft 2.6s steps(2) infinite; }\n"
        + "    @keyframes blink-soft { 50% { opacity: 0.4; } }\n"
        + "    .scroll-port { flex: 1; overflow-y: auto; overflow-x: hidden; scroll-snap-type: y proximity; scrollbar-width: " +
            "thin; scrollbar-color: var(--phosphor) var(--bg-deep); }\n"
        + "    .page-stage { min-height: 100%; scroll-snap-align: start; max-width: 1180px; margin: 0 auto; padding: 28px 18p" +
            "x 40px; display: flex; flex-direction: column; justify-content: center; }\n"
        + "    .burn-hero-stage { min-height: 100%; scroll-snap-align: start; display: flex; flex-direction: column; align-it" +
            "ems: center; justify-content: space-between; padding: 28px 20px 28px; text-align: center; max-width: 1180px; mar" +
                "gin: 0 auto; }\n"
        + "    .burn-hero-box { background: rgba(8, 12, 18, 0.86); border: 2px solid var(--border-accent-color); box-shadow: " +
            "4px 4px 0 0 #000, 0 12px 36px rgba(0, 0, 0, 0.82); backdrop-filter: blur(10px); padding: 24px 32px; max-width: 9" +
                "60px; width: 100%; margin: auto 0; }\n"
        + "    .burn-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: #0a0f18; b" +
            "order: 1px solid var(--border-accent-color); color: var(--hot); font-size: 11px; font-weight: 800; letter-spacin" +
                "g: 0.1em; margin-bottom: 12px; }\n"
        + "    .burn-dot { width: 8px; height: 8px; background: var(--phosphor); box-shadow: 0 0 10px var(--phosphor); animat" +
            "ion: blink-soft 1.4s steps(2) infinite; }\n"
        + "    .burn-mega-num { font-size: clamp(2.6rem, 6vw, 4.5rem); font-weight: 900; color: #ffffff; text-shadow: 3px 3px" +
            " 0 #000, 0 0 24px var(--phosphor-glow); line-height: 1.08; letter-spacing: -0.02em; }\n"
        + "    .burn-mega-unit { font-size: clamp(1.1rem, 2.5vw, 1.65rem); color: var(--phosphor); font-weight: 800; margin-l" +
            "eft: 8px; }\n"
        + "    .burn-sub-meta { font-size: 12px; color: var(--text-secondary); margin-top: 8px; margin-bottom: 16px; }\n"
        + "    .burn-pills { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 10px; text-alig" +
            "n: left; margin-top: 12px; }\n"
        + "    .burn-pill { background: #070a10; border: 1.5px solid #1e2636; box-shadow: 2px 2px 0 0 #000; padding: 8px 10px" +
            "; min-width: 0; overflow: hidden; }\n"
        + "    .burn-pill-hdr { font-size: 10.5px; font-weight: 800; d" +
            "isplay: flex; justify-content: space-between; gap: 4px; }\n"
        + "    .burn-pill-val { font-size: 15px; font-weight: 800; color: #fff; margin-top: 2px; }\n"
        + "    .burn-scroll-cue { display: inline-flex; align-items: center; gap: 8px; color: var(--hot); font-size: 11px; fo" +
            "nt-weight: 800; letter-spacing: 0.08em; padding: 7px 16px; background: rgba(10, 14, 22, 0.90); border: 1.5px sol" +
                "id var(--border-accent-color); box-shadow: 2px 2px 0 0 #000; text-decoration: none; }\n";
}

pub fn ss_css_p3() -> String {
    return "    .ticker-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 12px; margin-" +
        "bottom: 16px; }\n"
        + "    .stat-card { background: var(--bg-card); border: 1.5px solid var(--border-subtle); box-shadow: 3px 3px 0 0 #00" +
            "0; padding: 12px 14px; min-width: 0; max-width: 100%; overflow: hidden; word-break: break-word; overflow-wrap: a" +
                "nywhere; }\n"
        + "    .stat-card-highlight { border-color: var(--border-accent-color); background: rgba(12, 22, 28, 0.94); }\n"
        + "    .stat-label { font-size: 10.5px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08" +
            "em; font-weight: 700; }\n"
        + "    .stat-val { font-size: 1.35rem; font-weight: 800; color: #ffffff; text-shadow: 2px 2px 0 #000, 0 0 12px var(--" +
            "phosphor-dim); margin-top: 4px; min-width: 0; overflow: hidden; text-overflow: ellipsis; }\n"
        + "    .stat-sub { font-size: 11px; color: var(--phosphor); margin-top: 3px; min-width: 0; overflow: hidden; text-ove" +
            "rflow: ellipsis; }\n"
        + "    .tok-chart-wrap { background: #06090f; border: 1.5px solid #1e2636; box-shadow: inset 2px 2px 0 0 #000; paddin" +
            "g: 12px; width: 100%; overflow: hidden; }\n"
        + "    .tok-line-chart { width: 100%; height: 220px; display: block; }\n"
        + "    .window-statusbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height:" +
            " 52px; padding: 6px 20px; background: var(--bg-titlebar); border-top: 2px solid var(--border-accent-color); box-" +
                "shadow: 0 -2px 0 0 rgba(0, 0, 0, 0.85), 0 -8px 24px rgba(0, 0, 0, 0.65); backdrop-filter: blur(14px); font-s" +
                    "ize: 11px; flex-shrink: 0; z-index: 95; }\n"
        + "    .dock-side { display: flex; align-items: center; gap: 10px; }\n"
        + "    .dock-center { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }\n"
        + "    .nav-arrow, .arcade-btn { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0." +
            "06em; color: var(--phosphor); background: #101520; border: 1.5px solid var(--border-accent-color); box-shadow: 2" +
                "px 2px 0 0 #000; padding: 5px 11px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; te" +
                    "xt-transform: uppercase; }\n"
        + "    .nav-arrow.off { opacity: 0.28; pointer-events: none; }\n"
        + "    .footer-accent-picker { display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px; background: #08" +
            "0b11; border: 1px solid #1e2636; }\n"
        + "    .dock-accent-dot { width: 15px; height: 15px; border-radius: 1px; border: 1px solid #000; cursor: pointer; pad" +
            "ding: 0; }\n"
        + "    .dock-accent-dot.active { transform: scale(1.32); box-shadow: 0 0 0 2px #fff; border-color: #fff; }\n"
        + "    .dock-swatch-label { font-size: 10px; font-weight: 700; color: var(--hot); letter-spacing: 0.08em; min-width: " +
            "56px; text-align: right; }\n"
        + "    .footer-links { display: flex; gap: 10px; flex-wrap: wrap; }\n"
        + "    .footer-links a { color: var(--text-secondary); text-decoration: none; font-size: 11px; }\n"
        + "    .section-hdr { color: var(--hot); font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em; text-transform:" +
            " uppercase; margin: 24px 0 10px; padding: 6px 12px; background: var(--bg-bar); border: 1.5px solid var(--border-" +
                "accent-color); border-left: 4px solid var(--phosphor); box-shadow: 2px 2px 0 0 #000; display: flex; justify-" +
                    "content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; min-width: 0; overflow: hidden; " +
                        "word-break: break-word; }\n"
        + "    .panel { background: var(--bg-card); border: 1.5px solid var(--border-subtle); box-shadow: 3px 3px 0 0 #000, 0" +
            " 8px 24px rgba(0, 0, 0, 0.55); padding: 16px; margin-bottom" +
                ": 18px; min-width: 0; max-width: 100%; overflow: hidden; }\n";
}

pub fn ss_css_p4() -> String {
    return "    .gpu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px;" +
        " width: 100%; min-width: 0; }\n"
        + "    .gpu-card { background: #080b11; border: 1.5px solid var(--border-subtle); box-shadow: 2px 2px 0 0 #000; paddi" +
            "ng: 12px; font-size: 11.5px; min-width: 0; max-width: 100%; overflow: hidden; word-break: break-word; overflow-w" +
                "rap: anywhere; display: flex; flex-direction: column; gap: 4px; }\n"
        + "    .gpu-hdr { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px; marg" +
            "in-bottom: 4px; min-width: 0; }\n"
        + "    .gpu-id { color: var(--color-cyan); font-weight: 800; font-size: 13px; letter-spacing: 0.04em; min-width: 0; }\n"
        + "    .gpu-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; color: var(--text-se" +
            "condary); font-size: 10.5px; margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px dashed #1e2636; min-wid" +
                "th: 0; }\n"
        + "    .gpu-bar-line { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; margin-top: 4px; font-size:" +
            " 11px; min-width: 0; max-width: 100%; overflow: hidden; }\n"
        + "    .gpu-bar-lbl { width: 36px; flex-shrink: 0; color: var(--color-amber); font-weight: 700; font-size: 10.5px; }\n"
        + "    .gpu-seg-track { flex: 1 1 64px; min-width: 48px; max-width: 100%; height: 10px; background: #05070a; border: " +
            "1px solid #1e2636; box-shadow: inset 1px 1px 0 0 #000; overflow: hidden; position: relative; }\n"
        + "    .gpu-seg-fill { height: 100%; max-width: 100%; }\n"
        + "    .gpu-seg-cyan { background-color: var(--color-cyan); }\n"
        + "    .gpu-seg-green { background-color: var(--phosphor); }\n"
        + "    .seg-bar { font-family: var(--font-mono); letter-spacing: 0.02em; font-size: 11px; min-width: 0; max-width: 10" +
            "0%; overflow: hidden; text-overflow: clip; flex-shrink: 1; }\n"
        + "    .seg-inline { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.02em; max-width: 100%; overflo" +
            "w: hidden; }\n"
        + "    .gpu-bar-val { color: var(--text-primary); font-size: 10.5px; min-width: 0; max-width: 100%; overflow: hidden;" +
            " text-overflow: ellipsis; margin-left: auto; }\n"
        + "    .quota-row { padding: 11px 0; border-bottom: 1px dashed #1e2636; min-width: 0; max-width: 100%; overflow: hidd" +
            "en; word-break: break-word; }\n"
        + "    .quota-hdr { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; ma" +
            "rgin-bottom: 6px; font-size: 12px; min-width: 0; }\n"
        + "    .quota-agent { font-weight: 800; margin-right: 6px; }\n"
        + "    .quota-cycle { font-size: 10.5px; color: var(--color-amber); font-weight: 700; margin-right: 6px; }\n"
        + "    .quota-nums { font-size: 11.5px; min-width: 0; max-width: 100%; word-break: break-word; }\n"
        + "    .quota-bar-track { position: relative; width: 100%; max-width: 100%; height: 14px; background: #05070a; border" +
            ": 1.5px solid #1e2636; display: flex; overflow: hidden; }\n"
        + "    .quota-bar-used { height: 100%; }\n"
        + "    .quota-bar-rem { height: 100%; background: rgba(80, 250, 123, 0.16); }\n"
        + "    .quota-throttle-line { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--color-amber); z-in" +
            "dex: 2; }\n"
        + "    .quota-target-line { position: absolute; top: 0; bottom:" +
            " 0; width: 2px; background: var(--color-red); z-index: 2; }\n"
        + "    .quota-sub { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; font-size: 11px; color:" +
            " var(--text-secondary); margin-top: 5px; min-width: 0; }\n";
}

pub fn ss_css_p5() -> String {
    return "    .sort-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; padding: 8px " +
        "10px; background: #080b11; border: 1.5px solid #1e2636; min-width: 0; overflow: hidden; }\n"
        + "    .sort-label { font-size: 10.5px; font-weight: 800; color: var(--color-amber); letter-spacing: 0.06em; margin-r" +
            "ight: 4px; }\n"
        + "    .sort-btn { background: #0c1018; color: var(--text-secondary); border: 1px solid #1e2636; padding: 4px 9px; fo" +
            "nt-family: var(--font-mono); font-size: 10.5px; font-weight: 700; cursor: pointer; }\n"
        + "    .sort-btn.active { color: #06080b; background: var(--phosphor); border-color: var(--hot); }\n"
        + "    .stacked-bar { display: flex; width: 100%; max-width: 100%; height: 14px; background: #05070b; border: 1.5px s" +
            "olid #1e2636; margin-bottom: 14px; overflow: hidden; }\n"
        + "    .hm-wrap { overflow-x: auto; margin-bottom: 16px; max-width: 100%; }\n"
        + "    .hm-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; min-width: 680px; }\n"
        + "    .hm-org { width: 190px; font-size: 11.5px; font-weight: 700; flex-shrink: 0; }\n"
        + "    .hm-cells { display: grid; grid-template-columns: repeat(24, 1fr); gap: 3px; flex: 1; }\n"
        + "    .hm-hdr { font-size: 10px; color: var(--text-secondary); text-align: center; }\n"
        + "    .hm-cell { height: 14px; border: 1px solid rgba(255,255,255,0.08); }\n"
        + "    .hm-empty { background: #070a10; }\n"
        + "    .table-wrap { overflow-x: auto; max-width: 100%; }\n"
        + "    table.ag-table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-top: 6px; }\n"
        + "    table.ag-table th, table.ag-table td { text-align: left; padding: 8px 6px; border-bottom: 1px solid #19202e; }\n"
        + "    table.ag-table th { color: var(--color-amber); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0" +
            ".06em; border-bottom: 1.5px solid #1e2636; }\n"
        + "    .org-push-row { padding: 7px 0; border-bottom: 1px dashed #19202e; font-size: 11.5px; min-width: 0; max-width:" +
            " 100%; overflow: hidden; word-break: break-word; }\n"
        + "    .org-push-hdr { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;" +
            " min-width: 0; }\n"
        + "    .ns-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr)); gap: 12px; w" +
            "idth: 100%; min-width: 0; }\n"
        + "    .ns-card { background: #080b11; border: 1.5px solid #1e2636; box-shadow: 2px 2px 0 0 #000; padding: 14px; min-" +
            "width: 0; max-width: 100%; overflow: hidden; word-break: break-word; overflow-wrap: anywhere; }\n"
        + "    .ns-title { font-size: 12.5px; font-weight: 800; color: #fff; margin-bottom: 8px; display: flex; justify-conte" +
            "nt: space-between; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; }\n"
        + "    .ns-desc { font-size: 11.5px; color: var(--text-secondary); line-height: 1.5; min-width: 0; word-break: break-" +
            "word; }\n"
        + "    ul.missions { list-style: none; }\n"
        + "    ul.missions li { padding: 8px 0; border-bottom: 1px dashed #19202e; font-size: 12px; min-width: 0; overflow: h" +
            "idden; word-break: break-word; }\n"
        + "    pre { background: #05070b; border: 1.5px solid #1e2636; padding: 12px; overflow-x: auto; max-width: 100%; font" +
            "-size: 11px; color: #cbd5e1; line-height: 1.45; }\n";
}

pub fn ss_build_all_css() -> String {
    return ss_css_p1() + ss_css_p2() + ss_css_p3() + ss_css_p4() + ss_css_p5();
}
