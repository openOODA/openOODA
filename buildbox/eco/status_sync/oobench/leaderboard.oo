// # OOBench Leaderboard - Pure .oo Section [06] 24/7 Fleet OVS Table Emitter
//
// Logline: Emits the 12-profile 24/7 Fleet OODA Value Score leaderboard for status.openOODA.org.
//
// Setup: Pure string builders invoked by eco/status_sync/panes_heatmap.oo; no imports required.
//
// Beats:
//   1. Section header, formula badge, and table head.
//   2. Leaderboard rows #1-#4 and #5-#8.
//   3. Leaderboard rows #9-#12 and closing markup.

pub fn ss_oobench_section_html() -> String {
    return "        <div class='section-hdr' id='oobench'><span>-- [06] OOBENCH // 24/7 FLEET OODA VALUE SCORE ("
        + "OVS) LEADERBOARD (v0.5.0) --</span><span class='term-badge term-badge-cyan'>[ FORMULA: FLEET_OVS = ("
        + "Q^2 * EFF * PANES_24X7 * 60) / (TIME_S * COST_24X7) ]</span></div>\n"
        + "        <div class='panel'><div class='table-wrap'><table class='ag-table'><thead><tr><th>Rank</th><"
        + "th>Agent / Model Profile</th><th>24/7 Panes</th><th>Plan / Pricing Link</th><th>Price / Pane (24/7)<"
        + "/th><th>Quality (Q)</th><th>Speed / Time</th><th>Cost Index</th><th>24/7 Fleet OVS</th></tr></thead>"
        + "<tbody>\n"
        + oob_rows_a()
        + oob_rows_b()
        + oob_rows_c()
        + "        </tbody></table></div></div>\n"
        + "";
}

fn oob_rows_a() -> String {
    return "      <tr><td><strong>#1</strong></td><td><code>devin/swe-2-flash-max</code></td><td><span class='te"
        + "rm-badge term-badge-green'>10.0x Panes</span></td><td><a href='https://devin.ai/pricing' target='_bl"
        + "ank' rel='noopener' style='color:#50fa7b;'>Devin Pro ($20/mo Promo)</a></td><td><strong>$0 / pane</s"
        + "trong></td><td><strong>97 / 100</strong></td><td><strong style='color:var(--color-cyan);'>145 tok/s<"
        + "/strong> (120s)</td><td>10</td><td><strong style='color:var(--phosphor);'>564,540</strong> <span cla"
        + "ss='seg-inline' style='color:#50fa7b;'>████████████████</span></td></tr>\n"
        + "      <tr><td><strong>#2</strong></td><td><code>devin/swe-2-max</code></td><td><span class='term-bad"
        + "ge term-badge-green'>10.0x Panes</span></td><td><a href='https://devin.ai/pricing' target='_blank' r"
        + "el='noopener' style='color:#50fa7b;'>Devin Pro ($20/mo Promo)</a></td><td><strong>$0 / pane</strong>"
        + "</td><td><strong>98 / 100</strong></td><td><strong style='color:var(--color-cyan);'>92 tok/s</strong"
        + "> (180s)</td><td>10</td><td><strong style='color:var(--phosphor);'>377,750</strong> <span class='seg"
        + "-inline' style='color:#50fa7b;'>███████████░░░░░</span></td></tr>\n"
        + "      <tr><td><strong>#3</strong></td><td><code>mcode/MiniMax-M3.1-Flash</code></td><td><span class="
        + "'term-badge term-badge-cyan'>3.5x Panes</span></td><td><a href='https://www.minimax.io/platform/codi"
        + "ng-plan' target='_blank' rel='noopener' style='color:#00e5ff;'>MiniMax Annual ($550/yr = $45.83/mo)<"
        + "/a></td><td><strong>~$13 / pane</strong></td><td><strong>95 / 100</strong></td><td><strong style='co"
        + "lor:var(--color-cyan);'>128 tok/s</strong> (140s)</td><td>13</td><td><strong style='color:#00e5ff;'>"
        + "135,373</strong> <span class='seg-inline' style='color:#00e5ff;'>███████░░░░░░░░░</span></td></tr>\n"
        + "      <tr><td><strong>#4</strong></td><td><code>devin/glm-5-3-flash-high</code></td><td><span class="
        + "'term-badge term-badge-cyan'>2.0x Panes</span></td><td><a href='https://docs.devin.ai/' target='_bla"
        + "nk' rel='noopener' style='color:#00e5ff;'>Devin 24h Pool ($0.15/$0.50)</a></td><td><strong>~$10 / pa"
        + "ne</strong></td><td><strong>94 / 100</strong></td><td><strong style='color:var(--color-cyan);'>135 t"
        + "ok/s</strong> (130s)</td><td>15</td><td><strong>62,530</strong> <span class='seg-inline' style='colo"
        + "r:#ffb000;'>█████░░░░░░░░░░░</span></td></tr>\n"
        + "";
}

