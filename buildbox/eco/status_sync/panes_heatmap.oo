        + ss_pane_row("wH:p1", "(L2) openOODA-OS", "#50fa7b", "devin (SWE-2 Max)", "212.4",
            "FREE PROMO Nov30 (23.0M+ burn) / Ctx 68%", "OK (FREE PROMO THRU NOV 30)")
        + ss_pane_row("wH:p2", "(L2) openOODA-OS", "#00e5ff", "mcode (M3.1-Flash)", "84.2",
            "5h 12% (88% rem, rst 10:00) / Ctx 100%", "OK (+78% to 90% (95% cap))")
        + ss_pane_row("wJ:p1", "(L3) openOODA-tools", "#00e5ff", "mcode (M3.1-Flash)", "84.2",
            "5h 12% (88% rem, rst 10:00) / Ctx 100%", "OK (+78% to 90% (95% cap))")
        + ss_pane_row("wJ:p3", "(L3) openOODA-tools", "#50fa7b", "devin (SWE-2 Max)", "212.4",
            "FREE PROMO Nov30 (23.0M+ burn) / Ctx 64%", "OK (FREE PROMO THRU NOV 30)")
        + ss_pane_row("wK:p1", "(L4) openOODA-DE", "#00e5ff", "mcode (M3.1-Flash)", "84.2",
