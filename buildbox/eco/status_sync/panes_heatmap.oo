// # Status Sections Part 2 - Pure .oo HTML Builders For Panes Matrix, Heatmap, Gates, And Sanitized Snapshot
//
// Logline: Emits Sections [3], [4], [5], [6], and [7] of status.openOODA.org and sanitizes raw eco-status telemetry in pure .oo.
//
// Setup: Pure functions over strings. No Python dependencies.
//
// Beats:
//   1. Section [3] 19-pane Herdr matrix (Root w9 + wF..wQ).
//   2. Section [4] 24h contribution heatmap and per-organization usability breakdown.
//   3. Sections [5]-[7] North Star compatibility gates, L0-L7 layer list, and Zero-Trust sanitized snapshot.

import "std/core/primitives/str.oo";
import "text/lines.oo";

pub fn ss_pane_row(pid: String, ws: String, col: String, ag: String, tps: String, q: String, pace: String) -> String {
    return "      <tr><td><code>" + pid + "</code></td><td><strong>" + ws + "</strong></td><td><span style='color:" + col +
        "; font-weight:700;'>■ " + ag +
            "</span></td><td><span class='term-badge term-badge-green'>[WORKING]</span></td><td><strong style='color:var(-" +
                "-color-cyan);'>" + tps + " tok/s</strong> <span class='seg-inline' style='color:" + col +
                    ";'>████████</span></td><td>" + q + "</td><td class='muted'>" + pace + "</td></tr>\n";
}

