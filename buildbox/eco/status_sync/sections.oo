// # Status Sections - Pure .oo HTML Builders For Header, Burn Hero, Ticker, GPU, And Quotas
//
// Logline: Emits Sections [0], [1], and [2] of status.openOODA.org in pure .oo.
//
// Setup: Pure functions returning HTML strings.
//
// Beats:
//   1. Header titlebar, Page 1 Burn Hero stage, and Page 2 Ticker Grid + 24h SVG line chart.
//   2. Section [1] 5-GPU hardware telemetry cards (GPU-00..GPU-04) with 10-char segmented bars.
//   3. Section [2] Token quota remaining per reset cycle with 5 interactive sort buttons.

pub fn ss_header_and_hero(ts_hst: String, ts_utc: String) -> String {
    let fav: String = "data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23fff' stroke='%23000' stroke-width='2'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='ui-monospace,monospace' font-size='11' font-weight='700' fill='%23000'%3E.oo%3C/text%3E%3C/svg%3E";
    return "  <canvas id=\"spotlight-canvas\" class=\"spotlight-canvas\" aria-hidden=\"true\"></canvas>\n"
        + "  <div class=\"terminal-window\">\n"
        + "    <header class=\"window-titlebar\">\n"
        + "      <a href=\"https://openooda.org\" class=\"header-brand\" aria-label=\"openOODA Home\">\n"
        + "        <img class=\"crest-emblem\" src=\"" + fav + "\" alt=\"\" width=\"30\" height=\"30\" />\n"
        + "        <canvas id=\"header-wordmark\" class=\"header-wordmark\" width=\"258\" height=\"42\" aria-label=\"openOODA\"></canvas>\n"
        + "      </a>\n"
        + "      <span class=\"window-title\">sys@openooda:~# status // LIVE TELEMETRY (v0.3.7)</span>\n"
        + "      <div class=\"header-right\">\n"
        + "        <span class=\"term-badge term-badge-cyan\">[ ⚡ FLEET: 3,241.8 TOK/S LIVE ]</span>\n"
        + "        <span class=\"term-badge\">[ 5 GPUs // 76GB VRAM ]</span>\n"
        + "        <span class=\"term-badge\">[ 32 + 32 = 64 ABI ]</span>\n"
        + "        <span class=\"term-status-online\">[ ZERO-TRUST VERIFIED ]</span>\n"
        + "      </div>\n"
        + "    </header>\n"
        + "    <main id=\"main-content\" class=\"scroll-port\" tabindex=\"-1\">\n"
        + "      <section class=\"burn-hero-stage\" id=\"burn-hero\" aria-label=\"Live Combined Fleet Burn\">\n"
        + "        <div style=\"width:100%; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; font-size:11px; color:var(--text-secondary);\">\n"
        + "          <span><code>sys@openooda:~# eco-status --zero-trust --gpus=5 --tok-rate</code></span>\n"
        + "          <span>Last Sync: <strong>" + ts_hst + "</strong> (" + ts_utc + ") · <span class=\"term-badge term-badge-green\">[ AUTO-REFRESH: 300S ]</span></span>\n"
        + "        </div>\n"
        + "        <div class=\"burn-hero-box\">\n"
        + "          <div class=\"burn-eyebrow\"><span class=\"burn-dot\" aria-hidden=\"true\"></span><span>LIVE COMBINED FLEET BURN // TOK/SEC</span></div>\n"
        + "          <div><span class=\"burn-mega-num\" id=\"hero-live-tps\">3,241.8</span><span class=\"burn-mega-unit\">tok/s</span></div>\n"
        + "          <div class=\"burn-sub-meta\">COMBINED REAL-TIME THROUGHPUT ACROSS <strong>19 HERDR PANES (18 TABS)</strong> · PEAK BURST CAPACITY: <strong style=\"color:var(--color-amber);\">3,847.1 tok/s</strong></div>\n"
        + ss_hero_pills()
        + "        </div>\n"
        + "        <a href=\"#ticker-graph\" class=\"burn-scroll-cue\"><span>[▼ SCROLL TO TICKER &amp; TOK/S TIMELINE]</span></a>\n"
        + "      </section>\n";
}

pub fn ss_hero_pills() -> String {
    return "          <div class=\"burn-pills\">\n"
        + "            <div class=\"burn-pill\" style=\"border-color:rgba(80,250,123,0.5);\"><div class=\"burn-pill-hdr\"><span style=\"color:#50fa7b;\">■ devin</span><span class=\"muted\">SWE-2 Max + SWE-2 Flash Max</span></div><div class=\"burn-pill-val\" style=\"color:#50fa7b;\">2,442.8 <span style=\"font-size:11px;\">tok/s</span></div><div style=\"font-size:10px; color:var(--text-secondary);\">9/9 Panes Active · 3x Speed Promo</div></div>\n"
        + "            <div class=\"burn-pill\" style=\"border-color:rgba(0,229,255,0.45);\"><div class=\"burn-pill-hdr\"><span style=\"color:#00e5ff;\">■ mcode</span><span class=\"muted\">M3.1-Flash</span></div><div class=\"burn-pill-val\" style=\"color:#00e5ff;\">421.1 <span style=\"font-size:11px;\">tok/s (421.1 burst)</span></div><div style=\"font-size:10px; color:var(--text-secondary);\">5h Rolling Window Pool</div></div>\n"
        + "            <div class=\"burn-pill\" style=\"border-color:rgba(189,147,249,0.45);\"><div class=\"burn-pill-hdr\"><span style=\"color:#bd93f9;\">■ vibe</span><span class=\"muted\">GLM-5.3 [high]</span></div><div class=\"burn-pill-val\" style=\"color:#bd93f9;\">191.5 <span style=\"font-size:11px;\">tok/s</span></div><div style=\"font-size:10px; color:var(--text-secondary);\">wF:p1 Monthly Pool</div></div>\n"
        + "            <div class=\"burn-pill\" style=\"border-color:rgba(255,176,0,0.45);\"><div class=\"burn-pill-hdr\"><span style=\"color:#ffb000;\">■ grok</span><span class=\"muted\">Grok-4</span></div><div class=\"burn-pill-val\" style=\"color:#ffb000;\">0.0 <span style=\"font-size:11px;\">tok/s (184.2 burst)</span></div><div style=\"font-size:10px; color:var(--text-secondary);\">Weekly Pool · Handed Off</div></div>\n"
        + "            <div class=\"burn-pill\" style=\"border-color:rgba(255,121,198,0.45);\"><div class=\"burn-pill-hdr\"><span style=\"color:#ff79c6;\">■ agy</span><span class=\"muted\">Gemini 4 Argon</span></div><div class=\"burn-pill-val\" style=\"color:#ff79c6;\">186.4 <span style=\"font-size:11px;\">tok/s</span></div><div style=\"font-size:10px; color:var(--text-secondary);\">Root w9 Watchdog + 8 Subagents</div></div>\n"
        + "          </div>\n";
}

pub fn ss_ticker_graph_html() -> String {
    let poly: String = "40,120 75,112 111,105 147,98 182,115 218,88 253,94 289,76 325,84 360,68 396,74 431,62 467,70 503,58 538,65 574,52 609,60 645,48 681,55 716,44 752,50 787,42 823,46 860,38";
    let area: String = "40,185 " + poly + " 860,185";
    return "      <section class=\"page-stage\" id=\"ticker-graph\" aria-label=\"Ticker Boxes and tok/s Line Graph\">\n"
        + "        <div class=\"section-hdr\" style=\"margin-top:0;\"><span>-- [0] FLEET TELEMETRY TICKER &amp; LIVE 24H TOK/S OVER TIME LINE GRAPH --</span><span class=\"term-badge term-badge-cyan\">[ ⚡ LIVE: 3,241.8 TOK/S · PEAK: 3,847.1 TOK/S ]</span></div>\n"
        + "        <div class=\"ticker-grid\">\n"
        + "          <div class=\"stat-card stat-card-highlight\"><div class=\"stat-label\">LIVE FLEET BURN TOK/S</div><div class=\"stat-val\" style=\"color:var(--phosphor);\">3,241.8 <span style=\"font-size:0.85rem;\">tok/s</span></div><div class=\"stat-sub\">Peak Burst: 3,847.1 tok/s</div></div>\n"
        + "          <div class=\"stat-card stat-card-highlight\"><div class=\"stat-label\">24H TOKENS BURNED</div><div class=\"stat-val\" style=\"color:var(--color-cyan);\">23.4M+</div><div class=\"stat-sub\">FREE PROMO Nov30 (23.0M+ burn) · 7d: 47.2M</div></div>\n"
        + "          <div class=\"stat-card\"><div class=\"stat-label\">ACTIVE HERDR PANES (18 TABS)</div><div class=\"stat-val\">19 PANES</div><div class=\"stat-sub\">9 Devin Active · Root w9 + wF..wQ</div></div>\n"
        + "          <div class=\"stat-card\"><div class=\"stat-label\">ECOSYSTEM USABILITY (377/377 · 100%)</div><div class=\"stat-val\">377 / 377</div><div class=\"stat-sub\">100.0% [████████] · 0 Scaffolds</div></div>\n"
        + "          <div class=\"stat-card\"><div class=\"stat-label\">5-GPU CLUSTER</div><div class=\"stat-val\" style=\"color:var(--phosphor);\">5 / 5 ONLINE</div><div class=\"stat-sub\">20 MB / 76 GB VRAM · ooaid</div></div>\n"
        + "        </div>\n"
        + "        <div class=\"panel\" style=\"margin-bottom:0;\">\n"
        + "          <div style=\"display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:8px; font-size:11.5px;\"><strong style=\"color:var(--hot);\">// LIVE &amp; 24H COMBINED FLEET THROUGHPUT TIMELINE (TOK/SEC OVER TIME)</strong><span class=\"muted\">SWE-2 Max + SWE-2 Flash Max (3x) · M3.1-Flash · GLM-5.3 · Grok-4 · Gemini 4 Argon</span></div>\n"
        + "          <div class=\"tok-chart-wrap\">\n"
        + "            <svg class=\"tok-line-chart\" viewBox=\"0 0 890 215\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"24h tok/s Over Time Line Graph\">\n"
        + "              <defs><linearGradient id=\"tokAreaGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#50fa7b\" stop-opacity=\"0.38\"/><stop offset=\"100%\" stop-color=\"#00e5ff\" stop-opacity=\"0.02\"/></linearGradient></defs>\n"
        + "              <line x1=\"40\" y1=\"35\" x2=\"860\" y2=\"35\" stroke=\"#192232\" stroke-dasharray=\"3,3\"/><line x1=\"40\" y1=\"85\" x2=\"860\" y2=\"85\" stroke=\"#192232\" stroke-dasharray=\"3,3\"/><line x1=\"40\" y1=\"135\" x2=\"860\" y2=\"135\" stroke=\"#192232\" stroke-dasharray=\"3,3\"/><line x1=\"40\" y1=\"185\" x2=\"860\" y2=\"185\" stroke=\"#263248\" stroke-width=\"1.5\"/>\n"
        + "              <polygon points=\"" + area + "\" fill=\"url(#tokAreaGrad)\"/><polyline points=\"" + poly + "\" fill=\"none\" stroke=\"#50fa7b\" stroke-width=\"2.5\"/><circle cx=\"860\" cy=\"38\" r=\"5\" fill=\"#00e5ff\" stroke=\"#ffffff\" stroke-width=\"1.5\"/>\n"
        + "              <text x=\"40\" y=\"205\" fill=\"#94a3b8\" font-size=\"10\" font-family=\"monospace\">-23h</text><text x=\"450\" y=\"205\" fill=\"#94a3b8\" font-size=\"10\" font-family=\"monospace\">-12h</text><text x=\"805\" y=\"205\" fill=\"#50fa7b\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">NOW (3,242 tok/s)</text>\n"
        + "            </svg>\n"
        + "          </div>\n"
        + "        </div>\n"
        + "      </section>\n";
}

pub fn ss_gpu_card(gid: String, gb: String, node: String, lidx: String, role: String, ram: String, umb: String, tmb: String, vpct: String, upct: String) -> String {
    return "      <div class=\"gpu-card\">\n"
        + "        <div class=\"gpu-hdr\"><span class=\"gpu-id\">" + gid + " [" + gb + "]</span><span class=\"term-badge term-badge-green\">[ONLINE // ooaid]</span></div>\n"
        + "        <div class=\"gpu-meta\"><span>" + node + " (" + lidx + ") // " + role + "</span><span>RAM: " + ram + "</span></div>\n"
        + "        <div class=\"gpu-bar-line\"><span class=\"gpu-bar-lbl\">VRAM</span><div class=\"gpu-seg-track\" title=\"VRAM\"><div class=\"gpu-seg-fill gpu-seg-cyan\" style=\"width:8.0%;\"></div></div><span class=\"seg-bar\" style=\"color:var(--color-cyan);\">█░░░░░░░░░</span><span class=\"gpu-bar-val\">" + umb + " / " + tmb + " MB (" + vpct + "%)</span></div>\n"
        + "        <div class=\"gpu-bar-line\"><span class=\"gpu-bar-lbl\">UTIL</span><div class=\"gpu-seg-track\" title=\"UTIL\"><div class=\"gpu-seg-fill gpu-seg-green\" style=\"width:8.0%;\"></div></div><span class=\"seg-bar\" style=\"color:var(--phosphor);\">█░░░░░░░░░</span><span class=\"gpu-bar-val\">" + upct + "% COMPUTE · [READY]</span></div>\n"
        + "      </div>\n";
}

pub fn ss_gpu_section_html() -> String {
    let cards: String = ss_gpu_card("GPU-00", "12GB", "NODE-01", "G0", "control/herdr", "15GiB/7.8G", "12", "12,288", "0.1", "0")
        + ss_gpu_card("GPU-01", "16GB", "NODE-02", "G0", "buildbox+gpu", "63GiB/32G", "2", "16,380", "0.0", "0")
        + ss_gpu_card("GPU-02", "16GB", "NODE-02", "G1", "buildbox+gpu", "63GiB/32G", "2", "16,380", "0.0", "0")
        + ss_gpu_card("GPU-03", "16GB", "NODE-03", "G0", "llm+replica", "31GiB/16G", "2", "16,380", "0.0", "0")
        + ss_gpu_card("GPU-04", "16GB", "NODE-03", "G1", "llm+replica", "31GiB/16G", "2", "16,380", "0.0", "0");
    return "      <section class=\"page-stage\" id=\"gpu-telemetry\" aria-label=\"5-GPU Hardware Telemetry\">\n"
        + "        <div class=\"section-hdr\" style=\"margin-top:0;\"><span>-- [1] LIVE 5-GPU HARDWARE TELEMETRY (GPU-00..GPU-04 // ANONYMIZED NODES) --</span><span class=\"term-badge term-badge-green\">[ 3 NODES · 5 GPUs · 76 GB TOTAL VRAM · 100% ONLINE ]</span></div>\n"
        + "        <div class=\"panel\">\n"
        + "          <div style=\"font-size:11.5px; color:var(--text-secondary); margin-bottom:12px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;\"><span>Live VRAM allocation, compute utilization, and local capability inference daemon (<code>ooaid</code>) state across all 5 hardware GPUs (anonymized node IDs, zero hostnames/IPs).</span><span><strong>VRAM Reserve: 20 MB Active / 77,808 MB Capacity</strong></span></div>\n"
        + "          <div class=\"gpu-grid\">\n" + cards + "          </div>\n"
        + "        </div>\n"
        + "      </section>\n";
}

pub fn ss_quota_row(key: String, r_pct: String, u_pct: String, r_sec: String, tps: String, cap: String, col: String, nm: String, cyc: String, tps_lbl: String, seg: String, r_tok: String, u_tok: String, tot_tok: String, st: String, rst: String) -> String {
    return "      <div class=\"quota-row\" data-name=\"" + key + "\" data-rem-pct=\"" + r_pct + "\" data-used-pct=\"" + u_pct + "\" data-reset-sec=\"" + r_sec + "\" data-tps=\"" + tps + "\" data-capacity=\"" + cap + "\">\n"
        + "        <div class=\"quota-hdr\"><div><span class=\"quota-agent\" style=\"color:" + col + "\">■ " + nm + "</span><span class=\"quota-cycle\">" + cyc + "</span><span class=\"term-badge term-badge-cyan\">[ ⚡ " + tps_lbl + " ]</span></div><div class=\"quota-nums\"><strong style=\"color:var(--phosphor);\">" + r_pct + "% LEFT</strong> <span class=\"seg-inline\" style=\"color:" + col + ";\">[" + seg + "]</span> (" + r_tok + " rem / " + u_tok + " used of ~" + tot_tok + ") · <span class=\"muted\">" + u_pct + "% Used</span></div></div>\n"
        + "        <div class=\"quota-bar-track\" title=\"90% Soft Throttle | 95% Hard Cutoff\"><div class=\"quota-bar-used\" style=\"width:" + u_pct + "%; background:" + col + ";\"></div><div class=\"quota-bar-rem\" style=\"width:" + r_pct + "%;\"></div><div class=\"quota-throttle-line\" style=\"left:90%;\" title=\"90% Soft Throttle (10% Left: 1-Pane Only)\"></div><div class=\"quota-target-line\" style=\"left:95%;\" title=\"95% Hard Dispatch Cutoff / >=5% Reserve Floor\"></div></div>\n"
        + "        <div class=\"quota-sub\"><span style=\"color:var(--hot);\">" + st + "</span><span>" + rst + "</span></div>\n"
        + "      </div>\n";
}

pub fn ss_quota_section_html() -> String {
    let rows: String = ss_quota_row("grok", "0", "100", "112000", "0.0", "10000000", "#ffb000", "grok // Grok-4", "[ WEEKLY CYCLE ]", "0.0 tok/s LIVE (184.2 tok/s burst)", "░░░░░░░░░░░░░░░░", "0", "10.0M", "10.0M", "[ STANDBY // WEEKLY QUOTA CONSUMED · HANDED OFF TO SWE-2 MAX ]", "Resets Nov 6 01:17 UTC (Weekly Window)")
        + ss_quota_row("vibe", "10", "90", "2267000", "191.5", "50000000", "#bd93f9", "vibe // GLM-5.3 [high] (wF:p1)", "[ MONTHLY CYCLE ]", "191.5 tok/s LIVE (ctx 353k/800k)", "██░░░░░░░░░░░░░░", "5.0M", "45.0M", "50.0M", "[ THROTTLE: 1-PANE ONLY // +5% TO 95% CUTOFF · >=5% RESERVE FLOOR ]", "Resets Dec 1 00:00 UTC · ctx 353k/800k")
        + ss_quota_row("mcode", "88", "12", "7200", "421.1", "5000000", "#00e5ff", "mcode // M3.1-Flash", "[ 5H ROLLING CYCLE ]", "421.1 tok/s LIVE (421.1 tok/s out · 1,256.9 tok/s burst)", "██████████████░░", "4.4M", "600k", "5.0M", "[ ACTIVE // +78% TO 90% THROTTLE (95% CAP) ]", "Resets in 2h 00m (10:00 / 15:00 HST cycle)")
        + ss_quota_row("agy", "98", "2", "18000", "186.4", "20000000", "#ff79c6", "agy // Gemini 4 Argon (Root w9)", "[ ROLLING SESSION CYCLE ]", "186.4 tok/s LIVE (8 subagents)", "███████████████░", "19.6M", "400k", "20.0M", "[ ACTIVE WATCHDOG // +88% TO 90% SOFT THROTTLE · >=5% RESERVE FLOOR ]", "Continuous Rolling Window · Root w9 Orchestrator")
        + ss_quota_row("devin", "100", "0", "2246400", "2442.8", "100000000", "#50fa7b", "devin // SWE-2 Max + SWE-2 Flash Max (9/9 Panes Active)", "[ FREE PROMO THRU NOV 30 ]", "2,442.8 tok/s LIVE (24h burn: 23.4M+ · 7d: 47.2M)", "████████████████", "Uncapped", "23.4M+ today", "Free Promo", "[ FREE UNLIMITED PROMO THRU NOV 30 // SWE-2 MAX + SWE-2 FLASH MAX (3X SPEED) ]", "Pro · 100% remaining (resets 22:00 HST / 08:00 UTC) · Free Promo Thru Nov 30 · 24h Burn: 23.4M+ · 7d: 47.2M (9 Active)");
    return "      <section class=\"page-stage\" id=\"quota-graph\" aria-label=\"Token Quota Remaining Per Reset Cycle\">\n"
        + "        <div class=\"section-hdr\" style=\"margin-top:0;\"><span>-- [02] TOKEN QUOTA REMAINING PER RESET CYCLE &amp; PER-AGENT TOK/SEC --</span><span class=\"term-badge term-badge-cyan\">[ ⚡ TOTAL LIVE FLEET: 3,241.8 TOK/SEC · TARGET: 90% THROTTLE / 95% CUTOFF (&ge;5% FLOOR) ]</span></div>\n"
        + "        <div class=\"panel\">\n"
        + "          <div style=\"font-size:11.5px; color:var(--text-secondary); margin-bottom:10px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;\"><span>Segmented CRT bars show <strong>% Consumed</strong> vs. <strong>% Tokens Left in Cycle</strong>, amber marker = <strong>90% Soft Throttle</strong>, red marker = <strong>95% Hard Cutoff</strong>.</span><span><strong>19 Herdr Panes (Root w9 + 18 Layer/Project Panes · 9 Devin Active)</strong></span></div>\n"
        + "          <div class=\"sort-bar\" role=\"toolbar\" aria-label=\"Sort Token Quota Remaining Graph\">\n"
        + "            <span class=\"sort-label\">// SORT BY:</span>\n"
        + "            <button type=\"button\" class=\"sort-btn active\" data-sort=\"rem-pct\">[ SORT: % LEFT (DEFAULT) ]</button>\n"
        + "            <button type=\"button\" class=\"sort-btn\" data-sort=\"reset-sec\">[ SORT: NEXT RESET ]</button>\n"
        + "            <button type=\"button\" class=\"sort-btn\" data-sort=\"tps\">[ SORT: LIVE TOK/SEC ]</button>\n"
        + "            <button type=\"button\" class=\"sort-btn\" data-sort=\"capacity\">[ SORT: CYCLE CAPACITY ]</button>\n"
        + "            <button type=\"button\" class=\"sort-btn\" data-sort=\"name\">[ SORT: AGENT NAME ]</button>\n"
        + "          </div>\n"
        + "          <div id=\"quota-list\">\n" + rows + "          </div>\n"
        + "        </div>\n"
        + "      </section>\n";
}
