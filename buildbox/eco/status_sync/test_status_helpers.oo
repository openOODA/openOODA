// # Test Status Helpers - Pure .oo HTML/CSS Helpers For Status Verification
//
// Logline: Provides substring counting, CSS rule extraction, and segmented bar checks for the 7-test status verifier.
//
// Setup: Pure functions over HTML and CSS strings. No capabilities required.
//
// Beats:
//   1. Count occurrences of a needle string in a document.
//   2. Extract CSS declarations for a given selector.
//   3. Extract between start and end delimiters.
//   4. Check segmented CRT bars inside .gpu-card blocks.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "text/lines.oo";

pub fn ts_count_occ(doc: String, needle: String) -> Int {
    let nlen: Int = bytes_len(needle);
    if nlen == 0 { return 0; }
    let mut rest: String = doc;
    let mut count: Int = 0;
    while true {
        let idx: Int = str_index_of(rest, needle);
        if idx < 0 { break; }
        count = count + 1;
        rest = byte_slice(rest, idx + nlen, bytes_len(rest));
    }
    return count;
}

pub fn ts_extract_between(doc: String, open_s: String, close_s: String) -> String {
    let i1: Int = str_index_of(doc, open_s);
    if i1 < 0 { return ""; }
    let rest: String = byte_slice(doc, i1 + bytes_len(open_s), bytes_len(doc));
    let i2: Int = str_index_of(rest, close_s);
    if i2 < 0 { return ""; }
    return byte_slice(rest, 0, i2);
}

pub fn ts_extract_css_rule(css: String, selector: String) -> String {
    let mut rest: String = css;
    let mut out: String = "";
    let slen: Int = bytes_len(selector);
    while true {
        let idx: Int = str_index_of(rest, selector);
        if idx < 0 { break; }
        let after: String = byte_slice(rest, idx + slen, bytes_len(rest));
        let b_open: Int = str_index_of(after, "{");
        if b_open < 0 { break; }
        let mid: String = text_trim(byte_slice(after, 0, b_open));
        let after_brace: String = byte_slice(after, b_open + 1, bytes_len(after));
        let b_close: Int = str_index_of(after_brace, "}");
        if b_close < 0 { break; }
        if mid == "" {
            out = out + "\n" + byte_slice(after_brace, 0, b_close);
        }
        rest = byte_slice(after_brace, b_close + 1, bytes_len(after_brace));
    }
    return out;
}

pub fn ts_check_gpu_seg_bars(html: String) -> Bool {
    let marker: String = "<span class=\"seg-bar\"";
    let mlen: Int = bytes_len(marker);
    let mut rest: String = html;
    let mut cnt: Int = 0;
    while true {
        let idx: Int = str_index_of(rest, marker);
        if idx < 0 { break; }
        let after: String = byte_slice(rest, idx + mlen, bytes_len(rest));
        let gt: Int = str_index_of(after, ">");
        if gt < 0 { break; }
        let body: String = byte_slice(after, gt + 1, bytes_len(after));
        let lt: Int = str_index_of(body, "</span>");
        if lt < 0 { break; }
        let bar: String = text_trim(byte_slice(body, 0, lt));
        cnt = cnt + 1;
        if chars_len(bar) > 10 { return false; }
        rest = byte_slice(body, lt + 7, bytes_len(body));
    }
    return cnt == 10;
}

pub fn ts_has_privacy_leak(html: String) -> String {
    let low: String = to_lowercase(html);
    let pfx: String = "100.";
    let mut bad: List[String] = list_new();
    bad = list_push(list_push(list_push(list_push(bad, pfx + "102."), pfx + "88."), pfx + "66."), "zebes");
    bad = list_push(list_push(list_push(list_push(bad, "ringmaster"), "starjammer"), "11435"), "/home/" + "ubermetroid");
    bad = list_push(list_push(list_push(bad, "~04:00"), "04:30"), "$");
    let mut i: Int = 0;
    while i < list_len(bad) {
        let tok: String = list_get(bad, i);
        i = i + 1;
        if str_contains(low, tok) { return tok; }
    }
    let cleaned: String = str_replace(low, "spotlight-canvas", "");
    if str_contains(cleaned, "spotlight") { return "spotlight"; }
    return "";
}
