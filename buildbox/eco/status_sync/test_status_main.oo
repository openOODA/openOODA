// # Test Status Main - Standalone Entry Point For /Projects/openOODA/status/bin/test_status
//
// Logline: Invokes ts_verify_status_dir on /Projects/openOODA/status (or custom path) so test_status.oo stays importable by sync_status.oo without duplicate main symbols.
//
// Setup: Uses FsReadCap to read /Projects/openOODA/status/index.html.
//
// Beats:
//   1. Resolve target status directory from CLI arguments or default to /Projects/openOODA/status.
//   2. Delegate to ts_verify_status_dir(fs_r, sdir).

import "eco/status_sync/test_status.oo";

pub fn main(_sys: &ProcessCap, fs_r: &FsReadCap, _fs_w: &FsWriteCap, _env: &EnvCap, args: List[String]) -> Int {
    let sdir: String = if list_len(args) > 0 && list_get(args, 0) != "" {
        list_get(args, 0)
    } else {
        "/Projects/openOODA/status"
    };
    return ts_verify_status_dir(fs_r, sdir);
}
