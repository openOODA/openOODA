// # Eco Sync Docs - Organization Profile README & openooda.org Verifier
//
// Logline: Verifies and syncs .github/profile/README.md across all 5 organizations and runs the openooda.org static and compiler test suites in pure .oo.
//
// Setup: Needs ProcessCap for node/oodac/git and FsReadCap to inspect /Projects/openOODA*.
//
// Beats:
//   1. Audit .github/profile/README.md across openOODA, openOODA-kernel, openOODA-OS, openOODA-DE, and openOODA-tools.
//   2. Optionally commit and push profile updates when --push is passed.
//   3. Run all 5 openooda.org static test suites and oodac check on website .oo anchors.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";

fn sync_verify_profile(fs_r: &FsReadCap, org: String) -> Bool {
    let org_dir: String = "/Projects/" + org;
    let prof_path: String = org_dir + "/.github/profile/README.md";
    if !path_exists(fs_r, prof_path) {
        println("  FAIL: missing " + prof_path);
        return false;
    }
    let r: Result[String, String] = fs_read_file(fs_r, prof_path);
    if r.is_err() || chars_len(r.val) < 200 {
        println("  FAIL: empty or unreadable " + prof_path);
        return false;
    }
    if org == "openOODA" || org == "openOODA-tools" {
        println("  PASS: " + org + "/.github/profile/README.md verified (" + int_to_str(chars_len(r.val)) + " chars)");
        return true;
    }
    let entries: List[String] = fs_read_dir(fs_r, org_dir);
    let mut count: Int = 0;
    let mut missing: Int = 0;
    let mut i: Int = 0;
    while i < list_len(entries) {
        let repo: String = list_get(entries, i);
        i = i + 1;
        if repo == ".github" || !path_exists(fs_r, org_dir + "/" + repo + "/.git") { continue; }
        count = count + 1;
        if !str_contains(r.val, "https://github.com/" + org + "/" + repo) {
            println("  WARN: " + org + " profile missing link for " + repo);
            missing = missing + 1;
        }
    }
    if missing == 0 {
        println("  PASS: " + org + "/.github/profile/README.md lists all " + int_to_str(count) + "/" + int_to_str(count) +
            " repositories");
        return true;
    }
    if (org == "openOODA-cloud" || org == "openOODA-agents") && count < 16 {
        println("  INFO: " + org + " build in progress (" + int_to_str(count) + "/16 repos created)");
        return true;
    }
    return false;
}

fn sync_push_org_profile(sys: &ProcessCap, org: String) -> Bool {
    let gh_dir: String = "/Projects/" + org + "/.github";
    let st: Result[String, String] = sys_exec(sys, "git", "-C", gh_dir, "status", "--porcelain");
    if st.is_err() || text_trim(st.val) == "" { return true; }
    let _a: Result[String, String] = sys_exec(sys, "git", "-C", gh_dir, "add", "profile/README.md");
    let _c: Result[String, String] = sys_exec(sys, "git", "-C", gh_dir, "commit", "-q", "-m",
        "docs(profile): sync organization profile README");
    let _p1: Result[String, String] = sys_exec(sys, "git", "-C", gh_dir, "push", "-q", "origin", "HEAD:refs/heads/main");
    let _p2: Result[String, String] = sys_exec(sys, "git", "-C", gh_dir, "push", "-q", "origin", "HEAD:refs/heads/master");
    return true;
}

fn sync_verify_website(sys: &ProcessCap, fs_r: &FsReadCap) -> Bool {
    let web_dir: String = "/Projects/openOODA/website";
    let tests: List[String] = list_push(list_push(list_push(list_push(list_push(list_new(),
        "tests/test_copy.js"), "tests/test_layout.js"), "tests/test_links.js"), "tests/test_shim.js"), "tests/test_hooks.js");
    let mut i: Int = 0;
    while i < list_len(tests) {
        let t: String = list_get(tests, i);
        i = i + 1;
        let a: List[String] = list_push(list_push(list_new(), "-c"), "cd " + web_dir + " && node " + t);
        let r: Result[Int, String] = sys_exec_wait(sys, "bash", a);
        if r.is_err() || r.val != 0 { println("  FAIL: website test " + t);
        return false; }
    }
    let oodac: String = "/Projects/openOODA-core/oodac/bin/oodac";
    let walked: List[String] = fs_walk(fs_r, web_dir);
    let mut j: Int = 0;
    while j < list_len(walked) {
        let p: String = list_get(walked, j);
        j = j + 1;
        if !str_ends_with(p, ".oo") || str_contains(p, "/.git/") { continue; }
        let ca: List[String] = list_push(list_push(list_new(), "-c"), "cd " + web_dir +
            " && OODA_NO_JAIL=1 OODA_FS_READDIR=/Projects OODA_FS_WRITEDIR=/Projects:/tmp " + oodac + " check " + p +
                " >/dev/null");
        let cr: Result[Int, String] = sys_exec_wait(sys, "bash", ca);
        if cr.is_err() || cr.val != 0 { println("  FAIL: oodac check failed on " + p);
        return false; }
    }
    println("  PASS: oodac check holds on all website .oo anchor files");
    return true;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let do_push: Bool = list_len(args) > 0 && list_get(args, 0) == "--push";
    println("== [eco-sync-docs] verifying organization profile READMEs ==");
    let mut ok: Bool = true;
    let orgs: List[String] = list_push(list_push(list_push(list_push(list_push(list_push(list_push(list_push(list_push(list_new(
        ),
        "openOODA"), "openOODA-core"), "openOODA-kernel"), "openOODA-OS"), "openOODA-DE"), "openOODA-tools"), "openOODA-apps"),
            "openOODA-cloud"), "openOODA-agents");
    let mut i: Int = 0;
    while i < list_len(orgs) {
        let org: String = list_get(orgs, i);
        i = i + 1;
        if (org == "openOODA-apps" || org == "openOODA-cloud" || org == "openOODA-agents") && !path_exists(fs_r, "/Projects/" +
            org + "/.github/profile/README.md") { continue; }
        if !sync_verify_profile(fs_r, org) { ok = false; }
        if do_push { let _p: Bool = sync_push_org_profile(sys, org); }
    }
    println("== [eco-sync-docs] verifying /Projects/openOODA/website (openooda.org) ==");
    if !sync_verify_website(sys, fs_r) { ok = false; }
    if !ok { return 1; }
    println("== [eco-sync-docs] all organization profiles and openooda.org verified cleanly ==");
    return 0;
}
