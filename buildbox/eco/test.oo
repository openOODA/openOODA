// # Eco Self Test - Verifies The Pure .oo Ecosystem Helpers And Manifest Readers
//
// Logline: Runs positive and negative assertions over the ecosystem layer, category, integer, padding, and manifest helpers.
//
// Setup: Needs FsReadCap to read a known ooda.pkg manifest when present.
//
// Beats:
//   1. Check that eco_org_layer maps all 6 organizations and rejects unknown orgs.
//   2. Check that eco_valid_category accepts the 12+2 canonical category codes and rejects invalid codes.
//   3. Check that eco_parse_uint, eco_pad_left, and eco_pad_right handle normal and boundary inputs.
//   4. Check that eco_pkg_get reads real ooda.pkg fields and fails closed on missing files.

import "oostd/core/text/num_buffer.oo";
import "eco/anchor.oo";
import "eco/panes/quota.oo";

fn eco_expect_eq(name: String, got: String, want: String, fails: &mut Int) -> Int {
    if got == want {
        println("PASS\t" + name);
        return 0;
    }
    println("FAIL\t" + name + "\tgot " + got + " want " + want);
    *fails = *fails + 1;
    return 0;
}

fn eco_test_taxonomy(fails: &mut Int) -> Int {
    let _a: Int = eco_expect_eq("eco_anchor_ready", if eco_anchor_ready() { "true" } else { "false" }, "true", fails);
    let _b: Int = eco_expect_eq("eco_layer_kernel", eco_org_layer("openOODA-kernel"), "kernel", fails);
    let _c: Int = eco_expect_eq("eco_layer_os", eco_org_layer("openOODA-OS"), "os", fails);
    let _d: Int = eco_expect_eq("eco_layer_de", eco_org_layer("openOODA-DE"), "de", fails);
    let _e: Int = eco_expect_eq("eco_layer_tools", eco_org_layer("openOODA-tools"), "tools", fails);
    let _f: Int = eco_expect_eq("eco_layer_core", eco_org_layer("openOODA"), "core", fails);
    let _f0: Int = eco_expect_eq("eco_layer_openooda_core", eco_org_layer("openOODA-core"), "core", fails);
    let _f1: Int = eco_expect_eq("eco_layer_apps", eco_org_layer("openOODA-apps"), "apps", fails);
    let _f2: Int = eco_expect_eq("eco_layer_cloud", eco_org_layer("openOODA-cloud"), "cloud", fails);
    let _f3: Int = eco_expect_eq("eco_layer_agents", eco_org_layer("openOODA-agents"), "agents", fails);
    let _g: Int = eco_expect_eq("eco_layer_unknown", eco_org_layer("openOODA-nope"), "", fails);
    let _h: Int = eco_expect_eq("eco_cat_valid_hw", if eco_valid_category("HW") { "ok" } else { "bad" }, "ok", fails);
    let _i: Int = eco_expect_eq("eco_cat_valid_ui", if eco_valid_category("UI") { "ok" } else { "bad" }, "ok", fails);
    let _j: Int = eco_expect_eq("eco_cat_invalid_empty", if eco_valid_category("") { "ok" } else { "bad" }, "bad", fails);
    let _k: Int = eco_expect_eq("eco_cat_invalid_sub", if eco_valid_category("H") { "ok" } else { "bad" }, "bad", fails);
    let _l: Int = eco_expect_eq("eco_cat_invalid_lower", if eco_valid_category("sh") { "ok" } else { "bad" }, "bad", fails);
    return 0;
}

fn eco_test_primitives(fs_r: &FsReadCap, fails: &mut Int) -> Int {
    let _a: Int = eco_expect_eq("eco_parse_uint_pct", int_to_str(eco_parse_uint("19%)")), "19", fails);
    let _b: Int = eco_expect_eq("eco_parse_uint_zero", int_to_str(eco_parse_uint("0% rem")), "0", fails);
    let _c: Int = eco_expect_eq("eco_parse_uint_none", int_to_str(eco_parse_uint("no digits")), "-1", fails);
    let _d: Int = eco_expect_eq("eco_pad_right", eco_pad_right("ab", 4), "ab  ", fails);
    let _e: Int = eco_expect_eq("eco_pad_left", eco_pad_left("16", 4), "  16", fails);
    let _f: Int = eco_expect_eq("eco_pkg_missing", eco_pkg_get(fs_r, "/nonexistent/ooda.pkg", "version"), "", fails);
    let pkg: String = "/Projects/openOODA-kernel/ookernel-boot/ooda.pkg";
    if path_exists(fs_r, pkg) {
        let _g: Int = eco_expect_eq("eco_pkg_boot_layer", eco_pkg_get(fs_r, pkg, "layer"), "kernel", fails);
        let bver: String = eco_pkg_get(fs_r, pkg, "version");
        let bver_ok: String = if (str_starts_with(bver, "0.") || str_starts_with(bver, "1.")) && bver != "0.1.0" &&
            bver != "0.2.0" { "ok" } else { bver };
        let _h: Int = eco_expect_eq("eco_pkg_boot_ver", bver_ok, "ok", fails);
        let bpages: Int = eco_count_oo_pages(fs_r, "/Projects/openOODA-kernel/ookernel-boot");
        let _hp: Int = eco_expect_eq("eco_count_pages_boot", if bpages >= 6 { "ok" } else { "low" }, "ok", fails);
    }
    let _i: Int = eco_expect_eq("eco_quota_wF_vibe", eco_parse_pane_quota("wF:p1", "114k/800k tokens (14%)"),
        "11|Mo 89% (11% rem, rst Dec1) / Ctx 86%", fails);
    let _i2: Int = eco_expect_eq("eco_quota_mcode_live", eco_pane_quota_session("M3.1-Flash · Context 512K", 33),
        "33|5h 67% (33% rem, rst 10:00) / Ctx 100%", fails);
    let _j: Int = eco_expect_eq("eco_quota_wJ_active", eco_parse_pane_quota("wJ:p1",
        "Running 1h9min47s 273 tok/s | 5h 0% | Context 31% left"), "100|5h 0% (100% rem, rst 5h) / Ctx 31%", fails);
    let _k: Int = eco_expect_eq("eco_quota_wJ_idle0", eco_parse_pane_quota("wJ:p1", "Idle | 5h 0% | Context 31% left"),
        "100|5h 0% (100% rem, rst 5h) / Ctx 31%", fails);
    let hist: String = "Running old sweep\n1\n2\n3\n4\n5\n6\n7\n8\nIdle | 5h 0% | Context 31% left";
    let _l: Int = eco_expect_eq("eco_quota_wJ_hist", eco_parse_pane_quota("wJ:p1", hist),
        "100|5h 0% (100% rem, rst 5h) / Ctx 31%", fails);
    let jlog: String = "{\"creditUsagePercent\":7.0}\n{\"creditUsagePercent\":17.0}";
    let _m: Int = eco_expect_eq("eco_grok_weekly_pct", int_to_str(eco_grok_weekly_pct(jlog)), "17", fails);
    let _n: Int = eco_expect_eq("eco_quota_wH_wk", eco_pane_quota_wh_full("12s 40k [stop]", 17),
        "83|Wk 17% (83% rem, rst Nov6, ->95%:78%) / ~40k", fails);
    let _o: Int = eco_expect_eq("eco_pace_target_83", eco_parse_pane_quota("pace", "83"), "+73% to 90% (95% cap)", fails);
    let _o2: Int = eco_expect_eq("eco_pace_target_10", eco_parse_pane_quota("pace", "10"), "THROTTLE: 1-pane only (+5% to 95%)",
        fails);
    let _p: Int = eco_expect_eq("eco_pace_target_5", eco_parse_pane_quota("pace", "5"), "AT_95%_CUTOFF (hold >=5% reserve)",
        fails);
    let _q1: Int = eco_expect_eq("eco_quota_health_90", eco_pane_quota_health(10, "working"), "THROTTLE (1-pane max, 90% soft)",
        fails);
    let _q2: Int = eco_expect_eq("eco_quota_health_95", eco_pane_quota_health(4, "idle"), "HOLD (>=5% reserve floor)", fails);
    let _q3: Int = eco_expect_eq("eco_quota_devin_promo", eco_parse_pane_quota("wM:p1",
        "SWE-2 Max | bypass   Context: 171k / 262k tokens (65%)"), "100|FREE PROMO Nov30 (23.0M+ burn) / Ctx 35%", fails);
    let _q4: Int = eco_expect_eq("eco_quota_devin_flash_max", eco_parse_pane_quota("wJ:p3",
        "SWE-2 Flash Max | bypass   Context: 75k / 262k tokens (28%)"), "100|FREE PROMO Nov30 (23.0M+ burn) / Ctx 72%", fails);
    let _q5: Int = eco_expect_eq("eco_quota_wQ_p1", eco_parse_pane_quota("wQ:p1",
        "SWE-2 Max | bypass   Context: 93k / 262k tokens (35%)"), "100|FREE PROMO Nov30 (23.0M+ burn) / Ctx 65%", fails);
    let _q6: Int = eco_expect_eq("eco_quota_wQ_p2", eco_parse_pane_quota("wQ:p2",
        "SWE-2 Flash Max | bypass   Context: 59k / 262k tokens (22%)"), "100|FREE PROMO Nov30 (23.0M+ burn) / Ctx 78%", fails);
    let _q7: Int = eco_expect_eq("eco_quota_wQ_banner", eco_parse_pane_quota("wQ:p1",
        "Devin CLI v3000.11.234\nPro | 100% remaining (resets in 4h 44m)\nSWE-2 Max | bypass"),
            "100|FREE PROMO Nov30 (23.0M+ burn) / Pro 100% rem", fails);
    return 0;
}

pub fn eco_test_run(fs_r: &FsReadCap) -> Int {
    let mut fails: Int = 0;
    let _t: Int = eco_test_taxonomy(&mut fails);
    let _p: Int = eco_test_primitives(fs_r, &mut fails);
    if fails > 0 {
        println("ECO TEST FAIL n=" + int_to_str(fails));
        return 1;
    }
    println("ECO TEST PASS");
    return 0;
}
