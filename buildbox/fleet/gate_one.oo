// # Fleet Gate One - The Verdict Line Of One Repo Checkout
//
// Logline: Runs the fleet gate against one repo checkout and prints the verdict line of that checkout.
//
// Setup: Needs ProcessCap to run make and the tool, and FsReadCap to read the checkout.
//
// Beats:
//   1. Read the build target and the workflow of the checkout.
//   2. Run every check against the checkout.
//   3. Print the verdict line.
//
// The line is the one the loop writes to the queue. A checkout that does not
// build has to produce a BUILD_FAIL line and never a silent pass, so the
// acceptance test of the buildbox reads this line.

import "fleet/gate.oo";
import "fleet/manifest.oo";

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    if list_len(args) < 1 {
        println("usage: gate_one <repo-dir> [repo-name]");
        return 2;
    }
    let dir: String = list_get(args, 0);
    let repo: String = if list_len(args) > 1 { list_get(args, 1) } else { "repo" };
    let has_build: Bool = fleet_manifest_has_build_target(fs_r, dir);
    let has_ci: Bool = fleet_manifest_ci_present(fs_r, dir);
    let line: String = fleet_gate_repo(sys, fs_r, fs_w, repo, "main", "local", dir, has_build, has_ci, "acceptance");
    println(line);
    return 0;
}
