// # Fleet Manifest - The Single Generated Inventory Of The Tool Fleet
//
// Logline: Derives the default branch, head commit, build capability, CI state, and class of every fleet repo.
//
// Setup: Needs ProcessCap for git and FsReadCap to inspect a checkout.
//
// Beats:
//   1. Probe the remote default branch and the head commit with git ls-remote.
//   2. Detect whether a checkout declares a build target.
//   3. Count the modules and detect the CI workflow of a checkout.
//   4. Classify a repo by module count and audit priority.
//   5. Emit one manifest record per repo.

import "oostd/core/text/num_buffer.oo";
import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";

// The remote base of a repository. The base is a run setting so the gate can
// be pointed at a mirror or at a scratch origin during acceptance.
pub fn fleet_remote_url(base: String, org: String, name: String) -> String {
    return base + "/" + org + "/" + name + ".git";
}

pub fn fleet_cut_at_tab(line: String) -> String {
    let idx: Int = str_index_of(line, "\t");
    if idx < 0 { return text_trim(line); }
    return text_trim(str_slice(line, 0, idx));
}

// Probe the remote and return "default_branch|head_sha". An empty string means
// the remote could not be read. The branch is never hardcoded, which is what
// lets one fleet serve main branches and another serve master branches.
pub fn fleet_remote_probe(sys: &ProcessCap, base: String, org: String, name: String) -> String {
    let url: String = fleet_remote_url(base, org, name);
    let r: Result[String, String] = sys_exec(sys, "git", "ls-remote", "--symref", url, "HEAD");
    if r.is_err() { return ""; }
    let lines: List[String] = text_split_lines(r.val);
    let mut branch: String = "";
    let mut sha: String = "";
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if branch == "" && str_starts_with(l, "ref: refs/heads/") {
            branch = fleet_cut_at_tab(str_slice(l, 16, chars_len(l)));
        } else if sha == "" && str_starts_with(l, "refs/heads/") {
            let parts: List[String] = text_split_lines(str_replace(l, "\t", "\n"));
            if list_len(parts) > 0 { sha = text_trim(list_get(parts, 0)); }
        }
        i = i + 1;
    }
    if branch == "" { return ""; }
    return branch + "|" + sha;
}

// A repo declares a build target when its Makefile names a build rule or calls
// the compiler directly.
pub fn fleet_manifest_has_build_target(fs_r: &FsReadCap, dir: String) -> Bool {
    let mk: String = dir + "/Makefile";
    if !path_exists(fs_r, mk) { return false; }
    let r: Result[String, String] = fs_read_file(fs_r, mk);
    if r.is_err() { return false; }
    if str_contains(r.val, "oodac build") { return true; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_starts_with(l, "build:") { return true; }
        i = i + 1;
    }
    return false;
}

pub fn fleet_manifest_module_count(fs_r: &FsReadCap, dir: String) -> Int {
    let all: List[String] = fs_walk(fs_r, dir);
    let mut n: Int = 0;
    let mut i: Int = 0;
    while i < list_len(all) {
        if str_ends_with(list_get(all, i), ".oo") { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn fleet_manifest_ci_present(fs_r: &FsReadCap, dir: String) -> Bool {
    return path_exists(fs_r, dir + "/.github/workflows/ci.yml");
}

// Classify a repo. The audit priority order from RFC 0010 section 2.3 decides
// the first field. The module count decides whether the tool is implemented.
pub fn fleet_manifest_classify(repo: String, modules: Int) -> String {
    let mut priority: String = "rest";
    if str_contains(repo, "oowget") || str_contains(repo, "ootunnel") || str_contains(repo, "oovault") { priority = "network"; }
    else if str_contains(repo, "oobackup") || str_contains(repo, "oofetch") || str_contains(repo, "ooenv") { priority = "fs"; }
    else if str_contains(repo, "ooguard") || str_contains(repo, "oohistory") { priority = "fs"; }
    let mut kind: String = "stub";
    if modules >= 10 { kind = "real"; }
    return kind + "-" + priority;
}

pub fn fleet_manifest_record(repo: String, branch: String, sha: String, modules: Int, has_build: Bool, ci: Bool,
    path: String) -> String {
    return "{\"repo\":\"" + repo + "\",\"default_branch\":\"" + branch + "\",\"head_sha\":\"" + sha
        + "\",\"module_count\":" + int_to_str(modules)
        + ",\"has_build_target\":" + (if has_build { "true" } else { "false" })
        + ",\"ci_present\":" + (if ci { "true" } else { "false" })
        + ",\"tier\":\"" + fleet_manifest_classify(repo, modules)
        + "\",\"local_path\":\"" + path + "\"}";
}
