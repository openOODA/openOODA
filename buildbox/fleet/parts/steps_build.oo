// # Fleet Gate Steps Build - The Build Target Of One Repo
//
// Logline: Resolves the path of the built binary of one repo and names the make targets that the Makefile of that repo defines.
//
// Setup: Needs FsReadCap for the Makefile of the repo.
//
// Beats:
//   1. Resolve the built binary path across dist/<repo> (tools/core) and bin/<repo> (kernel/OS/DE).
//   2. Check whether the repo Makefile defines a specific target such as det:.

import "oostd/fs/os/fs.oo";
import "text/lines.oo";

// Resolve the built binary path across dist/<repo> (tools/core) and bin/<repo> (kernel/OS/DE).
pub fn fleet_resolve_bin(fs_r: &FsReadCap, dir: String, repo: String) -> String {
    let dpath: String = dir + "/dist/" + repo;
    if path_exists(fs_r, dpath) { return dpath; }
    let bpath: String = dir + "/bin/" + repo;
    if path_exists(fs_r, bpath) { return bpath; }
    return dpath;
}

// Check whether the repo Makefile defines a specific target such as det:.
pub fn fleet_has_make_target(fs_r: &FsReadCap, dir: String, target: String) -> Bool {
    let mk: String = dir + "/Makefile";
    if !path_exists(fs_r, mk) { return false; }
    let r: Result[String, String] = fs_read_file(fs_r, mk);
    if r.is_err() { return false; }
    let prefix: String = target + ":";
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_starts_with(l, prefix) { return true; }
        i = i + 1;
    }
    return false;
}
