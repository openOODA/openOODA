// # Fleet Verdict - The Fail Closed Result Vocabulary
//
// Logline: Defines the single verdict each fleet repo receives per gate run and the rules that decide what counts as a pass.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Map a verdict code to its name.
//   2. Report whether a verdict name is a pass.
//   3. Report whether a verdict name is a backlog state.
//   4. Map a verdict name back to its code.
//   5. Build the structured verdict line.

import "std/core/primitives/str.oo";

pub fn fleet_verdict(code: Int) -> String {
    if code == 0 { return "PASS"; }
    if code == 1 { return "BUILD_FAIL"; }
    if code == 2 { return "VERIFY_FAIL"; }
    if code == 3 { return "TEST_FAIL"; }
    if code == 4 { return "NO_BUILD_TARGET"; }
    if code == 5 { return "CI_MISSING"; }
    return "UNVERIFIABLE";
}

pub fn fleet_verdict_is_pass(name: String) -> Bool {
    return name == "PASS";
}

// A backlog state is neither a gate failure nor a tool success. It means the
// tool is not implemented and the repository must say so in public.
pub fn fleet_verdict_is_backlog(name: String) -> Bool {
    return name == "NO_BUILD_TARGET" || name == "CI_MISSING";
}

// The counts of one gate run. A repo that earns a pass, a repo that is still
// a backlog state, and a repo that fails the gate are three different things,
// so the run counts them apart and never reads a backlog state as a pass.
type FleetCounts = struct {
    passed: Int,
    backlog: Int,
    failed: Int
};

pub fn fleet_verdict_code(name: String) -> Int {
    if name == "PASS" { return 0; }
    if name == "BUILD_FAIL" { return 1; }
    if name == "VERIFY_FAIL" { return 2; }
    if name == "TEST_FAIL" { return 3; }
    if name == "NO_BUILD_TARGET" { return 4; }
    if name == "CI_MISSING" { return 5; }
    return 6;
}

// One line per repo per run. Fields are tab separated so a detail field that
// holds a space cannot break the record.
pub fn fleet_verdict_line(name: String, repo: String, branch: String, sha: String, detail: String, run_id: String) -> String {
    return name + "\t" + repo + "\t" + branch + "\t" + sha + "\t" + detail + "\t" + run_id;
}

// Read the verdict back out of a verdict line. The verdict is the first field.
pub fn fleet_verdict_line_verdict(line: String) -> String {
    let idx: Int = str_index_of(line, "\t");
    if idx <= 0 { return line; }
    return str_slice(line, 0, idx);
}
