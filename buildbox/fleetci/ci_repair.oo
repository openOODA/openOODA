// # Fleet CI Repair - Restores The Indentation Of A Workflow Of The Fleet
//
// Logline: Puts back the indentation that a sweep of the fleet took out of the workflow of the CI.
//
// Setup: Needs FsReadCap to read the text of the workflow.
//
// Beats:
//   1. Name the place where the indentation of a line ends.
//   2. Take the text of a line without its indentation.
//   3. Build the repaired text of a workflow out of a good one and a broken one.
//
// A sweep of the fleet joined the lines of the pages of the tools and took
// the indentation out of the workflows. A workflow whose steps carry no
// indentation is not a workflow at all: the runner of the CI reads it as a
// broken file, and the gate of a pull request never runs. The repair keeps
// every word of the broken text and gives every line the indentation of the
// line of a good workflow that stands at the same place.

import "std/core/primitives/str.oo";
import "text/lines.oo";

// The number of the spaces that stand at the front of a line.
pub fn fc_indent(line: String) -> Int {
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    while i < n {
        if str_char_at(line, i) != " " { break; }
        i = i + 1;
    }
    return i;
}

// The text of a line without the spaces that stand at its front.
pub fn fc_trim(line: String) -> String {
    let i: Int = fc_indent(line);
    return str_slice(line, i, chars_len(line));
}

// Build the repaired text of a workflow. Every line of the broken text keeps
// its words and takes the indentation of the line of the good text that
// stands at the same place. The answer is empty when the two texts hold a
// different number of lines, because then they are not the same workflow.
pub fn fc_repair(good: String, broken: String) -> String {
    let g: List[String] = text_split_lines(good);
    let b: List[String] = text_split_lines(broken);
    if list_len(g) != list_len(b) { return ""; }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(g) {
        let gl: String = list_get(g, i);
        let bl: String = list_get(b, i);
        let pad: String = str_slice(gl, 0, fc_indent(gl));
        out = list_push(out, pad + fc_trim(bl));
        i = i + 1;
    }
    return text_join_lines(out);
}
