// # Fleet Clean - Gives The History Of The Fleet One Author And No Trailer
//
// Logline: Rewrites the commits that every tool of the fleet gained so that every one of them is written by UberMetroid and carries no trailer of any other writer.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap and EnvCap.
//
// Beats:
//   1. Read the fleet root, the work directory and the table of the base refs from the environment.
//   2. Name the tools whose history carries a trailer of another writer.
//   3. Rewrite the history of one tool and land it.
//
// Usage: fleetclean <tool> <base-ref>...
//
// The base ref is the ref that the tool held before the release of the fleet,
// and the rewrite touches only the commits that the release brought. The
// commits below the base ref keep the author they had, because they were
// already on the branch of the tool and no release of the fleet moved them.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "fleetsync/sync_ref.oo";
import "fleetclean/clean_run.oo";

// Read one environment value with a fallback. The runtime only hands out the
// names that begin with OODA_ or OO_, so every setting of the tool is named
// that way.
fn fc_env(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && r.val != "" { return r.val; }
    return fallback;
}

// Clean the history of one tool. The answer is zero when the history landed.
pub fn fc_clean_tool(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, work: String, org: String,
    tool: String) -> Int {
    let repo: String = sy_clone(sys, fs_r, fs_w, cache, work, org, tool);
    if repo == "" { println(tool + " CLONE-FAIL");
    return 1; }
    let _f: Bool = sy_fetch(sys, fs_r, cache, repo);
    if !fc_clean_one(sys, fs_r, fs_w, cache, repo, tool) {
        println(tool + " CLEAN-FAIL");
        return 1;
    }
    return 0;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let fleet: String = fc_env(env, "OODA_FLEET_DIR", "/Projects/openOODA-tools");
    let work: String = fc_env(env, "OODA_CLEAN_WORK", "/home/ubermetroid/fleet-clean");
    let org: String = fc_env(env, "OODA_ORG", "openOODA-tools");
    let cache: String = fc_env(env, "OODA_FLEET_CACHE", "/var/lib/ooda-buildbox/cache/clean");
    let _mc: Result[Void, String] = fs_mkdir_p(fs_w, cache);
    let _mw: Result[Void, String] = fs_mkdir_p(fs_w, work);
    let mut rc: Int = 0;
    let mut i: Int = 0;
    while i < list_len(args) {
        let tool: String = list_get(args, i);
        i = i + 1;
        let r: Int = fc_clean_tool(sys, fs_r, fs_w, cache, work, org, tool);
        if r != 0 { rc = r; }
    }
    println("done tools=" + int_to_str(list_len(args)) + " failed=" + int_to_str(rc));
    return rc;
}
