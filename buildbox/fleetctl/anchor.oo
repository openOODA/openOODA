// # Fleet Control Anchor - The Landing And Release Suite Of The Fleet
//
// Logline: Re-exports the process helpers, the landing steps and the release steps of the fleet orchestrator.
//
// Setup: Pure module anchor under buildbox/fleetctl.
//
// Beats:
//   1. Export the process and text helpers that run a child command.
//   2. Export the landing steps that merge the contract and the repair.
//   3. Export the release steps that version, tag and publish a tool.

import "fleetctl/shell.oo";
import "fleetctl/branches.oo";
import "fleetctl/land.oo";
import "fleetctl/release.oo";
import "fleetctl/catalog.oo";
import "fleetctl/report.oo";
