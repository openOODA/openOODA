// # Fleet Branches - The Two Branches Of One Tool
//
// Logline: Reads the branches of a tool and reports whether the repair holds the contract.
//
// Setup: Needs ProcessCap for git and FsReadCap for the captured output.
//
// Beats:
//   1. Report whether the remote of a repository holds a branch.
//   2. Report whether the repair branch holds the tip of the contract branch.
//
// The contract branch carries the fleet contract and the repair branch carries
// the contract plus the repair. The repair can only be fast forwarded onto the
// contract when it holds the contract tip, so that check comes first.

import "fleetctl/shell.oo";

// Report whether the remote holds a branch.
pub fn fc_has_branch(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, branch: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "rev-parse");
    a = list_push(a, "--verify");
    a = list_push(a, "--quiet");
    a = list_push(a, "origin/" + branch);
    let _o: String = fc_git(sys, fs_r, cache, repo, a);
    return fc_code(fs_r, cache) == 0;
}

// Report whether the repair branch holds the tip of the contract branch.
pub fn fc_holds(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, base: String, head: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "merge-base");
    a = list_push(a, "--is-ancestor");
    a = list_push(a, "origin/" + base);
    a = list_push(a, "origin/" + head);
    let _o: String = fc_git(sys, fs_r, cache, repo, a);
    return fc_code(fs_r, cache) == 0;
}
