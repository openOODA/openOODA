// # Fleet Catalog - The Entry Of A Tool In The Catalog Of The Organization
//
// Logline: Sets the version and the description of a tool in the catalog of the organization and merges the change through a pull request.
//
// Setup: Needs ProcessCap for git and the GitHub CLI, FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Set the value of one string field of a line of JSON, in place.
//   2. Set the version of a tool in the catalog of the organization.
//   3. Merge the change of the catalog through a pull request.
//
// The catalog is a list of objects, one for each tool, and it is written by
// hand and by machine at the same time. The entry is therefore changed in
// place, on the lines that already carry it, so the rest of the file keeps
// the shape its author gave it.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetctl/land.oo";

// Read a file and trim the answer.
pub fn fc_read_trim(fs_r: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return ""; }
    return text_trim(r.val);
}

// Set the value of one string field of a line of JSON, in place.
pub fn fc_set_json_string(l: String, key: String, value: String) -> String {
    let k: String = "\"" + key + "\": \"";
    let p: Int = str_index_of(l, k);
    if p < 0 { return l; }
    let start: Int = p + chars_len(k);
    let q: Int = str_index_of(str_slice(l, start, chars_len(l)), "\"");
    if q < 0 { return l; }
    return str_slice(l, 0, start) + value + str_slice(l, start + q, chars_len(l));
}

// Set the version of a tool in the catalog of the organization.
pub fn fc_catalog_set(fs_r: &FsReadCap, fs_w: &FsWriteCap, path: String, tool: String, version: String, desc: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return false; }
    let lines: List[String] = text_split_lines(r.val);
    let needle: String = "\"id\": \"" + tool + "\"";
    let mut in_tool: Bool = false;
    let mut done: Bool = false;
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = list_get(lines, i);
        i = i + 1;
        if str_contains(l, needle) { in_tool = true; continue; }
        if in_tool && str_contains(l, "\"version\":") {
            out = list_push(out, fc_set_json_string(l, "version", "v" + version));
            in_tool = false;
            done = true;
            continue;
        }
        if in_tool && desc != "" && str_contains(l, "\"description\":") {
            out = list_push(out, fc_set_json_string(l, "description", desc));
            in_tool = false;
            continue;
        }
        out = list_push(out, l);
    }
    if !done { return false; }
    let w: Result[Void, String] = fs_write_file(fs_w, path, text_join_lines(out) + "\n");
    return w.is_ok();
}

// Put the new entry of a tool on a documentation branch and push the branch.
fn fc_catalog_branch(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, site: String, branch: String, tool: String, version: String, desc: String) -> Bool {
    let mut f: List[String] = list_new();
    f = list_push(f, "fetch");
    f = list_push(f, "-q");
    f = list_push(f, "origin");
    fc_git(sys, fs_r, cache, site, f);
    let mut b: List[String] = list_new();
    b = list_push(b, "checkout");
    b = list_push(b, "-q");
    b = list_push(b, "-B");
    b = list_push(b, branch);
    b = list_push(b, "origin/main");
    fc_git(sys, fs_r, cache, site, b);
    if !fc_catalog_set(fs_r, fs_w, site + "/data/tools.json", tool, version, desc) { return false; }
    let mut a: List[String] = list_new();
    a = list_push(a, "add");
    a = list_push(a, "-A");
    fc_git(sys, fs_r, cache, site, a);
    let mut c: List[String] = list_new();
    c = list_push(c, "commit");
    c = list_push(c, "-q");
    c = list_push(c, "-m");
    c = list_push(c, "docs(catalog): the entry of " + tool);
    fc_git(sys, fs_r, cache, site, c);
    let mut p: List[String] = list_new();
    p = list_push(p, "push");
    p = list_push(p, "-q");
    p = list_push(p, "origin");
    p = list_push(p, "HEAD:refs/heads/" + branch);
    fc_git(sys, fs_r, cache, site, p);
    return true;
}

// Set the version of a tool in the catalog of the organization and merge the
// change through a pull request.
pub fn fc_catalog_release(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, fleet: String, tool: String, version: String, desc: String, tries: Int) -> Int {
    let site: String = fleet + "/openOODA-tools.github.io";
    if !path_exists(fs_r, site) { return 0; }
    let slug: String = "openOODA-tools/openOODA-tools.github.io";
    let branch: String = "docs/" + tool + "-" + version;
    if !fc_catalog_branch(sys, fs_r, fs_w, cache, site, branch, tool, version, desc) { return 0; }
    let pr: String = fc_open_pr(sys, fs_r, cache, slug, branch,
        "docs(catalog): the entry of " + tool, "The catalog entry of " + tool + " names the new release.");
    if pr == "" { return 0; }
    let v: String = fc_merge_pr(sys, fs_r, cache, slug, pr, tries);
    println("catalog " + tool + " PR#" + pr + " " + v);
    if str_contains(v, " MERGED") { return 0; }
    return 1;
}
