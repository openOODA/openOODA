// # Fleet Land - Merges The Contract And The Repair Of One Tool
//
// Logline: Brings the contract branch up to the repair branch, waits for every fleet gate check of both pull requests, and merges them.
//
// Setup: Needs ProcessCap for git and the GitHub CLI, and FsReadCap for the captured output.
//
// Beats:
//   1. Find the open pull request of a branch.
//   2. Read the verdict of the fleet gate checks of a pull request.
//   3. Wait for every gate check to report a success, then merge.
//   4. Fast forward the contract branch to the repair branch.
//
// The contract branch carries the fleet contract. A repair is built on top of
// it, so the contract branch is brought up to the repair before the pull
// requests are merged. After that the default branch holds the contract and
// the repair, and both pull requests say so.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetctl/branches.oo";


// The number of the open pull request of a branch. An empty answer means the
// branch carries no open pull request.
pub fn fc_pr_of(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, slug: String, branch: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "pr");
    a = list_push(a, "list");
    a = list_push(a, "--repo");
    a = list_push(a, slug);
    a = list_push(a, "--head");
    a = list_push(a, branch);
    a = list_push(a, "--state");
    a = list_push(a, "open");
    a = list_push(a, "--json");
    a = list_push(a, "number");
    a = list_push(a, "--jq");
    a = list_push(a, ".[0].number");
    let _o: String = fc_run(sys, fs_r, cache, "gh", a);
    return fc_line(fs_r, cache);
}

// The verdict of the fleet gate checks of a pull request. An empty answer means
// the gate has not reported yet.
pub fn fc_gate(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, slug: String, pr: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "pr");
    a = list_push(a, "view");
    a = list_push(a, pr);
    a = list_push(a, "--repo");
    a = list_push(a, slug);
    a = list_push(a, "--json");
    a = list_push(a, "statusCheckRollup");
    a = list_push(a, "--jq");
    a = list_push(a, "[.statusCheckRollup[]? | select(.name==\"Fleet gate\") | .conclusion] | join(\",\")");
    let _o: String = fc_run(sys, fs_r, cache, "gh", a);
    return fc_line(fs_r, cache);
}

// Report whether every check of a verdict reported a success.
fn fc_all_ok(verdict: String) -> Bool {
    if verdict == "" { return false; }
    let parts: List[String] = text_split_lines(str_replace(verdict, ",", "\n"));
    if list_len(parts) == 0 { return false; }
    let mut i: Int = 0;
    while i < list_len(parts) {
        if text_trim(list_get(parts, i)) != "SUCCESS" { return false; }
        i = i + 1;
    }
    return true;
}

// Merge one pull request and report what the merge did.
fn fc_do_merge(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, slug: String, pr: String, verdict: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "pr");
    a = list_push(a, "merge");
    a = list_push(a, pr);
    a = list_push(a, "--repo");
    a = list_push(a, slug);
    a = list_push(a, "--squash");
    a = list_push(a, "--delete-branch=false");
    let _o: String = fc_run(sys, fs_r, cache, "gh", a);
    if fc_code(fs_r, cache) == 0 { return verdict + " MERGED"; }
    return verdict + " MERGE-FAIL";
}

// Wait for the gate of a pull request and merge it. The answer is the verdict
// that was seen last, followed by what the merge did.
//
// A repository that carries no fleet gate is merged anyway: the branch rules
// of the organization still refuse a merge that is not allowed, so the gate
// is never traded away.
pub fn fc_merge_pr(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, slug: String, pr: String, tries: Int) -> String {
    let mut i: Int = 0;
    let mut empty: Int = 0;
    let mut verdict: String = "";
    while i < tries {
        verdict = fc_gate(sys, fs_r, cache, slug, pr);
        if fc_all_ok(verdict) {
            return fc_do_merge(sys, fs_r, cache, slug, pr, verdict);
        }
        if str_contains(verdict, "FAILURE") || str_contains(verdict, "CANCELLED") { return verdict + " FAILED"; }
        if verdict == "" {
            empty = empty + 1;
            if empty >= 5 {
                let tried: String = fc_do_merge(sys, fs_r, cache, slug, pr, verdict);
                if str_contains(tried, " MERGED") { return tried; }
            }
        } else {
            empty = 0;
        }
        fc_wait(sys, "30");
        i = i + 1;
    }
    return verdict + " TIMEOUT";
}



// The number of the pull request that a pull request command reported.
pub fn fc_pr_number(all: String) -> String {
    let lines: List[String] = text_split_lines(all);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_contains(l, "/pull/") {
            let mut n: String = "";
            let mut j: Int = 0;
            while j < chars_len(l) {
                let c: String = str_char_at(l, j);
                if c == "/" { n = ""; } else { n = n + c; }
                j = j + 1;
            }
            return n;
        }
        i = i + 1;
    }
    return "";
}

// Open a pull request and return its number.
pub fn fc_open_pr(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, slug: String, branch: String, title: String, body: String) -> String {
    let mut g: List[String] = list_new();
    g = list_push(g, "pr");
    g = list_push(g, "create");
    g = list_push(g, "--repo");
    g = list_push(g, slug);
    g = list_push(g, "--head");
    g = list_push(g, branch);
    g = list_push(g, "--base");
    g = list_push(g, "main");
    g = list_push(g, "--title");
    g = list_push(g, title);
    g = list_push(g, "--body");
    g = list_push(g, body);
    let _o: String = fc_run(sys, fs_r, cache, "gh", g);
    let pr: String = fc_pr_number(fc_all(fs_r, cache));
    if pr != "" { return pr; }
    return fc_pr_of(sys, fs_r, cache, slug, branch);
}

// Land one tool. The contract branch is brought up to the repair branch, and
// both pull requests are merged once their gate is green.
pub fn fc_land(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, fleet: String, org: String, tool: String, tries: Int) -> Int {
    let repo: String = fleet + "/" + tool;
    let slug: String = org + "/" + tool;
    let contract: String = "buildbox/fleet-contract";
    let fix: String = "fix/" + tool + "-dropin";
    let mut f: List[String] = list_new();
    f = list_push(f, "fetch");
    f = list_push(f, "-q");
    f = list_push(f, "origin");
    let _o: String = fc_git(sys, fs_r, cache, repo, f);
    if fc_has_branch(sys, fs_r, cache, repo, fix) && fc_holds(sys, fs_r, cache, repo, contract, fix) {
        let mut p: List[String] = list_new();
        p = list_push(p, "push");
        p = list_push(p, "-q");
        p = list_push(p, "origin");
        p = list_push(p, "origin/" + fix + ":refs/heads/" + contract);
        let _o2: String = fc_git(sys, fs_r, cache, repo, p);
        println(tool + ": the contract branch is now the repair branch");
    }
    let mut rc: Int = 0;
    let mut branches: List[String] = list_new();
    branches = list_push(branches, contract);
    branches = list_push(branches, fix);
    let mut i: Int = 0;
    while i < list_len(branches) {
        let br: String = list_get(branches, i);
        i = i + 1;
        let pr: String = fc_pr_of(sys, fs_r, cache, slug, br);
        if pr == "" { continue; }
        let v: String = fc_merge_pr(sys, fs_r, cache, slug, pr, tries);
        println(tool + " " + br + " PR#" + pr + " " + v);
        if !str_contains(v, " MERGED") { rc = 1; }
    }
    return rc;
}
