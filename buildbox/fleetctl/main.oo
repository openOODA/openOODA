// # Fleet Control - Lands And Releases The Repaired Tools Of The Fleet
//
// Logline: Merges the contract and the repair of a tool once the gate is green, and publishes the release of a tool.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap and EnvCap.
//
// Beats:
//   1. Land the pull requests of a tool once every fleet gate check has passed.
//   2. Release a tool: version, pull request, tag and catalog entry.
//   3. Report the gate verdict of the open pull requests of a tool.
//
// Usage: fleetctl land <tool>... | release <tool>... | status <tool>...

import "oostd/fs/process/env.oo";
import "fleetctl/land.oo";
import "fleetctl/release.oo";
import "fleetctl/catalog.oo";
import "fleetctl/report.oo";

// Read one environment value with a fallback. The runtime only hands out the
// names that begin with OODA_ or OO_, so every setting of the orchestrator is
// named that way.
fn fc_env(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && r.val != "" { return r.val; }
    return fallback;
}

// The gate verdict of the open pull requests of a tool.
fn fc_status(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, org: String, tool: String) -> String {
    let slug: String = org + "/" + tool;
    let mut branches: List[String] = list_new();
    branches = list_push(branches, "buildbox/fleet-contract");
    branches = list_push(branches, "fix/" + tool + "-dropin");
    let mut report: String = "";
    let mut i: Int = 0;
    while i < list_len(branches) {
        let br: String = list_get(branches, i);
        i = i + 1;
        let pr: String = fc_pr_of(sys, fs_r, cache, slug, br);
        if pr == "" { continue; }
        let v: String = fc_gate(sys, fs_r, cache, slug, pr);
        report = report + br + " PR#" + pr + " gate=" + v + " ";
    }
    return report;
}

// Run one command of the orchestrator for one tool. The extra word carries
// the version of the catalog command and is empty for the other commands.
type BagFcRunOne = struct {
    extra: String,
    cmd: String,
    tries: Int,
};

fn fc_run_one(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, fleet: String, org: String, tool: String,
    bag: BagFcRunOne) -> Int {
    if bag.cmd == "land" {
        return fc_land(sys, fs_r, cache, fleet, org, tool, bag.tries);
    }
    if bag.cmd == "release" {
        return fc_release(sys, fs_r, fs_w, cache, fleet, org, tool, BagFcRelease { desc: "", tries: bag.tries });
    }
    if bag.cmd == "status" {
        println(tool + " " + fc_status(sys, fs_r, cache, org, tool));
        return 0;
    }
    if bag.cmd == "catalog" {
        return fc_catalog_release(sys, fs_r, fs_w, cache, fleet, tool, bag.extra, BagFcCatalogRelease { desc: "",
            tries: bag.tries });
    }
    println("unknown command: " + bag.cmd);
    return 2;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    if list_len(args) == 0 {
        println("usage: fleetctl land|release|status <tool>... | report");
        return 2;
    }
    let cmd: String = list_get(args, 0);
    if cmd != "land" && cmd != "release" && cmd != "status" && cmd != "catalog" && cmd != "report" {
        println("unknown command: " + cmd);
        return 2;
    }
    let fleet: String = fc_env(env, "OODA_FLEET_DIR", "/Projects/openOODA-tools");
    if cmd == "report" {
        let logs: String = fc_env(env, "OODA_GATE_LOGS", "/home/ubermetroid/fleet-gate/logs");
        return fc_report(fs_r, fleet, logs);
    }
    if list_len(args) < 2 {
        println("usage: fleetctl land|release|status <tool>...");
        return 2;
    }
    let org: String = fc_env(env, "OODA_ORG", "openOODA-tools");
    let cache: String = fc_env(env, "OODA_FLEET_CACHE", "/var/lib/ooda-buildbox/cache");
    let tries: Int = 60;
    let mut rc: Int = 0;
    let mut i: Int = 1;
    while i < list_len(args) {
        let tool: String = list_get(args, i);
        i = i + 1;
        let mut extra: String = "";
        if cmd == "catalog" {
            if i < list_len(args) { extra = list_get(args, i); }
            i = i + 1;
        }
        let r: Int = fc_run_one(sys, fs_r, fs_w, cache, fleet, org, tool, BagFcRunOne { extra: extra, cmd: cmd, tries: tries });
        if r != 0 { rc = r; }
    }
    return rc;
}
