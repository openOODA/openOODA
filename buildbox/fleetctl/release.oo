// # Fleet Release - Versions, Tags And Publishes One Tool
//
// Logline: Moves the version of a tool, opens the release pull request, tags the release, and updates the catalog of the organization.
//
// Setup: Needs ProcessCap for git and the GitHub CLI, FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Move a version to the next patch release.
//   2. Rewrite a version in the VERSION file, the Makefile, the README, the
//      sources, the package manifest and the packaging files.
//   3. Put the new version on a release branch and push it.
//   4. Tag the release at the head of the default branch.
//
// The version lives in more than one place: the VERSION file, the variable of
// the Makefile, the text the tool prints and the README that names the
// release. They move together, or the tool answers with one version while its
// repository says another.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetctl/land.oo";
import "fleetctl/catalog.oo";

// Report whether a character belongs to a version number.
fn fc_ver_char(c: String) -> Bool {
    return str_contains("0123456789.", c);
}

// Replace every occurrence of a version that stands on its own. A version that
// is part of a longer number is left alone.
fn fc_replace_ver(s: String, old: String, new: String) -> String {
    if old == "" || old == new { return s; }
    let ol: Int = chars_len(old);
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        if i + ol <= n && str_slice(s, i, i + ol) == old {
            let before_ok: Bool = i == 0 || !fc_ver_char(str_char_at(s, i - 1));
            let after_ok: Bool = i + ol >= n || !fc_ver_char(str_char_at(s, i + ol));
            if before_ok && after_ok {
                out = out + new;
                i = i + ol;
                continue;
            }
        }
        out = out + str_char_at(s, i);
        i = i + 1;
    }
    return out;
}

// The next patch release of a version.
pub fn fc_next_version(old: String) -> String {
    let t: String = text_trim(old);
    let p1: Int = str_index_of(t, ".");
    if p1 < 0 { return t; }
    let rest: String = str_slice(t, p1 + 1, chars_len(t));
    let p2: Int = str_index_of(rest, ".");
    if p2 < 0 { return t; }
    let patch: String = str_slice(rest, p2 + 1, chars_len(rest));
    let pr: Result[Int, String] = parse_int(patch);
    if pr.is_err() { return t; }
    let major: String = str_slice(t, 0, p1);
    let minor: String = str_slice(rest, 0, p2);
    return major + "." + minor + "." + int_to_str(pr.val + 1);
}

// Rewrite a version in every file of a repository that carries it.
fn fc_bump_files(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String, old: String, new: String) -> Int {
    let walked: List[String] = fs_walk(fs_r, repo);
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(walked) {
        let p: String = list_get(walked, i);
        i = i + 1;
        if str_contains(p, "/.git/") || str_contains(p, "/.ooda-cache/") { continue; }
        if str_contains(p, "/dist/") || str_contains(p, "/bin/") { continue; }
        let is_src: Bool = str_ends_with(p, ".oo") || str_ends_with(p, ".oot");
        let is_doc: Bool = str_ends_with(p, "Makefile") || str_ends_with(p, "README.md");
        let is_pkg: Bool = str_ends_with(p, ".pkg") || str_contains(p, "/packaging/");
        let is_inst: Bool = str_ends_with(p, "/install.sh") || str_ends_with(p, "/uninstall.sh");
        if !is_src && !is_doc && !is_pkg && !is_inst { continue; }
        let r: Result[String, String] = fs_read_file(fs_r, p);
        if r.is_err() { continue; }
        let body: String = r.val;
        let s: String = fc_replace_ver(body, old, new);
        if s != body {
            let _w: Result[Void, String] = fs_write_file(fs_w, p, s);
            changed = changed + 1;
        }
    }
    return changed;
}

// Put the new version of a tool on a release branch and push the branch.
fn fc_release_branch(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String, branch: String, tool: String, old: String, new: String) -> Bool {
    let mut f: List[String] = list_new();
    f = list_push(f, "fetch");
    f = list_push(f, "-q");
    f = list_push(f, "origin");
    fc_git(sys, fs_r, cache, repo, f);
    let mut b: List[String] = list_new();
    b = list_push(b, "checkout");
    b = list_push(b, "-q");
    b = list_push(b, "-B");
    b = list_push(b, branch);
    b = list_push(b, "origin/main");
    fc_git(sys, fs_r, cache, repo, b);
    let _w: Result[Void, String] = fs_write_file(fs_w, repo + "/VERSION", new + "\n");
    let _n: Int = fc_bump_files(fs_r, fs_w, repo, old, new);
    let mut a: List[String] = list_new();
    a = list_push(a, "add");
    a = list_push(a, "-A");
    fc_git(sys, fs_r, cache, repo, a);
    let mut c: List[String] = list_new();
    c = list_push(c, "commit");
    c = list_push(c, "-q");
    c = list_push(c, "-m");
    c = list_push(c, "release(" + tool + "): " + new);
    fc_git(sys, fs_r, cache, repo, c);
    let mut p: List[String] = list_new();
    p = list_push(p, "push");
    p = list_push(p, "-q");
    p = list_push(p, "--force");
    p = list_push(p, "origin");
    p = list_push(p, "HEAD:refs/heads/" + branch);
    fc_git(sys, fs_r, cache, repo, p);
    return true;
}

// Tag the release at the head of the default branch and push the tag.
fn fc_release_tag(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, new: String) -> Bool {
    let mut f: List[String] = list_new();
    f = list_push(f, "fetch");
    f = list_push(f, "-q");
    f = list_push(f, "origin");
    fc_git(sys, fs_r, cache, repo, f);
    let mut b: List[String] = list_new();
    b = list_push(b, "checkout");
    b = list_push(b, "-q");
    b = list_push(b, "-B");
    b = list_push(b, "main");
    b = list_push(b, "origin/main");
    fc_git(sys, fs_r, cache, repo, b);
    let mut t: List[String] = list_new();
    t = list_push(t, "tag");
    t = list_push(t, "-f");
    t = list_push(t, "v" + new);
    fc_git(sys, fs_r, cache, repo, t);
    let mut tp: List[String] = list_new();
    tp = list_push(tp, "push");
    tp = list_push(tp, "-q");
    tp = list_push(tp, "--force");
    tp = list_push(tp, "origin");
    tp = list_push(tp, "refs/tags/v" + new);
    fc_git(sys, fs_r, cache, repo, tp);
    return fc_code(fs_r, cache) == 0;
}

// Release one tool: the version moves, the pull request is merged, the tag is
// pushed and the catalog of the organization names the new release.
pub fn fc_release(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, fleet: String, org: String, tool: String, desc: String, tries: Int) -> Int {
    let repo: String = fleet + "/" + tool;
    let slug: String = org + "/" + tool;
    let old: String = fc_read_trim(fs_r, repo + "/VERSION");
    let new: String = fc_next_version(old);
    let branch: String = "release/" + tool + "-" + new;
    let _b: Bool = fc_release_branch(sys, fs_r, fs_w, cache, repo, branch, tool, old, new);
    let pr: String = fc_open_pr(sys, fs_r, cache, slug, branch, "release(" + tool + "): " + new,
        "The version of " + tool + " moves from " + old + " to " + new + ". The README of the tool names the new release.");
    if pr == "" { println(tool + " RELEASE-FAIL no pull request"); return 1; }
    let v: String = fc_merge_pr(sys, fs_r, cache, slug, pr, tries);
    println(tool + " release PR#" + pr + " " + v);
    if !str_contains(v, " MERGED") { return 1; }
    let _t: Bool = fc_release_tag(sys, fs_r, cache, repo, new);
    println(tool + " tagged v" + new);
    let rc: Int = fc_catalog_release(sys, fs_r, fs_w, cache, fleet, tool, new, desc, tries);
    println(tool + " released " + new);
    return rc;
}
