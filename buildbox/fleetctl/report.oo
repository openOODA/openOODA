// # Fleet Report - Reads The Gate Verdicts Of The Tools Of The Fleet
//
// Logline: Prints the gate verdict and the parity score of every tool that carries a build target.
//
// Setup: Needs FsReadCap to read the gate logs of the fleet.
//
// Beats:
//   1. List the tools of the fleet that carry a build target.
//   2. Read the verdict of every step of the gate of one tool out of its log.
//   3. Read the match, differ, skip and fail counts of the parity step.
//   4. Print the report of the fleet with the tools that pass and the tools that do not.
//
// The gate writes one log per step for every tool it runs. A step that passed
// holds the word OK in its log and a step that failed holds an ERR or a make
// failure in its log, so the verdict of a tool can be read back without
// running the gate again.

import "std/core/primitives/str.oo";
import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";

// The tools of the fleet that carry a build target. A repository without a
// build target is a stub of the backlog and is not a tool of the fleet.
pub fn fc_report_tools(fs_r: &FsReadCap, fleet: String) -> List[String] {
    let entries: List[String] = fs_read_dir(fs_r, fleet);
    let mut tools: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(entries) {
        let name: String = list_get(entries, i);
        i = i + 1;
        if !str_starts_with(name, "oo") { continue; }
        let dir: String = fleet + "/" + name;
        if !path_exists(fs_r, dir + "/.git") { continue; }
        let r: Result[String, String] = fs_read_file(fs_r, dir + "/Makefile");
        if r.is_err() { continue; }
        if !fc_report_has_build(r.val) { continue; }
        tools = list_push(tools, name);
    }
    return tools;
}

// Whether a makefile carries a build target of its own. The word build on a
// line of its own is what makes a tool a tool of the fleet, and the mention
// of the word in a comment or in the name of another target does not.
fn fc_report_has_build(makefile: String) -> Bool {
    let lines: List[String] = text_split_lines(makefile);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = text_trim(list_get(lines, i));
        if str_starts_with(ln, "build:") { return true; }
        i = i + 1;
    }
    return false;
}

// The verdict of one step of the gate of one tool. The answer is 0 when the
// step passed and the code of the failure when it did not.
pub fn fc_report_step(fs_r: &FsReadCap, logs: String, tool: String, step: String) -> Int {
    let r: Result[String, String] = fs_read_file(fs_r, logs + "/" + tool + "." + step + ".log");
    if r.is_err() { return 90; }
    let body: String = r.val;
    if str_contains(body, "make: ***") { return 2; }
    if str_contains(body, "ERR\t") { return 2; }
    if str_contains(body, "FAIL ") { return 2; }
    return 0;
}

// The match, differ, skip and fail counts of the parity step of one tool. The
// answer holds the four counts and the word of the upstream.
pub fn fc_report_parity(fs_r: &FsReadCap, logs: String, tool: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, logs + "/" + tool + ".parity.log");
    if r.is_err() { return "-/-/-"; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = text_trim(list_get(lines, i));
        if str_starts_with(ln, "PARITY ") {
            let up: String = fc_report_word(ln, 3);
            return fc_report_count(ln, "match=") + "/" + fc_report_count(ln, "skip=") + "/" + fc_report_count(ln, "fail=") + " " + up;
        }
        i = i + 1;
    }
    return "-/-/-";
}

// The word at the given place of a line, counted from zero.
fn fc_report_word(line: String, place: Int) -> String {
    let parts: List[String] = text_split_lines(str_replace(line, " ", "\n"));
    if place >= list_len(parts) { return ""; }
    return list_get(parts, place);
}

// The number that follows the given word in a line.
fn fc_report_count(line: String, word: String) -> String {
    let idx: Int = str_index_of(line, word);
    if idx < 0 { return "-"; }
    let rest: String = str_slice(line, idx + chars_len(word), chars_len(line));
    let parts: List[String] = text_split_lines(str_replace(rest, " ", "\n"));
    if list_len(parts) == 0 { return "-"; }
    return list_get(parts, 0);
}

// Print the report of the fleet. The report names every tool that carries a
// build target with the verdict of its gate and the score of its parity, and
// it ends with the number of tools that pass and the number that do not.
pub fn fc_report(fs_r: &FsReadCap, fleet: String, logs: String) -> Int {
    let tools: List[String] = fc_report_tools(fs_r, fleet);
    println("FLEET GATE REPORT");
    println("tools=" + int_to_str(list_len(tools)));
    println("");
    println("tool          build verify test  parity own   parity match/skip/fail upstream");
    let mut passed: Int = 0;
    let mut failed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(tools) {
        let tool: String = list_get(tools, i);
        i = i + 1;
        let b: Int = fc_report_step(fs_r, logs, tool, "build");
        let v: Int = fc_report_step(fs_r, logs, tool, "verify");
        let t: Int = fc_report_step(fs_r, logs, tool, "test");
        let p: Int = fc_report_step(fs_r, logs, tool, "parity");
        let o: Int = fc_report_step(fs_r, logs, tool, "own");
        if b == 0 && v == 0 && t == 0 && p == 0 && o == 0 { passed = passed + 1; } else { failed = failed + 1; }
        let score: String = fc_report_parity(fs_r, logs, tool);
        println(fc_report_pad(tool, 14) + fc_report_pad(int_to_str(b), 6) + fc_report_pad(int_to_str(v), 7)
            + fc_report_pad(int_to_str(t), 6) + fc_report_pad(int_to_str(p), 8) + fc_report_pad(int_to_str(o), 6)
            + "  " + score);
    }
    println("");
    println("passed=" + int_to_str(passed) + " failed=" + int_to_str(failed));
    return 0;
}

// Pad a name to the given width so that the report lines up in a column.
fn fc_report_pad(s: String, width: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < width {
        out = out + " ";
    }
    return out;
}
