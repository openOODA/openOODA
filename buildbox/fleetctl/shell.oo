// # Fleet Shell - Process And Text Helpers For The Fleet Orchestrator
//
// Logline: Runs a child command with a list of arguments, captures its output, and reports its exit code.
//
// Setup: Needs ProcessCap for the child processes and FsReadCap to read the captured output.
//
// Beats:
//   1. Run a command through a shell that keeps every argument in its own word.
//   2. Read the captured output back out of the capture file.
//   3. Read the exit code of the command back out of the code file.
//   4. Wait for a number of seconds between two checks.
//
// The command never travels as shell text. The shell receives the program in
// the name slot and the arguments in the parameter slots, so an argument can
// never become a shell command of its own. The output and the exit code are
// written into the cache directory, because a waiting child hands its output
// to the parent instead of holding it.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";

// Run a command and capture its output. The answer holds the output of the
// command. An empty answer means the command could not be started at all.
pub fn fc_run(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, prog: String, args: List[String]) -> String {
    let out_path: String = cache + "/fleetctl.out";
    let rc_path: String = cache + "/fleetctl.rc";
    let script: String = "\"$0\" \"$@\" > " + out_path + " 2>&1; echo $? > " + rc_path;
    let mut a: List[String] = list_new();
    a = list_push(a, "-c");
    a = list_push(a, script);
    a = list_push(a, prog);
    let mut i: Int = 0;
    while i < list_len(args) {
        a = list_push(a, list_get(args, i));
        i = i + 1;
    }
    let r: Result[Int, String] = sys_exec_wait(sys, "sh", a);
    if r.is_err() { return ""; }
    let or: Result[String, String] = fs_read_file(fs_r, out_path);
    if or.is_err() { return ""; }
    return or.val;
}

// The exit code of the command that ran last. A negative answer means the
// command never reached the point of writing its code.
pub fn fc_code(fs_r: &FsReadCap, cache: String) -> Int {
    let r: Result[String, String] = fs_read_file(fs_r, cache + "/fleetctl.rc");
    if r.is_err() { return -1; }
    let p: Result[Int, String] = parse_int(text_trim(r.val));
    if p.is_err() { return -1; }
    return p.val;
}

// The first line of the output of the command that ran last.
pub fn fc_line(fs_r: &FsReadCap, cache: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, cache + "/fleetctl.out");
    if r.is_err() { return ""; }
    let lines: List[String] = text_split_lines(r.val);
    if list_len(lines) == 0 { return ""; }
    return text_trim(list_get(lines, 0));
}

// The whole output of the command that ran last.
pub fn fc_all(fs_r: &FsReadCap, cache: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, cache + "/fleetctl.out");
    if r.is_err() { return ""; }
    return r.val;
}

// Run a git command in one repository.
pub fn fc_git(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, args: List[String]) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    let mut i: Int = 0;
    while i < list_len(args) {
        a = list_push(a, list_get(args, i));
        i = i + 1;
    }
    return fc_run(sys, fs_r, cache, "git", a);
}

// Wait for the given number of seconds.
pub fn fc_wait(sys: &ProcessCap, secs: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, secs);
    let r: Result[Int, String] = sys_exec_wait(sys, "sleep", a);
    return r.is_ok();
}
