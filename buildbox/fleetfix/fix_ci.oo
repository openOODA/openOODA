// # Fleet Fix Workflow - Writes The Workflow Of The Gate Again
//
// Logline: Writes the workflow file and the release workflow file of a branch out of the generator of the contract.
//
// Setup: Needs FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Name the upstream program that a tool replaces.
//   2. Write the workflow of the gate of one branch.
//   3. Report whether a branch holds the contract of the gate.
//
// The workflow of the gate is generated, so it is generated again when it is
// broken. A workflow whose steps carry no indentation is not a workflow at
// all, and the gate of a pull request never runs against it.

import "parity/mapping.oo";
import "ci/apply.oo";

// Name the upstream program that a tool replaces. The answer is empty when the
// table of the organization names no program for the tool, and a tool with
// no upstream program has no parity step.
pub fn ff_upstream(fs_r: &FsReadCap, rows: List[String], tool: String) -> String {
    return parity_map_lookup(rows, tool);
}

// Report whether a repository holds the harness of the contract of the gate.
// A repository without the harness holds no contract, so its workflow is left
// alone.
pub fn ff_has_contract(fs_r: &FsReadCap, repo_dir: String) -> Bool {
    return path_exists(fs_r, repo_dir + "/qa/parity/run.oo");
}

// Write the workflow of the gate and the release workflow of one repository.
// The generator holds the shape of the workflow, so a workflow that lost its
// indentation is written again with the shape it always had.
pub fn ff_write_workflows(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo_dir: String, tool: String, upstream: String) -> Bool {
    let _w: Bool = ci_apply_workflow(fs_r, fs_w, repo_dir, tool, upstream);
    let _r: Bool = ci_apply_release(fs_r, fs_w, repo_dir, tool, upstream);
    return true;
}
