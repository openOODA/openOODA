// # Fleet Fix - Puts Back The Files And The Workflows Of A Branch Of The Fleet
//
// Logline: Gives a branch of a tool the files and the workflows of the gate that it lost, and pushes the repair.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap and EnvCap.
//
// Beats:
//   1. Read the fleet root, the work directory, the organization and the table of the upstreams from the environment.
//   2. Put the files and the workflows of one branch of one tool back.
//   3. Report the number of the branches that were repaired.
//
// Usage: fleetfix <tool> <branch> [<source-ref>] [<push-branch>]
//
// The source ref is where the lost files come from, and it is the default
// branch of the tool when it is not named. The push branch is where the
// repair is pushed, and it is the branch that was repaired when it is not
// named.
//
// A sweep of the fleet took the installers of some tools out of their
// branches and the indentation out of the workflows of the gate. A branch
// that lost a file of the default branch carries a change that nothing asked
// for, and a workflow whose steps carry no indentation is not a workflow at
// all, so the gate of a pull request never runs against it.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "parity/mapping.oo";
import "fleetfix/fix_flow.oo";

// Repair one branch of one tool. The answer is zero when the repair landed.
pub fn ff_fix_tool(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, work: String, org: String, tool: String, branch: String, src: String, push: String, rows: List[String]) -> Int {
    let repo: String = ff_clone(sys, fs_r, fs_w, cache, work, org, tool);
    if repo == "" { println(tool + " CLONE-FAIL"); return 1; }
    let n: Int = ff_fix_branch(sys, fs_r, fs_w, cache, repo, tool, branch, src, push, rows);
    println(tool + " " + branch + " REPAIRED files=" + int_to_str(n));
    return 0;
}

// Read one environment value with a fallback. The runtime only hands out the
// names that begin with OODA_ or OO_, so every setting of the tool is named
// that way.
fn ff_env(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && r.val != "" { return r.val; }
    return fallback;
}

// Read the table of the upstreams of the fleet. The table of the organization
// is the truth, and the backlog holds the tools the table does not name.
fn ff_rows(fs_r: &FsReadCap, profile: String, backlog: String) -> List[String] {
    let mut rows: List[String] = parity_map_rows(fs_r, profile);
    let extra: List[String] = parity_map_rows(fs_r, backlog);
    let mut i: Int = 0;
    while i < list_len(extra) {
        rows = list_push(rows, list_get(extra, i));
        i = i + 1;
    }
    return rows;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    if list_len(args) < 2 {
        println("usage: fleetfix <tool> <branch> [<source-ref>] [<push-branch>]");
        return 1;
    }
    let work: String = ff_env(env, "OODA_FIX_WORK", "/home/ubermetroid/fleet-fix");
    let org: String = ff_env(env, "OODA_ORG", "openOODA-tools");
    let cache: String = ff_env(env, "OODA_FLEET_CACHE", "/var/lib/ooda-buildbox/cache/fix");
    let profile: String = ff_env(env, "OODA_PROFILE", "/Projects/openOODA-tools/.github/profile/README.md");
    let backlog: String = ff_env(env, "OODA_BACKLOG", "/Projects/openOODA/openOODA/docs/tools-backlog.oot");
    let _mc: Result[Void, String] = fs_mkdir_p(fs_w, cache);
    let _mw: Result[Void, String] = fs_mkdir_p(fs_w, work);
    let tool: String = list_get(args, 0);
    let branch: String = list_get(args, 1);
    let src: String = if list_len(args) > 2 { list_get(args, 2) } else { "origin/main" };
    let push: String = if list_len(args) > 3 { list_get(args, 3) } else { branch };
    let rows: List[String] = ff_rows(fs_r, profile, backlog);
    let rc: Int = ff_fix_tool(sys, fs_r, fs_w, cache, work, org, tool, branch, src, push, rows);
    println("done tools=1 failed=" + int_to_str(rc));
    return rc;
}
