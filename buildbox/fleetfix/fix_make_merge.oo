// # Fleet Fix Make Merge - Puts The Makefile Of A Branch Back Together
//
// Logline: Merges the blocks of the default branch into the Makefile of a branch, so a branch that lost a part of the build gets it back.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Report whether a block kept every line of another block that names an installer.
//   2. Name the setting that a line of a header names.
//   3. Report whether a list of lines names a setting.
//   4. Merge the blocks of two Makefiles.
//
// A sweep of the fleet took the installers out of some branches and made the
// Makefile of those branches agree with their absence. The guard that lets
// the installers past the law of the files was loosened, and the lines that
// put the uninstaller into the packages were taken away. The merge puts a
// block of the default branch back when the branch lost a part of it, and
// puts back a block of the default branch that the branch never had.
//
// The block of the branch is the truth in every other case. The branch is
// the work of an agent, and the work is never thrown away for a block that
// the branch holds whole.

import "text/lines.oo";
import "fleetfix/fix_makefile.oo";

// Report whether a block kept every line of another block that names an
// installer. The answer is false when the block lost a part of the build of
// a package.
pub fn ff_mk_keeps_installer(main_block: String, branch_block: String) -> Bool {
    let lines: List[String] = text_split_lines(main_block);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = list_get(lines, i);
        i = i + 1;
        if !ff_mk_names_installer(l) { continue; }
        if !ff_mk_has_line(branch_block, l) { return false; }
    }
    return true;
}

// The setting that a line of a header names. The name stands in front of the
// sign of the setting. The answer is empty when the line names no setting.
pub fn ff_mk_var_name(line: String) -> String {
    let marks: List[String] = list_new();
    let mut m1: List[String] = list_push(marks, " ?=");
    m1 = list_push(m1, " :=");
    m1 = list_push(m1, " =");
    let mut i: Int = 0;
    while i < list_len(m1) {
        let mark: String = list_get(m1, i);
        i = i + 1;
        let p: Int = str_index_of(line, mark);
        if p > 0 { return text_trim(str_slice(line, 0, p)); }
    }
    return "";
}

// Report whether a list of lines names a setting.
pub fn ff_mk_has_var(lines: List[String], name: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(lines) {
        if ff_mk_var_name(list_get(lines, i)) == name { return true; }
        i = i + 1;
    }
    return false;
}

// The header of a branch with the settings of the default branch that the
// branch does not name. The settings of the branch are the truth, because
// the branch carries the version of the tree.
pub fn ff_mk_header_merge(main_lines: List[String], branch_lines: List[String]) -> List[String] {
    let main_head: List[String] = ff_mk_header_lines(main_lines);
    let branch_head: List[String] = ff_mk_header_lines(branch_lines);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(branch_head) {
        out = list_push(out, list_get(branch_head, i));
        i = i + 1;
    }
    i = 0;
    while i < list_len(main_head) {
        let l: String = list_get(main_head, i);
        i = i + 1;
        let v: String = ff_mk_var_name(l);
        if v == "" { continue; }
        if !ff_mk_has_var(branch_head, v) { out = list_push(out, l); }
    }
    return out;
}

// Put the lines of a block at the end of a list of lines.
pub fn ff_mk_push(out: List[String], block: String) -> List[String] {
    let lines: List[String] = text_split_lines(block);
    let mut i: Int = 0;
    while i < list_len(lines) {
        out = list_push(out, list_get(lines, i));
        i = i + 1;
    }
    return out;
}

// Merge the blocks of the default branch into the Makefile of a branch.
//
// A block of the default branch that the branch does not hold comes back. A
// block that both hold stays the block of the branch, unless the block of
// the default branch names an installer that the block of the branch does
// not name. Then the block of the default branch comes back, because the
// branch lost a part of it.
pub fn ff_mk_merge(main_lines: List[String], branch_lines: List[String]) -> List[String] {
    let main_blocks: List[String] = ff_mk_blocks(main_lines);
    let branch_blocks: List[String] = ff_mk_blocks(branch_lines);
    let mut out: List[String] = list_new();
    let head: List[String] = ff_mk_header_merge(main_lines, branch_lines);
    let mut i: Int = 0;
    while i < list_len(head) {
        out = list_push(out, list_get(head, i));
        i = i + 1;
    }
    i = 0;
    while i < list_len(branch_blocks) {
        let b: String = list_get(branch_blocks, i);
        i = i + 1;
        let m: String = ff_mk_find(main_blocks, ff_mk_name(b));
        if m != "" && ff_mk_names_installer(m) && !ff_mk_keeps_installer(m, b) {
            out = ff_mk_push(out, m);
        } else {
            out = ff_mk_push(out, b);
        }
    }
    i = 0;
    while i < list_len(main_blocks) {
        let m: String = list_get(main_blocks, i);
        i = i + 1;
        if ff_mk_find(branch_blocks, ff_mk_name(m)) == "" { out = ff_mk_push(out, m); }
    }
    return out;
}
