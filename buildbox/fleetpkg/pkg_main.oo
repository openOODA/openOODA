// # Fleet Package Fix - Moves The Version Of The Packaging Files Of The Tools Of The Fleet
//
// Logline: Finds the tools whose packaging files carry a version that is not the version of their tree and merges the change of each of them through a pull request.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap and EnvCap.
//
// Beats:
//   1. Read the fleet root, the work directory and the organization from the environment.
//   2. Name the tools whose packaging files disagree with their tree.
//   3. Move the version of every one of them and merge the change.
//
// Usage: fleetpkg [tool]...
//
// The tool that names no tool sweeps the whole fleet. The tool that names one
// or more tools moves only the packaging files of those tools. The tool never
// merges a pull request whose gate is red, and it never moves the version of
// the tree itself: the tree says which version the tool is.

import "std/core/primitives/str.oo";
import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "text/lines.oo";
import "fleetpkg/pkg_scan.oo";
import "fleetpkg/pkg_flow.oo";

// Read one environment value with a fallback. The runtime only hands out the
// names that begin with OODA_ or OO_, so every setting of the tool is named
// that way.
fn fp_env(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && r.val != "" { return r.val; }
    return fallback;
}

// The tools to move, with the stale version and the version of the tree of
// each of them. The tool that names no tool takes every tool of the fleet.
fn fp_list(fs_r: &FsReadCap, fleet: String, args: List[String]) -> List[String] {
    if list_len(args) == 0 { return fp_scan(fs_r, fleet); }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(args) {
        let tool: String = list_get(args, i);
        i = i + 1;
        let repo: String = fleet + "/" + tool;
        let tree: String = fp_tree_ver(fs_r, repo);
        if tree == "" { continue; }
        let stale: String = fp_stale_ver(fs_r, repo, tree);
        if stale == "" { continue; }
        out = list_push(out, tool + "|" + stale + "|" + tree);
    }
    return out;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let fleet: String = fp_env(env, "OODA_FLEET_DIR", "/Projects/openOODA-tools");
    let work: String = fp_env(env, "OODA_PKG_WORK", "/home/ubermetroid/fleet-pkg");
    let org: String = fp_env(env, "OODA_ORG", "openOODA-tools");
    let cache: String = fp_env(env, "OODA_FLEET_CACHE", "/var/lib/ooda-buildbox/cache");
    let _mc: Result[Void, String] = fs_mkdir_p(fs_w, cache);
    let _mw: Result[Void, String] = fs_mkdir_p(fs_w, work);
    let tries: Int = 60;
    if list_len(args) > 0 && list_get(args, 0) == "scan" {
        let found: List[String] = fp_scan(fs_r, fleet);
        let mut j: Int = 0;
        while j < list_len(found) {
            println(list_get(found, j));
            j = j + 1;
        }
        println("stale=" + int_to_str(list_len(found)));
        return 0;
    }
    let list: List[String] = fp_list(fs_r, fleet, args);
    println("tools=" + int_to_str(list_len(list)));
    let mut rc: Int = 0;
    let mut i: Int = 0;
    while i < list_len(list) {
        let entry: String = list_get(list, i);
        i = i + 1;
        let parts: List[String] = text_split_lines(str_replace(entry, "|", "\n"));
        if list_len(parts) < 3 { continue; }
        let tool: String = list_get(parts, 0);
        let old: String = list_get(parts, 1);
        let new: String = list_get(parts, 2);
        let r: Int = fp_fix_one(sys, fs_r, fs_w, cache, work, org, tool, BagFpFixOne { old: old, fresh: new, tries: tries });
        if r != 0 { rc = r; }
    }
    println("done=" + int_to_str(list_len(list)) + " failed=" + int_to_str(rc));
    return rc;
}
