// # Fleet Site Files - Moves The Version Of One Tool On The Site
//
// Logline: Moves the version of a tool in every file of the site that carries it and puts the installer of the tool back, byte for byte.
//
// Setup: Needs ProcessCap for git, FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Move the version in one file of the site.
//   2. Move the version in every file of one tool of the site.
//   3. Put the installer of a tool back on the site.
//   4. Move the version of one tool in the catalog of the portal.
//
// The house law of the site says that the installer of the site and the
// installer of the repository are the same file. A copy that lags the
// repository offers an installer that installs an older release, so the copy
// comes from the repository every time.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetfix/fix_write.oo";
import "fleetpkg/pkg_scan.oo";
import "fleetsite/site_ref.oo";

// Move the version in one file of the site. The answer tells whether the file
// changed.
pub fn fs_bump_file(fs_r: &FsReadCap, fs_w: &FsWriteCap, path: String, old: String, new: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return false; }
    let body: String = r.val;
    let s: String = ff_replace_ver(body, old, new);
    if s == body { return false; }
    let _w: Result[Void, String] = fs_write_file(fs_w, path, s);
    return true;
}

// Move the version in every file of one tool of the site. The answer holds
// the number of the files that changed.
pub fn fs_bump_tool(fs_r: &FsReadCap, fs_w: &FsWriteCap, site: String, tool: String, old: String, new: String) -> Int {
    if old == "" || old == new { return 0; }
    let dir: String = site + "/" + tool;
    let names: List[String] = list_push(list_push(list_push(list_push(list_new(),
        "index.html"), "PKGBUILD"), "install.sh"), "uninstall.sh");
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(names) {
        let p: String = dir + "/" + list_get(names, i);
        i = i + 1;
        if fs_bump_file(fs_r, fs_w, p, old, new) { changed = changed + 1; }
    }
    return changed;
}

// Put the installer of a tool back on the site, byte for byte, and give it
// the rights that the law of the site asks for. The answer tells whether the
// file was written.
pub fn fs_put_installer(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, fleet: String, site: String,
    tool: String, name: String) -> Bool {
    let body: String = fs_show_repo(sys, fs_r, cache, fleet, tool, name);
    if body == "" { return false; }
    let path: String = site + "/" + tool + "/" + name;
    let _w: Result[Void, String] = fs_write_file(fs_w, path, body);
    let mut c: List[String] = list_new();
    c = list_push(c, "-c");
    c = list_push(c, "chmod 755 " + path);
    let _o: String = fc_run(sys, fs_r, cache, "sh", c);
    return true;
}

// Put the release of a tool in one line of the catalog. The answer holds the
// line. The catalog writes the release with a v in front of it, and the line
// keeps that shape.
fn fs_set_version(line: String, new: String) -> String {
    let key: String = "\"version\": \"";
    let at: Int = index_of(line, key);
    if at < 0 { return line; }
    let head: String = str_sub(line, 0, at + str_len(key));
    let rest: String = str_sub(line, at + str_len(key), str_len(line));
    let cut: Int = index_of(rest, "\"");
    if cut < 0 { return line; }
    let oldv: String = str_sub(rest, 0, cut);
    let tail: String = str_sub(rest, cut, str_len(rest));
    let pre: String = if starts_with(oldv, "v") { "v" } else { "" };
    return head + str_concat(pre, new) + tail;
}

// Move the version of one tool in the catalog of the portal. The answer tells
// whether the file changed.
//
// The catalog names every tool on a line of its own, and the version of the
// tool stands on one of the lines that follow the name. The version that
// stands there is the version of the tool.
//
// The catalog is written from the fleet, so the version of the tool is put
// there and not searched for it. A catalog that holds a release of its own
// that the fleet does not carry would send the reader to an installer that
// installs an older tool.
pub fn fs_bump_catalog(fs_r: &FsReadCap, fs_w: &FsWriteCap, path: String, tool: String, new: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return false; }
    let lines: List[String] = text_split_lines(r.val);
    let mut out: List[String] = list_new();
    let mut named: Bool = false;
    let mut changed: Bool = false;
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = list_get(lines, i);
        i = i + 1;
        if str_contains(ln, "\"id\": \"" + tool + "\"") { named = true;
        out = list_push(out, ln);
        continue; }
        if named && str_contains(ln, "\"version\":") {
            named = false;
            let s: String = fs_set_version(ln, new);
            if s != ln { changed = true; }
            out = list_push(out, s);
            continue;
        }
        if named && !str_contains(ln, "\"id\":") { out = list_push(out, ln);
        continue; }
        named = false;
        out = list_push(out, ln);
    }
    if !changed { return false; }
    let body: String = text_join_lines(out);
    let _w: Result[Void, String] = fs_write_file(fs_w, path, body);
    return true;
}
