// # Fleet Site Ref - Reads The Site And The Tools It Carries
//
// Logline: Reads the tool directories of the site, the version each of them carries and the files of a tool of the fleet.
//
// Setup: Needs ProcessCap for git and FsReadCap to read the files.
//
// Beats:
//   1. Name the tool directories of the site.
//   2. Read the version that a file of the site carries on its version line.
//   3. Read the version that a tool directory of the site carries.
//   4. Read one file of the repository of a tool.
//
// The site carries one directory for every tool that ships. The version of a
// tool lives in more than one place on the site: the badge of the page, the
// package file, the installer and the catalog of the portal. They move
// together, or the portal offers a release that the tool does not carry.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetpkg/pkg_scan.oo";

// Name the tool directories of the site.
pub fn fs_site_tools(fs_r: &FsReadCap, site: String) -> List[String] {
    let entries: List[String] = fs_read_dir(fs_r, site);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(entries) {
        let name: String = list_get(entries, i);
        i = i + 1;
        if !str_starts_with(name, "oo") { continue; }
        if !path_exists(fs_r, site + "/" + name + "/index.html") { continue; }
        out = list_push(out, name);
    }
    return out;
}

// Read the version that a file of the site carries on its version line. The
// answer is empty when the file names no such line.
pub fn fs_file_version(fs_r: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return ""; }
    return fp_field_ver(r.val);
}

// Read the version that a tool directory of the site carries. The package
// file of the tool is the anchor, because every tool of the site has one.
pub fn fs_tool_version(fs_r: &FsReadCap, site: String, tool: String) -> String {
    let dir: String = site + "/" + tool;
    let pkg: String = fs_file_version(fs_r, dir + "/PKGBUILD");
    if pkg != "" { return pkg; }
    return fs_file_version(fs_r, dir + "/install.sh");
}

// Bring the default branch of the repository of a tool back from the origin.
pub fn fs_fetch_repo(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, fleet: String, tool: String) -> Bool {
    let repo: String = fleet + "/" + tool;
    let mut f: List[String] = list_new();
    f = list_push(f, "-C");
    f = list_push(f, repo);
    f = list_push(f, "fetch");
    f = list_push(f, "--quiet");
    f = list_push(f, "origin");
    let _fo: String = fc_run(sys, fs_r, cache, "git", f);
    return fc_code(fs_r, cache) == 0;
}

// Read one file of the repository of a tool at its default branch.
pub fn fs_show_repo(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, fleet: String, tool: String, path: String) -> String {
    let repo: String = fleet + "/" + tool;
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "show");
    a = list_push(a, "origin/main:" + path);
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    if fc_code(fs_r, cache) != 0 { return ""; }
    return fc_all(fs_r, cache);
}
