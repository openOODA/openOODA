// # Fleet Sync Anchor - The Anchor Of The Fleet Synchronization
//
// Logline: Re-exports the refs of a repository, the build of its tree, the move of its version and the push that lands the release.
//
// Setup: Pure shim re-exporting every fleetsync subsystem anchor.
//
// Beats:
//   1. Re-export the refs and the versions of the repository of one tool.
//   2. Re-export the build of the tree that a tool is released from.
//   3. Re-export the move of the version of one tool.
//   4. Re-export the push that lands the release on both default branches.

import "fleetsync/sync_ref.oo";
import "fleetsync/sync_prep.oo";
import "fleetsync/sync_bump.oo";
import "fleetsync/sync_push.oo";
