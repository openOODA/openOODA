// # Fleet Sync Bump - Moves The Version Of One Tool
//
// Logline: Moves the version of a tool in every file that carries it, so the tool, its manifest, its installer and its packages all name the same release.
//
// Setup: Needs FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Move the version in one file of a tool.
//   2. Move the version in every file of a repository that carries it.
//
// The version lives in more than one place: the VERSION file, the variable of
// the Makefile, the text the tool prints, the manifest of the package, the
// installer and the files of the packaging directory. They move together, or
// the tool answers with one version while its repository says another. The
// version that the files of the packaging carry when it is not the version of
// the tree moves as well, so that no package of the release names an older
// release.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "fleetfix/fix_write.oo";
import "fleetpkg/pkg_scan.oo";

// Move the version in one file of a tool. The answer tells whether the file
// changed.
pub fn sy_bump_file(fs_r: &FsReadCap, fs_w: &FsWriteCap, path: String, old: String, new: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return false; }
    let body: String = r.val;
    let s: String = ff_replace_ver(body, old, new);
    if s == body { return false; }
    let _w: Result[Void, String] = fs_write_file(fs_w, path, s);
    return true;
}

// Report whether a path names a file that carries the version of a tool.
fn sy_carries_version(path: String) -> Bool {
    if str_ends_with(path, ".oo") || str_ends_with(path, ".oot") { return true; }
    if str_ends_with(path, "Makefile") || str_ends_with(path, "README.md") { return true; }
    if str_ends_with(path, ".pkg") || str_contains(path, "/packaging/") { return true; }
    if str_ends_with(path, "/install.sh") || str_ends_with(path, "/uninstall.sh") { return true; }
    return false;
}

// Move the version of one tool in every file of its repository that carries
// it. The answer holds the number of the files that changed.
pub fn sy_bump(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String, old: String, new: String) -> Int {
    if old == "" || old == new { return 0; }
    let _w: Result[Void, String] = fs_write_file(fs_w, repo + "/VERSION", new + "\n");
    let walked: List[String] = fs_walk(fs_r, repo);
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(walked) {
        let p: String = list_get(walked, i);
        i = i + 1;
        if str_contains(p, "/.git/") || str_contains(p, "/dist/") { continue; }
        if str_contains(p, "/bin/") || str_contains(p, "/.ooda-cache/") { continue; }
        if !sy_carries_version(p) { continue; }
        if sy_bump_file(fs_r, fs_w, p, old, new) { changed = changed + 1; }
        if !str_contains(p, "/packaging/") { continue; }
        let r: Result[String, String] = fs_read_file(fs_r, p);
        if r.is_err() { continue; }
        let stale: String = fp_field_ver(r.val);
        if stale == "" || stale == old || stale == new { continue; }
        if sy_bump_file(fs_r, fs_w, p, stale, new) { changed = changed + 1; }
    }
    return changed;
}
