// # Fleet Sync - Lands The Release Of The Tools Of The Fleet On Both Default Branches
//
// Logline: Builds the tree of every tool of the fleet, moves its version and lands the release on the default branch and on the master branch of the origin.
//
// Setup: Needs ProcessCap, FsReadCap, FsWriteCap and EnvCap.
//
// Beats:
//   1. Read the fleet root, the work directory, the organization and the release from the environment.
//   2. Read the table of the upstreams of the fleet.
//   3. Name the tools of the fleet.
//   4. Land the release of one tool on both default branches.
//
// Usage: fleetsync [<tool>...]
//
// The tool that names no tool sweeps the whole fleet. The release is the
// version that every tool moves to, and it is read from the environment.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "parity/mapping.oo";
import "fleetsync/sync_ref.oo";
import "fleetsync/sync_prep.oo";
import "fleetsync/sync_bump.oo";
import "fleetsync/sync_push.oo";

// Read one environment value with a fallback. The runtime only hands out the
// names that begin with OODA_ or OO_, so every setting of the tool is named
// that way.
fn sy_env(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && r.val != "" { return r.val; }
    return fallback;
}

// Read the table of the upstreams of the fleet. The table of the organization
// is the truth, and the backlog holds the tools the table does not name.
fn sy_rows(fs_r: &FsReadCap, profile: String, backlog: String) -> List[String] {
    let mut rows: List[String] = parity_map_rows(fs_r, profile);
    let extra: List[String] = parity_map_rows(fs_r, backlog);
    let mut i: Int = 0;
    while i < list_len(extra) {
        rows = list_push(rows, list_get(extra, i));
        i = i + 1;
    }
    return rows;
}

// Name the tools of the fleet. Every tool is a directory of the fleet root
// that holds a repository of its own.
fn sy_tools(fs_r: &FsReadCap, fleet: String) -> List[String] {
    let entries: List[String] = fs_read_dir(fs_r, fleet);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(entries) {
        let name: String = list_get(entries, i);
        i = i + 1;
        if !str_starts_with(name, "oo") { continue; }
        if !path_exists(fs_r, fleet + "/" + name + "/.git") { continue; }
        out = list_push(out, name);
    }
    return out;
}

// Split one name of a tool into the tool and the release it moves to. A name
// that names no release moves to the release of the fleet.
fn sy_split(arg: String) -> List[String] {
    let at: Int = str_index_of(arg, "@");
    if at < 0 { return list_push(list_new(), arg); }
    let mut out: List[String] = list_new();
    out = list_push(out, str_slice(arg, 0, at));
    out = list_push(out, str_slice(arg, at + 1, chars_len(arg)));
    return out;
}

// Land the release of one tool on both default branches of the origin. The
// answer is zero when the release landed.
pub fn sy_one(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, work: String, org: String, tool: String, branch: String, src: String, ver: String, rows: List[String]) -> Int {
    let repo: String = sy_clone(sys, fs_r, fs_w, cache, work, org, tool);
    if repo == "" { println(tool + " CLONE-FAIL"); return 1; }
    let _f: Bool = sy_fetch(sys, fs_r, cache, repo);
    let n: Int = sy_prepare(sys, fs_r, fs_w, cache, repo, tool, branch, src, rows);
    let old: String = sy_tree_version(fs_r, repo);
    let b: Int = sy_bump(fs_r, fs_w, repo, old, ver);
    if !sy_land(sys, fs_r, fs_w, cache, repo, tool, ver) {
        println(tool + " LAND-FAIL files=" + int_to_str(n));
        return 1;
    }
    println(tool + " " + ver + " LANDED files=" + int_to_str(n) + " bumped=" + int_to_str(b));
    return 0;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let fleet: String = sy_env(env, "OODA_FLEET_DIR", "/Projects/openOODA-tools");
    let work: String = sy_env(env, "OODA_SYNC_WORK", "/home/ubermetroid/fleet-sync");
    let org: String = sy_env(env, "OODA_ORG", "openOODA-tools");
    let cache: String = sy_env(env, "OODA_FLEET_CACHE", "/var/lib/ooda-buildbox/cache/sync");
    let ver: String = sy_env(env, "OODA_RELEASE_VERSION", "0.2.3");
    let branch: String = sy_env(env, "OODA_SYNC_BRANCH", "buildbox/fleet-contract");
    let src: String = sy_env(env, "OODA_SYNC_SRC", "origin/main");
    let profile: String = sy_env(env, "OODA_PROFILE", "/Projects/openOODA-tools/.github/profile/README.md");
    let backlog: String = sy_env(env, "OODA_BACKLOG", "/Projects/openOODA/openOODA/docs/tools-backlog.oot");
    let _mc: Result[Void, String] = fs_mkdir_p(fs_w, cache);
    let _mw: Result[Void, String] = fs_mkdir_p(fs_w, work);
    let rows: List[String] = sy_rows(fs_r, profile, backlog);
    let mut tools: List[String] = list_new();
    let mut vers: List[String] = list_new();
    if list_len(args) > 0 {
        let mut i: Int = 0;
        while i < list_len(args) {
            let pair: List[String] = sy_split(list_get(args, i));
            i = i + 1;
            if list_len(pair) == 0 { continue; }
            tools = list_push(tools, list_get(pair, 0));
            if list_len(pair) > 1 { vers = list_push(vers, list_get(pair, 1)); } else { vers = list_push(vers, ver); }
        }
    } else {
        tools = sy_tools(fs_r, fleet);
        let mut i: Int = 0;
        while i < list_len(tools) {
            vers = list_push(vers, ver);
            i = i + 1;
        }
    }
    println("tools=" + int_to_str(list_len(tools)) + " version=" + ver + " branch=" + branch);
    let rc: Int = sy_run_all(sys, fs_r, fs_w, cache, work, org, tools, vers, branch, src, rows);
    println("done tools=" + int_to_str(list_len(tools)) + " failed=" + int_to_str(rc));
    return rc;
}

// Run the sync of every tool of the list. The answer holds the exit code of
// the last tool that failed.
fn sy_run_all(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, work: String, org: String, tools: List[String], vers: List[String], branch: String, src: String, rows: List[String]) -> Int {
    let mut rc: Int = 0;
    let mut i: Int = 0;
    while i < list_len(tools) {
        let t: String = list_get(tools, i);
        let v: String = list_get(vers, i);
        i = i + 1;
        let r: Int = sy_one(sys, fs_r, fs_w, cache, work, org, t, branch, src, v, rows);
        if r != 0 { rc = r; }
    }
    return rc;
}
