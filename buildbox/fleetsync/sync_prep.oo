// # Fleet Sync Prep - Builds The Tree That A Tool Is Released From
//
// Logline: Puts the files, the Makefile and the workflows of a tool back together and moves the toolchain of the tree to the core organization.
//
// Setup: Needs ProcessCap for git, FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Put the Makefile of the default branch back into the Makefile of the branch.
//   2. Move the toolchain of the Makefile to the core organization.
//   3. Build the tree of one tool that the release is made from.
//
// The branch of the contract is the base of the tree, because it holds the
// parity harness and the pages of the tool. The files that the default branch
// holds and the branch lost come back, the Makefile is put back together and
// the workflows of the gate are written again out of the generator of the
// contract, so that no branch keeps a workflow that no parser can read.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetfix/fix_write.oo";
import "fleetfix/fix_restore.oo";
import "fleetfix/fix_ci.oo";
import "fleetfix/fix_make_merge.oo";
import "ci/makefile.oo";
import "fleetsync/sync_ref.oo";

// Put the Makefile of the default branch back into the Makefile of the
// branch. The blocks of the branch are the truth and the blocks of the
// default branch come back where the branch lost a part of the build. The
// gate of the drop-in property is wired in again afterwards.
pub fn sy_merge_makefile(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String,
    src: String) -> Bool {
    let main_mk: String = sy_read_ref(sys, fs_r, cache, repo, src, "Makefile");
    if main_mk == "" { return false; }
    let r: Result[String, String] = fs_read_file(fs_r, repo + "/Makefile");
    if r.is_err() { return false; }
    let merged: List[String] = ff_mk_merge(text_split_lines(main_mk), text_split_lines(r.val));
    let _w: Result[Void, String] = fs_write_file(fs_w, repo + "/Makefile", text_join_lines(merged));
    let _p: Bool = ci_mk_patch(fs_r, fs_w, repo + "/Makefile");
    return true;
}

// Move the toolchain of the Makefile to the core organization. The compiler,
// the runtime and the library of the tree live in the core organization, and
// a Makefile that still names the old organization builds against a toolchain
// that is no longer there.
pub fn sy_core_toolchain(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let path: String = repo + "/Makefile";
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return 0; }
    let body: String = r.val;
    let s: String = ff_replace_ver(body, "openOODA/oodac", "openOODA-core/oodac");
    let s2: String = ff_replace_ver(s, "openOODA/oodar", "openOODA-core/oodar");
    let s3: String = ff_replace_ver(s2, "openOODA/std", "openOODA-core/std");
    if s3 == body { return 0; }
    let _w: Result[Void, String] = fs_write_file(fs_w, path, s3);
    return 1;
}

// Put the guard of the file law back. The law bans every shell script that
// is not an installer, and the guard that names the installers is the guard
// that lets the installers through. A guard that names no installer bans the
// installers too, and a tool with an installer fails its own gate.
pub fn sy_file_law(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let path: String = repo + "/Makefile";
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return 0; }
    let body: String = r.val;
    if !str_contains(body, "name \"*.sh\"") { return 0; }
    let broken: String = "if [ -n \"$$f\" ]; then";
    if !str_contains(body, broken) { return 0; }
    let fixed: String = "if [ \"$$f\" != \"./install.sh\" ] && [ \"$$f\" != \"./uninstall.sh\" ]; then";
    let _w: Result[Void, String] = fs_write_file(fs_w, path, ff_replace_ver(body, broken, fixed));
    return 1;
}

// Put back the files of one ref that the branch lost and that do not carry
// code.
//
// An installer, a page of the verification and a file of the packaging belong
// to the tool and not to the branch that wrote them, so they come back. A page
// of code does not: a page of the default branch may call a name that the
// branch does not have, and a tree that calls a name that is not there does
// not build.
//
// The version of the ref comes back with the file, moved to the version of
// the tree, so that the file that comes back names the release of the tree.
pub fn sy_restore_assets(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String,
    src: String) -> Int {
    let lost: List[String] = ff_lost(sys, fs_r, cache, repo, src, "HEAD");
    let entries: List[String] = ff_tree(sys, fs_r, cache, repo, src);
    let old: String = sy_ref_version(sys, fs_r, cache, repo, src);
    let new: String = sy_tree_version(fs_r, repo);
    let mut n: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lost) {
        let p: String = list_get(lost, i);
        i = i + 1;
        if str_ends_with(p, ".oo") || str_ends_with(p, ".oot") { continue; }
        let mode: String = ff_mode_of(entries, p);
        if ff_restore_one(sys, fs_r, fs_w, cache, repo, src, p, BagFfRestoreOne { mode: mode, old: old, fresh: new }) { n = n +
            1; }
    }
    return n;
}

// Build the tree of one tool that the release is made from. The answer holds
// the number of the files that were put back.
//
// A tool whose branch of the contract is not there is built from its default
// branch, so that the newest tool of the fleet is released as well. A tool
// whose installers live in a branch of a repair gets them back from there,
// because the default branch lost them as well.
type BagSyPrepare = struct {
    src: String,
    rows: List[String],
};

pub fn sy_prepare(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String, tool: String,
    branch: String, bag: BagSyPrepare) -> Int {
    let base: String = branch;
    if !sy_checkout(sys, fs_r, cache, repo, base) {
        if !sy_checkout(sys, fs_r, cache, repo, "main") { return 0; }
    }
    let mut n: Int = sy_restore_assets(sys, fs_r, fs_w, cache, repo, bag.src);
    let repair: String = "origin/fix/" + tool + "-installers";
    if sy_has_ref(sys, fs_r, cache, repo, repair) {
        n = n + sy_restore_assets(sys, fs_r, fs_w, cache, repo, repair);
    }
    let _m: Bool = sy_merge_makefile(sys, fs_r, fs_w, cache, repo, bag.src);
    let _l: Int = sy_file_law(fs_r, fs_w, repo);
    let upstream: String = ff_upstream(fs_r, bag.rows, tool);
    if ff_has_contract(fs_r, repo) {
        let _w: Bool = ff_write_workflows(fs_r, fs_w, repo, tool, upstream);
    }
    let _c: Int = sy_core_toolchain(fs_r, fs_w, repo);
    return n;
}
