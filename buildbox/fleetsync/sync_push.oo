// # Fleet Sync Push - Lands The Release Of One Tool On Both Default Branches
//
// Logline: Writes the release of a tool into a commit of UberMetroid and lands it on the default branch and on the master branch of the origin, with a tag.
//
// Setup: Needs ProcessCap for git and FsReadCap to read the files.
//
// Beats:
//   1. Name the author of every commit that this tool writes.
//   2. Write the release of one tool into a commit.
//   3. Land one branch of the repository on the origin.
//   4. Tag the release and land the tag on the origin.
//   5. Land the release of one tool on both default branches.
//
// The commit of the release carries the name of UberMetroid and no other
// author, and it carries no trailer of any other writer. The two default
// branches of a tool carry the same tree, because a tool that answers on one
// branch and not on the other is two tools.

import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";

// Name the author of every commit that this tool writes. The name and the
// address of the author stand in the configuration of the repository, so the
// commit carries them as its writer and as its author.
pub fn sy_identity(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> Bool {
    let mut n: List[String] = list_new();
    n = list_push(n, "-C");
    n = list_push(n, repo);
    n = list_push(n, "config");
    n = list_push(n, "user.name");
    n = list_push(n, "UberMetroid");
    let _o: String = fc_run(sys, fs_r, cache, "git", n);
    let mut e: List[String] = list_new();
    e = list_push(e, "-C");
    e = list_push(e, repo);
    e = list_push(e, "config");
    e = list_push(e, "user.email");
    e = list_push(e, "jerydleuck@gmail.com");
    let _o2: String = fc_run(sys, fs_r, cache, "git", e);
    return fc_code(fs_r, cache) == 0;
}

// Write the release of one tool into a commit of the working tree. The
// answer tells whether the tree was written. A tree that already carries the
// release needs no commit of its own.
pub fn sy_commit(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String, msg: String) -> Bool {
    let mut s: List[String] = list_new();
    s = list_push(s, "-C");
    s = list_push(s, repo);
    s = list_push(s, "status");
    s = list_push(s, "--porcelain");
    let _so: String = fc_run(sys, fs_r, cache, "git", s);
    if text_trim(fc_all(fs_r, cache)) == "" { return true; }
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "add");
    a = list_push(a, "-A");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    let mut c: List[String] = list_new();
    c = list_push(c, "-C");
    c = list_push(c, repo);
    c = list_push(c, "commit");
    c = list_push(c, "-q");
    c = list_push(c, "--author");
    c = list_push(c, "UberMetroid <jerydleuck@gmail.com>");
    c = list_push(c, "-m");
    c = list_push(c, msg);
    let _o2: String = fc_run(sys, fs_r, cache, "git", c);
    return fc_code(fs_r, cache) == 0;
}

// Land one branch of the repository on the origin. The branch is replaced,
// because the release is the whole of the branch.
pub fn sy_push_branch(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, branch: String) -> Bool {
    let mut p: List[String] = list_new();
    p = list_push(p, "-C");
    p = list_push(p, repo);
    p = list_push(p, "push");
    p = list_push(p, "--quiet");
    p = list_push(p, "--force");
    p = list_push(p, "origin");
    p = list_push(p, "HEAD:refs/heads/" + branch);
    let _o: String = fc_run(sys, fs_r, cache, "git", p);
    return fc_code(fs_r, cache) == 0;
}

// Tag the release at the head of the working tree and land the tag.
pub fn sy_push_tag(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, tag: String) -> Bool {
    let mut t: List[String] = list_new();
    t = list_push(t, "-C");
    t = list_push(t, repo);
    t = list_push(t, "tag");
    t = list_push(t, "-f");
    t = list_push(t, tag);
    let _o: String = fc_run(sys, fs_r, cache, "git", t);
    if fc_code(fs_r, cache) != 0 { return false; }
    let mut p: List[String] = list_new();
    p = list_push(p, "-C");
    p = list_push(p, repo);
    p = list_push(p, "push");
    p = list_push(p, "--quiet");
    p = list_push(p, "--force");
    p = list_push(p, "origin");
    p = list_push(p, "refs/tags/" + tag);
    let _o2: String = fc_run(sys, fs_r, cache, "git", p);
    return fc_code(fs_r, cache) == 0;
}

// Land the release of one tool on the default branch and on the master branch
// of the origin, and tag it there.
pub fn sy_land(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String, tool: String,
    ver: String) -> Bool {
    let msg: String = "release(" + tool + "): " + ver;
    let _i: Bool = sy_identity(sys, fs_r, cache, repo);
    if !sy_commit(sys, fs_r, fs_w, cache, repo, msg) { return false; }
    if !sy_push_branch(sys, fs_r, cache, repo, "main") { return false; }
    if !sy_push_branch(sys, fs_r, cache, repo, "master") { return false; }
    let _t: Bool = sy_push_tag(sys, fs_r, cache, repo, "v" + ver);
    return true;
}
