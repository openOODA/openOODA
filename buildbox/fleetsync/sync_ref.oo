// # Fleet Sync Ref - Reads The Refs Of The Repository Of One Tool
//
// Logline: Clones a tool, brings every ref of it back and reads the files and the versions that its refs hold.
//
// Setup: Needs ProcessCap for git and FsReadCap to read the files.
//
// Beats:
//   1. Clone the repository of one tool into the work directory.
//   2. Bring every ref of the repository back from the origin.
//   3. Put one branch of the repository on the working tree.
//   4. Read one file of one ref of the repository.
//   5. Read the version that a ref of the repository carries.
//   6. Read the version that the working tree of the repository carries.

import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";

// Clone the repository of one tool into the work directory. The answer holds
// the path of the clone, and it is empty when the clone failed.
pub fn sy_clone(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, work: String, org: String,
    tool: String) -> String {
    let dest: String = work + "/" + tool;
    if path_exists(fs_r, dest) {
        let _d: Result[Void, String] = fs_remove_tree(fs_w, fs_r, dest);
    }
    let mut mk: List[String] = list_new();
    mk = list_push(mk, "-p");
    mk = list_push(mk, work);
    let _o: String = fc_run(sys, fs_r, cache, "mkdir", mk);
    let mut a: List[String] = list_new();
    a = list_push(a, "clone");
    a = list_push(a, "--quiet");
    a = list_push(a, "https://github.com/" + org + "/" + tool + ".git");
    a = list_push(a, dest);
    let _o2: String = fc_run(sys, fs_r, cache, "git", a);
    if fc_code(fs_r, cache) != 0 { return ""; }
    return dest;
}

// Bring every ref of the repository back from the origin, the tags with them.
pub fn sy_fetch(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "fetch");
    a = list_push(a, "--quiet");
    a = list_push(a, "--tags");
    a = list_push(a, "origin");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return fc_code(fs_r, cache) == 0;
}

// Put one branch of the repository on the working tree. The answer tells
// whether the branch was there at all.
pub fn sy_checkout(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, branch: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "checkout");
    a = list_push(a, "-q");
    a = list_push(a, "-B");
    a = list_push(a, branch);
    a = list_push(a, "origin/" + branch);
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return fc_code(fs_r, cache) == 0;
}

// Read one file of one ref of the repository.
pub fn sy_read_ref(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, ref: String, path: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "show");
    a = list_push(a, ref + ":" + path);
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return fc_all(fs_r, cache);
}

// Read the version that one ref of the repository carries.
pub fn sy_ref_version(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, ref: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "show");
    a = list_push(a, ref + ":VERSION");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return text_trim(fc_all(fs_r, cache));
}

// Report whether the repository holds one ref. The answer tells whether the
// branch of a repair of a tool is there at all.
pub fn sy_has_ref(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, ref: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "rev-parse");
    a = list_push(a, "--verify");
    a = list_push(a, "--quiet");
    a = list_push(a, ref);
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return fc_code(fs_r, cache) == 0;
}

// Read the version that the working tree of the repository carries.
pub fn sy_tree_version(fs_r: &FsReadCap, repo: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, repo + "/VERSION");
    if r.is_err() { return ""; }
    return text_trim(r.val);
}
