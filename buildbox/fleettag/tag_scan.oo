// # Fleet Tag Scan - Reads The Tags And The Versions Of A Repository
//
// Logline: Names the tags of a repository, the commits of its default branch, and the version that a commit names.
//
// Setup: Needs ProcessCap for git and FsReadCap to read the capture of the commands.
//
// Beats:
//   1. Name the tags of a repository.
//   2. Name the commit of a tag.
//   3. Report whether a commit stands on the default branch.
//   4. Name the commits of the default branch.
//   5. Name the version that a commit names.
//   6. Find the commit of the default branch that names a version.
//
// A release tag has to point at a commit of the default branch, because the
// tree of that commit names the version of the release. A tag that points
// somewhere else names a release the default branch never carried.

import "text/lines.oo";
import "fleetctl/shell.oo";

// The tags of a repository.
pub fn ft_tags(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> List[String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "tag");
    a = list_push(a, "--list");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    let out: String = fc_all(fs_r, cache);
    let mut out_lines: List[String] = list_new();
    let lines: List[String] = text_split_lines(out);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        i = i + 1;
        if l != "" && str_starts_with(l, "v") { out_lines = list_push(out_lines, l); }
    }
    return out_lines;
}

// The commit of a tag.
pub fn ft_commit_of(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, tag: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "rev-list");
    a = list_push(a, "-n");
    a = list_push(a, "1");
    a = list_push(a, tag);
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return text_trim(fc_line(fs_r, cache));
}

// Report whether a commit stands on the default branch of the repository.
pub fn ft_on_main(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, commit: String) -> Bool {
    if commit == "" { return false; }
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "merge-base");
    a = list_push(a, "--is-ancestor");
    a = list_push(a, commit);
    a = list_push(a, "origin/main");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return fc_code(fs_r, cache) == 0;
}

// The commits of the default branch of the repository, the newest first.
pub fn ft_main_commits(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> List[String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "log");
    a = list_push(a, "--format=%H");
    a = list_push(a, "origin/main");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    let lines: List[String] = text_split_lines(fc_all(fs_r, cache));
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        i = i + 1;
        if l != "" { out = list_push(out, l); }
    }
    return out;
}

// The version that the tree of a commit names.
pub fn ft_version_of(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, commit: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "show");
    a = list_push(a, commit + ":VERSION");
    let _o: String = fc_run(sys, fs_r, cache, "git", a);
    return text_trim(fc_line(fs_r, cache));
}

// The commit of the default branch whose tree names a version. The answer is
// empty when the default branch never carried that version.
pub fn ft_find_version(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, version: String) -> String {
    if version == "" { return ""; }
    let commits: List[String] = ft_main_commits(sys, fs_r, cache, repo);
    let mut i: Int = 0;
    while i < list_len(commits) {
        let c: String = list_get(commits, i);
        i = i + 1;
        if ft_version_of(sys, fs_r, cache, repo, c) == version { return c; }
    }
    return "";
}
