// # Fleet Agents - Herdr Socket Sweep And Idle-Workspace Report (RFC 0013)
//
// Logline: Turn one read-only `herdr agent list` snapshot into a per-workspace idle/active/blocked report.
//
// Setup: The parsers need no capability; agents_fetch needs &ProcessCap and runs herdr under a cleaned environment (HOME, XDG_RUNTIME_DIR).
//
// Beats:
//   1. Collect pane_id, agent_status and workspace_id values in document order.
//   2. Align them into one "ws|pane|status" triple per agent object.
//   3. Roll the triples up per workspace: BLOCKED beats ACTIVE beats IDLE; seal the report with a sha3 round.

import "fleettick/btext.oo";
import "std/core/primitives/str.oo";
import "std/sec/pqc.oo";

// Every "key":"value" string value in document order, walked by byte
// position so multibyte titles never skew an offset.
pub fn agents_values(text: String, key: String) -> List[String] {
    let pat: String = "\"" + key + "\":\"";
    let plen: Int = bytes_len(pat);
    let mut out: List[String] = list_new();
    let mut pos: Int = 0;
    while true {
        let i: Int = bt_idx_from(text, pat, pos);
        if i < 0 { return out; }
        let v0: Int = i + plen;
        let q: Int = bt_idx_from(text, "\"", v0);
        if q < 0 { return out; }
        out = list_push(out, bt_slice(text, v0, q));
        pos = q + 1;
    }
}

// One "ws|pane|status" triple per agent object. A field-count mismatch
// degrades to a single ERR triple so corruption is never silent.
pub fn agents_panes(text: String) -> List[String] {
    let panes: List[String] = agents_values(text, "pane_id");
    let stats: List[String] = agents_values(text, "agent_status");
    let wss: List[String] = agents_values(text, "workspace_id");
    let n: Int = list_len(panes);
    if n == 0 { return list_new(); }
    if list_len(stats) != n || list_len(wss) != n {
        return list_push(list_new(), "ERR||misaligned");
    }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(wss, i) + "|" + list_get(panes, i) + "|" + list_get(stats, i));
        i = i + 1;
    }
    return out;
}

// The workspace ids that appear in the triples, in first-seen order.
pub fn agents_ws_names(panes: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(panes) {
        let ws: String = list_get(str_split(list_get(panes, i), "|"), 0);
        if ws != "" {
            let mut seen: Bool = false;
            let mut j: Int = 0;
            while j < list_len(out) {
                if list_get(out, j) == ws { seen = true; }
                j = j + 1;
            }
            if !seen { out = list_push(out, ws); }
        }
        i = i + 1;
    }
    return out;
}

// The verdict of one workspace: BLOCKED when any pane is blocked, else
// ACTIVE when any pane is working, else IDLE. Counts travel with the line.
pub fn agents_ws_verdict(panes: List[String], ws: String) -> String {
    let mut b: Int = 0; let mut w: Int = 0; let mut i2: Int = 0; let mut o: Int = 0;
    let mut i: Int = 0;
    while i < list_len(panes) {
        let parts: List[String] = str_split(list_get(panes, i), "|");
        if list_get(parts, 0) == ws {
            let st: String = list_get(parts, 2);
            if st == "blocked" { b = b + 1; }
            else if st == "working" { w = w + 1; }
            else if st == "idle" || st == "done" { i2 = i2 + 1; }
            else { o = o + 1; }
        }
        i = i + 1;
    }
    let tag: String = if b > 0 { "BLOCKED-WS" } else if w > 0 { "ACTIVE-WS" } else { "IDLE-WS" };
    return tag + " " + ws + " blocked=" + b.to_string() + " working=" + w.to_string()
        + " idle=" + i2.to_string() + " other=" + o.to_string();
}

// The per-workspace report plus its summary line.
pub fn agents_report(text: String) -> List[String] {
    let panes: List[String] = agents_panes(text);
    let wss: List[String] = agents_ws_names(panes);
    let mut out: List[String] = list_new();
    if list_len(panes) > 0 && starts_with(list_get(panes, 0), "ERR|") {
        out = list_push(out, "ERR misaligned agent fields");
    }
    let mut idle: Int = 0; let mut active: Int = 0; let mut blocked: Int = 0;
    let mut i: Int = 0;
    while i < list_len(wss) {
        let v: String = agents_ws_verdict(panes, list_get(wss, i));
        if starts_with(v, "IDLE-WS") { idle = idle + 1; }
        else if starts_with(v, "ACTIVE-WS") { active = active + 1; }
        else { blocked = blocked + 1; }
        out = list_push(out, v);
        i = i + 1;
    }
    out = list_push(out, "workspaces=" + list_len(wss).to_string() + " idle=" + idle.to_string()
        + " active=" + active.to_string() + " blocked=" + blocked.to_string());
    let seal: Int = oo_pqc_sha3_round(bytes_len(text) + list_len(wss) * 131, 20261106);
    return list_push(out, "SEAL " + seal.to_string());
}

// One read-only snapshot of the local Herdr agent list. sys_exec children
// get a minimal PATH, so the binary is pinned under $HOME/.local/bin (the
// fleet install convention) and the child env carries only HOME and
// XDG_RUNTIME_DIR for the socket lookup.
pub fn agents_fetch(p: &ProcessCap, home: String, xdg: String) -> Result[String, String] {
    let bin: String = if home != "" { home + "/.local/bin/herdr" } else { "herdr" };
    return sys_exec(p, "env", "HOME=" + home, "XDG_RUNTIME_DIR=" + xdg, bin, "agent", "list");
}
