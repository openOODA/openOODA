// # Fleet Tick Anchor - Read-Only Mechanical Tick Pages (RFC 0013)
//
// Logline: Re-exports the read-only state sweep, quota meter, agent, and probe pages of the RFC 0013 fleet tick.
//
// Setup: Shim page. sweep.oo, meter.oo, agents.oo and probe/* are the slices; test_sweep.oo is the driver and stays outside the anchor so a main symbol never leaks into importers.
//
// Beats:
//   1. sweep.oo — repository enumeration plus LOCKED/DIRTY/CLEAN/ERR report.
//   2. btext.oo — byte-native text primitives (str_index_of is byte-indexed, str_slice is char-indexed).
//   3. meter.oo — agent usage parsing plus QUOTA verdict lines.
//   4. agents.oo — herdr agent list parsing plus the idle-workspace and live pane quota reports.
//   5. probe/host.oo — per-box disk/mem/proc health lines.
//   6. probe/forge.oo — github tip drift probe (SYNC/DRIFT/GAP).
//   7. out/snap.oo — pack the verdict set and write the fleet state file.
//   8. out/alert.oo — spool one ALERT file per breached condition, clear recovered ones.
//   9. recon/recon.oo — forge-gated sequential fetch + classify + ff-only pull.
//   10. loop/lock.oo — atomic-create single-instance lock with staleness expiry.
//   11. fix/fixrepo.oo — hermetic git fixture builders for the live-path suite.

import "fleettick/btext.oo";
import "fleettick/sweep.oo";
import "fleettick/meter.oo";
import "fleettick/agents.oo";
import "fleettick/probe/host.oo";
import "fleettick/probe/forge.oo";
import "fleettick/recon/recon.oo";
import "fleettick/out/snap.oo";
import "fleettick/out/alert.oo";
import "fleettick/loop/lock.oo";
import "fleettick/fix/fixrepo.oo";
