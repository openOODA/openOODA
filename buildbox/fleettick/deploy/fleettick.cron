# fleettick.cron — cron alternative to fleettick.timer (RFC-0013).
# Append to your crontab (crontab -e) or drop into /etc/cron.d/fleettick
# (prepend a user field there). One line = one 600s tick; the lock file
# inside the binary prevents overlap if a tick runs long.
#
# SHELL and PATH needed so git/df/pgrep/date resolve; herdr is reached
# through OODA_FLEET_HOME/.local/bin/herdr.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# m h dom mon dow   command
# NOTE: cron supplies no XDG_RUNTIME_DIR — derive it via $(id -u).
*/10 * * * * OODA_NO_JAIL=1 OO_LIST_AMBIENT_QUOTA=8589934592 OODA_FLEET_HOME="$HOME" OODA_FLEET_XDG="/run/user/$(id -u)" "$HOME/.local/bin/fleettick" /Projects/openOODA >> "$HOME/.local/state/fleettick.log" 2>&1
