# fleettick.timer — the 600s cadence for fleettick.service (RFC-0013).
# Install: cp to ~/.config/systemd/user/ — operator enables manually;
# this file ships inert, nothing here starts the timer.
[Unit]
Description=Run openOODA fleettick every 10 minutes

[Timer]
# First tick 2 min after login, then every 600s after the last
# service *completion* — ticks can never overlap; the .fleet-tick lock
# is a second line of defense if the unit is started by hand.
OnBootSec=2min
OnUnitActiveSec=600
AccuracySec=30
Persistent=true

[Install]
WantedBy=timers.target
