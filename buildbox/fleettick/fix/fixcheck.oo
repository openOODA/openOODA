// # Recon Fixture Checks - Drive The Live Verdict Paths
//
// Logline: Build the hermetic fixture fleet, run the real fetch/classify/pull pipeline over it, and assert each verdict class fires — plus a real breach alert cycle and a crashed-tick lock steal.
//
// Setup: fixrepo.oo builds the repos; recon_repo/recon_report run the real git pipeline against them; alert_emit and lock_take cover the breach and stale-lock paths. Own expect helpers because the test_sweep ones are page-private.
//
// Beats:
//   1. fx_build -> "OK"; sweep enumerates the eight fixture repos.
//   2. recon_report emits PULLED, DIRTY-SKIP, DIVERGED, DETACHED, NO-TRACK, FETCH_ERR, PULL_ERR, AHEAD plus recon=8.
//   3. Post-state: the pulled repo re-reconciles SYNC; the dirty one stays DIRTY-SKIP.
//   4. CUTOFF verdict spools a real alert file that clears on recovery; a stale lock is stolen.

import "fleettick/fix/fixrepo.oo";
import "fleettick/sweep.oo";
import "fleettick/recon/recon.oo";
import "fleettick/out/alert.oo";
import "fleettick/loop/lock.oo";
import "oostd/fs/os/fs.oo";

fn fc_expect(name: String, got: String, want: String) -> Int {
    if got == want { println("PASS\t" + name);
    return 0; }
    println("FAIL\t" + name + "\twant=" + want + "\tgot=" + got);
    return 1;
}

fn fc_expect_bool(name: String, got: Bool, want: Bool) -> Int {
    let ws: String = if want { "true" } else { "false" };
    let gs: String = if got { "true" } else { "false" };
    if got == want { println("PASS\t" + name);
    return 0; }
    println("FAIL\t" + name + "\twant=" + ws + "\tgot=" + gs);
    return 1;
}

fn fc_expect_has(name: String, hay: List[String], needle: String) -> Int {
    let n: Int = list_len(hay);
    let mut i: Int = 0;
    while i < n {
        if list_get(hay, i) == needle { println("PASS\t" + name);
        return 0; }
        i = i + 1;
    }
    println("FAIL\t" + name + "\tmissing=" + needle + "\tn=" + n.to_string());
    return 1;
}

fn fc_copy(list: List[String]) -> List[String] {
    let n: Int = list_len(list);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n { out = list_push(out, list_get(list, i));
    i = i + 1; }
    return out;
}

pub fn fx_checks(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap) -> Int {
    let mut fails: Int = 0;
    let root: String = "/tmp/fleettick-fxroot";
    fails = fails + fc_expect("fx_build", fx_build(p, fw, root, "/tmp/fleettick-fxseed"), "OK");
    let repos: List[String] = fc_copy(sweep_repos(fr, root));
    fails = fails + fc_expect("fx_enum_count", list_len(repos).to_string(), "8");
    let rep: List[String] = fc_copy(recon_report(p, repos, true));
    fails = fails + fc_expect_has("fx_pulled", rep, "RECON " + root + "/fx-pull PULLED")
        + fc_expect_has("fx_dirty_skip", rep, "RECON " + root + "/fx-dirty DIRTY-SKIP")
        + fc_expect_has("fx_diverged", rep, "RECON " + root + "/fx-diverged DIVERGED")
        + fc_expect_has("fx_detached", rep, "RECON " + root + "/fx-detached DETACHED")
        + fc_expect_has("fx_no_track", rep, "RECON " + root + "/fx-notrack NO-TRACK")
        + fc_expect_has("fx_fetch_err", rep, "RECON " + root + "/fx-fetcherr FETCH_ERR")
        + fc_expect_has("fx_pull_err", rep, "RECON " + root + "/fx-pullerr PULL_ERR")
        + fc_expect_has("fx_ahead", rep, "RECON " + root + "/fx-ahead AHEAD")
        + fc_expect_has("fx_recon_n", rep, "recon=8");
    fails = fails + fc_expect("fx_pulled_syncs", recon_repo(p, root + "/fx-pull"), "RECON " + root + "/fx-pull SYNC")
        + fc_expect("fx_dirty_stays", recon_repo(p, root + "/fx-dirty"), "RECON " + root + "/fx-dirty DIRTY-SKIP");
    let adir: String = "/tmp/fleettick-fixalert";
    let cut: List[String] = list_push(list_push(list_new(), "QUOTA vibe CUTOFF used=97 rem=3"), "CLEAN /a");
    let _e1: List[String] = fc_copy(alert_emit(fw, fr, adir, cut));
    fails = fails + fc_expect_bool("fx_breach_written", fs_path_exists(fr, adir + "/ALERT-cutoff-0.txt"), true);
    let e2: List[String] = fc_copy(alert_emit(fw, fr, adir, list_push(list_new(), "CLEAN /a")));
    fails = fails + fc_expect_has("fx_breach_cleared", e2, "ALERT_CLEAR ALERT-cutoff-0.txt")
        + fc_expect_bool("fx_breach_gone", fs_path_exists(fr, adir + "/ALERT-cutoff-0.txt"), false);
    let lp: String = "/tmp/fleettick-fxlock";
    let _rm: Result[Void, String] = fs_remove_file(fw, lp);
    match fs_write_file(fw, lp, "1000\n") { Ok(_) => { }, Err(_) => { fails = fails + 1; } }
    fails = fails + fc_expect("fx_crash_steal", lock_take(fw, fr, lp, 5000), "TICK_LOCK stole age=4000");
    let _un: String = lock_release(fw, lp);
    return fails;
}
