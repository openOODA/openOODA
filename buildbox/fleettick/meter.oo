// # Fleet Quota Meter - Parses Agent Usage Outputs Into Pacing Verdicts (RFC 0013)
//
// Logline: Turn agent usage text (ledger JSON, pane footers, tool output) into used and remaining percentages plus a pacing verdict.
//
// Setup: Pure byte-native parsing over btext.oo; no capabilities. The caller supplies every text.
//
// Beats:
//   1. Read the unsigned number that follows a marker or ends before it.
//   2. Recognise the fleet's usage shapes: used_pct, remaining_pct, creditUsagePercent, "NN% rem", "NN% remaining", "5h NN%", "NN% · ctx".
//   3. Classify against the pacing floors: >=95 used is CUTOFF, >=90 is THROTTLE, else OK; no number is UNKNOWN.

import "fleettick/btext.oo";
import "std/core/primitives/str.oo";

// The unsigned number that follows a marker, or -1 when the marker is absent.
pub fn meter_after(text: String, key: String) -> Int {
    let idx: Int = bt_idx_from(text, key, 0);
    if idx < 0 { return -1; }
    return bt_uint_at(text, idx + bytes_len(key));
}

// The used percentage inside one usage text. The markers are tried in the
// order the fleet's writers emit them; -1 means the shape is unknown.
pub fn meter_used(text: String) -> Int {
    let c: Int = meter_after(text, "\"creditUsagePercent\":");
    if c >= 0 { return c; }
    let u: Int = meter_after(text, "\"used_pct\":");
    if u >= 0 { return u; }
    let h: Int = meter_after(text, "5h ");
    if h >= 0 && h <= 100 { return h; }
    let d: Int = bt_idx_from(text, "% · ctx", 0);
    if d > 0 { return bt_num_before(text, d); }
    let g: Int = meter_after(text, "usage ");
    if g >= 0 && g <= 100 { return g; }
    return -1;
}

// The remaining percentage inside one usage text, or -1 when unknown.
pub fn meter_remaining(text: String) -> Int {
    let v: Int = meter_after(text, "\"remaining_pct\":");
    if v >= 0 { return v; }
    let r: Int = bt_idx_from(text, "% remaining", 0);
    if r > 0 { return bt_num_before(text, r); }
    let m: Int = bt_idx_from(text, "% rem", 0);
    if m > 0 { return bt_num_before(text, m); }
    return -1;
}

// The pacing verdict for one metered agent: CUTOFF at the 95% reserve
// floor, THROTTLE at the 90% soft line, OK below it, UNKNOWN with no number.
pub fn meter_classify(used: Int, rem: Int) -> String {
    let mut u: Int = used;
    if u < 0 && rem >= 0 && rem <= 100 { u = 100 - rem; }
    if u < 0 || u > 100 { return "UNKNOWN"; }
    if u >= 95 { return "CUTOFF"; }
    if u >= 90 { return "THROTTLE"; }
    return "OK";
}

// One "name|used|rem" triple per ledger entry that carries remaining_pct.
// Entries are the four-space-indented keys of the agents object; the
// shared-policy fields share that indent but hold no remaining_pct.
pub fn meter_entries(doc: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut pos: Int = 0;
    while true {
        let i: Int = bt_idx_from(doc, "\n    \"", pos);
        if i < 0 { return out; }
        let endq: Int = bt_idx_from(doc, "\"", i + 6);
        if endq <= i + 6 { return out; }
        let nxt: Int = bt_idx_from(doc, "\n    \"", i + 6);
        let rpos: Int = bt_idx_from(doc, "\"remaining_pct\":", i + 6);
        if rpos >= 0 && (nxt < 0 || rpos < nxt) {
            let upos: Int = bt_idx_from(doc, "\"used_pct\":", i + 6);
            let u: Int = if upos >= 0 && upos < rpos { bt_uint_at(doc, upos + 11) } else { -1 };
            let us: String = if u >= 0 { u.to_string() } else { "-1" };
            out = list_push(out, bt_slice(doc, i + 6, endq) + "|" + us
                + "|" + bt_uint_at(doc, rpos + 16).to_string());
        }
        pos = i + 6;
    }
}

// The QUOTA verdict line of every metered ledger entry.
pub fn meter_report(doc: String) -> List[String] {
    let entries: List[String] = meter_entries(doc);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(entries) {
        let parts: List[String] = str_split(list_get(entries, i), "|");
        let us_raw: String = list_get(parts, 1);
        let u: Int = if us_raw == "-1" { -1 } else { bt_uint_at(us_raw, 0) };
        let r: Int = bt_uint_at(list_get(parts, 2), 0);
        out = list_push(out, "QUOTA " + list_get(parts, 0) + " " + meter_classify(u, r)
            + " used=" + u.to_string() + " rem=" + r.to_string());
        i = i + 1;
    }
    return out;
}
