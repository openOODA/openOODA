// # Fleet Snapshot - Tick State Capture To A Single File (RFC 0013)
//
// Logline: Pack one tick's complete verdict lines into a state document and write it to the fleet state file.
//
// Setup: &FsWriteCap for the state file write only; packing needs no capability. The caller chooses the path so the page stays free of host layout.
//
// Beats:
//   1. Pack the section lines into one newline-terminated document.
//   2. Write the document to the state path in one fs_write_file call.
//   3. Emit SNAP <path> lines=<n> on success, SNAP_ERR with the reason on failure.

import "oostd/fs/os/fs.oo";

// All lines joined with newlines plus a trailing newline — the complete
// tick state document, deterministic for a given line set.
pub fn snap_pack(lines: List[String]) -> String {
    let mut doc: String = "";
    let mut i: Int = 0;
    let n: Int = list_len(lines);
    while i < n {
        doc = doc + list_get(lines, i) + "\n";
        i = i + 1;
    }
    return doc;
}

// Write the packed state to path; returns the report line either way.
pub fn snap_write(fw: &FsWriteCap, path: String, lines: List[String]) -> String {
    let wr: Result[Void, String] = fs_write_file(fw, path, snap_pack(lines));
    return match wr {
        Ok(_) => "SNAP " + path + " lines=" + list_len(lines).to_string(),
        Err(e) => "SNAP_ERR " + path + " " + e,
    };
}
