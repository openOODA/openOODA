// # Fleet Tick - Mechanical Tick Entrypoint (RFC 0013)
//
// Logline: Run the fleet tick sections and the gated reconcile, then capture the full verdict set to the state file and emit breach alerts to the spool dir.
//
// Setup: &FsReadCap reads repos, the quota ledger, the health config, /proc/meminfo and the spool dir; &ProcessCap runs git (incl. fetch/pull --ff-only behind the forge gate), herdr, df, pgrep; &EnvCap reads OODA_FLEET_HOME / OODA_FLEET_XDG; &FsWriteCap writes the state file and the alert spool.
//
// Beats:
//   1. Admit this instance via the atomic lock or print TICK SKIP and stop.
//   2. Run every section in fixed order: repos, quota, workspaces, health, forge, reconcile, naming, autosnap.
//   3. Pack every verdict into .fleet-state.txt, spool one ALERT file per breached condition, then release the lock.

import "fleettick/sweep.oo";
import "fleettick/meter.oo";
import "fleettick/agents.oo";
import "fleettick/probe/host.oo";
import "fleettick/probe/forge.oo";
import "fleettick/probe/naming.oo";
import "fleettick/autosnap.oo";
import "fleettick/recon/recon.oo";
import "fleettick/out/snap.oo";
import "fleettick/out/alert.oo";
import "fleettick/loop/lock.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

fn sm_print(lines: List[String]) {
    let mut i: Int = 0;
    while i < list_len(lines) { println(list_get(lines, i)); i = i + 1; }
}

// Print a section's lines and append them to the running state list.
fn sm_emit(all: List[String], lines: List[String]) -> List[String] {
    let mut acc: List[String] = all;
    sm_print(lines);
    let mut i: Int = 0;
    while i < list_len(lines) { acc = list_push(acc, list_get(lines, i)); i = i + 1; }
    return acc;
}

// Every section in fixed order; the returned list is the state doc.
fn sm_sections(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, root: String, home: String, xdg: String) -> List[String] {
    let al: Result[String, String] = agents_fetch(p, home, xdg);
    let atext: String = match al { Ok(v) => v, Err(_) => "" };
    let mut all: List[String] = list_new();
    println("-- repos");
    let rl: List[String] = sweep_report(fr, p, root);
    all = sm_emit(all, rl);
    let sum: String = sweep_summary(rl);
    println(sum);
    all = list_push(all, sum);
    println("-- quota");
    let rd: Result[String, String] = fs_read_file(fr, "/Projects/openOODA/.fleet-quota-ledger.json");
    let ql: List[String] = match rd {
        Ok(doc) => meter_report(doc),
        Err(e) => list_push(list_new(), "QUOTA none (ledger unreadable): " + e)
    };
    all = sm_emit(all, ql);
    let pq: List[String] = if atext == "" { list_push(list_new(), "QUOTA panes UNREADABLE") } else { agents_pane_quota(p, home, xdg, atext) };
    all = sm_emit(all, pq);
    println("-- workspaces");
    let wl: List[String] = if atext == "" { list_push(list_new(), "AGENTS_ERR herdr unreadable") } else { agents_report(atext) };
    all = sm_emit(all, wl);
    println("-- health");
    all = sm_emit(all, host_report(p, fr, "/Projects/openOODA/.fleet-health.conf"));
    println("-- forge");
    let fl: List[String] = forge_report(p, "/Projects/openOODA/openOODA");
    all = sm_emit(all, fl);
    let repos: List[String] = sweep_repos(fr, root);
    println("-- reconcile");
    all = sm_emit(all, recon_report(p, repos, recon_gate(fl)));
    println("-- naming");
    all = sm_emit(all, naming_report(p, fr, repos));
    println("-- autosnap");
    all = sm_emit(all, autosnap_report(p, fr, fw, home, repos, recon_gate(fl), "/Projects/openOODA/.fleet-tick/autosnap-index"));
    println("-- snapshot");
    println(snap_write(fw, "/Projects/openOODA/.fleet-state.txt", all));
    println("-- alerts");
    sm_print(alert_emit(fw, fr, "/Projects/openOODA/.fleet-alerts", all));
    return all;
}

// Single-run tick: the external scheduler calls this every 600s; the lock
// refuses a second in-flight instance. Exit 0 on a refused run — a skip is
// cadence behavior, not a failure.
pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let root: String = if list_len(args) > 0 && list_get(args, 0) != "" { list_get(args, 0) } else { "/Projects" };
    let home: String = match env_get(env, "OODA_FLEET_HOME") { Ok(s) => s, Err(_) => "" };
    let xdg: String = match env_get(env, "OODA_FLEET_XDG") { Ok(s) => s, Err(_) => "" };
    let lv: String = lock_take(fw, fr, "/Projects/openOODA/.fleet-tick/lock", lock_now(p));
    println(lv);
    if !lock_ok(lv) { println("TICK SKIP"); return 0; }
    let _done: List[String] = sm_sections(p, fr, fw, root, home, xdg);
    println(lock_release(fw, "/Projects/openOODA/.fleet-tick/lock"));
    println("TICK done");
    return 0;
}
