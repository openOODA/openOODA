// # Fleet Tick - Read-Only Sweep Entrypoint (RFC 0013)
//
// Logline: Run the read-only fleet tick sections: repository states, quota metering, idle workspaces, host health, and the forge probe.
//
// Setup: &FsReadCap reads repos, the quota ledger, the health config and /proc/meminfo; &ProcessCap runs git, herdr, df, pgrep; &EnvCap reads OODA_FLEET_HOME / OODA_FLEET_XDG; &FsWriteCap is admitted but unused (read-only contract).
//
// Beats:
//   1. Sweep the repos under the root and print the verdict lines plus the tally.
//   2. Read .fleet-quota-ledger.json for ledger QUOTA lines, then meter each agent pane's visible text into live QUOTA lines.
//   3. Snapshot the local herdr agent list and print the per-workspace report.
//   4. Run the host health checks and the github forge probe; both stay read-only.

import "fleettick/sweep.oo";
import "fleettick/meter.oo";
import "fleettick/agents.oo";
import "fleettick/probe/host.oo";
import "fleettick/probe/forge.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

fn sm_print(lines: List[String]) {
    let mut i: Int = 0;
    while i < list_len(lines) { println(list_get(lines, i)); i = i + 1; }
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, _fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let root: String = if list_len(args) > 0 && list_get(args, 0) != "" { list_get(args, 0) } else { "/Projects" };
    let home: String = match env_get(env, "OODA_FLEET_HOME") { Ok(s) => s, Err(_) => "" };
    let xdg: String = match env_get(env, "OODA_FLEET_XDG") { Ok(s) => s, Err(_) => "" };
    let al: Result[String, String] = agents_fetch(p, home, xdg);
    let atext: String = match al { Ok(v) => v, Err(_) => "" };
    println("-- repos");
    let lines: List[String] = sweep_report(fr, p, root);
    sm_print(lines);
    println(sweep_summary(lines));
    println("-- quota");
    let rd: Result[String, String] = fs_read_file(fr, "/Projects/openOODA/.fleet-quota-ledger.json");
    match rd {
        Ok(doc) => sm_print(meter_report(doc)),
        Err(e) => println("QUOTA none (ledger unreadable): " + e)
    }
    if atext == "" { println("QUOTA panes UNREADABLE"); } else { sm_print(agents_pane_quota(p, home, xdg, atext)); }
    println("-- workspaces");
    if atext == "" { println("AGENTS_ERR herdr unreadable"); } else { sm_print(agents_report(atext)); }
    println("-- health");
    sm_print(host_report(p, fr, "/Projects/openOODA/.fleet-health.conf"));
    println("-- forge");
    sm_print(forge_report(p, "/Projects/openOODA/openOODA"));
    return 0;
}
