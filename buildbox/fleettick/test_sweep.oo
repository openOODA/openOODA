// # Test Fleet Sweep - Pure-Function Checks For The Read-Only Sweep
//
// Logline: Prove the sweep's pure classifiers and its repository detector against fixed inputs and one known repository.
//
// Setup: FsReadCap for the live detection checks; FsWriteCap + ProcessCap for the /tmp fixtures that prove ERR and .git-file detection; every other check is a pure string function over fixed text.
//
// Beats:
//   1. Porcelain classification: empty and whitespace-only text mean CLEAN, any marker means DIRTY.
//   2. Lock list: the four off-limits repository paths are LOCKED, neighbours are not.
//   3. Enumeration: a known space root yields its known repository; a file root yields none; fixtures prove ERR and .git-file detection.
//   4. Quota metering: every observed usage shape parses and the pacing verdicts hold.
//   5. Idle workspaces: the herdr JSON aligns into triples and the per-workspace verdicts hold.
//   6. Host health and forge probe: config/df/meminfo/ls-remote parsing and the threshold/drift classifiers.

import "fleettick/sweep.oo";
import "fleettick/meter.oo";
import "fleettick/agents.oo";
import "fleettick/probe/host.oo";
import "fleettick/probe/forge.oo";
import "std/fs/os/fs.oo";

fn ts_expect(name: String, got: String, want: String) -> Int {
    if got == want { println("PASS\t" + name); return 0; }
    println("FAIL\t" + name + "\twant=" + want + "\tgot=" + got);
    return 1;
}

fn ts_expect_bool(name: String, got: Bool, want: Bool) -> Int {
    if got == want { println("PASS\t" + name); return 0; }
    let ws: String = if want { "true" } else { "false" };
    let gs: String = if got { "true" } else { "false" };
    println("FAIL\t" + name + "\twant=" + ws + "\tgot=" + gs);
    return 1;
}

fn ts_expect_has(name: String, hay: List[String], needle: String) -> Int {
    let n: Int = list_len(hay);
    let mut i: Int = 0;
    while i < n {
        if list_get(hay, i) == needle { println("PASS\t" + name); return 0; }
        i = i + 1;
    }
    println("FAIL\t" + name + "\tmissing=" + needle + "\tn=" + n.to_string());
    return 1;
}

// Materialise a list eagerly: walk every element into a fresh list so the
// result never depends on when (or whether) the source is realised later.
fn ts_copy(list: List[String]) -> List[String] {
    let n: Int = list_len(list);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n { out = list_push(out, list_get(list, i)); i = i + 1; }
    return out;
}

fn ts_sweep_checks(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap) -> Int {
    let mut fails: Int = 0;
    fails = fails + ts_expect("porcelain_empty_is_clean", sweep_classify(""), "CLEAN");
    fails = fails + ts_expect("porcelain_blank_is_clean", sweep_classify("\n"), "CLEAN");
    fails = fails + ts_expect("porcelain_modified_is_dirty", sweep_classify(" M install.sh\n"), "DIRTY");
    fails = fails + ts_expect("porcelain_untracked_is_dirty", sweep_classify("?? new.oo\n"), "DIRTY");
    fails = fails + ts_expect_bool("locked_std", sweep_locked("/Projects/openOODA-core/std"), true);
    fails = fails + ts_expect_bool("locked_oodar", sweep_locked("/Projects/openOODA-core/oodar"), true);
    fails = fails + ts_expect_bool("locked_oohat", sweep_locked("/Projects/openOODA-agents/oohat"), true);
    fails = fails + ts_expect_bool("unlocked_install", sweep_locked("/Projects/openOODA/install"), false);
    fails = fails + ts_expect_bool("unlocked_sibling", sweep_locked("/Projects/openOODA-core/stdc"), false);
    fails = fails + ts_expect("summary_counts", sweep_summary(list_push(list_push(list_push(list_push(list_new(), "DIRTY /a"), "CLEAN /b"), "ERR /c"), "LOCKED /d")), "repos=4 dirty=1 clean=1 err=1 locked=1");
    let repos: List[String] = ts_copy(sweep_repos(fr, "/Projects/openOODA"));
    let rn: Int = list_len(repos);
    fails = fails + ts_expect("enum_count", rn.to_string(), "6");
    fails = fails + ts_expect_has("enum_finds_governance_repo", repos, "/Projects/openOODA/openOODA");
    fails = fails + ts_expect("enum_file_root_empty", list_len(sweep_repos(fr, "/Projects/openOODA/openOODA/VERSION")).to_string(), "0");
    let _m1: Result[Void, String] = fs_mkdir_p(fw, "/tmp/fleettick-fix/err-repo/.git");
    let _m2: Result[Void, String] = fs_mkdir_p(fw, "/tmp/fleettick-fix/wt-repo");
    let _gf: Result[Void, String] = fs_write_file(fw, "/tmp/fleettick-fix/wt-repo/.git", "gitdir: /nonexistent-gitdir\n");
    let frepos: List[String] = ts_copy(sweep_repos(fr, "/tmp/fleettick-fix"));
    let frep: List[String] = ts_copy(sweep_report(fr, p, "/tmp/fleettick-fix"));
    fails = fails + ts_expect_has("fixture_err_detected", frepos, "/tmp/fleettick-fix/err-repo");
    fails = fails + ts_expect_has("fixture_gitfile_detected", frepos, "/tmp/fleettick-fix/wt-repo");
    fails = fails + ts_expect_has("fixture_err_classified", frep, "ERR /tmp/fleettick-fix/err-repo");
    fails = fails + ts_expect_has("fixture_gitfile_classified", frep, "ERR /tmp/fleettick-fix/wt-repo");
    return fails;
}

fn ts_meter_checks() -> Int {
    let mut fails: Int = 0;
    fails = fails + ts_expect("meter_used_credit", meter_used("{\"creditUsagePercent\":15}").to_string(), "15");
    fails = fails + ts_expect("meter_used_ledger", meter_used("\"used_pct\": 12").to_string(), "12");
    fails = fails + ts_expect("meter_used_5h", meter_used("5h 67% (33% rem, rst 10:00)").to_string(), "67");
    fails = fails + ts_expect("meter_used_vibe_ctx", meter_used("usage 92% · ctx 500k/800k").to_string(), "92");
    fails = fails + ts_expect("meter_rem_ledger", meter_remaining("\"remaining_pct\": 88").to_string(), "88");
    fails = fails + ts_expect("meter_rem_devin", meter_remaining("Pro · 100% remaining (resets in").to_string(), "100");
    fails = fails + ts_expect("meter_rem_paren", meter_remaining("(0% rem, rst Dec1)").to_string(), "0");
    fails = fails + ts_expect("meter_used_unknown", meter_used("no numbers here").to_string(), "-1");
    fails = fails + ts_expect("classify_cutoff", meter_classify(96, 4), "CUTOFF");
    fails = fails + ts_expect("classify_throttle", meter_classify(91, 9), "THROTTLE");
    fails = fails + ts_expect("classify_ok", meter_classify(50, 50), "OK");
    fails = fails + ts_expect("classify_unknown", meter_classify(-1, -1), "UNKNOWN");
    let led: String = "{\n  \"agents\": {\n    \"devin\": {\n      \"used_pct\": 0,\n      \"remaining_pct\": 100\n    },\n    \"vibe\": {\n      \"used_pct\": 90,\n      \"remaining_pct\": 10\n    }\n  }\n}\n";
    fails = fails + ts_expect("entries_count", list_len(meter_entries(led)).to_string(), "2");
    fails = fails + ts_expect("entry_devin", list_get(meter_entries(led), 0), "devin|0|100");
    fails = fails + ts_expect_has("report_vibe_throttle", meter_report(led), "QUOTA vibe THROTTLE used=90 rem=10");
    let conf: String = "disk_warn=85\nmem_warn=90\nproc=herdr\ndisk_path=/\n";
    fails = fails + ts_expect("conf_disk_warn", host_conf_int(conf, "disk_warn").to_string(), "85");
    fails = fails + ts_expect("conf_missing", host_conf_int(conf, "swap_warn").to_string(), "-1");
    fails = fails + ts_expect("conf_str_proc", host_conf_str(conf, "proc"), "herdr");
    fails = fails + ts_expect("disk_pct", host_disk_pct("Filesystem 1K-blocks Used Available Capacity Mounted on\n/dev/sda 1000 450 550 45% /\n").to_string(), "45");
    fails = fails + ts_expect("disk_pct_hdr_pct", host_disk_pct("Filesystem Use% Mounted\n/dev/sda 1000 450 550 67% /\n").to_string(), "67");
    fails = fails + ts_expect("mem_pct", host_mem_pct("MemTotal:       1000 kB\nMemFree:         100 kB\nMemAvailable:    250 kB\n").to_string(), "75");
    fails = fails + ts_expect("health_ok", host_class(80, 85), "OK");
    fails = fails + ts_expect("health_warn", host_class(85, 85), "WARN");
    fails = fails + ts_expect("health_unknown", host_class(-1, 85), "UNKNOWN");
    return fails;
}

fn ts_agent_checks() -> Int {
    let mut fails: Int = 0;
    let js: String = "{\"result\":{\"agents\":[{\"agent_status\":\"idle\",\"pane_id\":\"w3:p1\",\"workspace_id\":\"w3\"},{\"agent_status\":\"working\",\"pane_id\":\"w4:p1\",\"workspace_id\":\"w4\"},{\"agent_status\":\"blocked\",\"pane_id\":\"w4:p2\",\"workspace_id\":\"w4\"}]}}";
    fails = fails + ts_expect("panes_count", list_len(agents_panes(js)).to_string(), "3");
    fails = fails + ts_expect("pane_first", list_get(agents_panes(js), 0), "w3|w3:p1|idle");
    fails = fails + ts_expect_has("ws_idle_w3", agents_report(js), "IDLE-WS w3 blocked=0 working=0 idle=1 other=0");
    fails = fails + ts_expect_has("ws_blocked_w4", agents_report(js), "BLOCKED-WS w4 blocked=1 working=1 idle=0 other=0");
    fails = fails + ts_expect_has("ws_summary", agents_report(js), "workspaces=2 idle=1 active=0 blocked=1");
    fails = fails + ts_expect("panes_empty", list_len(agents_panes("{}")).to_string(), "0");
    fails = fails + ts_expect("panes_misaligned", list_get(agents_panes("{\"pane_id\":\"w1:p1\"}"), 0), "ERR||misaligned");
    let lsr: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/heads/ooda\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\trefs/heads/master\n";
    fails = fails + ts_expect("forge_parse_n", list_len(forge_parse(lsr)).to_string(), "2");
    fails = fails + ts_expect("forge_tip", forge_tip(forge_parse(lsr), "refs/heads/ooda"), "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    fails = fails + ts_expect("forge_tip_missing", forge_tip(forge_parse(lsr), "refs/heads/nope"), "");
    fails = fails + ts_expect("forge_drift_sync", forge_drift("aaa", "aaa"), "SYNC");
    fails = fails + ts_expect("forge_drift_diff", forge_drift("aaa", "bbb"), "DRIFT");
    fails = fails + ts_expect("forge_drift_gap", forge_drift("", "bbb"), "GAP");
    fails = fails + ts_expect("forge_drift_unknown", forge_drift("aaa", ""), "UNKNOWN");
    return fails;
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, _args: List[String]) -> Int {
    let fails: Int = ts_sweep_checks(p, fr, fw) + ts_meter_checks() + ts_agent_checks();
    if fails > 0 { println("FAIL\ttest_sweep\t" + fails.to_string() + " check(s) failed"); return 1; }
    println("Ran 55 checks in pure .oo — OK");
    return 0;
}
