// # Fleet Verify Anchor - The Anchor Of The Verification Of The Fleet
//
// Logline: Re-exports the refs of one repository of the fleet, the tags that carry its releases, the files that it ships and the report of its state.
//
// Setup: Pure shim re-exporting every fleetverify subsystem anchor.
//
// Beats:
//   1. Re-export the refs of one repository of the fleet and the origin that wins over them.
//   2. Re-export the tag that carries the highest release of one repository of the fleet.
//   3. Re-export the files of one repository of the fleet and the checks that read them.

import "fleetverify/verify_ref.oo";
import "fleetverify/verify_tag.oo";
import "fleetverify/verify_files.oo";
