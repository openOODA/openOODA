// # Fleet Verify Files - Reads The Files Of One Repository Of The Fleet
//
// Logline: Reads the version, the installer, the writers and the workflows of one repository of the fleet and tells whether they hold the law of the fleet.
//
// Setup: Needs ProcessCap for git and FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Read the version that the default branch of one repository of the fleet carries.
//   2. Report whether it ships an installer.
//   3. Count the trailers of another writer that its history holds.
//   4. Name the writers of its history.
//   5. Tell whether every workflow of it is a sound document of YAML.

import "oostd/core/primitives/str.oo";
import "oostd/core/text/num_buffer.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetverify/verify_ref.oo";

// The version that the default branch of one repository of the fleet carries.
pub fn vf_version(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "show");
    a = list_push(a, "origin/main:VERSION");
    let _o: String = vf_git(sys, fs_r, cache, repo, a);
    if fc_code(fs_r, cache) != 0 { return ""; }
    return text_trim(fc_all(fs_r, cache));
}

// Report whether the default branch of one repository of the fleet ships an
// installer.
pub fn vf_has_install(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "cat-file");
    a = list_push(a, "-e");
    a = list_push(a, "origin/main:install.sh");
    let _o: String = vf_git(sys, fs_r, cache, repo, a);
    return fc_code(fs_r, cache) == 0;
}

// Count how many times one text holds one word.
fn vf_count(body: String, word: String) -> Int {
    let mut n: Int = 0;
    let mut rest: String = body;
    while str_contains(rest, word) {
        rest = str_replace(rest, word, "");
        n = n + 1;
    }
    return n;
}

// Count how many trailers of another writer the history of one repository of
// the fleet holds. The name of a trailer is written in many a case, so the
// count is made without regard to it.
pub fn vf_trailer_count(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> Int {
    let mut a: List[String] = list_new();
    a = list_push(a, "log");
    a = list_push(a, "--format=%B");
    a = list_push(a, "origin/main");
    let _o: String = vf_git(sys, fs_r, cache, repo, a);
    if fc_code(fs_r, cache) != 0 { return -1; }
    let body: String = to_uppercase(fc_all(fs_r, cache));
    let mut n: Int = 0;
    n = n + vf_count(body, "CO-AUTHORED-BY:");
    n = n + vf_count(body, "GENERATED BY ");
    n = n + vf_count(body, "GENERATED WITH ");
    n = n + vf_count(body, "SIGNED-OFF-BY:");
    return n;
}

// Name the writers of the history of one repository of the fleet. Every
// writer of the law of the fleet is one writer, and the answer names them
// all so that a second one can be seen.
pub fn vf_authors(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "log");
    a = list_push(a, "--format=%an <%ae>");
    a = list_push(a, "origin/main");
    let _o: String = vf_git(sys, fs_r, cache, repo, a);
    if fc_code(fs_r, cache) != 0 { return "?"; }
    let lines: List[String] = text_split_lines(fc_all(fs_r, cache));
    let mut out: String = "";
    let mut seen: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let name: String = text_trim(list_get(lines, i));
        i = i + 1;
        if name == "" { continue; }
        let mut known: Bool = false;
        let mut j: Int = 0;
        while j < list_len(seen) {
            if list_get(seen, j) == name { known = true; }
            j = j + 1;
        }
        if known { continue; }
        seen = list_push(seen, name);
        if out != "" { out = out + ","; }
        out = out + name;
    }
    return out;
}

// The workflow files of the default branch of one repository of the fleet.
fn vf_yaml_files(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> List[String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "ls-tree");
    a = list_push(a, "-r");
    a = list_push(a, "--name-only");
    a = list_push(a, "origin/main");
    a = list_push(a, ".github/workflows");
    let _o: String = vf_git(sys, fs_r, cache, repo, a);
    let mut out: List[String] = list_new();
    let lines: List[String] = text_split_lines(fc_all(fs_r, cache));
    let mut i: Int = 0;
    while i < list_len(lines) {
        let p: String = text_trim(list_get(lines, i));
        i = i + 1;
        if p == "" { continue; }
        if ends_with(p, ".yml") || ends_with(p, ".yaml") { out = list_push(out, p); }
    }
    return out;
}

// Tell whether every workflow of one repository of the fleet is a sound
// document of YAML. The answer is NONE when the repository holds no workflow
// at all, and BAD when one of them is no document.
pub fn vf_yaml(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String, tool: String) -> String {
    let files: List[String] = vf_yaml_files(sys, fs_r, cache, repo);
    if list_len(files) == 0 { return "NONE"; }
    let mut bad: Int = 0;
    let mut i: Int = 0;
    while i < list_len(files) {
        let p: String = list_get(files, i);
        i = i + 1;
        let mut a: List[String] = list_new();
        a = list_push(a, "show");
        a = list_push(a, "origin/main:" + p);
        let _o: String = vf_git(sys, fs_r, cache, repo, a);
        let tmp: String = "/tmp/fleetverify-" + tool + "-" + int_to_str(i) + ".yml";
        let _w: Result[Void, String] = fs_write_file(fs_w, tmp, fc_all(fs_r, cache));
        let mut c: List[String] = list_new();
        c = list_push(c, "-c");
        c = list_push(c, "import yaml,sys;yaml.safe_load(open(sys.argv[1]))");
        c = list_push(c, tmp);
        let _p: String = fc_run(sys, fs_r, cache, "python3", c);
        if fc_code(fs_r, cache) != 0 { bad = bad + 1; }
        let _d: Result[Void, String] = fs_remove_file(fs_w, tmp);
    }
    if bad == 0 { return "OK"; }
    return "BAD";
}
