// # Fleet Network Clean - The Installers That The Packaging Of A Repo Must Not Carry
//
// Logline: Takes the installer scripts of a package away from one repository when those scripts are present.
//
// Setup: Needs FsReadCap and FsWriteCap for the packaging directory.
//
// Beats:
//   1. Name the installer scripts that the packaging of a repo must not carry.
//   2. Take every installer script that is present away from that packaging.

import "std/fs/os/fs.oo";

// Take the installer scripts of the packaging of one repo away. The answer
// holds the number of the files that were taken away.
pub fn nw_clean_installers(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let mut removed: Int = 0;
    let mut names: List[String] = list_new();
    names = list_push(names, "install-apt.sh");
    names = list_push(names, "install-dnf.sh");
    names = list_push(names, "install-rpm.sh");
    names = list_push(names, "install-arch.sh");
    names = list_push(names, "install-pacman.sh");
    names = list_push(names, "install-zypper.sh");
    let mut i: Int = 0;
    while i < list_len(names) {
        let p: String = repo + "/packaging/" + list_get(names, i);
        i = i + 1;
        if path_exists(fs_r, p) {
            let _r: Result[Void, String] = fs_remove_file(fs_w, p);
            removed = removed + 1;
        }
    }
    return removed;
}
