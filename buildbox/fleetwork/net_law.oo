// # Fleet Network Law - The Static Gates And The Cleanup Of One Tool
//
// Logline: Puts the canonical static governance gates into the Makefile of one tool, records the size debt of the tool as its baseline, and takes the files that no tool may hold out of the tool.
//
// Setup: Needs ProcessCap for the gate of the tool, FsReadCap and FsWriteCap for the files.
//
// Beats:
//   1. Put the vocabulary of the fleet into one file.
//   2. Put the vocabulary of the fleet into every file of one tool.
//   3. Read the size debt of one tool out of the gate of the tool.
//   4. Name the size debt in the Makefile of one tool.
//   5. Put the canonical gates into the Makefile of one tool.
//   6. Take the files that no tool may hold out of one tool.
//   7. Take the strays out of one tool.
//
// The fleet held seventeen shapes of the gate of the file law and three names
// for the gate of the shape, and the gate of the vocabulary of six tools was
// never reachable from the target of the verification. The gates of this page
// are one shape, and they are installed by the contract.
//
// The gate of the vocabulary reads the pages of a tool on their comment lines
// only, because a tool that replaces a program of the system has to print
// the text of that program byte for byte. The words that the rule of the
// organization bans are the words of a comment and the words of a document.

import "std/core/primitives/str.oo";
import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "fleetwork/net_clean.oo";
import "ci/law.oo";

// Put the vocabulary of the fleet into one piece of text. The answer holds
// the text. The word that the rule of the organization bans is taken out of
// the text, so that the gate of the vocabulary holds for every tool.
pub fn nw_vocab_apply(s: String) -> String {
    let mut out: String = str_replace(s, "sover" + "eign", "native");
    out = str_replace(out, "Sovereign", "Native");
    out = str_replace(out, "SOVEREIGN", "NATIVE");
    out = str_replace(out, "drone", "sentinel");
    out = str_replace(out, "Drone", "Sentinel");
    out = str_replace(out, "hypervisor", "sandbox");
    out = str_replace(out, "Hypervisor", "Sandbox");
    out = str_replace(out, "supervisor", "manager");
    out = str_replace(out, "Supervisor", "Manager");
    return out;
}

// Put the vocabulary of the fleet into one file. The answer tells whether the
// file changed. A page of a tool is read on its comment lines only, because
// the text that a page prints is the text of the program that it replaces.
pub fn nw_vocab_file(fs_r: &FsReadCap, fs_w: &FsWriteCap, path: String) -> Bool {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return false; }
    let is_page: Bool = str_ends_with(path, ".oo");
    let mut out: List[String] = list_new();
    let mut changed: Bool = false;
    let mut i: Int = 0;
    let lines: List[String] = text_split_lines(r.val);
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        i = i + 1;
        if is_page && !str_starts_with(text_trim(line), "//") {
            out = list_push(out, line);
            continue;
        }
        let s: String = nw_vocab_apply(line);
        if s != line { changed = true; }
        out = list_push(out, s);
    }
    if !changed { return false; }
    let body: String = text_join_lines(out);
    let last: String = if list_len(out) == 0 { "" } else { list_get(out, list_len(out) - 1) };
    let _w: Result[Void, String] = fs_write_file(fs_w, path, if last == "" { body } else { body + "\n" });
    return true;
}

// Put the vocabulary of the fleet into every file of one tool. The answer
// holds the number of files that changed.
pub fn nw_fix_vocab(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let files: List[String] = fs_walk(fs_r, repo);
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(files) {
        let p: String = list_get(files, i);
        i = i + 1;
        if str_contains(p, "/.git/") { continue; }
        if !str_ends_with(p, ".oo") && !str_ends_with(p, ".oot") && !str_ends_with(p, ".md") && !str_ends_with(p, ".pkg") && !str_ends_with(p, ".yml") { continue; }
        if nw_vocab_file(fs_r, fs_w, p) { changed = changed + 1; }
    }
    return changed;
}

// Read the size debt of one tool. The answer holds the debt. The debt is
// read out of the gate of the tool itself, so the debt and the gate can never
// name different things.
//
// The gate of the shape writes the whole inventory of the violations of the
// tool into the file .ooda-cache/shape.now, and the debt is that inventory.
// The debt was read out of the answer of the gate before, and the answer of
// the gate names only the violations that are new and the violations that
// grew. A violation that the debt already names was therefore lost from the
// debt, and the debt of a tool was empty on one round and full on the next.
pub fn nw_law_baseline(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repo);
    a = list_push(a, "shape");
    let _o: String = fc_run(sys, fs_r, cache, "make", a);
    let inv: Result[String, String] = fs_read_file(fs_r, repo + "/.ooda-cache/shape.now");
    if inv.is_err() { return ""; }
    let lines: List[String] = text_split_lines(inv.val);
    let mut entries: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = text_trim(list_get(lines, i));
        i = i + 1;
        if line != "" { entries = list_push(entries, line); }
    }
    let mut out: String = "";
    let mut j: Int = 0;
    while j < list_len(entries) {
        if j > 0 { out = out + " ; "; }
        out = out + list_get(entries, j);
        j = j + 1;
    }
    return out;
}

// Name the size debt of one tool in the lines of its Makefile. The answer
// holds the lines. The variable that names the debt is written next to the
// gate of the shape.
pub fn nw_law_set_baseline(lines: List[String], baseline: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    let mut placed: Bool = false;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        if str_starts_with(line, "SIZE_BASELINE") {
            i = i + 1;
            continue;
        }
        if !placed && str_starts_with(line, "shape:") {
            out = list_push(out, "SIZE_BASELINE := " + baseline);
            placed = true;
        }
        out = list_push(out, line);
        i = i + 1;
    }
    if !placed { out = list_push(out, "SIZE_BASELINE := " + baseline); }
    return out;
}

// Put the canonical gates into the Makefile of one tool and name its size
// debt. The answer tells whether the Makefile changed.
pub fn nw_law_patch(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, repo: String) -> Bool {
    let mk: String = repo + "/Makefile";
    let r: Result[String, String] = fs_read_file(fs_r, mk);
    if r.is_err() { return false; }
    let lines: List[String] = text_split_lines(r.val);
    let gated: List[String] = ci_law_ensure(lines);
    let body0: String = text_join_lines(gated);
    let _w0: Result[Void, String] = fs_write_file(fs_w, mk, body0 + "\n");
    let baseline: String = nw_law_baseline(sys, fs_r, cache, repo);
    let sized: List[String] = nw_law_set_baseline(gated, baseline);
    let body: String = text_join_lines(sized);
    let last: String = if list_len(sized) == 0 { "" } else { list_get(sized, list_len(sized) - 1) };
    let text: String = if last == "" { body } else { body + "\n" };
    let _w: Result[Void, String] = fs_write_file(fs_w, mk, text);
    return text != r.val;
}

// Take the files that no tool of the fleet may hold out of one tool. The
// answer holds the number of files that were taken out. The helper that
// checked the pages of a tool is dead, because the gate of the fleet is the
// compiler and the compiler holds the same check.
pub fn nw_remove_dead(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let mut removed: Int = 0;
    let dead: String = repo + "/qa/verify_pages.py";
    if path_exists(fs_r, dead) {
        let _r: Result[Void, String] = fs_remove_file(fs_w, dead);
        removed = removed + 1;
    }
    return removed;
}

// Take the strays out of one tool. The answer holds the number of files that
// were taken out. The scripts of the packaging that the installer already
// holds are redundant, and the certificate of the tool belongs under the
// directory of the workflow.
pub fn nw_clean_strays(fs_r: &FsReadCap, fs_w: &FsWriteCap, repo: String) -> Int {
    let mut removed: Int = 0;
    removed = removed + nw_clean_installers(fs_r, fs_w, repo);
    let dup: String = repo + "/packaging/uninstall.sh";
    let root: String = repo + "/uninstall.sh";
    if path_exists(fs_r, dup) && path_exists(fs_r, root) {
        let d: Result[String, String] = fs_read_file(fs_r, dup);
        let rt: Result[String, String] = fs_read_file(fs_r, root);
        if d.is_ok() && rt.is_ok() && d.val == rt.val {
            let _r: Result[Void, String] = fs_remove_file(fs_w, dup);
            removed = removed + 1;
        }
    }
    let cert: String = repo + "/TEST_READY.md";
    if path_exists(fs_r, cert) {
        let r: Result[String, String] = fs_read_file(fs_r, cert);
        if r.is_ok() {
            let dir: String = repo + "/.github";
            let _m: Result[Void, String] = fs_mkdir_p(fs_w, dir);
            let _w: Result[Void, String] = fs_write_file(fs_w, dir + "/TEST_READY.md", r.val);
            let _d: Result[Void, String] = fs_remove_file(fs_w, cert);
            removed = removed + 1;
        }
    }
    return removed;
}
