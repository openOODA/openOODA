// # Fleet Network Push - One Ref Of A Repo Onto One Branch Of The Origin
//
// Logline: Pushes one ref of one repository onto one branch of the origin of that repository.
//
// Setup: Needs ProcessCap for git and FsReadCap for the captured output.
//
// Beats:
//   1. Push one ref of a repository onto one branch of the origin of that repository.
//   2. Report whether that push went through.

import "fleetctl/shell.oo";

// Push one ref of a repository onto one branch of the origin of that
// repository. The answer tells whether the push went through.
pub fn nw_push_branch(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, repo: String, src: String, dst: String) -> Bool {
    let mut p: List[String] = list_new();
    p = list_push(p, "-C");
    p = list_push(p, repo);
    p = list_push(p, "push");
    p = list_push(p, "--quiet");
    p = list_push(p, "origin");
    p = list_push(p, src + ":refs/heads/" + dst);
    let _o: String = fc_run(sys, fs_r, cache, "git", p);
    return fc_code(fs_r, cache) == 0;
}
