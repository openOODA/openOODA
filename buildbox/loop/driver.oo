// # Loop Driver - The Steps One Loop Run Executes
//
// Logline: Holds the individual steps of a loop run so the entry point stays small and every step can be tested alone.
//
// Setup: Needs ProcessCap for the compiler, git, make, and curl. Needs FsReadCap and FsWriteCap for the checkouts and the queue.
//
// Beats:
//   1. Read one environment value with a fallback.
//   2. Create the working directories.
//   3. Rebuild the compiler with the sanctioned boot-strap script.
//   4. Run the compiler gate.
//   5. Resolve the repo list for the run.
//   6. Fetch every repo and read its state.
//   7. Run the fleet gate over every repo and write the verdicts.
//   8. Prepare the run: compiler, cache purge, then the gate.

import "oostd/core/text/num_buffer.oo";
import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "oostd/fs/process/env.oo";
import "fleet/anchor.oo";
import "text/json.oo";
import "loop/cache.oo";
import "loop/gh_api.oo";
import "loop/manifest.oo";
import "loop/setup.oo";

// Rebuild the compiler with the sanctioned boot-strap script. The working
// directory is set by the env command, so no shell string is needed.
pub fn loop_driver_build_compiler(sys: &ProcessCap, repos: String, out_bin: String) -> Int {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, repos);
    a = list_push(a, "bash");
    a = list_push(a, "oodac/boot" + "strap/oodac_pure_build");
    a = list_push(a, "oodac/main.oo");
    a = list_push(a, out_bin);
    let r: Result[Int, String] = sys_exec_wait(sys, "env", a);
    let mut code: Int = 1;
    if r.is_ok() { code = r.val; }
    return code;
}

// Build the compiler gate with the compiler that was just built. The gate
// must exercise the new compiler, never the seed compiler.
//
// The compiler builds a module the per module way, and that path asks the
// environment for the compiler that runs it. The child process therefore
// needs OODA_COMPILER, or the build fails closed with "OODA_COMPILER or
// OODAC_BIN required" and the gate never runs.
//
// The build runs in the compiler checkout, because the gate reaches the
// runtime source of the compiler through the parent walk of the working
// directory. The runtime is a sibling checkout, so the gate only finds
// oodar/oodar.c when the working directory is the compiler checkout itself.
pub fn loop_driver_build_gate(sys: &ProcessCap, oodac_dir: String, compiler: String, gate_bin: String) -> Int {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, oodac_dir);
    a = list_push(a, "OODA_COMPILER=" + compiler);
    a = list_push(a, compiler);
    a = list_push(a, "build");
    a = list_push(a, "qa/audit_gate.oo");
    a = list_push(a, "-o");
    a = list_push(a, gate_bin);
    let r: Result[Int, String] = sys_exec_wait(sys, "env", a);
    let mut code: Int = 1;
    if r.is_ok() { code = r.val; }
    return code;
}

// Run the compiler gate. The gate reads its fixtures relative to the compiler
// checkout, so the working directory is set with env and argv.
//
// The gate builds fixtures with the compiler that was just built, so that
// compiler is named in the environment of the child process as well.
pub fn loop_driver_run_gate(sys: &ProcessCap, compiler: String, oodac_dir: String, gate_bin: String) -> Int {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, oodac_dir);
    a = list_push(a, "OODA_COMPILER=" + compiler);
    a = list_push(a, gate_bin);
    a = list_push(a, "--compiler");
    a = list_push(a, compiler);
    let r: Result[Int, String] = sys_exec_wait(sys, "env", a);
    let mut code: Int = 1;
    if r.is_ok() { code = r.val; }
    return code;
}

// Resolve the repo list for the run.
//   no flag: the four core repos only.
//   OODA_FLEET: the four core repos plus the shipped tools in the catalog.
//   OODA_FLEET_ALL: the four core repos plus every repo of the organization
//   (or all five organizations when org is "all"), read from the GitHub API.
pub fn loop_driver_repo_list(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, cache: String,
    org: String) -> List[String] {
    let mut names: List[String] = loop_manifest_core_repos();
    let fleet: String = loop_setup_env_or(env, "OODA_FLEET", "");
    let all: String = loop_setup_env_or(env, "OODA_FLEET_ALL", "");
    if all == "1" {
        let token: String = loop_setup_env_or(env, "OODA_GITHUB_TOKEN", "");
        let found: List[String] = if org == "all" { loop_manifest_multi_org_names(sys, fs_w, cache,
            token) } else { loop_manifest_repo_names(sys, fs_w, cache, token, org) };
        let mut i: Int = 0;
        while i < list_len(found) {
            let n: String = list_get(found, i);
            if n != "" && n != ".github" && !str_contains(n, ".github.io") {
                names = list_push(names, n);
            }
            i = i + 1;
        }
    } else if fleet == "1" {
        let shipped: List[String] = fleet_catalog_tools(sys, fs_r, cache);
        let mut i: Int = 0;
        while i < list_len(shipped) {
            names = list_push(names, list_get(shipped, i));
            i = i + 1;
        }
    }
    return names;
}

// Fetch every repo and read its state.
pub fn loop_driver_fetch_all(sys: &ProcessCap, fs_r: &FsReadCap, names: List[String], core_org: String, org: String,
    repos: String, git_base: String) -> List[LoopRepo] {
    let mut states: List[LoopRepo] = list_new();
    let mut i: Int = 0;
    while i < list_len(names) {
        let entry: String = list_get(names, i);
        let name: String = loop_manifest_repo_name(entry);
        let fallback_org: String = if name == "openOODA" { "openOODA" } else if name == "oodac" || name == "oodar" ||
            name == "std" || name == "std-hw" { core_org } else { org };
        let repo_org: String = loop_manifest_entry_org(entry, fallback_org);
        let dir: String = repos + "/" + name;
        let st: LoopRepo = loop_manifest_collect(sys, fs_r, git_base, repo_org, name, dir);
        if !st.ok {
            println("ERR\tloop\tfetch failed for " + name);
        }
        states = list_push(states, st);
        i = i + 1;
    }
    return states;
}

// Run the fleet gate over every repo and write one verdict line per repo.
// The returned counts keep the three states apart: a repo that earned a
// pass, a repo that is still a backlog state, and a repo that failed the
// gate. A backlog state is not a failure, because the four core repos and
// the stubs of the fleet carry no build target and must never be read as a
// broken tool.
pub fn loop_driver_gate_all(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, states: List[LoopRepo], run_id: String,
    queue: String, compiler: String) -> FleetCounts {
    let verdict_path: String = queue + "/fleet_verdicts.oot";
    let manifest_path: String = queue + "/manifest/fleet.json";
    // The verdict file holds the verdicts of ONE run. A file that kept every
    // run would make the repair step walk the failures of every run that came
    // before, and open the same pull request again and again.
    let _t: Result[Void, String] = fs_write_file(fs_w, verdict_path, "");
    let mut manifest: String = "{\"run_id\":\"" + run_id + "\",\"repos\":[";
    let mut passed: Int = 0;
    let mut backlog: Int = 0;
    let mut failed: Int = 0;
    let mut j: Int = 0;
    while j < list_len(states) {
        let st: LoopRepo = list_get(states, j);
        if !st.ok {
            failed = failed + 1;
            j = j + 1;
            continue;
        }
        let line: String = fleet_gate_repo(sys, fs_r, fs_w, st.name, st.branch, st.sha, st.dir,
            BagFleetGateRepo { has_build: st.has_build, has_ci: st.has_ci, run_id: run_id, compiler: compiler });
        let _w: Bool = fleet_gate_write(fs_w, verdict_path, line);
        let verdict: String = fleet_verdict_line_verdict(line);
        if fleet_verdict_is_pass(verdict) { passed = passed + 1; }
        else if fleet_verdict_is_backlog(verdict) { backlog = backlog + 1; }
        else { failed = failed + 1; }
        if j > 0 { manifest = manifest + ","; }
        manifest = manifest + fleet_manifest_record(st.name, st.branch, st.sha, st.modules, st.has_build, st.has_ci, st.dir);
        j = j + 1;
    }
    manifest = manifest + "]}";
    let _mw: Result[Void, String] = fs_write_file(fs_w, manifest_path, manifest + "\n");
    return FleetCounts { passed: passed, backlog: backlog, failed: failed };
}

// Prepare the run: rebuild the compiler, purge the caches that are keyed by
// source only, and run the compiler gate. Returns 0 when the run may go on.
pub fn loop_driver_prepare(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, repos: String, cache: String,
    out_bin: String) -> Int {
    let build_rc: Int = loop_driver_build_compiler(sys, repos, out_bin);
    if build_rc != 0 {
        println("ERR\tloop\tbuild failed");
        return 1;
    }
    let runtime_rc: Int = loop_setup_build_runtime(sys, repos);
    if runtime_rc != 0 {
        println("ERR\tloop\truntime build failed");
        return 4;
    }
    let stamp: String = loop_cache_compiler_stamp(sys, out_bin);
    let stamp_path: String = loop_cache_stamp_path(cache);
    if loop_cache_changed(fs_r, stamp_path, stamp) {
        let purged: Bool = loop_cache_purge(sys, fs_r, fs_w, repos + "/oodac");
        if !purged { println("ERR\tloop\tcache purge failed"); }
        let _s: Bool = loop_cache_store(fs_w, stamp_path, stamp);
    }
    let gate_bin: String = cache + "/audit_gate.bin";
    let gate_build_rc: Int = loop_driver_build_gate(sys, repos + "/oodac", out_bin, gate_bin);
    if gate_build_rc != 0 {
        println("ERR\tloop\tgate build failed");
        return 2;
    }
    let gate_rc: Int = loop_driver_run_gate(sys, out_bin, repos + "/oodac", gate_bin);
    if gate_rc != 0 {
        println("ERR\tloop\tgate failed");
        return 3;
    }
    return 0;
}

// The result of one loop run.
type LoopResult = struct {
    repos: Int,
    passed: Int,
    backlog: Int,
    failed: Int,
    gate_rc: Int
};

// Run the gate phase: resolve inventory, fetch repos, rebuild compiler, and run gate.
pub fn loop_driver_execute(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, cfg: LoopCfg,
    out_bin: String) -> LoopResult {
    let names: List[String] = loop_driver_repo_list(sys, fs_r, fs_w, env, cfg.cache, cfg.org);
    println("loop repos=" + int_to_str(list_len(names)));
    let states: List[LoopRepo] = loop_driver_fetch_all(sys, fs_r, names, cfg.core_org, cfg.org, cfg.repos, cfg.git_base);
    let prep: Int = loop_driver_prepare(sys, fs_r, fs_w, cfg.repos, cfg.cache, out_bin);
    if prep != 0 {
        return LoopResult { repos: list_len(states), passed: 0, backlog: 0, failed: list_len(states), gate_rc: prep };
    }
    let stamp: String = loop_cache_compiler_stamp(sys, out_bin);
    let run_id: String = loop_manifest_run_id(stamp, states);
    let counts: FleetCounts = loop_driver_gate_all(sys, fs_r, fs_w, states, run_id, cfg.queue, out_bin);
    return LoopResult { repos: list_len(states), passed: counts.passed, backlog: counts.backlog, failed: counts.failed,
        gate_rc: 0 };
}
