// # Loop Lock - Single Flight Guard For The Buildbox Loop
//
// Logline: Holds one lock file so the hourly timer and the nightly timer never run the loop together.
//
// Setup: Needs ProcessCap for the clock probe, FsReadCap and FsWriteCap for the lock file.
//
// Beats:
//   1. Take the lock with an atomic hard link, which fails when the lock exists.
//   2. Measure the age of an existing lock so a crashed run cannot block forever.
//   3. Release the lock by removing the lock file.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";

pub fn loop_lock_age_seconds(sys: &ProcessCap, path: String) -> Int {
    let sr: Result[String, String] = sys_exec(sys, "stat", "-c", "%Y", path);
    if sr.is_err() { return 0; }
    let dr: Result[String, String] = sys_exec(sys, "date", "+%s");
    if dr.is_err() { return 0; }
    let pr: Result[Int, String] = parse_int(text_trim(sr.val));
    let mut m: Int = 0;
    if pr.is_ok() { m = pr.val; }
    let qr: Result[Int, String] = parse_int(text_trim(dr.val));
    let mut n: Int = 0;
    if qr.is_ok() { n = qr.val; }
    if n <= m { return 0; }
    return n - m;
}

// Take the lock. Returns 1 when this run holds it, 0 when another run holds it.
pub fn loop_lock_take(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, lock_path: String, stale_seconds: Int) -> Int {
    let src: String = lock_path + ".src";
    let w: Result[Void, String] = fs_write_file(fs_w, src, "ooda-buildbox loop lock\n");
    if w.is_err() { return 0; }
    let link: Result[Void, String] = fs_hardlink(fs_w, src, lock_path);
    if link.is_ok() { return 1; }
    let age: Int = loop_lock_age_seconds(sys, lock_path);
    if age <= stale_seconds { return 0; }
    let rm: Result[Void, String] = fs_remove_file(fs_w, lock_path);
    if rm.is_err() { return 0; }
    let link2: Result[Void, String] = fs_hardlink(fs_w, src, lock_path);
    if link2.is_ok() { return 1; }
    return 0;
}

pub fn loop_lock_release(fs_w: &FsWriteCap, lock_path: String) {
    let rm: Result[Void, String] = fs_remove_file(fs_w, lock_path);
    if rm.is_err() { return; }
    return;
}
