// # Loop Manifest - The Fleet Inventory The Gate Iterates
//
// Logline: Reads the repo list from the GitHub API and records the branch and identity of every repo.
//
// Setup: Needs ProcessCap for git, FsWriteCap for the manifest file, and the cache directory for the credential header.
//
// Beats:
//   1. Reduce a full name to the repo name.
//   2. Collect the repo names of every page of the organization repository list.
//   3. Resolve the default branch and the head commit of one repo.
//   4. Fetch one repo and read its state.
//   5. Derive the run identity from the compiler and the head commits.
//
// The repo list comes from the API on every run so a new repository is picked
// up without editing any inventory. The default branch comes from the remote
// so no branch name is ever hardcoded.

import "oostd/core/text/num_buffer.oo";
import "oostd/core/primitives/str.oo";
import "text/json.oo";
import "text/hash.oo";
import "fleet/manifest.oo";
import "loop/fetch.oo";
import "loop/gh_api.oo";

// Reduce a full name such as openOODA-tools/oogrep to the repo name. A name
// that carries no organization is already the name of the repo and is given
// back unchanged.
pub fn loop_manifest_repo_name(full_name: String) -> String {
    let n: Int = chars_len(full_name);
    let mut cut: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if char_at(full_name, i) == "/" { cut = i; }
        i = i + 1;
    }
    if cut < 0 { return full_name; }
    if cut + 1 >= n { return full_name; }
    return str_slice(full_name, cut + 1, n);
}

// Collect the repo names of every page of the organization repository list.
pub fn loop_manifest_repo_names(sys: &ProcessCap, fs_w: &FsWriteCap, cache_dir: String, token: String,
    org: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut page: Int = 1;
    while page <= 10 {
        let url: String = "https://api.github.com/orgs/" + org + "/repos?per_page=100&type=public&page=" + int_to_str(page);
        let doc: String = gh_api_get(sys, fs_w, cache_dir, token, url);
        if doc == "" { break; }
        let names: List[String] = json_string_values(doc, "full_name");
        let mut i: Int = 0;
        while i < list_len(names) {
            out = list_push(out, loop_manifest_repo_name(list_get(names, i)));
            i = i + 1;
        }
        if list_len(names) < 100 { break; }
        page = page + 1;
    }
    return out;
}



// The five core repos that the compiler gate needs.
pub fn loop_manifest_core_repos() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "openOODA-core/oodac");
    out = list_push(out, "openOODA-core/oodar");
    out = list_push(out, "openOODA-core/oostd");
    out = list_push(out, "openOODA/openOODA");
    return out;
}

// The state of one repo after the fetch pass.
type LoopRepo = struct {
    org: String,
    name: String,
    branch: String,
    sha: String,
    dir: String,
    modules: Int,
    has_build: Bool,
    has_ci: Bool,
    ok: Bool
};

// Fetch one repo and read its state. The branch comes from the remote.
pub fn loop_manifest_collect(sys: &ProcessCap, fs_r: &FsReadCap, base: String, org: String, name: String,
    dir: String) -> LoopRepo {
    let branch: String = loop_manifest_branch(sys, base, org, name);
    if branch == "" {
        return LoopRepo { org: org, name: name, branch: "", sha: "", dir: dir, modules: 0, has_build: false, has_ci: false,
            ok: false };
    }
    let fetched: Bool = loop_fetch_repo(sys, fs_r, base, org, name, branch, dir);
    if !fetched {
        return LoopRepo { org: org, name: name, branch: branch, sha: "", dir: dir, modules: 0, has_build: false, has_ci: false,
            ok: false };
    }
    let sha: String = loop_manifest_head_sha(sys, base, org, name);
    let modules: Int = fleet_manifest_module_count(fs_r, dir);
    let has_build: Bool = fleet_manifest_has_build_target(fs_r, dir);
    let has_ci: Bool = fleet_manifest_ci_present(fs_r, dir);
    return LoopRepo { org: org, name: name, branch: branch, sha: sha, dir: dir, modules: modules, has_build: has_build,
        has_ci: has_ci, ok: true };
}

// The organizations of the ecosystem.
pub fn loop_manifest_all_orgs() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "openOODA");
    out = list_push(out, "openOODA-core");
    out = list_push(out, "openOODA-kernel");
    out = list_push(out, "openOODA-OS");
    out = list_push(out, "openOODA-DE");
    out = list_push(out, "openOODA-tools");
    out = list_push(out, "openOODA-apps");
    out = list_push(out, "openOODA-cloud");
    out = list_push(out, "openOODA-agents");
    return out;
}

// Resolve the organization of a repo entry that may be "org/name" or "name".
pub fn loop_manifest_entry_org(entry: String, fallback: String) -> String {
    let idx: Int = str_index_of(entry, "/");
    if idx <= 0 { return fallback; }
    return str_slice(entry, 0, idx);
}

// Collect the repo entries of every organization in the ecosystem.
pub fn loop_manifest_multi_org_names(sys: &ProcessCap, fs_w: &FsWriteCap, cache_dir: String, token: String) -> List[String] {
    let mut out: List[String] = list_new();
    let orgs: List[String] = loop_manifest_all_orgs();
    let mut k: Int = 0;
    while k < list_len(orgs) {
        let cur_org: String = list_get(orgs, k);
        let found: List[String] = loop_manifest_repo_names(sys, fs_w, cache_dir, token, cur_org);
        let mut i: Int = 0;
        while i < list_len(found) {
            let n: String = list_get(found, i);
            let is_core: Bool = (cur_org == "openOODA" || cur_org == "openOODA-core") && (n == "oodac" || n == "oodar" ||
                n == "oostd" || n == "openOODA");
            if n != "" && n != ".github" && !str_contains(n, ".github.io") && !is_core {
                out = list_push(out, cur_org + "/" + n);
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return out;
}

// The run identity is derived from the compiler identity and the head commit
// of every repo. Two runs over the same inputs produce the same run identity,
// so the verdict queue stays comparable and deterministic.
pub fn loop_manifest_run_id(stamp: String, states: List[LoopRepo]) -> String {
    let mut acc: String = stamp;
    let mut i: Int = 0;
    while i < list_len(states) {
        let s: LoopRepo = list_get(states, i);
        acc = acc + "|" + s.name + "|" + s.branch + "|" + s.sha;
        i = i + 1;
    }
    return text_hash_string(acc);
}
