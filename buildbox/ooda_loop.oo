// # ooda-loop — 24/7 build/audit loop driver for the OODA-buildbox (v1)
//
// Logline: fetch core repos -> stage1 oodac build -> audit_gate -> queue line.
//   All exec is argv form; no shell strings. --nightly = fixed-point build.
//
// Setup: runs inside ooda-buildbox as native entrypoint. /work/repos,
//   /queue, /cache are volumes. Env: OODA_COMPILER, OODA_SPOTLIGHT (fan-out v2).
//
// Beats:
//   1. git fetch/clone the core repos (argv git).
//   2. Rebuild oodac from the oodac checkout (bootstrap carve-out, argv bash).
//   3. Build + run audit_gate against the fresh binary.
//   4. Append result to /queue/state.oot via file_append_sync.

import "std/fs/process/env.oo";
import "std/core/text/num_buffer.oo";

pub fn buildbox_ping() -> Int {
    return 0;
}

fn has_arg(args: List[String], name: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn env_or(env: &EnvCap, name: String, dflt: String) -> String {
    let r: Result[String, String] = env_get(env, name);
    if r.is_ok() && r.val != "" { return r.val; }
    return dflt;
}

fn is_dir(sys: &ProcessCap, dir: String) -> Bool {
    return sys_exec(sys, "test", "-d", dir).is_ok();
}

fn fetch_repo(sys: &ProcessCap, repos: String, name: String, branch: String) -> Bool {
    let dir: String = repos + "/" + name;
    let url: String = "https://github.com/openOODA/" + name + ".git";
    if is_dir(sys, dir) {
        let mut a: List[String] = list_new();
        a = list_push(a, "-C");
        a = list_push(a, dir);
        a = list_push(a, "fetch");
        a = list_push(a, "--depth");
        a = list_push(a, "1");
        a = list_push(a, "origin");
        a = list_push(a, branch);
        if sys_exec_wait(sys, "git", a).is_err() { return false; }
        let mut c: List[String] = list_new();
        c = list_push(c, "-C");
        c = list_push(c, dir);
        c = list_push(c, "checkout");
        c = list_push(c, "FETCH_HEAD");
        return sys_exec_wait(sys, "git", c).is_ok();
    }
    let mut a: List[String] = list_new();
    a = list_push(a, "clone");
    a = list_push(a, "--depth");
    a = list_push(a, "1");
    a = list_push(a, "--branch");
    a = list_push(a, branch);
    a = list_push(a, url);
    a = list_push(a, dir);
    let r: Result[Int, String] = sys_exec_wait(sys, "git", a);
    if r.is_err() { return false; }
    return r.val == 0;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) {
    let nightly: Bool = has_arg(args, "--nightly");
    let repos: String = "/work/repos";
    let _m1: Result[String, String] = sys_exec(sys, "mkdir", "-p", repos);
    let _m2: Result[String, String] = sys_exec(sys, "mkdir", "-p", "/queue/raw");
    let _m3: Result[String, String] = sys_exec(sys, "mkdir", "-p", "/cache");

    let mut names: List[String] = list_new();
    names = list_push(names, "oodac");
    names = list_push(names, "oodar");
    names = list_push(names, "std");
    names = list_push(names, "openOODA");
    let mut i: Int = 0;
    while i < list_len(names) {
                let mut br: String = "master";
        if list_get(names, i) == "oodac" { br = env_or(env, "OODA_BRANCH", "master"); }
        if !fetch_repo(sys, repos, list_get(names, i), br) {
            println("ERR\tloop\tfetch failed");
            process_exit(1);
        }
        i = i + 1;
    }

    let oodac_src: String = repos + "/oodac";
    let out_bin: String = "/cache/oodac-new";
    let mut bargv: List[String] = list_new();
    bargv = list_push(bargv, "-c");
    bargv = list_push(bargv, "cd /work/repos && exec bash oodac/bootstrap/oodac_pure_build oodac/main.oo " + out_bin);
    let bp: Result[Int, String] = sys_exec_wait(sys, "bash", bargv);
    let mut bcode: Int = 1;
    if bp.is_ok() { bcode = bp.val; }
    if bcode != 0 {
        println("ERR\tloop\tbuild failed");
        process_exit(1);
    }

    let gate_bin: String = "/cache/audit_gate.bin";
    let mut gargv: List[String] = list_new();
    gargv = list_push(gargv, "build");
    gargv = list_push(gargv, oodac_src + "/qa/audit_gate.oo");
    gargv = list_push(gargv, "-o");
    gargv = list_push(gargv, gate_bin);
    let g: Result[Int, String] = sys_exec_wait(sys, out_bin, gargv);
    let mut gcode: Int = 1;
    if g.is_ok() { gcode = g.val; }
    if gcode != 0 {
        println("ERR\tloop\tgate build failed");
        process_exit(1);
    }
    // gate expects CWD = oodac repo (fixtures at qa/audit_fixtures/)
    let mut rargv: List[String] = list_new();
    rargv = list_push(rargv, "-c");
    rargv = list_push(rargv, "cd /work/repos/oodac && exec " + gate_bin + " --compiler " + out_bin);
    let gr: Result[Int, String] = sys_exec_wait(sys, "bash", rargv);
    let mut grc: Int = 1;
    if gr.is_ok() { grc = gr.val; }

    // advisory fan-out to spotlight (raw output to /queue/raw, mcode S3)
    let mut fargv: List[String] = list_new();
    let fr: Result[Int, String] = sys_exec_wait(sys, "/usr/local/bin/ooda-fanout", fargv);
    let mut _f: Int = 0;
    if fr.is_ok() { _f = fr.val; }

    let mut mode: String = "fast";
    if nightly { mode = "nightly"; }
    let mut status: String = "FAIL";
    if grc == 0 { status = "PASS"; }
    let line: String = "loop " + status + " mode=" + mode + " gate_rc=" + int_to_str(grc);
    let _q: Result[Void, String] = file_append_sync(fs_w, "/queue/state.oot", line + "\n");
    println("OODA_LOOP: " + status + " mode=" + mode);
    if grc == 0 { process_exit(0); }
    process_exit(1);
}
