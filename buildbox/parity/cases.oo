// # Parity Cases - The Comparison Cases Taken From A Tool Own Test Suite
//
// Logline: Reads the test recipe of a tool Makefile and turns the tool invocations into parity cases.
//
// Setup: Needs FsReadCap to read the Makefile.
//
// Beats:
//   1. Join the continued recipe lines into one command.
//   2. Find every invocation of the tool under test in that command.
//   3. Render the case table.
//
// The test recipe of a tool already holds the arguments that tool must accept.
// Those arguments are the natural parity cases, because a drop-in replacement
// must accept the same arguments as the tool it replaces.
//
// A recipe that continues its lines writes them as one command, so one command
// may hold many invocations of the tool. Every invocation is a case, and the
// input that the recipe pipes into that invocation is the input of the case.
//
// The table holds at most PARITY_CASE_LIMIT cases, because the case table is
// a page and a page holds at most 256 lines.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";
import "text/lines.oo";
import "parity/scan.oo";
import "parity/input.oo";
import "parity/words.oo";
import "parity/deviation.oo";
import "parity/recipe/recipe.oo";

// The most cases one tool holds. A case with an input takes two lines, and
// the table is a page of at most 256 lines.
pub fn parity_case_limit() -> Int {
    return 80;
}

// The most lines one table holds. The setup commands of the recipe stand in
// the table as well, so the table is bounded by lines and not by cases alone.
pub fn parity_case_line_limit() -> Int {
    return 230;
}

// Report whether a word cannot be compared. A make variable has no value
// outside make. The model context protocol reads from standard input, so it
// has no comparable file output.
pub fn parity_case_skip_word(word: String) -> Bool {
    if str_contains(word, "$(") { return true; }
    if str_contains(word, "--mcp") { return true; }
    return false;
}

// Report whether a word asks for the usage text or the version text. No two
// tools print the same usage text, so such a case proves nothing about the
// drop-in behaviour.
pub fn parity_case_is_usage(word: String) -> Bool {
    return word == "--help" || word == "-h" || word == "--version" || word == "-V";
}

// Take the case of one invocation of the tool. The empty string means the
// invocation cannot be compared.
pub fn parity_case_one(cmd: String, tool: String, at: Int, devs: List[String]) -> String {
    let tl: Int = parity_scan_tool_at(cmd, at, tool);
    if tl <= 0 { return ""; }
    let raw: String = parity_scan_take(cmd, at + tl);
    if raw == "" { return ""; }
    let words: List[String] = parity_scan_words(raw);
    if list_len(words) == 0 { return ""; }
    if parity_case_is_usage(list_get(words, 0)) { return ""; }
    let mut keep: List[String] = list_new();
    let mut w: Int = 0;
    while w < list_len(words) {
        let word: String = list_get(words, w);
        if parity_case_skip_word(word) { break; }
        keep = list_push(keep, word);
        w = w + 1;
    }
    if list_len(keep) == 0 { return ""; }
    let bound: String = parity_scan_bound(cmd, at);
    if bound != "" {
        let mut with_bound: List[String] = list_new();
        with_bound = list_push(with_bound, bound);
        let mut z: Int = 0;
        while z < list_len(keep) {
            with_bound = list_push(with_bound, list_get(keep, z));
            z = z + 1;
        }
        keep = with_bound;
    }
    let raw_case: String = parity_case_line(keep);
    if raw_case == "" { return ""; }
    let case: String = parity_case_apply_deviation(devs, raw_case);
    let inp: String = parity_input_directive(cmd, at);
    let mut head: String = "";
    if inp != "" { head = inp + "\n"; }
    return head + case;
}

// Collect the parity cases of one tool from its Makefile test recipe. Every
// case is one invocation of the tool under test, and every setup command of
// the recipe stands in front of the case it prepares.
pub fn parity_case_collect(fs_r: &FsReadCap, tool: String, mk_path: String, dev_path: String) -> List[String] {
    let mut found: List[String] = list_new();
    let devs: List[String] = parity_case_deviations(fs_r, dev_path);
    let r: Result[String, String] = fs_read_file(fs_r, mk_path);
    if r.is_err() { return found; }
    let lines: List[String] = text_split_lines(r.val);
    let cmds: List[String] = parity_recipe_commands(lines);
    let mut cases: Int = 0;
    let mut i: Int = 0;
    while i < list_len(cmds) && cases < parity_case_limit() && list_len(found) < parity_case_line_limit() {
        let cmd: String = list_get(cmds, i);
        i = i + 1;
        let places: List[Int] = parity_scan_places(cmd, tool);
        if list_len(places) == 0 {
            let setup: String = parity_recipe_setup(cmd, tool);
            if setup != "" { found = list_push(found, setup); }
            continue;
        }
        let mut p: Int = 0;
        while p < list_len(places) && cases < parity_case_limit() && list_len(found) < parity_case_line_limit() {
            let at: Int = list_get(places, p);
            p = p + 1;
            let block: String = parity_case_one(cmd, tool, at, devs);
            if block == "" { continue; }
            cases = cases + 1;
            if !parity_case_has(found, block) { found = list_push(found, block); }
        }
    }
    return found;
}

// Render one case as the line of the case table. Every argument goes through
// the writer of the word codec, so the runner reads back exactly the argument
// that the recipe gave to the tool.
pub fn parity_case_line(args: List[String]) -> String {
    if list_len(args) == 0 { return ""; }
    let mut out: String = "match";
    let mut i: Int = 0;
    while i < list_len(args) {
        out = out + " " + parity_quote_word(list_get(args, i));
        i = i + 1;
    }
    return out;
}

// Report whether the case list already holds a case.
pub fn parity_case_has(cases: List[String], case: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(cases) {
        if list_get(cases, i) == case { return true; }
        i = i + 1;
    }
    return false;
}
