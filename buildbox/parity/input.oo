// # Parity Input - Takes The Input A Recipe Pipes Into The Tool
//
// Logline: Finds the command a test recipe pipes into the tool and writes it as the input of a parity case.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Find the pipe that feeds one invocation of the tool.
//   2. Take the command that stands before that pipe.
//   3. Write the command and its arguments as the input line of a case.
//
// A tool that works on a stream is compared on a stream and not on an empty
// input. The recipe writes "echo TEXT | ./tool" or "printf FMT ARG | ./tool",
// and that command may stand inside a command substitution, so the pipe is
// found by the place of the tool and not by the start of the line.
//
// The input line holds the command and its arguments, and the runner runs
// that command and pipes it into both tools. The recipe and the runner then
// make the same bytes, because the runner runs the same command.

import "std/core/primitives/str.oo";
import "text/lines.oo";
import "parity/scan.oo";
import "parity/words.oo";

// Report the place of the last time the needle stands in the text. The answer
// is -1 when the text does not hold the needle at all.
fn parity_scan_last_at(text: String, needle: String) -> Int {
    let n: Int = chars_len(text);
    let ln: Int = chars_len(needle);
    if ln == 0 || n < ln { return 0 - 1; }
    let mut last: Int = 0 - 1;
    let mut i: Int = 0;
    while i + ln <= n {
        let mut same: Bool = true;
        let mut j: Int = 0;
        while j < ln {
            if char_at(text, i + j) != char_at(needle, j) { same = false;
            break; }
            j = j + 1;
        }
        if same { last = i; }
        i = i + 1;
    }
    return last;
}

// Take the text that stands before the pipe that feeds the invocation at the
// given place. The empty string means the recipe does not pipe a text into
// that invocation.
//
// The last pipe before the invocation is the one that feeds it. An earlier
// pipe may stand in the expected value of another assertion, so the first
// pipe of the command is not the one that feeds the tool.
pub fn parity_input_left(cmd: String, at: Int) -> String {
    let mut pipe_at: Int = 0 - 1;
    let mut k: Int = 0;
    while k < at {
        if char_at(cmd, k) == "|" { pipe_at = k; }
        k = k + 1;
    }
    if pipe_at < 0 { return ""; }
    return text_trim(str_slice(cmd, 0, pipe_at));
}

// Take the input line of the invocation at the given place. The empty string
// means the case has no input and the runner closes the standard input.
pub fn parity_input_directive(cmd: String, at: Int) -> String {
    let left: String = parity_input_left(cmd, at);
    if left == "" { return ""; }
    let echo_at: Int = parity_scan_last_at(left, "echo ");
    let printf_at: Int = parity_scan_last_at(left, "printf ");
    let mut start: Int = 0 - 1;
    let mut name: String = "";
    if echo_at >= 0 && echo_at >= printf_at {
        start = echo_at;
        name = "echo";
    } else if printf_at >= 0 {
        start = printf_at;
        name = "printf";
    } else {
        return "";
    }
    let rest: String = text_trim(str_slice(left, start + chars_len(name) + 1, chars_len(left)));
    let words: List[String] = parity_scan_words(rest);
    if list_len(words) == 0 { return ""; }
    let mut out: String = "input " + name;
    let mut i: Int = 0;
    while i < list_len(words) {
        out = out + " " + parity_quote_word(list_get(words, i));
        i = i + 1;
    }
    return out;
}
