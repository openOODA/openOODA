// # Parity Mapping - The Upstream Tool Every Tool Replaces
//
// Logline: Reads the organization profile and extracts the upstream tool that every tool replaces.
//
// Setup: Needs FsReadCap to read the profile.
//
// Beats:
//   1. Find the index of a marker in a string after a given position.
//   2. Extract the tool name out of a profile row.
//   3. Extract the upstream binary out of a profile row.
//   4. Build the mapping table from the profile.
//
// The organization profile holds the drop-in table of the whole fleet. The
// profile is the single source of truth, so the mapping is never written twice
// and never drifts from what the fleet publishes.

import "oostd/fs/os/fs.oo";
import "text/lines.oo";

// Find the index of a marker in a string after a given position. The result is
// the index of the first occurrence at or after the position, or -1.
pub fn parity_index_from(s: String, marker: String, from: Int) -> Int {
    let n: Int = chars_len(s);
    let m: Int = chars_len(marker);
    if m == 0 { return -1; }
    let mut i: Int = from;
    while i + m <= n {
        let mut hit: Bool = true;
        let mut j: Int = 0;
        while j < m {
            if char_at(s, i + j) != char_at(marker, j) { hit = false;
            break; }
            j = j + 1;
        }
        if hit { return i; }
        i = i + 1;
    }
    return -1;
}

// Extract the tool name out of a mapping row. A profile row holds the tool as
// a bold link. A backlog row holds the tool as a plain word.
pub fn parity_map_tool(line: String) -> String {
    let a: Int = str_index_of(line, "**[");
    if a >= 0 {
        let b: Int = parity_index_from(line, "](", a + 3);
        if b < 0 { return ""; }
        return str_slice(line, a + 3, b);
    }
    let p1: Int = str_index_of(line, "|");
    if p1 < 0 { return ""; }
    let p2: Int = parity_index_from(line, "|", p1 + 1);
    if p2 < 0 { return ""; }
    return text_trim(str_slice(line, p1 + 1, p2));
}

// Extract the upstream binary out of a profile row. The drop-in field holds
// the upstream names in back quotes. The first name is the reference tool.
// A name that names no program, such as "theme engine", yields an empty
// string and the tool has no upstream program.
pub fn parity_map_upstream(line: String) -> String {
    let p1: Int = str_index_of(line, "|");
    if p1 < 0 { return ""; }
    let p2: Int = parity_index_from(line, "|", p1 + 1);
    if p2 < 0 { return ""; }
    let p3: Int = parity_index_from(line, "|", p2 + 1);
    let field: String = if p3 < 0 { str_slice(line, p2 + 1, chars_len(line)) } else { str_slice(line, p2 + 1, p3) };
    let q1: Int = str_index_of(field, "`");
    if q1 < 0 { return ""; }
    let q2: Int = parity_index_from(field, "`", q1 + 1);
    if q2 < 0 { return ""; }
    let name: String = str_slice(field, q1 + 1, q2);
    let sp: Int = str_index_of(name, " ");
    if sp > 0 { return str_slice(name, 0, sp); }
    return name;
}

// Build the mapping table from the organization profile. Every row is one
// "tool|upstream" record. A row with an empty upstream is skipped.
pub fn parity_map_rows(fs_r: &FsReadCap, profile_path: String) -> List[String] {
    let mut rows: List[String] = list_new();
    let r: Result[String, String] = fs_read_file(fs_r, profile_path);
    if r.is_err() { return rows; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_starts_with(l, "| **[") || str_starts_with(l, "| oo") {
            let tool: String = parity_map_tool(l);
            let up: String = parity_map_upstream(l);
            if tool != "" && up != "" {
                rows = list_push(rows, tool + "|" + up);
            }
        }
        i = i + 1;
    }
    return rows;
}

// Find the upstream of one tool in the mapping table. An empty result means
// the tool has no upstream program in the profile.
pub fn parity_map_lookup(rows: List[String], tool: String) -> String {
    let mut i: Int = 0;
    while i < list_len(rows) {
        let row: String = list_get(rows, i);
        let p: Int = str_index_of(row, "|");
        if p > 0 {
            let name: String = str_slice(row, 0, p);
            if name == tool { return str_slice(row, p + 1, chars_len(row)); }
        }
        i = i + 1;
    }
    return "";
}
