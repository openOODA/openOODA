// # Parity Recipe - Takes The Test Recipe Of A Tool Apart
//
// Logline: Joins the continued lines of a test recipe and names the commands that prepare the input of a case.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Take the commands of the test recipe of a Makefile.
//   2. Strip the marks that make puts in front of a recipe command.
//   3. Name the command that prepares the input of a case.
//
// The test recipe of a tool already prepares the input of its own cases. A
// case that reads a file the recipe made has to run the same preparation
// first, or the file is not there and the upstream tool answers with the
// error of a missing file while the tool under test answers with something
// else. The case table therefore carries the preparation beside the case.
//
// Three commands are not a preparation. A command that only prints a message
// changes nothing. A command that holds a make variable has no value outside
// make, so it cannot run at all. A command that removes the tool under test
// would leave the gate with no tool to compare, so it is left out as well.

import "oostd/core/primitives/str.oo";
import "text/lines.oo";
import "parity/scan.oo";

// Take the commands of the test recipe of a Makefile. A recipe that continues
// its lines writes them as one command, so the continued lines are joined and
// the command stands as one string. Only the recipe of the test target is
// taken, because that is the recipe that holds the cases.
pub fn parity_recipe_commands(lines: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut in_test: Bool = false;
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = list_get(lines, i);
        i = i + 1;
        if !str_starts_with(l, "\t") {
            in_test = str_starts_with(text_trim(l), "test:");
            continue;
        }
        if !in_test { continue; }
        let mut cmd: String = text_trim(l);
        while str_ends_with(cmd, "\\") && i < list_len(lines) {
            cmd = str_slice(cmd, 0, chars_len(cmd) - 1);
            let nxt: String = list_get(lines, i);
            i = i + 1;
            cmd = cmd + " " + text_trim(nxt);
        }
        out = list_push(out, cmd);
    }
    return out;
}

// Strip the marks that make puts in front of a recipe command. The at mark
// tells make not to print the command, the dash mark tells make to ignore a
// failure and the plus mark tells make to run the command even under the
// option that asks make not to run any command. None of them belongs to the
// shell command itself.
pub fn parity_recipe_strip(cmd: String) -> String {
    let mut c: String = text_trim(cmd);
    if chars_len(c) == 0 { return ""; }
    let first: String = char_at(c, 0);
    if first == "@" || first == "-" || first == "+" {
        c = text_trim(str_slice(c, 1, chars_len(c)));
    }
    return c;
}

// Report whether a command only prints a message. A command that writes a
// file, that pipes into another command or that runs two commands one after
// the other changes something, and a command that only prints does not.
pub fn parity_recipe_is_message(cmd: String) -> Bool {
    if str_contains(cmd, ">") { return false; }
    if str_contains(cmd, "|") { return false; }
    if str_contains(cmd, ";") { return false; }
    if str_contains(cmd, "&") { return false; }
    let words: List[String] = parity_scan_words(cmd);
    if list_len(words) == 0 { return true; }
    let first: String = list_get(words, 0);
    if first == "echo" { return true; }
    if first == "printf" { return true; }
    return false;
}

// Report whether a command removes the tool under test. The tool stands in the
// build directory of the repository, so a command that removes it would leave
// the gate with nothing to compare.
pub fn parity_recipe_kills_tool(cmd: String, tool: String) -> Bool {
    if !str_contains(cmd, "rm ") { return false; }
    if !str_contains(cmd, "dist/" + tool) { return false; }
    return true;
}

// Name the command that prepares the input of a case. The answer is the empty
// string when the command prepares nothing and must not be carried in the
// case table.
pub fn parity_recipe_setup(cmd: String, tool: String) -> String {
    let c: String = parity_recipe_strip(cmd);
    if c == "" { return ""; }
    if str_contains(c, "$(") { return ""; }
    if parity_recipe_is_message(c) { return ""; }
    if parity_recipe_kills_tool(c, tool) { return ""; }
    if list_len(parity_scan_places(c, tool)) > 0 { return ""; }
    return "setup " + c;
}

// Compare one answer with the answer that is wanted. A difference is
// reported and counted, so the self test of the buildbox fails on it.
fn parity_recipe_expect(name: String, got: String, want: String, fails: &mut Int) -> Int {
    if got == want {
        println("PASS\t" + name);
        return 0;
    }
    println("FAIL\t" + name + "\tgot " + got + " want " + want);
    *fails = *fails + 1;
    return 0;
}

// Check that a command that prepares the input of a case is carried in the
// case table beside the case, and that a command which prepares nothing is
// not. The marks that make puts in front of a recipe command are taken off, a
// command that only prints a message is left out, and a command that would
// remove the tool under test is left out as well.
pub fn parity_test_setup(fails: &mut Int) -> Int {
    let make_cmd: String = "@printf \"line 1\\n\" > dist/fixture.txt";
    let _a: Int = parity_recipe_expect("parity_setup_strip", parity_recipe_strip(make_cmd),
        "printf \"line 1\\n\" > dist/fixture.txt", fails);
    let _b: Int = parity_recipe_expect("parity_setup_make", parity_recipe_setup(make_cmd, "oohead"),
        "setup printf \"line 1\\n\" > dist/fixture.txt", fails);
    let _c: Int = parity_recipe_expect("parity_setup_message", parity_recipe_setup("@echo \"=== testing ===\"", "oohead"), "",
        fails);
    let _d: Int = parity_recipe_expect("parity_setup_variable", parity_recipe_setup("@cat $(FIXTURE)", "oohead"), "", fails);
    let _e: Int = parity_recipe_expect("parity_setup_kills_tool", parity_recipe_setup("@rm -f dist/oohead", "oohead"), "",
        fails);
    let _f: Int = parity_recipe_expect("parity_setup_keeps_fixture", parity_recipe_setup("@rm -f dist/fixture.txt", "oohead"),
        "setup rm -f dist/fixture.txt", fails);
    let _g: Int = parity_recipe_expect("parity_setup_tool_line", parity_recipe_setup("@./$(BIN) -n 2 dist/fixture.txt",
        "oohead"), "", fails);
    let _h: Int = parity_recipe_expect("parity_setup_no_mark", parity_recipe_setup("printf x > f", "oohead"),
        "setup printf x > f", fails);
    return 0;
}
