// # Parity Runner - Compares The Tool Against The Tool It Replaces
// Logline: Runs the upstream tool and the built tool with the same arguments and reports every difference.
// Setup: Needs ProcessCap to run both binaries and FsReadCap to read the case table.
// Beats:
//   1. Read the upstream tool and the tool under test out of the case table.
//   2. Require the upstream tool. A missing upstream tool fails the run. A tool
//      that names no upstream tool has no parity gate, and the run is skipped.
//   3. Run both tools with the same arguments and compare stdout, stderr, and the exit code.
//
// The case table holds one case per line ("match", "differ", "input", "setup").
// Every word is wrapped in single quotes so shell metacharacters stay inert.
// The word codec lives on words.oo next to this page.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "words.oo";

// The count of the three kinds of case.
type ParityCount = struct {
    matches: Int,
    devs: Int,
    skips: Int,
    fails: Int
};

// Run one tool with the given arguments. The stdout and the stderr go to
// files and the standard input is closed, so a tool that reads the input never
// waits for it. The run is bounded by the timeout helper.
fn parity_run(sys: &ProcessCap, tool: String, words: List[String], from: Int, out_path: String, err_path: String, input_words: List[String]) -> Int {
    let mut secs: String = "10";
    let mut first: Int = from;
    if list_get(words, from) == "timeout" && from + 1 < list_len(words) {
        secs = list_get(words, from + 1);
        first = from + 2;
    }
    let mut script: String = "t=''; command -v timeout >/dev/null 2>&1 && t='timeout " + secs + "'; ";
    if list_len(input_words) > 0 {
        script = script + list_get(input_words, 0);
        let mut k: Int = 1;
        while k < list_len(input_words) {
            script = script + " " + parity_quote(list_get(input_words, k));
            k = k + 1;
        }
        script = script + " | ";
    }
    script = script + "$t ";
    script = script + parity_quote(tool);
    let mut i: Int = first;
    while i < list_len(words) {
        script = script + " " + parity_quote(list_get(words, i));
        i = i + 1;
    }
    script = script + " > " + parity_quote(out_path) + " 2> " + parity_quote(err_path);
    if list_len(input_words) == 0 {
        script = script + " < /dev/null";
    }
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, script);
    let r: Result[Int, String] = sys_exec_wait(sys, "sh", argv);
    let mut code: Int = 127;
    if r.is_ok() { code = r.val; }
    return code;
}

// Compare the two results of one case. The returned string is "ok" when the
// case passes, "skip" when the upstream does not know the arguments, and
// otherwise the reason the case fails.
fn parity_compare(fs_r: &FsReadCap, up_rc: Int, oo_rc: Int, kind: String) -> String {
    let r1: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/up.out");
    let mut up_out: String = "";
    if r1.is_ok() { up_out = r1.val; }
    let r2: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/oo.out");
    let mut oo_out: String = "";
    if r2.is_ok() { oo_out = r2.val; }
    let r3: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/up.err");
    let mut up_err: String = "";
    if r3.is_ok() { up_err = r3.val; }
    let r4: Result[String, String] = fs_read_file(fs_r, ".ooda-cache/parity/oo.err");
    let mut oo_err: String = "";
    if r4.is_ok() { oo_err = r4.val; }
    if str_contains(up_err, "unrecognized option") { return "skip"; }
    if str_contains(up_err, "unknown option") { return "skip"; }
    if str_contains(up_err, "invalid option") { return "skip"; }
    if str_contains(up_err, "unrecognized command") { return "skip"; }
    if str_contains(up_err, "invalid argument") { return "skip"; }
    if str_contains(up_err, "illegal option") { return "skip"; }
    // A tool that answers an argument it does not know with its usage banner
    // did not understand the case. The upstream cannot be the reference for a
    // case it never accepts, so the case is skipped. The wording of that
    // answer differs per tool: procps ps says "unknown gnu long option",
    // "unsupported option", "unsupported SysV option" and "process ID list
    // syntax error", and prints the banner in every one of those answers.
    if str_contains(up_err, "Usage:") { return "skip"; }
    if str_contains(up_err, "usage:") { return "skip"; }
    // A run that was cut short by the bound did not finish. The upstream
    // cannot be the reference for a case it never completes, so it is skipped.
    if up_rc == 124 { return "skip"; }
    if oo_rc == 124 { return "the tool does not finish"; }
    if up_rc != oo_rc { return "exit code " + int_to_str(up_rc) + " against " + int_to_str(oo_rc); }
    if kind == "match" {
        if up_out != oo_out { return "stdout differs"; }
        if up_err != oo_err { return "stderr differs"; }
    }
    return "ok";
}

// Take the input words of the line that names the command that makes the
// input of a case. The empty list means the line names no input, or names a
// command that is not the one that makes an input.
fn parity_input_of(l: String) -> List[String] {
    let rest: String = parity_trim(str_slice(l, 6, chars_len(l)));
    let in_words: List[String] = parity_words(rest);
    if list_len(in_words) == 0 { return list_new(); }
    let cmd_name: String = list_get(in_words, 0);
    if cmd_name != "echo" && cmd_name != "printf" { return list_new(); }
    return in_words;
}

// Run the setup commands of the case table. A setup command prepares the
// input of a case: it makes the file the tool reads. The commands are run
// again before the tool runs, so the upstream tool and the tool under test
// both see the same input even when one of them changes it.
//
// Every command is bounded and reads no input, so a preparation that waits
// for the stream does not hold the gate.
fn parity_run_setup(sys: &ProcessCap, setup: List[String]) -> String {
    let mut notes: String = "";
    let mut i: Int = 0;
    while i < list_len(setup) {
        let cmd: String = list_get(setup, i);
        let mut script: String = "if command -v timeout >/dev/null 2>&1; then timeout 10 sh -c ";
        script = script + parity_quote(cmd);
        script = script + "; else sh -c ";
        script = script + parity_quote(cmd);
        script = script + "; fi < /dev/null";
        let mut argv: List[String] = list_new();
        argv = list_push(argv, "-c");
        argv = list_push(argv, script);
        let r: Result[Int, String] = sys_exec_wait(sys, "sh", argv);
        let mut code: Int = 0;
        if r.is_ok() { code = r.val; }
        if code != 0 { notes = notes + "setup failed: " + cmd + "\n"; }
        i = i + 1;
    }
    return notes;
}

// Run every case of the case table and count the results.
fn parity_cases(sys: &ProcessCap, fs_r: &FsReadCap, lines: List[String], upstream: String, tool: String) -> ParityCount {
    let mut c: ParityCount = ParityCount { matches: 0, devs: 0, skips: 0, fails: 0 };
    let mut input_words: List[String] = list_new();
    let mut setup: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = parity_trim(list_get(lines, i));
        i = i + 1;
        if l == "" || str_starts_with(l, "#") { continue; }
        if str_starts_with(l, "input ") { input_words = parity_input_of(l); continue; }
        if str_starts_with(l, "setup ") {
            let cmd: String = parity_trim(str_slice(l, 6, chars_len(l)));
            if cmd != "" { setup = list_push(setup, cmd); }
            continue;
        }
        let words: List[String] = parity_words(l);
        if list_len(words) < 2 { continue; }
        let kind: String = list_get(words, 0);
        if kind != "match" && kind != "differ" { continue; }
        let _s1: String = parity_run_setup(sys, setup);
        let up_rc: Int = parity_run(sys, upstream, words, 1, ".ooda-cache/parity/up.out", ".ooda-cache/parity/up.err", input_words);
        let _s2: String = parity_run_setup(sys, setup);
        let oo_rc: Int = parity_run(sys, tool, words, 1, ".ooda-cache/parity/oo.out", ".ooda-cache/parity/oo.err", input_words);
        input_words = list_new();
        let verdict: String = parity_compare(fs_r, up_rc, oo_rc, kind);
        if verdict == "ok" {
            if kind == "match" { c.matches = c.matches + 1; } else { c.devs = c.devs + 1; }
        } else if verdict == "skip" {
            c.skips = c.skips + 1;
        } else {
            c.fails = c.fails + 1;
            println("  FAIL " + kind + " [" + l + "] " + verdict);
        }
    }
    return c;
}

// Find the upstream tool on the runner. The standard places are searched,
// because the process that runs the gate holds a short path and the program
// of the upstream often stands in /usr/sbin, where the path of the gate does
// not reach. The workflow of every repository makes the same search and
// links the program it finds, so the gate and the workflow always compare
// against the same program.
fn parity_find_upstream(fs_r: &FsReadCap, env: &EnvCap, upstream: String) -> String {
    if upstream == "" { return ""; }
    let mut dirs: List[String] = str_split("/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/games", ":");
    let path_env: String = match env_get(env, "PATH") { Ok(s) => s, Err(_) => "" };
    let pdirs: List[String] = str_split(path_env, ":");
    let mut i: Int = 0;
    while i < list_len(pdirs) { dirs = list_push(dirs, list_get(pdirs, i)); i = i + 1; }
    let mut j: Int = 0;
    while j < list_len(dirs) {
        let d: String = list_get(dirs, j);
        if d != "" { let p: String = d + "/" + upstream; if fs_path_exists(fs_r, p) { return p; } }
        j = j + 1;
    }
    return "";
}

// Read the case table, run every case, and report the parity result.
pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap) -> Int {
    let cases_path: String = "qa/parity/cases.oot";
    let r: Result[String, String] = fs_read_file(fs_r, cases_path);
    if r.is_err() { println("ERR\tparity\tcannot read " + cases_path); return 1; }
    let _d: Result[Void, String] = fs_mkdir_p(fs_w, ".ooda-cache/parity");
    let lines: List[String] = parity_lines(r.val);
    let mut upstream: String = "";
    let mut tool_rel: String = "";
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = parity_trim(list_get(lines, i));
        if str_starts_with(l, "# upstream:") { upstream = parity_trim(str_slice(l, 11, chars_len(l))); }
        if str_starts_with(l, "# tool:") { tool_rel = parity_trim(str_slice(l, 7, chars_len(l))); }
        i = i + 1;
    }
    if upstream == "" {
        println("SKIP\tparity\tno upstream in " + cases_path + ", the tool names no program to replace, so it has no parity gate");
        return 0;
    }
    if tool_rel == "" { println("ERR\tparity\tno tool in " + cases_path); return 1; }
    let upstream_path: String = parity_find_upstream(fs_r, env, upstream);
    if upstream_path == "" {
        println("ERR\tparity\tupstream tool " + upstream + " is not installed. The parity gate cannot pass without it.");
        return 1;
    }
    let tool: String = if str_starts_with(tool_rel, "/") { tool_rel } else { "./" + tool_rel };
    let c: ParityCount = parity_cases(sys, fs_r, lines, upstream_path, tool);
    println("PARITY " + tool + " against " + upstream + " match=" + int_to_str(c.matches)
        + " differ=" + int_to_str(c.devs) + " skip=" + int_to_str(c.skips)
        + " fail=" + int_to_str(c.fails));
    if c.matches == 0 { println("ERR\tparity\tno match case against " + upstream + "."); return 1; }
    if c.fails > 0 { return 1; }
    return 0;
}
