// # Parity Self Test - Proves The Mapping And The Case Extraction
//
// Logline: Checks the profile parser and the case extractor against known values.
//
// Setup: Needs FsReadCap to read the profile and a Makefile.
//
// Beats:
//   1. Check that the profile yields the expected number of mappings.
//   2. Check that a known tool maps to its known upstream.
//   3. Check that the case extractor finds the expected invocations.
//   4. Check that a metacharacter cuts the command.
//   5. Check that the word codec reads a word back as it was written.
//
// The fleet directory comes from OODA_FLEET_DIR. The test reports a skip when
// the fleet directory is not there, so the test never fails on a host that
// holds no fleet checkout.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "text/lines.oo";
import "parity/mapping.oo";
import "parity/cases.oo";
import "parity/scan.oo";
import "parity/input.oo";
import "parity/words.oo";
import "parity/recipe/recipe.oo";

fn expect_eq(name: String, got: String, want: String, fails: &mut Int) -> Int {
    if got == want {
        println("PASS\t" + name);
        return 0;
    }
    println("FAIL\t" + name + "\tgot " + got + " want " + want);
    *fails = *fails + 1;
    return 0;
}

// Check that the profile parser finds every mapping and reads the upstream
// tool of a known entry.
fn parity_test_mapping(fs_r: &FsReadCap, fleet: String, fails: &mut Int) -> Int {
    let profile: String = fleet + "/.github/profile/README.md";
    if !path_exists(fs_r, profile) {
        println("SKIP\tparity_mapping\tno profile at " + profile);
        return 0;
    }
    let rows: List[String] = parity_map_rows(fs_r, profile);
    println("parity mapping rows=" + int_to_str(list_len(rows)));
    if list_len(rows) < 99 {
        println("FAIL\tparity_mapping\ttoo few rows");
        *fails = *fails + 1;
        return 0;
    }
    let _a: Int = expect_eq("parity_map_oogrep", parity_map_lookup(rows, "oogrep"), "grep", fails);
    let _b: Int = expect_eq("parity_map_oodiff", parity_map_lookup(rows, "oodiff"), "diff", fails);
    let _c: Int = expect_eq("parity_map_oojq", parity_map_lookup(rows, "oojq"), "jq", fails);
    let _d: Int = expect_eq("parity_map_unknown", parity_map_lookup(rows, "oo_nope"), "", fails);
    return 0;
}

// Check that the scanner finds the words of the tool and the bound that
// stands in front of it.
fn parity_test_scan(fails: &mut Int) -> Int {
    let pipe_line: String = "echo hi | ./x -q a | grep q";
    let pipe_at: Int = parity_scan_tool_pos(pipe_line, "x");
    let _f: Int = expect_eq("parity_scan_pipe", text_trim(parity_scan_take(pipe_line, pipe_at + 3)), "-q a", fails);
    let fd_line: String = "./x -f a 2>&1";
    let fd_at: Int = parity_scan_tool_pos(fd_line, "x");
    let _h: Int = expect_eq("parity_scan_fd", text_trim(parity_scan_take(fd_line, fd_at + 3)), "-f a", fails);
    let bound_line: String = "timeout 2 ./x -f a";
    let bound_at: Int = parity_scan_tool_pos(bound_line, "x");
    let _e: Int = expect_eq("parity_scan_bound", parity_scan_bound(bound_line, bound_at), "timeout 2", fails);
    let num_line: String = "./x --count=2";
    let num_at: Int = parity_scan_tool_pos(num_line, "x");
    let _j: Int = expect_eq("parity_scan_number_word", text_trim(parity_scan_take(num_line, num_at + 3)), "--count=2", fails);
    let words: List[String] = parity_scan_words("'a b' c");
    let _g: Int = expect_eq("parity_scan_words", list_get(words, 0), "a b", fails);
    let many: List[Int] = parity_scan_places("assert a; ./x -q; ./x -r", "x");
    let _p: Int = expect_eq("parity_scan_places", int_to_str(list_len(many)), "2", fails);
    let sub_line: String = "test \"$$(./oojq -c 5 qa/fixtures/single.txt)\" = \"line\" && echo \"PASS\"";
    let sub_at: Int = parity_scan_tool_pos(sub_line, "oojq");
    let sub_len: Int = parity_scan_tool_at(sub_line, sub_at, "oojq");
    let _q: Int = expect_eq("parity_scan_substitution", text_trim(parity_scan_take(sub_line, sub_at + sub_len)),
        "-c 5 qa/fixtures/single.txt", fails);
    return 0;
}

// Check that the input of a case is the command the recipe pipes into the
// tool, and that a command with no pipe has no input.
fn parity_test_input(fails: &mut Int) -> Int {
    let echo_line: String = "echo 'a b' | ./x -q";
    let echo_at: Int = parity_scan_tool_pos(echo_line, "x");
    let _k: Int = expect_eq("parity_case_input_echo", parity_input_directive(echo_line, echo_at), "input echo \"a b\"", fails);
    let printf_line: String = "printf '%s' '0.5' | ./x -q";
    let printf_at: Int = parity_scan_tool_pos(printf_line, "x");
    let _l: Int = expect_eq("parity_case_input_printf", parity_input_directive(printf_line, printf_at), "input printf %s 0.5",
        fails);
    let after_line: String = "./x -q | grep a";
    let after_at: Int = parity_scan_tool_pos(after_line, "x");
    let _m: Int = expect_eq("parity_case_input_after", parity_input_directive(after_line, after_at), "", fails);
    let none_line: String = "./x -q";
    let none_at: Int = parity_scan_tool_pos(none_line, "x");
    let _n: Int = expect_eq("parity_case_input_none", parity_input_directive(none_line, none_at), "", fails);
    let sub_line: String = "x \"$$(echo 'a b' | ./x -q)\"";
    let sub_at: Int = parity_scan_tool_pos(sub_line, "x");
    let _o: Int = expect_eq("parity_case_input_subshell", parity_input_directive(sub_line, sub_at), "input echo \"a b\"",
        fails);
    let bin_line: String = "assert_out \"$$(echo '[[1],[2]]' | ./$(BIN) -c '[recurse(.[]?)]' 2>&1)\"";
    let bin_at: Int = parity_scan_tool_pos(bin_line, "oojq");
    let _r: Int = expect_eq("parity_case_input_bin", parity_input_directive(bin_line, bin_at), "input echo [[1],[2]]", fails);
    let two_line: String = "assert \"x\"| ; echo 'b' | ./x -q; echo 'c' | ./x -r";
    let two_at: Int = parity_scan_tool_pos(two_line, "x");
    let _s: Int = expect_eq("parity_case_input_last_pipe", parity_input_directive(two_line, two_at), "input echo b", fails);
    return 0;
}

// Check that the case extractor finds the tool invocations of a test recipe.
fn parity_test_cases(fs_r: &FsReadCap, fleet: String, fails: &mut Int) -> Int {
    let mk: String = fleet + "/oogrep/Makefile";
    if !path_exists(fs_r, mk) {
        println("SKIP\tparity_cases\tno Makefile at " + mk);
        return 0;
    }
    let cases: List[String] = parity_case_collect(fs_r, "oogrep", mk, fleet + "/oogrep/qa/parity/deviations.oot");
    println("parity cases extracted=" + int_to_str(list_len(cases)));
    if list_len(cases) < 5 {
        println("FAIL\tparity_cases\ttoo few cases");
        *fails = *fails + 1;
        return 0;
    }
    let mut show: Int = 0;
    while show < 5 && show < list_len(cases) {
        println("  case: " + list_get(cases, show));
        show = show + 1;
    }
    let _s: Int = parity_test_scan(fails);
    let _t: Int = parity_test_input(fails);
    let _u: Int = parity_test_setup(fails);
    return 0;
}

// Check that the writer of the word codec and the reader of the same codec
// are the exact inverse. A word with a space, a double quote or a backslash
// has to come back as it went in, because a case that loses its quotes is a
// case that runs another program than the recipe did.
fn parity_test_words(fails: &mut Int) -> Int {
    let plain: String = "-c";
    let _a: Int = expect_eq("parity_word_plain", parity_quote_word(plain), "-c", fails);
    let spaced: String = "if . == 1 then a elif . == 2 then b else c end";
    let _b: Int = expect_eq("parity_word_spaced", parity_quote_word(spaced),
        "\"if . == 1 then a elif . == 2 then b else c end\"", fails);
    let quoted: String = "if . == 1 then \"a\" elif . == 2 then \"b\" else \"c\" end";
    let _c: Int = expect_eq("parity_word_quoted", parity_quote_word(quoted),
        "\"if . == 1 then \\\"a\\\" elif . == 2 then \\\"b\\\" else \\\"c\\\" end\"", fails);
    let slashed: String = "a\\b";
    let _d: Int = expect_eq("parity_word_slash", parity_quote_word(slashed), "\"a\\\\b\"", fails);
    let back: List[String] = parity_words("match -c " + parity_quote_word(quoted));
    let _e: Int = expect_eq("parity_word_read_back", list_get(back, 2), quoted, fails);
    let two: List[String] = parity_words("match " + parity_quote_word(quoted) + " " + parity_quote_word(spaced));
    let _f: Int = expect_eq("parity_word_read_two", list_get(two, 1), quoted, fails);
    let _g: Int = expect_eq("parity_word_read_two_b", list_get(two, 2), spaced, fails);
    let empty: List[String] = parity_words("match " + parity_quote_word(""));
    let _h: Int = expect_eq("parity_word_empty", list_get(empty, 1), "", fails);
    return 0;
}

// Check that a declared deviation turns a case into a differ case, and that a
// case that is not declared stays a match case.
fn parity_test_deviation(fails: &mut Int) -> Int {
    let mut devs: List[String] = list_new();
    devs = list_push(devs, "match -c from_entries");
    let _x: Int = expect_eq("parity_deviation_none", parity_case_apply_deviation(devs, "match -c map_values"),
        "match -c map_values", fails);
    let _y: Int = expect_eq("parity_deviation_yes", parity_case_apply_deviation(devs, "match -c from_entries"),
        "differ -c from_entries", fails);
    let _z: Int = expect_eq("parity_deviation_twice", parity_case_apply_deviation(devs, "differ -c from_entries"),
        "differ -c from_entries", fails);
    return 0;
}

// Run every parity self test.
pub fn parity_test_run(fs_r: &FsReadCap, env: &EnvCap) -> Int {
    let mut fails: Int = 0;
    let r: Result[String, String] = env_get(env, "OODA_FLEET_DIR");
    let fleet: String = if r.is_ok() && r.val != "" { r.val } else { "/Projects/openOODA-tools" };
    let _m: Int = parity_test_mapping(fs_r, fleet, &mut fails);
    let _c: Int = parity_test_cases(fs_r, fleet, &mut fails);
    let _w: Int = parity_test_words(&mut fails);
    let _d: Int = parity_test_deviation(&mut fails);
    if fails > 0 {
        println("PARITY TEST FAIL n=" + int_to_str(fails));
        return 1;
    }
    println("PARITY TEST PASS");
    return 0;
}
