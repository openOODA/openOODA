// # Probe Cases - Prints The Generated Case Table Of One Tool
//
// Logline: Prints the parity cases of one tool so that a person can read them.
//
// Setup: Needs FsReadCap to read the Makefile of the tool.
//
// Beats:
//   1. Print every case of the tool named by the first argument.

import "std/core/text/num_buffer.oo";
import "parity/cases.oo";

pub fn main(fs_r: &FsReadCap, args: List[String]) -> Int {
    if list_len(args) < 1 {
        println("usage: probe_cases <tool> [fleet-dir]");
        return 2;
    }
    let tool: String = list_get(args, 0);
    let fleet: String = if list_len(args) > 1 { list_get(args, 1) } else { "/Projects/openOODA-tools" };
    let cases: List[String] = parity_case_collect(fs_r, tool, fleet + "/" + tool + "/Makefile", fleet + "/" + tool +
        "/qa/parity/deviations.oot");
    let mut i: Int = 0;
    while i < list_len(cases) {
        println(list_get(cases, i));
        i = i + 1;
    }
    println("cases=" + int_to_str(list_len(cases)));
    return 0;
}
