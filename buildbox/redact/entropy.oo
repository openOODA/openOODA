// # Redaction Entropy - Secret Shape Metrics
//
// Logline: Computes character frequency entropy so the redactor separates a real secret from an ordinary word.
//
// Setup: Pure functions. No caps. No IO. No filesystem access.
//
// Beats:
//   1. Split a candidate into distinct characters.
//   2. Count occurrences of each distinct character.
//   3. Compute Shannon entropy over that distribution.
//   4. Decide whether a candidate is secret-shaped.

// Characters that may appear inside a prefixed secret token. The set is
// deliberately narrow so a token never swallows trailing diff punctuation.
pub fn redact_is_token_char(c: String) -> Bool {
    return char_is_alpha(c) || char_is_digit(c) || c == "_" || c == "-";
}

pub fn redact_distinct(s: String) -> List[String] {
    let n: Int = chars_len(s);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let mut found: Bool = false;
        let mut j: Int = 0;
        while j < list_len(out) {
            if list_get(out, j) == c { found = true; }
            j = j + 1;
        }
        if !found { out = list_push(out, c); }
        i = i + 1;
    }
    return out;
}

pub fn redact_char_counts(s: String) -> List[Int] {
    let ds: List[String] = redact_distinct(s);
    let n: Int = chars_len(s);
    let mut counts: List[Int] = list_new();
    let mut j: Int = 0;
    while j < list_len(ds) {
        let c: String = list_get(ds, j);
        let mut k: Int = 0;
        let mut hit: Int = 0;
        while k < n {
            if char_at(s, k) == c { hit = hit + 1; }
            k = k + 1;
        }
        counts = list_push(counts, hit);
        j = j + 1;
    }
    return counts;
}

// The language has no direct Int to Float conversion. Build the float by
// decimal decomposition, which is exact for the small counts used here.
pub fn redact_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn redact_entropy(s: String) -> Float {
    let n: Int = chars_len(s);
    if n == 0 { return 0.0; }
    let counts: List[Int] = redact_char_counts(s);
    let nf: Float = redact_int_to_float(n);
    let mut h: Float = 0.0;
    let mut i: Int = 0;
    while i < list_len(counts) {
        let cf: Float = redact_int_to_float(list_get(counts, i));
        let p: Float = cf / nf;
        if p > 0.0 { h = h + (0.0 - p * ln(p)); }
        i = i + 1;
    }
    return h;
}

// A secret is long, uses many distinct characters, and has high entropy.
// Ordinary prose and ordinary identifiers fail at least one test.
pub fn redact_is_secret_shaped(s: String) -> Bool {
    if chars_len(s) <= 16 { return false; }
    if list_len(redact_distinct(s)) < 8 { return false; }
    if redact_entropy(s) < 3.0 { return false; }
    return true;
}
