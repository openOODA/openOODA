// # Redaction Self Test - Proves The Engine Removes Secrets And Keeps Ordinary Text
//
// Logline: Runs positive and negative redaction fixtures and reports the count of passes and failures.
//
// Setup: No caps. Pure string checks over fixed fixtures.
//
// Beats:
//   1. Assert that a prefixed API token is removed.
//   2. Assert that a PEM private key block is removed.
//   3. Assert that an environment dump credential is removed.
//   4. Assert that a marked fake fixture is kept.
//   5. Assert that ordinary code text is not mangled.

import "oostd/core/text/num_buffer.oo";
import "redact/anchor.oo";

fn expect_redacted(name: String, input: String, marker: String, fails: &mut Int) -> Int {
    let out: String = redact_text(input);
    if !str_contains(out, marker) {
        println("FAIL\t" + name + "\tmarker missing");
        *fails = *fails + 1;
        return 0;
    }
    println("PASS\t" + name);
    return 0;
}

fn expect_kept(name: String, input: String, needle: String, fails: &mut Int) -> Int {
    let out: String = redact_text(input);
    if !str_contains(out, needle) {
        println("FAIL\t" + name + "\tcontent lost");
        *fails = *fails + 1;
        return 0;
    }
    println("PASS\t" + name);
    return 0;
}

// The positive fixtures. Each input holds a real credential shape and each
// output must hold the redaction marker of that shape.
fn redact_test_secrets(fails: &mut Int) -> Int {
    let _r: Int = expect_redacted("prefixed_token",
        "key = sk-abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOP",
        "[REDACTED:sk-]", fails);
    let _r: Int = expect_redacted("aws_access_key",
        "AKIAIOSFODNN7EXAMPLEKEYMATERIAL01",
        "[REDACTED:AKIA]", fails);
    let _r: Int = expect_redacted("github_token",
        "ghp_abcdefghijklmnopqrstuvwxyz0123456789",
        "[REDACTED:ghp_]", fails);
    let _r: Int = expect_redacted("pem_private_key",
        "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAx7Vq3\nabcdefghijklmnopqrstuvwxyz0123\n-----END RSA PRIVATE KEY-----",
        "[REDACTED:" + "PRIVATE" + "_KEY]", fails);
    let _r: Int = expect_redacted("env_dump_secret",
        "OPENAI_API_KEY=sk-Zx9Kp2Lm7Qw4Er8Ty1Ui0Op3As6Df9Gh2Jk5Lz",
        "[REDACTED:ENV_SECRET]", fails);
    let _r: Int = expect_redacted("env_dump_password",
        "DB_PASSWORD=aB3xK9mQ7zR1vT5yW2uE6nL4pS8gH0jD",
        "[REDACTED:ENV_SECRET]", fails);
    return 0;
}

// The negative fixtures. Each input is text that must survive the engine.
fn redact_test_kept(fails: &mut Int) -> Int {
    let _r: Int = expect_kept("fake_fixture_kept",
        "TEST_TOKEN=sk-abcdefghijklmnopqrstuvwxyz0123456789 # OO-FAKE",
        "sk-abcdefghijklmnopqrstuvwxyz0123456789", fails);
    let _r: Int = expect_kept("ordinary_code_kept",
        "let total: Int = compute_sum(alpha, beta);",
        "compute_sum(alpha, beta)", fails);
    let _r: Int = expect_kept("short_string_kept",
        "short=abc",
        "short=abc", fails);
    return 0;
}

pub fn redact_test_run() -> Int {
    let mut fails: Int = 0;
    let _s: Int = redact_test_secrets(&mut fails);
    let _k: Int = redact_test_kept(&mut fails);
    if fails > 0 {
        println("REDACTION TEST FAIL n=" + int_to_str(fails));
        return 1;
    }
    println("REDACTION TEST PASS");
    return 0;
}
