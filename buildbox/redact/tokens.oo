// # Redaction Tokens - Prefixed Tokens And Private Key Blocks
//
// Logline: Removes API tokens with known prefixes and whole PEM private key blocks from text bound for a model.
//
// Setup: Pure functions. No caps. No IO. No network access.
//
// Beats:
//   1. Remove a PEM private key block, header to footer.
//   2. Remove one prefixed token kind from a candidate string.
//   3. Remove every known prefixed token kind from the text.

import "redact/entropy.oo";

// Remove every PEM private key block in the text. A block starts at a
// "-----BEGIN" marker that names a private key and ends at the next
// "-----END" marker. Blocks that do not name a private key are left intact.
pub fn redact_pem_blocks(s: String) -> String {
    let mut out: String = "";
    let mut rest: String = s;
    let mut guard: Int = 0;
    while guard < 64 {
        guard = guard + 1;
        let begin: Int = str_index_of(rest, "-----BEGIN");
        if begin < 0 { break; }
        let after: String = str_slice(rest, begin, chars_len(rest));
        let end: Int = str_index_of(after, "-----END");
        if end < 0 { break; }
        let block: String = str_slice(after, 0, end);
        let tail: String = str_slice(after, end, chars_len(after));
        let mark_end: Int = str_index_of(tail, "-----");
        if mark_end < 0 { rest = "";
        break; }
        let next: String = str_slice(tail, mark_end + 5, chars_len(tail));
        if str_contains(block, "PRIVATE KEY-----") {
            out = out + str_slice(rest, 0, begin) + "[REDACTED:" + "PRIVATE" + "_KEY]";
        } else {
            out = out + str_slice(rest, 0, begin) + block + str_slice(tail, 0, mark_end + 5);
        }
        rest = next;
    }
    out = out + rest;
    return out;
}

pub fn redact_prefix(s: String, pre: String) -> String {
    let pl: Int = chars_len(pre);
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        if i + pl <= n && str_slice(s, i, i + pl) == pre {
            let mut j: Int = i + pl;
            while j < n {
                let c: String = char_at(s, j);
                if !redact_is_token_char(c) { break; }
                j = j + 1;
            }
            if j - i > 16 {
                out = out + "[REDACTED:" + pre + "]";
                i = j;
                continue;
            }
        }
        out = out + char_at(s, i);
        i = i + 1;
    }
    return out;
}

pub fn redact_tokens(s: String) -> String {
    let mut prefixes: List[String] = list_new();
    prefixes = list_push(prefixes, "sk-");
    prefixes = list_push(prefixes, "AKIA");
    prefixes = list_push(prefixes, "ghp_");
    prefixes = list_push(prefixes, "gho_");
    prefixes = list_push(prefixes, "xox");
    let mut out: String = s;
    let mut i: Int = 0;
    while i < list_len(prefixes) {
        out = redact_prefix(out, list_get(prefixes, i));
        i = i + 1;
    }
    return out;
}
