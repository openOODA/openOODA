// # Auto Repair - The Bounded Proposal Flow
//
// Logline: Reads the fleet verdicts of one run and turns the failures the buildbox can repair into pull requests that ask a human to merge them.
//
// Setup: Needs ProcessCap for git and the API calls, FsReadCap for the verdicts and the checkouts, FsWriteCap for the notes and the request bodies, and EnvCap for the run.
//
// Beats:
//   1. Classify one fleet verdict.
//   2. Read one field of a verdict line.
//   3. Read the upstream a repository names in its own case table.
//   4. Read the failing verdicts of one run.
//   5. Read the bound of one run.
//   6. Repair one repository.
//   7. Run the bounded flow over one run.
//
// The flow is bounded twice. The bound of the run says how many pull
// requests one run may open, and the flow stops at the pull request. It
// never merges one, because a repair that repairs itself is a repair that
// nobody read.
//
// A verdict the buildbox cannot repair is not dropped. The flow writes a
// note that names the tool, the verdict, and the next action, so the queue
// always holds the whole story of the run.
//
// The repair the buildbox can make is the contract itself: the workflow, the
// parity runner, the case table, and the patch of the makefile. Those are
// files the buildbox holds, so the repair is the same bytes in every
// repository. The behaviour of a tool is never repaired by the buildbox,
// because the buildbox does not know what a tool is supposed to do.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "text/lines.oo";
import "ci/apply.oo";
import "loop/setup.oo";
import "repair/propose.oo";

// Classify one fleet verdict into the kind of work it asks for. A contract
// failure is a file the buildbox holds and can write again. A behaviour
// failure is a question about what a tool is supposed to do, and only a
// human or an agent can answer it. A backlog tool is not implemented and
// asks for nothing.
pub fn auto_repair_classify(verdict: String) -> String {
    if verdict == "PASS" { return "pass"; }
    if verdict == "NO_BUILD_TARGET" { return "backlog"; }
    if verdict == "CI_MISSING" { return "contract"; }
    return "behavior";
}

// Read one field of a verdict line. The fields are separated by a tab, so a
// field that holds a space cannot break the record.
pub fn auto_repair_field(line: String, index: Int) -> String {
    let mut rest: String = line;
    let mut i: Int = 0;
    while i < index {
        let p: Int = str_index_of(rest, "\t");
        if p < 0 { return ""; }
        rest = str_slice(rest, p + 1, chars_len(rest));
        i = i + 1;
    }
    let q: Int = str_index_of(rest, "\t");
    if q < 0 { return rest; }
    return str_slice(rest, 0, q);
}

// Read the upstream a repository names in its own case table. The table is
// the truth of the repository about the tool it replaces, so the buildbox
// never has to guess it.
pub fn auto_repair_upstream_of(fs_r: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return ""; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if str_starts_with(l, "# upstream:") {
            return text_trim(str_slice(l, 11, chars_len(l)));
        }
        i = i + 1;
    }
    return "";
}

// Read the failing verdicts of one run. A pass and a backlog tool are not a
// failure, so they never reach the flow.
pub fn auto_repair_failures(fs_r: &FsReadCap, path: String) -> List[String] {
    let mut out: List[String] = list_new();
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return out; }
    let lines: List[String] = text_split_lines(r.val);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let l: String = text_trim(list_get(lines, i));
        if l != "" {
            let k: String = auto_repair_classify(auto_repair_field(l, 0));
            if k == "contract" || k == "behavior" { out = list_push(out, l); }
        }
        i = i + 1;
    }
    return out;
}

// Read the bound of one run. The bound is the number of pull requests one
// run may open. A bound below one is raised to one, because a run that may
// open nothing would never repair anything.
pub fn auto_repair_limit(env: &EnvCap) -> Int {
    let raw: String = loop_setup_env_or(env, "OODA_REPAIR_LIMIT", "5");
    let mut digits: List[String] = list_new();
    let mut k: Int = 0;
    while k < 10 {
        digits = list_push(digits, int_to_str(k));
        k = k + 1;
    }
    let mut n: Int = 5;
    let mut i: Int = 0;
    while i < list_len(digits) {
        if list_get(digits, i) == raw { n = i; }
        i = i + 1;
    }
    if n < 1 { return 1; }
    return n;
}

// Publish the repair: write the credential, push the branch, and open the
// pull request. The answer is one word.
pub fn auto_repair_publish(sys: &ProcessCap, fs_w: &FsWriteCap, env: &EnvCap, cfg: LoopCfg, repo: String, verdict: String, branch: String) -> String {
    let note_path: String = cfg.queue + "/repair/" + repo + ".oot";
    let token: String = loop_setup_env_or(env, "OODA_GITHUB_TOKEN", "");
    if token == "" {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tno credential, so the branch was not pushed");
        return "note";
    }
    let cred: String = repair_credential_path(cfg.cache);
    if !repair_write_credential(sys, fs_w, cred, token) {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tthe credential file was not written");
        return "note";
    }
    if !repair_push(sys, repair_dir(cfg.repos, repo), branch, cfg.org, repo, cred) {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tthe branch was not pushed");
        return "note";
    }
    let title: String = "ci(buildbox): restore the fail closed contract";
    let body: String = "The gate of this tool failed closed because the contract was missing. The buildbox wrote the workflow, the parity runner, the case table, and the patch of the makefile again. The change is proposed for a human to read and merge.";
    let rc: Int = repair_pr(sys, fs_w, cfg.cache, token, cfg.org, repo, branch, title, body);
    let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\ta pull request waits for a human");
    if rc != 0 { return "note"; }
    return "pull";
}

// Repair one repository that lost its contract. The answer is one word:
// the kind of work that was done for the tool.
pub fn auto_repair_contract(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, cfg: LoopCfg, repo: String, verdict: String) -> String {
    let note_path: String = cfg.queue + "/repair/" + repo + ".oot";
    let dir: String = repair_dir(cfg.repos, repo);
    if !path_exists(fs_r, dir) {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tno checkout to repair");
        return "note";
    }
    let upstream: String = auto_repair_upstream_of(fs_r, dir + "/qa/parity/cases.oot");
    if upstream == "" {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tthe tool names no upstream, so the contract cannot be written");
        return "note";
    }
    let harness: String = loop_setup_env_or(env, "OODA_HARNESS_DIR", "/build/src/parity");
    let _c: Bool = ci_apply_repo(fs_r, fs_w, cfg.repos, repo, upstream, harness);
    let branch: String = "buildbox/auto-repair-" + repo;
    let message: String = "ci(buildbox): restore the fail closed contract";
    if !repair_commit(sys, dir, branch, message) {
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\tthe contract is already there");
        return "note";
    }
    return auto_repair_publish(sys, fs_w, env, cfg, repo, verdict, branch);
}
