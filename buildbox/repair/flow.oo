// # Repair Flow - The Bounded Run Over The Verdicts Of One Loop Run
//
// Logline: Walks the failing verdicts of one run and repairs as many tools as the bound of the run allows.
//
// Setup: Needs ProcessCap for git and the API calls, FsReadCap for the verdicts, FsWriteCap for the notes, and EnvCap for the run.
//
// Beats:
//   1. Repair one repository of the run.
//   2. Run the bounded flow over the verdicts of one run.
//
// The bound of the run says how many pull requests one run may open. The
// flow never merges a pull request, because a repair that repairs itself is
// a repair that nobody read.
//
// A tool the buildbox cannot repair is not dropped. The flow writes a note
// that names the tool, the verdict, and the next action, so the queue
// always holds the whole story of the run.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "loop/setup.oo";
import "repair/auto_repair.oo";
import "repair/propose.oo";

// Repair one repository of the run. The answer is one word: the kind of
// work that was done for the tool.
pub fn auto_repair_one(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, cfg: LoopCfg, line: String) -> String {
    let repo: String = auto_repair_field(line, 1);
    if repo == "" { return "skip"; }
    let verdict: String = auto_repair_field(line, 0);
    let kind: String = auto_repair_classify(verdict);
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, cfg.queue + "/repair");
    if kind == "behavior" {
        let note_path: String = cfg.queue + "/repair/" + repo + ".oot";
        let _n: Bool = repair_note(fs_w, note_path, verdict + "\t" + repo + "\ta human has to repair the tool");
        return "note";
    }
    return auto_repair_contract(sys, fs_r, fs_w, env, cfg, repo, verdict);
}

// Run the bounded flow over the verdicts of one run. The answer is the
// number of pull requests the run opened.
pub fn auto_repair_run(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, cfg: LoopCfg) -> Int {
    let verdicts: String = cfg.queue + "/fleet_verdicts.oot";
    let lines: List[String] = auto_repair_failures(fs_r, verdicts);
    let limit: Int = auto_repair_limit(env);
    let mut opened: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lines) && opened < limit {
        let kind: String = auto_repair_one(sys, fs_r, fs_w, env, cfg, list_get(lines, i));
        if kind == "pull" { opened = opened + 1; }
        i = i + 1;
    }
    println("repair opened=" + int_to_str(opened) + " bound=" + int_to_str(limit) + " failures=" + int_to_str(list_len(lines)));
    return opened;
}
