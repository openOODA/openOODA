// # Repair Propose - The Mechanics Of One Repair Pull Request
//
// Logline: Writes the credential, commits the repair, pushes the branch, and opens the pull request that asks a human to look.
//
// Setup: Needs ProcessCap for git and curl, and FsWriteCap for the credential and the request body.
//
// Beats:
//   1. Build the path of the credential file.
//   2. Write the credential into a file of mode 0600.
//   3. Run git in one checkout.
//   4. Commit the repair on its own branch.
//   5. Push the branch with the credential file.
//   6. Open the pull request.
//   7. Write the repair note into the queue.
//
// The credential never appears on a command line and never enters the queue
// mount. The credential file is created empty, tightened to mode 0600, and
// only then filled, so no wider mode ever holds the secret. The git
// credential store reads it from that file.
//
// The repair never merges itself. A pull request is a question to a human,
// and the answer is the merge.

import "oostd/fs/os/fs.oo";
import "oostd/app/agent/token/json_envelope.oo";
import "text/lines.oo";
import "loop/gh_api.oo";

// The checkout of one tool of the run.
pub fn repair_dir(repos: String, repo: String) -> String {
    return repos + "/" + repo;
}

// The path of the credential file of one run.
pub fn repair_credential_path(cache_dir: String) -> String {
    return cache_dir + "/git_credential.txt";
}

// Write the credential into a file of mode 0600. The file is created empty,
// tightened to mode 0600, and the mode is read back. The secret is written
// only after the read back confirms the mode, so no wider mode ever holds
// it.
pub fn repair_write_credential(sys: &ProcessCap, fs_w: &FsWriteCap, path: String, token: String) -> Bool {
    let mut t: List[String] = list_new();
    t = list_push(t, path);
    let tr: Result[Int, String] = sys_exec_wait(sys, "touch", t);
    if tr.is_err() { return false; }
    let mut c: List[String] = list_new();
    c = list_push(c, "600");
    c = list_push(c, path);
    let cr: Result[Int, String] = sys_exec_wait(sys, "chmod", c);
    if cr.is_err() { return false; }
    let sr: Result[String, String] = sys_exec(sys, "stat", "-c", "%a", path);
    if sr.is_err() { return false; }
    if text_trim(sr.val) != "600" { return false; }
    let body: String = "https://x-access-token:" + token + "@github.com\n";
    let w: Result[Void, String] = fs_write_file(fs_w, path, body);
    if w.is_err() { return false; }
    let mut c2: List[String] = list_new();
    c2 = list_push(c2, "600");
    c2 = list_push(c2, path);
    let cr2: Result[Int, String] = sys_exec_wait(sys, "chmod", c2);
    return cr2.is_ok();
}

// Run git in one checkout. The arguments travel in argv form, so no shell
// string is built and no value can be read as a command.
pub fn repair_git(sys: &ProcessCap, dir: String, args: List[String]) -> Int {
    let mut a: List[String] = list_new();
    a = list_push(a, "-C");
    a = list_push(a, dir);
    let mut i: Int = 0;
    while i < list_len(args) {
        a = list_push(a, list_get(args, i));
        i = i + 1;
    }
    let r: Result[Int, String] = sys_exec_wait(sys, "git", a);
    let mut code: Int = 1;
    if r.is_ok() { code = r.val; }
    return code;
}

// Commit the repair on its own branch. The branch is created from the head
// of the checkout, so the repair sits on the default branch plus one
// commit and the pull request shows exactly that. A checkout with no change
// is not committed, because an empty commit is noise.
pub fn repair_commit(sys: &ProcessCap, dir: String, branch: String, message: String) -> Bool {
    let sr: Result[String, String] = sys_exec(sys, "git", "-C", dir, "status", "--porcelain");
    if sr.is_err() { return false; }
    if text_trim(sr.val) == "" { return false; }
    let mut co: List[String] = list_new();
    co = list_push(co, "checkout");
    co = list_push(co, "-B");
    co = list_push(co, branch);
    if repair_git(sys, dir, co) != 0 { return false; }
    let mut ad: List[String] = list_new();
    ad = list_push(ad, "add");
    ad = list_push(ad, "-A");
    if repair_git(sys, dir, ad) != 0 { return false; }
    let mut cm: List[String] = list_new();
    cm = list_push(cm, "commit");
    cm = list_push(cm, "-m");
    cm = list_push(cm, message);
    return repair_git(sys, dir, cm) == 0;
}

// Push the branch. The credential store reads the secret from the file of
// mode 0600, so the secret never appears on a command line.
pub fn repair_push(sys: &ProcessCap, dir: String, branch: String, org: String, repo: String, cred: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "-c");
    a = list_push(a, "credential.helper=store --file=" + cred);
    a = list_push(a, "push");
    a = list_push(a, "https://github.com/" + org + "/" + repo + ".git");
    a = list_push(a, "HEAD:refs/heads/" + branch);
    return repair_git(sys, dir, a) == 0;
}

// Open the pull request. The body travels in a file, so the request never
// carries the secret, and the answer of the server is the exit code.
type BagRepairPr = struct {
    title: String,
    body: String,
};

pub fn repair_pr(sys: &ProcessCap, fs_w: &FsWriteCap, cache_dir: String, token: String, org: String, repo: String,
    branch: String, bag: BagRepairPr) -> Int {
    let path: String = cache_dir + "/repair_pr_body.json";
    let doc: String = "{\"title\":" + json_str(bag.title)
        + ",\"head\":" + json_str(branch)
        + ",\"base\":\"main\""
        + ",\"body\":" + json_str(bag.body) + "}";
    let _w: Result[Void, String] = fs_write_file(fs_w, path, doc);
    let url: String = "https://api.github.com/repos/" + org + "/" + repo + "/pulls";
    let code: Int = gh_api_call(sys, fs_w, cache_dir, token, "POST", url, path, "");
    let _rm: Result[Void, String] = fs_remove_file(fs_w, path);
    return code;
}

// Write the repair note into the queue. The note names the tool, the
// verdict, and the next action, so a human reads one file per tool.
pub fn repair_note(fs_w: &FsWriteCap, path: String, line: String) -> Bool {
    let w: Result[Void, String] = fs_write_file(fs_w, path, line + "\n");
    return w.is_ok();
}
