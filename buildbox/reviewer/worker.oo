// # ReviewWorker - Per-Tool And Idlescreen Deterministic Build & Golden Parity Worker
//
// Logline: Runs make det and make parity for idlescreen and individual openOODA-tools repositories in pure .oo.
//
// Setup: Uses ProcessCap, FsReadCap, and FsWriteCap.
//
// Beats:
//   1. Append timestamped entries to review.log and extract 64-hex SHA256 digests.
//   2. Run idlescreen (branch ooda) make parity and make det gates.
//   3. Run per-tool make det and make parity gates for a single openOODA-tools repository.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "eco/manifest_exec.oo";

pub fn sp_log(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, msg: String) -> Int {
    let dr: Result[String, String] = sys_exec(sys, "date", "-Is");
    let ts: String = if dr.is_ok() && text_trim(dr.val) != "" { text_trim(dr.val) } else { "2026-11-04T20:40:00-10:00" };
    let lpath: String = root + "/review.log";
    let prev: Result[String, String] = fs_read_file(fs_r, lpath);
    let base: String = if prev.is_ok() { prev.val } else { "" };
    let _w: Result[Void, String] = fs_write_file(fs_w, lpath, base + "[" + ts + "] " + msg + "\n");
    return 0;
}

pub fn sp_is_hex64(s: String) -> Bool {
    if bytes_len(s) < 64 { return false; }
    let mut i: Int = 0;
    while i < 64 {
        let b: Int = byte_at(s, i);
        let ok: Bool = (b >= 48 && b <= 57) || (b >= 97 && b <= 102);
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

pub fn sp_sha_of(txt: String) -> String {
    let lines: List[String] = text_split_lines(txt);
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = list_get(lines, i);
        i = i + 1;
        if sp_is_hex64(ln) { return byte_slice(ln, 0, 64); }
    }
    return "";
}

pub fn sp_count_substr(txt: String, sub: String) -> Int {
    let lines: List[String] = text_split_lines(txt);
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lines) {
        if str_contains(list_get(lines, i), sub) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn sp_parity_detail(txt: String) -> String {
    let lines: List[String] = text_split_lines(txt);
    let mut last: String = "";
    let mut i: Int = 0;
    while i < list_len(lines) {
        let ln: String = text_trim(list_get(lines, i));
        i = i + 1;
        let idx: Int = str_index_of(ln, "match=");
        if idx >= 0 && str_contains(ln, "fail=") {
            last = str_slice(ln, idx, chars_len(ln));
        }
    }
    return last;
}

pub fn sp_run_idlescreen(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, cyc: String, det_to: String) -> Int {
    let idle: String = "/Projects/idlescreen/idlescreen";
    let rdir: String = root + "/results/c" + cyc;
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, rdir);
    let br_r: Result[String, String] = sys_exec(sys, "git", "-C", idle, "branch", "--show-current");
    let br: String = if br_r.is_ok() && text_trim(br_r.val) != "" { text_trim(br_r.val) } else { "?" };
    let st_r: Result[String, String] = sys_exec(sys, "git", "-C", idle, "status", "--porcelain");
    let st_txt: String = if st_r.is_ok() { text_trim(st_r.val) } else { "" };
    let dirty: Int = if st_txt == "" { 0 } else { list_len(text_split_lines(st_txt)) };
    let _l0: Int = sp_log(sys, fs_r, fs_w, root, "IDLE branch=" + br + " dirty_files=" + int_to_str(dirty));
    let plog: String = root + "/logs/c" + cyc + "-idle-parity.log";
    let pr: Result[String, String] = sys_exec(sys, "timeout", det_to, "make", "-C", idle, "parity");
    let ptxt: String = match pr { Ok(s) => s, Err(e) => e };
    let prc: Int = if pr.is_ok() { 0 } else { 1 };
    let _wp: Result[Void, String] = fs_write_file(fs_w, plog, ptxt);
    let _wt: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-parity.txt", "gate=parity rc=" + int_to_str(prc) + "\n" + eco_tail_lines(ptxt, 12));
    if prc == 0 && str_contains(ptxt, "PASS: scene parity") {
        let _wv: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-parity.verdict", "PASS\n");
        let _l1: Int = sp_log(sys, fs_r, fs_w, root, "IDLE parity PASS (" + int_to_str(sp_count_substr(ptxt, "bit-exact parity")) + " scenes)");
    } else {
        let _wv: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-parity.verdict", "FAIL\n");
        let _l1: Int = sp_log(sys, fs_r, fs_w, root, "IDLE parity FAIL rc=" + int_to_str(prc) + " — see " + plog);
    }
    return sp_run_idlescreen_det(sys, fs_r, fs_w, root, cyc, det_to, idle, rdir);
}

pub fn sp_run_idlescreen_det(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, cyc: String, det_to: String, idle: String, rdir: String) -> Int {
    let dlog: String = root + "/logs/c" + cyc + "-idle-det.log";
    let dr: Result[String, String] = sys_exec(sys, "timeout", det_to, "make", "-C", idle, "det");
    let dtxt: String = match dr { Ok(s) => s, Err(e) => e };
    let drc: Int = if dr.is_ok() { 0 } else { 1 };
    let _wd: Result[Void, String] = fs_write_file(fs_w, dlog, dtxt);
    let dsha: String = sp_sha_of(dtxt);
    let _wt: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-det.txt", "gate=det rc=" + int_to_str(drc) + " sha256=" + dsha + "\n" + eco_tail_lines(dtxt, 3));
    if drc == 0 && str_contains(dtxt, "PASS: deterministic build") {
        let _wv: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-det.verdict", "PASS " + dsha + "\n");
        let sha16: String = if chars_len(dsha) >= 16 { str_slice(dsha, 0, 16) } else { dsha };
        let _l2: Int = sp_log(sys, fs_r, fs_w, root, "IDLE det PASS sha256=" + sha16 + "...");
    } else {
        let _wv: Result[Void, String] = fs_write_file(fs_w, rdir + "/idle-det.verdict", "FAIL " + dsha + "\n");
        let _l2: Int = sp_log(sys, fs_r, fs_w, root, "IDLE det FAIL rc=" + int_to_str(drc) + " — see " + dlog);
    }
    return 0;
}

pub fn sp_tool_worker(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, d: String, name: String, cyc: String, det_to: String, par_to: String, oodac: String) -> Int {
    let rdir: String = root + "/results/c" + cyc;
    let _m: Result[Void, String] = fs_mkdir_p(fs_w, rdir);
    let st_r: Result[String, String] = sys_exec(sys, "git", "-C", d, "status", "--porcelain");
    let dirty: String = if st_r.is_ok() && text_trim(st_r.val) != "" { "1" } else { "0" };
    let mk: String = eco_read_trimmed(fs_r, d + "/Makefile");
    if str_contains("\n" + mk, "\ndet:") {
        let dlog: String = root + "/logs/c" + cyc + "-" + name + ".det.log";
        let dr: Result[String, String] = sys_exec(sys, "timeout", det_to, "make", "-C", d, "det", "OODA_COMPILER=" + oodac);
        let dtxt: String = match dr { Ok(s) => s, Err(e) => e };
        let _wd: Result[Void, String] = fs_write_file(fs_w, dlog, dtxt);
        let dsha: String = sp_sha_of(dtxt);
        let v_det: String = if dr.is_ok() && str_contains(dtxt, "PASS: deterministic") { "PASS" } else { "FAIL" };
        let _w1: Result[Void, String] = fs_write_file(fs_w, rdir + "/" + name + ".det", v_det + " " + dsha + " dirty=" + dirty + "\n");
        if v_det != "PASS" { let _cp: Result[Void, String] = fs_write_file(fs_w, root + "/logs/FAIL-c" + cyc + "-" + name + ".det.log", dtxt); }
    } else {
        let _w1: Result[Void, String] = fs_write_file(fs_w, rdir + "/" + name + ".det", "SKIP - - dirty=" + dirty + "\n");
    }
    if str_contains("\n" + mk, "\nparity:") {
        let plog: String = root + "/logs/c" + cyc + "-" + name + ".par.log";
        let pr: Result[String, String] = sys_exec(sys, "timeout", par_to, "make", "-C", d, "parity", "OODA_COMPILER=" + oodac);
        let ptxt: String = match pr { Ok(s) => s, Err(e) => e };
        let _wp: Result[Void, String] = fs_write_file(fs_w, plog, ptxt);
        let det_s: String = sp_parity_detail(ptxt);
        let v_par: String = if str_contains(ptxt, "no upstream in qa/parity/cases.oot") || str_contains(ptxt, "SKIP\tparity") || str_contains(ptxt, "SKIP:") || (str_contains(ptxt, "upstream tool") && str_contains(ptxt, "not installed")) || (str_contains(ptxt, "127 against") && str_contains(ptxt, "match=0") && str_contains(ptxt, "differ=0")) { "SKIP-NOUPSTREAM" } else if str_contains(ptxt, "no match case") && str_contains(ptxt, "differ=0") { "SKIP-NOMATCH" } else if pr.is_ok() && (str_contains(ptxt, "fail=0\n") || str_contains(ptxt, "fail=0 ") || str_ends_with(text_trim(ptxt), "fail=0")) { "PASS" } else { "FAIL" };
        let d_out: String = if det_s != "" { det_s } else { "rc=" + (if pr.is_ok() { "0" } else { "1" }) };
        let _w2: Result[Void, String] = fs_write_file(fs_w, rdir + "/" + name + ".par", v_par + " " + d_out + " dirty=" + dirty + "\n");
        if v_par == "FAIL" { let _cp2: Result[Void, String] = fs_write_file(fs_w, root + "/logs/FAIL-c" + cyc + "-" + name + ".par.log", ptxt); }
    } else {
        let _w2: Result[Void, String] = fs_write_file(fs_w, rdir + "/" + name + ".par", "SKIP - - dirty=" + dirty + "\n");
    }
    return 0;
}
