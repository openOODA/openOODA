// # Buildbox Self Test - Runs The Module Self Tests From The Buildbox Root
//
// Logline: Runs every buildbox module self test and reports the aggregate result.
//
// Setup: The entry point must sit at the buildbox root so nested imports resolve from the root.
//
// Beats:
//   1. Run the redaction engine self test.
//   2. Run the parity mapping and case extraction self test.
//   3. Report the aggregate result.

import "redact/redact_test.oo";
import "parity/test.oo";
import "eco/test.oo";

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap) -> Int {
    let rc: Int = redact_test_run();
    if rc != 0 { return rc; }
    let prc: Int = parity_test_run(fs_r, env);
    if prc != 0 { return prc; }
    let erc: Int = eco_test_run(fs_r);
    if erc != 0 { return erc; }
    println("BUILDBOX SELFTEST PASS");
    return 0;
}
