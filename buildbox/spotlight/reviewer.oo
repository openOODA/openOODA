// # Spotlight Reviewer - Continuous Golden-Parity & Deterministic-Build Monitor
//
// Logline: Native .oo continuous review daemon for spotlight (100.66.54.24) running idlescreen and 257-repo openOODA-tools det + parity sweeps.
//
// Setup: Uses ProcessCap, FsReadCap, FsWriteCap, and EnvCap. Zero .sh or .py scripts.
//
// Beats:
//   1. Support `--worker <dir> <cyc>` subcommand for parallel xargs -P worker execution.
//   2. Enumerate all 257 openOODA-tools repositories with Makefiles and dispatch parallel workers.
//   3. Aggregate per-tool .det and .par verdicts and detect FLIP / DRIFT against previous cycle state.
//   4. Loop continuously (or run once with `--once`) across idlescreen and openOODA-tools.

import "std/core/text/num_buffer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";
import "text/lines.oo";
import "eco/manifest_exec.oo";
import "spotlight/worker.oo";

fn sp_env_or(env: &EnvCap, key: String, dflt: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() && text_trim(r.val) != "" { return text_trim(r.val); }
    return dflt;
}

fn sp_basename(path: String) -> String {
    let mut s: String = path;
    while str_ends_with(s, "/") { s = str_slice(s, 0, chars_len(s) - 1); }
    let n: Int = chars_len(s);
    let mut last_slash: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "/" { last_slash = i; }
        i = i + 1;
    }
    if last_slash < 0 { return s; }
    return str_slice(s, last_slash + 1, n);
}

fn sp_first_word(s: String) -> String {
    let t: String = text_trim(s);
    let idx: Int = str_index_of(t, " ");
    if idx < 0 { return t; }
    return str_slice(t, 0, idx);
}

fn sp_check_flip(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, rdir: String, name: String, gate: String) -> Int {
    let cur_raw: String = eco_read_trimmed(fs_r, rdir + "/" + name + "." + gate);
    let cur: String = if cur_raw != "" { cur_raw } else { "?" };
    let curv: String = sp_first_word(cur);
    let statef: String = root + "/state/" + gate + "." + name;
    let prev_raw: String = eco_read_trimmed(fs_r, statef);
    let prev: String = if prev_raw != "" { prev_raw } else { "INIT" };
    if prev != "INIT" {
        let prevv: String = sp_first_word(prev);
        if prevv != curv {
            let _l: Int = sp_log(sys, fs_r, fs_w, root, "FLIP " + name + " " + gate + " " + prevv + " -> " + curv);
        } else if prev != cur {
            let _l2: Int = sp_log(sys, fs_r, fs_w, root, "DRIFT " + name + " " + gate + " verdict=" + curv + " detail changed");
        }
    }
    let _w: Result[Void, String] = fs_write_file(fs_w, statef, cur + "\n");
    return 0;
}

fn sp_aggregate_tools(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, cyc: String) -> Int {
    let rdir: String = root + "/results/c" + cyc;
    let entries: List[String] = fs_read_dir(fs_r, rdir);
    let mut tsv: String = "";
    let mut nd: Int = 0; let mut np: Int = 0; let mut ns: Int = 0; let mut fd: Int = 0; let mut fp: Int = 0; let mut fs_c: Int = 0;
    let mut i: Int = 0;
    while i < list_len(entries) {
        let fnm: String = list_get(entries, i);
        i = i + 1;
        if !str_ends_with(fnm, ".det") { continue; }
        let name: String = str_slice(fnm, 0, chars_len(fnm) - 4);
        let det_line: String = eco_read_trimmed(fs_r, rdir + "/" + fnm);
        let par_line: String = eco_read_trimmed(fs_r, rdir + "/" + name + ".par");
        let dv: String = sp_first_word(if det_line != "" { det_line } else { "SKIP" });
        let pv: String = sp_first_word(if par_line != "" { par_line } else { "SKIP" });
        tsv = tsv + name + "\tdet=" + dv + "\tpar=" + pv + "\n";
        if dv == "PASS" { nd = nd + 1; } else if dv == "FAIL" || dv == "TIMEOUT" { fd = fd + 1; } else { ns = ns + 1; }
        if pv == "PASS" { np = np + 1; } else if pv == "FAIL" || pv == "TIMEOUT" { fp = fp + 1; } else { fs_c = fs_c + 1; }
        let _f1: Int = sp_check_flip(sys, fs_r, fs_w, root, rdir, name, "det");
        let _f2: Int = sp_check_flip(sys, fs_r, fs_w, root, rdir, name, "par");
    }
    let _wt: Result[Void, String] = fs_write_file(fs_w, root + "/sweep-c" + cyc + ".tsv", tsv);
    let _lg: Int = sp_log(sys, fs_r, fs_w, root, "TOOLS sweep done det: pass=" + int_to_str(nd) + " fail=" + int_to_str(fd) + " skip=" + int_to_str(ns) + " | parity: pass=" + int_to_str(np) + " fail=" + int_to_str(fp) + " skip=" + int_to_str(fs_c));
    return 0;
}

fn sp_run_tools(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, root: String, cyc: String, jobs: String, self_bin: String) -> Int {
    let _l0: Int = sp_log(sys, fs_r, fs_w, root, "TOOLS sweep begin (" + jobs + " jobs)");
    let tools_dir: String = "/Projects/openOODA-tools";
    let entries: List[String] = fs_read_dir(fs_r, tools_dir);
    let mut tlist: String = "";
    let mut i: Int = 0;
    while i < list_len(entries) {
        let e: String = list_get(entries, i);
        i = i + 1;
        if str_starts_with(e, "oo") && path_exists(fs_r, tools_dir + "/" + e + "/Makefile") {
            tlist = tlist + tools_dir + "/" + e + "\n";
        }
    }
    let list_path: String = root + "/tools.list";
    let _wl: Result[Void, String] = fs_write_file(fs_w, list_path, tlist);
    let mut xargv: List[String] = list_new();
    xargv = list_push(list_push(list_push(list_push(list_push(xargv, "-a"), list_path), "-P"), jobs), "-I{}");
    xargv = list_push(list_push(list_push(list_push(xargv, self_bin), "--worker"), "{}"), cyc);
    let _xr: Result[Int, String] = sys_exec_wait(sys, "xargs", xargv);
    return sp_aggregate_tools(sys, fs_r, fs_w, root, cyc);
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, args: List[String]) -> Int {
    let root: String = sp_env_or(env, "OODA_SPOTLIGHT_ROOT", "/home/ubermetroid/.local/state/spotlight-reviewer");
    let jobs: String = sp_env_or(env, "OODA_SPOTLIGHT_JOBS", "6");
    let sleep_s: String = sp_env_or(env, "OODA_SPOTLIGHT_SLEEP", "300");
    let det_to: String = sp_env_or(env, "OODA_SPOTLIGHT_DET_TIMEOUT", "1200");
    let par_to: String = sp_env_or(env, "OODA_SPOTLIGHT_PAR_TIMEOUT", "900");
    let oodac: String = sp_env_or(env, "OODA_COMPILER", "/Projects/openOODA-core/oodac/bin/oodac");
    let _m1: Result[Void, String] = fs_mkdir_p(fs_w, root + "/logs");
    let _m2: Result[Void, String] = fs_mkdir_p(fs_w, root + "/state");
    let _m3: Result[Void, String] = fs_mkdir_p(fs_w, root + "/results");
    if list_len(args) >= 3 && list_get(args, 0) == "--worker" {
        let d: String = list_get(args, 1);
        let cyc: String = list_get(args, 2);
        return sp_tool_worker(sys, fs_r, fs_w, root, d, sp_basename(d), cyc, det_to, par_to, oodac);
    }
    let once: Bool = list_len(args) > 0 && list_get(args, 0) == "--once";
    let self_bin: String = "/home/ubermetroid/.local/bin/spotlight-reviewer";
    let _st: Int = sp_log(sys, fs_r, fs_w, root, "=== spotlight-reviewer (.oo native) start jobs=" + jobs + " sleep=" + sleep_s + "s ===");
    let mut cycle: Int = 0;
    while true {
        cycle = cycle + 1;
        let cyc_s: String = int_to_str(cycle);
        let _lb: Int = sp_log(sys, fs_r, fs_w, root, "CYCLE " + cyc_s + " begin");
        let _ri: Int = sp_run_idlescreen(sys, fs_r, fs_w, root, cyc_s, det_to);
        let _rt: Int = sp_run_tools(sys, fs_r, fs_w, root, cyc_s, jobs, self_bin);
        let _le: Int = sp_log(sys, fs_r, fs_w, root, "CYCLE " + cyc_s + " complete; sleeping " + sleep_s + "s");
        if once { break; }
        let _sl: Result[String, String] = sys_exec(sys, "sleep", sleep_s);
    }
    return 0;
}
