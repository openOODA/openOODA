// # Text Words - Split A Line Into Words
//
// Logline: Splits a line into words and honors double quotes so a word can hold a space.
//
// Setup: Pure function. No caps. No IO.
//
// Beats:
//   1. Split a line into words.
//   2. Keep a quoted word as one word.

import "std/core/primitives/str.oo";

pub fn text_words(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = "";
    let mut in_quotes: Bool = false;
    let mut has: Bool = false;
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            in_quotes = !in_quotes;
            has = true;
        } else if c == " " && !in_quotes {
            if has { out = list_push(out, cur);
            cur = "";
            has = false; }
        } else {
            cur = cur + c;
            has = true;
        }
        i = i + 1;
    }
    if has { out = list_push(out, cur); }
    return out;
}
