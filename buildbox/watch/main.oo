// # Head Watch Main - Token-Free Ten-Minute Head Watcher
//
// Logline: Runs the Forgejo safety backup and the pane triage every ten minutes and exits only when a decision is needed.
//
// Setup: Needs ProcessCap for child processes, FsReadCap for captured output, and FsWriteCap for the watch log. Cache directory comes from argv[0] or defaults to /tmp/head-watch.
//
// Beats:
//   1. Back up every repository that holds work Forgejo does not have; exit on any FAIL.
//   2. Exit when any pane waits on a confirmation or selection prompt.
//   3. Send Continue to a rate-limited devin pane between minute 2 and minute 12 of the hour.
//   4. Exit when a devin pane has been idle for two checks in a row; otherwise sleep ten minutes and repeat.

import "std/sec/pqc.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "text/lines.oo";
import "fleetctl/shell.oo";
import "watch/snapshot.oo";
import "watch/panes.oo";

// One shell-free date field, such as "%M" or "%Y-%m-%dT%H:%M:%S".
fn wm_date(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, fmt: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "+" + fmt);
    return text_trim(fc_run(sys, fs_r, cache, "date", a));
}

// Triage one devin pane. Answer 0 = busy, 1 = idle this check, 2 = continued.
fn wm_devin(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, pane: String, v: String, minute: Int) -> Int {
    if wp_rate_limited(v) && minute >= 2 && minute <= 12 {
        let _s: Bool = wp_send(sys, fs_r, cache, pane,
            "Continue your current task. Commit and push to Forgejo after each finished step.");
        return 2;
    }
    if wp_devin_idle(v) { return 1; }
    return 0;
}

// One full check. The answer is an ATTENTION report, or "" when nothing needs a decision.
fn wm_cycle(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, cache: String, idle_prev: Bool) -> String {
    let stamp: String = wm_date(sys, fs_r, cache, "%Y-%m-%dT%H:%M:%S");
    let minute_r: Result[Int, String] = parse_int(wm_date(sys, fs_r, cache, "%M"));
    let minute: Int = if minute_r.is_ok() { minute_r.val } else { 0 };
    let snap: String = ws_snapshot_all(sys, fs_r, cache, stamp);
    let seal: Int = oo_pqc_sha3_round(chars_len(snap), 20261106);
    let _w: Result[Int, String] = fs_write_file(fs_w, cache + "/watch.last", snap + "seal=" + seal.to_string() + "\n");
    if str_contains(snap, "FAIL ") { return "ATTENTION backup failures:\n" + snap; }
    let panes: List[String] = str_split("w3:p1,w8:p1,wC:p1,wF:p1,wG:p1", ",");
    let mut i: Int = 0;
    while i < list_len(panes) {
        let p: String = list_get(panes, i);
        i = i + 1;
        let v: String = wp_read(sys, fs_r, cache, p);
        if wp_has_prompt(v) { return "ATTENTION " + p + " waits on a prompt:\n" + wp_tail(v, 12); }
        if p == "wG:p1" {
            let st: Int = wm_devin(sys, fs_r, cache, p, v, minute);
            if st == 1 && idle_prev { return "ATTENTION " + p + " finished and is idle:\n" + wp_tail(v, 15); }
            if st == 1 { return "IDLE"; }
        }
    }
    return "";
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, args: List[String]) -> Int {
    let cache: String = if list_len(args) > 0 { list_get(args, 0) } else { "/tmp/head-watch" };
    let mut idle_prev: Bool = false;
    while true {
        let rep: String = wm_cycle(sys, fs_r, fs_w, cache, idle_prev);
        if str_starts_with(rep, "ATTENTION") { println(rep);
        return 0; }
        idle_prev = rep == "IDLE";
        let _z: Bool = fc_wait(sys, "600");
    }
    return 0;
}
