// # Head Watch Panes - Token-Free Herdr Pane Triage
//
// Logline: Reads each head Herdr pane and classifies it as busy, waiting on a prompt, rate limited, or finished and idle.
//
// Setup: Needs ProcessCap for herdr and FsReadCap for the captured output. Never switches a pane to a different agent tool.
//
// Beats:
//   1. Read the visible text of one pane.
//   2. Detect an interactive confirmation or selection prompt that needs a decision.
//   3. Detect the devin free-tier hourly limit and send a single Continue just after the top of the hour.
//   4. Detect a devin pane that has finished and sits idle at its input box.

import "oostd/core/primitives/str.oo";
import "fleetctl/shell.oo";

// The visible text of one pane.
pub fn wp_read(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, pane: String) -> String {
    let mut a: List[String] = list_new();
    a = list_push(a, "pane");
    a = list_push(a, "read");
    a = list_push(a, pane);
    a = list_push(a, "--source");
    a = list_push(a, "visible");
    return fc_run(sys, fs_r, cache, "herdr", a);
}

// True when the pane waits on a confirmation or selection prompt.
pub fn wp_has_prompt(v: String) -> Bool {
    if str_contains(v, "select · ↵ confirm") || str_contains(v, "(y/n)") { return true; }
    if str_contains(v, "[Y/n]") || str_contains(v, "Do you want to") { return true; }
    return str_contains(v, "Allow this") || str_contains(v, "approve?");
}

// True when a devin pane sits at the free-tier hourly limit.
pub fn wp_rate_limited(v: String) -> Bool {
    return str_contains(v, "Reached free model rate limit");
}

// True when a devin pane has finished and sits idle at its input box.
pub fn wp_devin_idle(v: String) -> Bool {
    if !str_contains(v, "Ask Devin to build") { return false; }
    if str_contains(v, "Thinking") || str_contains(v, "Running tools") { return false; }
    if str_contains(v, "Typing") || str_contains(v, "Editing") { return false; }
    return !wp_rate_limited(v);
}

// Send one line of text and press Enter in one pane.
pub fn wp_send(sys: &ProcessCap, fs_r: &FsReadCap, cache: String, pane: String, text: String) -> Bool {
    let mut a: List[String] = list_new();
    a = list_push(a, "pane");
    a = list_push(a, "run");
    a = list_push(a, pane);
    a = list_push(a, text);
    let _r: String = fc_run(sys, fs_r, cache, "herdr", a);
    let mut k: List[String] = list_new();
    k = list_push(k, "pane");
    k = list_push(k, "send-keys");
    k = list_push(k, pane);
    k = list_push(k, "Enter");
    let _k: String = fc_run(sys, fs_r, cache, "herdr", k);
    return fc_code(fs_r, cache) == 0;
}

// The last n lines of a pane text, for the attention report.
pub fn wp_tail(v: String, n: Int) -> String {
    let lines: List[String] = str_split(v, "\n");
    let len: Int = list_len(lines);
    let start: Int = if len > n { len - n } else { 0 };
    let mut out: String = "";
    let mut i: Int = start;
    while i < len { out = out + list_get(lines, i) + "\n";
    i = i + 1; }
    return out;
}
