// | 2    | 60    | took | all 9    | 0      | 0    |
// | 3    | 60    | took | all 9    | 0      | 0    |

// Every tick: TICK_LOCK took -> repos/quota/workspaces/health/forge/
// reconcile/snapshot/alerts -> TICK_UNLOCK -> TICK done. State doc 47
