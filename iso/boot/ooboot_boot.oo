// # ooboot Boot Services - Kernel Image Handle and Entry Jump
//
// Logline: Declare the bodyless UEFI boot services that the efi_bridge.c host supplies to the ooboot loader.
//
// Setup: efi_bridge.c defines every function below. The kernel image handle travels back
//   through an &mut out parameter because the bridge ABI returns no value.
//
// Beats:
//   1. Declare the kernel image handle lookup.
//   2. Declare the transfer to the kernel entry point.

pub fn oo_efi_kernel_start(out: &mut Int);
pub fn oo_efi_jump(e: Int);
