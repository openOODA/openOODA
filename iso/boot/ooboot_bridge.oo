// # ooboot Bridge - UEFI Console and Memory Primitives
//
// Logline: Declare the bodyless bridge primitives that the efi_bridge.c host supplies to the ooboot loader.
//
// Setup: efi_bridge.c defines every function below. The bridge ABI returns no value, so
//   the little-endian loaders report their result through an &mut out parameter.
//
// Beats:
//   1. Declare the console byte writer and the UEFI init entry.
//   2. Declare the little-endian 16, 32 and 64 bit loaders.
//   3. Declare the raw memory copy and the raw memory fill.

pub fn oo_efi_putb(c: Int);
pub fn oo_efi_init(img: Int, st: Int);
pub fn oo_efi_ld16(a: Int, out: &mut Int);
pub fn oo_efi_ld32(a: Int, out: &mut Int);
pub fn oo_efi_ld64(a: Int, out: &mut Int);
pub fn oo_efi_memcpy(d: Int, s: Int, n: Int);
pub fn oo_efi_memset(d: Int, v: Int, n: Int);
