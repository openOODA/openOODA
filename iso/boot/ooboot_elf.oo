// # ooboot ELF - Kernel Image Parse and Segment Load
//
// Logline: Read the kernel ELF64 header off the firmware image, validate it, and copy every PT_LOAD segment into memory.
//
// Setup: Needs the console and memory bridge from ooboot_bridge.oo and the kernel image
//   handle plus the entry jump from ooboot_boot.oo. Results flow back through &mut out parameters.
//
// Beats:
//   1. Wrap the 16, 32 and 64 bit little-endian bridge loaders.
//   2. Copy one PT_LOAD segment and zero its BSS tail.
//   3. Validate the ELF64 header, load every segment, and jump to the entry point.

import "ooboot_bridge.oo";
import "ooboot_boot.oo";
import "ooboot_tag.oo";

fn ooboot_ld16(a: Int) -> Int {
    let mut v: Int = 0;
    oo_efi_ld16(a, &mut v);
    return v;
}

fn ooboot_ld32(a: Int) -> Int {
    let mut v: Int = 0;
    oo_efi_ld32(a, &mut v);
    return v;
}

fn ooboot_ld64(a: Int) -> Int {
    let mut v: Int = 0;
    oo_efi_ld64(a, &mut v);
    return v;
}

fn ooboot_load_phdr(ksrc: Int, phoff: Int, i: Int) {
    let ph: Int = ksrc + phoff + i * 56;
    if ooboot_ld32(ph) != 1 { return; }
    let p_offset: Int = ooboot_ld64(ph + 8);
    let p_vaddr: Int = ooboot_ld64(ph + 16);
    let p_filesz: Int = ooboot_ld64(ph + 32);
    let p_memsz: Int = ooboot_ld64(ph + 40);
    oo_efi_memcpy(p_vaddr, ksrc + p_offset, p_filesz);
    if p_memsz > p_filesz {
        oo_efi_memset(p_vaddr + p_filesz, 0, p_memsz - p_filesz);
    }
}

pub fn ooboot_load() -> Int {
    let mut ksrc: Int = 0;
    oo_efi_kernel_start(&mut ksrc);
    if ksrc <= 0 { return 1; }
    if ooboot_ld32(ksrc) != 1179403647 { return 1; }
    if ooboot_ld16(ksrc + 18) != 62 { return 1; }
    let entry: Int = ooboot_ld64(ksrc + 24);
    let phoff: Int = ooboot_ld64(ksrc + 32);
    let phentsize: Int = ooboot_ld16(ksrc + 54);
    let phnum: Int = ooboot_ld16(ksrc + 56);
    if phentsize != 56 { return 1; }
    if phnum <= 0 || phnum > 32 { return 1; }
    if entry <= 0 { return 1; }
    let mut i: Int = 0;
    while i < phnum {
        ooboot_load_phdr(ksrc, phoff, i);
        i = i + 1;
    }
    ooboot_tag6(79, 79, 76, 79, 65, 68);
    oo_efi_jump(entry);
    return 1;
}
