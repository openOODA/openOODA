// # ooboot Main - UEFI Loader Entry Point
//
// Logline: Enter the ooboot UEFI loader, mark the start of the boot chain, and hand over to the ELF segment loader.
//
// Setup: The bridge supplies the console writer and the UEFI init call. ooboot_elf.oo
//   supplies the kernel image parse and the segment copy.
//
// Beats:
//   1. Mark the firmware entry on the serial log.
//   2. Hand the firmware image handle and system table to the bridge.
//   3. Run the ELF loader and report its result as the entry status.

import "ooboot_bridge.oo";
import "ooboot_tag.oo";
import "ooboot_elf.oo";

export fn efi_main(img: Int, st: Int) -> Int {
    ooboot_tag5(79, 79, 69, 70, 73);
    oo_efi_init(img, st);
    return ooboot_load();
}
