// # ooboot Tag - Serial Stage Markers
//
// Logline: Write the short ASCII stage markers that the serial log uses to identify each boot phase.
//
// Setup: Needs the console byte writer from ooboot_bridge.oo. Every marker ends with a line feed.
//
// Beats:
//   1. Write a five byte marker and a line feed.
//   2. Write a six byte marker and a line feed.

import "ooboot_bridge.oo";

pub fn ooboot_tag5(a: Int, b: Int, c: Int, d: Int, e: Int) {
    oo_efi_putb(a);
    oo_efi_putb(b);
    oo_efi_putb(c);
    oo_efi_putb(d);
    oo_efi_putb(e);
    oo_efi_putb(10);
}

pub fn ooboot_tag6(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int) {
    oo_efi_putb(a);
    oo_efi_putb(b);
    oo_efi_putb(c);
    oo_efi_putb(d);
    oo_efi_putb(e);
    oo_efi_putb(f);
    oo_efi_putb(10);
}
