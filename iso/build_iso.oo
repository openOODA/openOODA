// # ISO Build - Milestone-2 Deterministic Bootable Image
//
// Logline: Assemble the kernel payload, the ooboot UEFI application, the ESP image and the ISO9660 image in one deterministic pass.
//
// Setup: ProcessCap for the toolchain argv calls, FsWriteCap for the emitted artefacts. The ISO root,
//   the compiler, the OODAR root and the nostdlib archive come from the environment.
//
// Beats:
//   1. Emit and link the freestanding kernel payload.
//   2. Emit every ooboot page, compile the C bridge and link the EFI application.
//   3. Build the FAT ESP image and the ISO9660 image with pinned timestamps.

import "iso_tools.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";

fn iso_emit_page(p: &ProcessCap, fw: &FsWriteCap, oodac: String, root: String, page: String, flag: String, value: String, out: String) -> Result[Int, String] {
    let mut cargs: List[String] = list_new();
    cargs = list_push(cargs, "check");
    cargs = list_push(cargs, root + "/" + page);
    let c: Result[Int, String] = iso_run(p, oodac, cargs);
    if c.is_err() { return Err("check failed " + page + ": " + match c { Ok(_) => "", Err(m) => m }); }
    let src: String = root + "/" + page;
    let ll: Result[String, String] = if str_len(flag) > 0 {
        sys_exec(p, oodac, "emit-llvm", flag, value, src)
    } else {
        sys_exec(p, oodac, "emit-llvm", src)
    };
    if ll.is_err() { return Err("emit failed " + page + ": " + match ll { Ok(_) => "", Err(m) => m }); }
    let w: Result[Void, String] = fs_write_file(fw, out, ll.val);
    if w.is_err() { return Err("write failed " + out + ": " + match w { Ok(_) => "", Err(m) => m }); }
    return Ok(0);
}

fn iso_build_payload(p: &ProcessCap, fw: &FsWriteCap, oodac: String, root: String, bld: String, oodar_root: String, nostd_a: String) -> Result[Int, String] {
    let e: Result[Int, String] = iso_emit_page(p, fw, oodac, root + "/payload", "app.oo", "", "", bld + "/app.ll");
    if e.is_err() { return e; }
    let mut a: List[String] = list_new();
    a = list_push(a, "--no-default-config");
    a = list_push(a, "--target=x86_64-unknown-none");
    a = list_push(a, "-fuse-ld=lld");
    a = list_push(a, "-static");
    a = list_push(a, "-ffreestanding");
    a = list_push(a, "-nostdlib");
    a = list_push(a, "-fno-builtin");
    a = list_push(a, "-fno-stack-protector");
    a = list_push(a, "-Os");
    a = list_push(a, "-g0");
    a = list_push(a, "-fno-ident");
    a = list_push(a, "-ffunction-sections");
    a = list_push(a, "-fdata-sections");
    a = list_push(a, "-fno-asynchronous-unwind-tables");
    a = list_push(a, "-fno-unwind-tables");
    a = list_push(a, "-Wno-override-module");
    a = list_push(a, "-I" + oodar_root);
    a = list_push(a, root + "/payload/km_entry.c");
    a = list_push(a, bld + "/app.ll");
    a = list_push(a, nostd_a);
    a = list_push(a, "-Wl,--build-id=none");
    a = list_push(a, "-Wl,--gc-sections");
    a = list_push(a, "-Wl,-z,noseparate-code");
    a = list_push(a, "-Wl,-Ttext=0x1000000");
    a = list_push(a, "-Wl,--strip-all");
    a = list_push(a, "-o");
    a = list_push(a, bld + "/payload.elf");
    let mut envs: List[String] = list_new();
    envs = list_push(envs, "OODA_LLVM_TRIPLE=x86_64-unknown-none");
    return iso_run_env(p, envs, "clang", a);
}

fn iso_compile_obj(p: &ProcessCap, src: String, out: String) -> Result[Int, String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "--no-default-config");
    a = list_push(a, "--target=x86_64-unknown-windows");
    a = list_push(a, "-ffreestanding");
    a = list_push(a, "-fno-stack-protector");
    a = list_push(a, "-fno-builtin");
    a = list_push(a, "-Os");
    a = list_push(a, "-g0");
    a = list_push(a, "-fno-ident");
    a = list_push(a, "-nostdlib");
    a = list_push(a, "-Wno-override-module");
    a = list_push(a, "-c");
    a = list_push(a, src);
    a = list_push(a, "-o");
    a = list_push(a, out);
    return iso_run(p, "clang", a);
}

fn iso_build_efi(p: &ProcessCap, fw: &FsWriteCap, oodac: String, root: String, bld: String) -> Result[Int, String] {
    let pages: List[String] = str_split("ooboot_tag ooboot_elf ooboot_main", " ");
    let mut objs: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(pages) {
        let page: String = list_get(pages, i);
        let e: Result[Int, String] = iso_emit_page(p, fw, oodac, root + "/boot", page + ".oo", "--target", "x86_64-windows", bld + "/" + page + ".ll");
        if e.is_err() { return e; }
        let c: Result[Int, String] = iso_compile_obj(p, bld + "/" + page + ".ll", bld + "/" + page + ".o");
        if c.is_err() { return Err("compile failed " + page); }
        objs = list_push(objs, bld + "/" + page + ".o");
        i = i + 1;
    }
    let bc: Result[Int, String] = iso_compile_obj(p, root + "/boot/efi_bridge.c", bld + "/efi_bridge.o");
    if bc.is_err() { return Err("compile failed efi_bridge"); }
    objs = list_push(objs, bld + "/efi_bridge.o");
    let mut a: List[String] = list_new();
    a = list_push(a, "--no-default-config");
    a = list_push(a, "--target=x86_64-unknown-windows");
    a = list_push(a, "-nostdlib");
    a = list_push(a, "-fuse-ld=lld");
    a = list_push(a, "-Wl,-entry:efi_main");
    a = list_push(a, "-Wl,-subsystem:efi_application");
    a = list_push(a, "-Wl,/debug:none");
    a = list_push(a, "-Wl,/timestamp:0");
    let mut j: Int = 0;
    while j < list_len(objs) {
        a = list_push(a, list_get(objs, j));
        j = j + 1;
    }
    a = list_push(a, "-o");
    a = list_push(a, bld + "/BOOTX64.EFI");
    return iso_run(p, "clang", a);
}

fn iso_mcopy(p: &ProcessCap, src: String, img: String, dest: String) -> Result[Int, String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "-m");
    a = list_push(a, "-i");
    a = list_push(a, img);
    a = list_push(a, src);
    a = list_push(a, dest);
    return iso_run(p, "mcopy", a);
}

fn iso_build_esp(p: &ProcessCap, fw: &FsWriteCap, bld: String, epoch: String) -> Result[Int, String] {
    let mut rm: List[String] = list_new();
    rm = list_push(rm, "-f");
    rm = list_push(rm, bld + "/esp.img");
    rm = list_push(rm, bld + "/ooda.iso");
    let _r: Result[Int, String] = iso_run(p, "rm", rm);
    let mut tp: List[String] = list_new();
    tp = list_push(tp, "-d");
    tp = list_push(tp, "@" + epoch);
    tp = list_push(tp, bld + "/BOOTX64.EFI");
    tp = list_push(tp, bld + "/payload.elf");
    let _t: Result[Int, String] = iso_run(p, "touch", tp);
    let mut mk: List[String] = list_new();
    mk = list_push(mk, "-C");
    mk = list_push(mk, "-F");
    mk = list_push(mk, "12");
    mk = list_push(mk, "--invariant");
    mk = list_push(mk, "-n");
    mk = list_push(mk, "OODAESP");
    mk = list_push(mk, bld + "/esp.img");
    mk = list_push(mk, "1440");
    let m: Result[Int, String] = iso_run(p, "mkfs.fat", mk);
    if m.is_err() { return Err("mkfs.fat failed"); }
    let mut md: List[String] = list_new();
    md = list_push(md, "-i");
    md = list_push(md, bld + "/esp.img");
    md = list_push(md, "::/EFI");
    md = list_push(md, "::/EFI/BOOT");
    let _d: Result[Int, String] = iso_run(p, "mmd", md);
    let _c1: Result[Int, String] = iso_mcopy(p, bld + "/BOOTX64.EFI", bld + "/esp.img", "::/EFI/BOOT/BOOTX64.EFI");
    let _c2: Result[Int, String] = iso_mcopy(p, bld + "/payload.elf", bld + "/esp.img", "::/KERNEL.ELF");
    let mut cp: List[String] = list_new();
    cp = list_push(cp, bld + "/esp.img");
    cp = list_push(cp, bld + "/efiroot/esp.img");
    let _cp: Result[Int, String] = iso_run(p, "cp", cp);
    let mut tp2: List[String] = list_new();
    tp2 = list_push(tp2, "-d");
    tp2 = list_push(tp2, "@" + epoch);
    tp2 = list_push(tp2, bld + "/efiroot/esp.img");
    let _t2: Result[Int, String] = iso_run(p, "touch", tp2);
    return Ok(0);
}


fn iso_build_iso(p: &ProcessCap, bld: String) -> Result[Int, String] {
    let mut a: List[String] = list_new();
    a = list_push(a, "-as");
    a = list_push(a, "mkisofs");
    a = list_push(a, "-o");
    a = list_push(a, bld + "/ooda.iso");
    a = list_push(a, "-R");
    a = list_push(a, "-J");
    a = list_push(a, "-V");
    a = list_push(a, "OODAISO");
    a = list_push(a, "-A");
    a = list_push(a, "openOODA milestone-2");
    a = list_push(a, "-eltorito-alt-boot");
    a = list_push(a, "-e");
    a = list_push(a, "/esp.img");
    a = list_push(a, "-no-emul-boot");
    a = list_push(a, bld + "/efiroot");
    return iso_run(p, "xorriso", a);
}

pub fn main(p: &ProcessCap, fw: &FsWriteCap, env: &EnvCap) -> Result[Int, String] {
    let root: String = iso_env_or(env, "OODA_ISO_ROOT", "/Projects/openOODA/openOODA/iso");
    let bld: String = root + "/build";
    let oodac: String = iso_env_or(env, "OODA_COMPILER", "/home/ubermetroid/.openooda/bin/oodac");
    let oodar_root: String = iso_env_or(env, "OODA_OODAR_ROOT", "/Projects/openOODA-core/oodar");
    let nostd_a: String = iso_env_or(env, "OODA_NOSTD_A", oodar_root + "/scripts/lib/liboodar-nostd.a");
    let epoch: String = iso_env_or(env, "SOURCE_DATE_EPOCH", "946684800");
    let _m: Result[Void, String] = fs_mkdir_p(fw, bld + "/efiroot/EFI/BOOT");
    let e1: Result[Int, String] = iso_build_payload(p, fw, oodac, root, bld, oodar_root, nostd_a);
    if e1.is_err() { let m: String = match e1 { Ok(_) => "", Err(x) => x }; print("ERR " + m); return Err(m); }
    let e2: Result[Int, String] = iso_build_efi(p, fw, oodac, root, bld);
    if e2.is_err() { let m: String = match e2 { Ok(_) => "", Err(x) => x }; print("ERR " + m); return Err(m); }
    let e3: Result[Int, String] = iso_build_esp(p, fw, bld, epoch);
    if e3.is_err() { let m: String = match e3 { Ok(_) => "", Err(x) => x }; print("ERR " + m); return Err(m); }
    let e4: Result[Int, String] = iso_build_iso(p, bld);
    if e4.is_err() { let m: String = match e4 { Ok(_) => "", Err(x) => x }; print("ERR " + m); return Err(m); }
    let out: Result[String, String] = sys_exec(p, "sha256sum", bld + "/ooda.iso");
    print(match out { Ok(s) => s, Err(e) => e });
    print("BUILD-ISO OK");
    return Ok(0);
}
