// # ISO Tools - Argv Helpers for the Deterministic Image Build
//
// Logline: Build argv lists and run toolchain binaries without a shell interpreter.
//
// Setup: ProcessCap for every call. The helpers never use a shell, so no argument is ever re-parsed.
//
// Beats:
//   1. Read one configuration value from the environment with a fallback.
//   2. Concatenate argument lists into one argv list.
//   3. Run a binary, optionally with extra environment assignments in front.

import "std/fs/process/env.oo";

pub fn iso_env_or(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() { return r.val; }
    return fallback;
}

pub fn iso_cat(head: List[String], tail: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(head) {
        out = list_push(out, list_get(head, i));
        i = i + 1;
    }
    let mut j: Int = 0;
    while j < list_len(tail) {
        out = list_push(out, list_get(tail, j));
        j = j + 1;
    }
    return out;
}

pub fn iso_run(p: &ProcessCap, prog: String, args: List[String]) -> Result[Int, String] {
    return sys_exec_wait(p, prog, args);
}

pub fn iso_run_env(p: &ProcessCap, assigns: List[String], prog: String, args: List[String]) -> Result[Int, String] {
    let mut tail: List[String] = list_new();
    tail = list_push(tail, prog);
    return sys_exec_wait(p, "env", iso_cat(assigns, iso_cat(tail, args)));
}
