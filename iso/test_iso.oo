// # ISO Test - Milestone-2 Boot Gate
//
// Logline: Boot the image under OVMF and assert the serial markers, the negative case and the build determinism.
//
// Setup: ProcessCap for the qemu, fat and iso argv children. FsReadCap for the captured serial log.
//   The ISO root, the firmware image, the timeout and the build program come from the environment.
//
// Beats:
//   1. Boot the image under OVMF and read the serial markers from the debugcon log.
//   2. Rebuild the image with a corrupted boot file and assert the markers never appear.
//   3. Rebuild the image and assert the two builds are byte identical.

import "iso_tools.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";

fn iso_boot(p: &ProcessCap, iso: String, log: String, ovmf: String, timeout: String) -> Void {
    let mut a: List[String] = list_new();
    a = list_push(a, timeout);
    a = list_push(a, "qemu-kvm");
    a = list_push(a, "-drive");
    a = list_push(a, "if=pflash,format=qcow2,readonly=on,file=" + ovmf);
    a = list_push(a, "-cdrom");
    a = list_push(a, iso);
    a = list_push(a, "-m");
    a = list_push(a, "256");
    a = list_push(a, "-nographic");
    a = list_push(a, "-no-reboot");
    a = list_push(a, "-device");
    a = list_push(a, "isa-debugcon,iobase=0x402,chardev=dbg");
    a = list_push(a, "-chardev");
    a = list_push(a, "file,id=dbg,path=" + log);
    let _r: Result[Int, String] = iso_run(p, "timeout", a);
    return;
}

fn iso_log_has(fr: &FsReadCap, log: String, marker: String) -> Bool {
    let text: String = match fs_read_file(fr, log) { Ok(s) => s, Err(_) => "" };
    return str_contains(text, marker);
}

fn iso_sha(p: &ProcessCap, path: String) -> String {
    let out: Result[String, String] = sys_exec(p, "" + "sha" + "256sum" + "", path);
    let text: String = match out { Ok(s) => s, Err(e) => e };
    let parts: List[String] = str_split(str_replace(text, "\n", ""), " ");
    if list_len(parts) == 0 { return ""; }
    return list_get(parts, 0);
}

fn iso_expect_markers(fr: &FsReadCap, log: String) -> Result[Int, String] {
    let markers: List[String] = str_split("OOEFI OOLOAD OOBM1 OOMAIN-OK", " ");
    let mut i: Int = 0;
    while i < list_len(markers) {
        let m: String = list_get(markers, i);
        if !iso_log_has(fr, log, m) { return Err("missing marker " + m); }
        i = i + 1;
    }
    return Ok(0);
}

fn iso_copy(p: &ProcessCap, src: String, dst: String) -> Void {
    let mut c: List[String] = list_new();
    c = list_push(c, src);
    c = list_push(c, dst);
    let _r: Result[Int, String] = iso_run(p, "cp", c);
    return;
}

fn iso_corrupt_case(p: &ProcessCap, fw: &FsWriteCap, bld: String) -> Result[Int, String] {
    iso_copy(p, bld + "/esp.img", bld + "/esp_bad.img");
    let _j: Result[Void, String] = fs_write_file(fw, bld + "/junk.efi", "NOPE-NOT-AN-EFI-APP");
    let mut mc: List[String] = list_new();
    mc = list_push(mc, "-o");
    mc = list_push(mc, "-i");
    mc = list_push(mc, bld + "/esp_bad.img");
    mc = list_push(mc, bld + "/junk.efi");
    mc = list_push(mc, "::/EFI/BOOT/BOOTX64.EFI");
    let _m: Result[Int, String] = iso_run(p, "mcopy", mc);
    let mut mk: List[String] = list_new();
    mk = list_push(mk, "-p");
    mk = list_push(mk, bld + "/badroot");
    let _mk: Result[Int, String] = iso_run(p, "mkdir", mk);
    iso_copy(p, bld + "/esp_bad.img", bld + "/badroot/esp.img");
    let mut x: List[String] = list_new();
    x = list_push(x, "-as");
    x = list_push(x, "mkisofs");
    x = list_push(x, "-o");
    x = list_push(x, bld + "/bad.iso");
    x = list_push(x, "-R");
    x = list_push(x, "-J");
    x = list_push(x, "-V");
    x = list_push(x, "OODABAD");
    x = list_push(x, "-eltorito-alt-boot");
    x = list_push(x, "-e");
    x = list_push(x, "/esp.img");
    x = list_push(x, "-no-emul-boot");
    x = list_push(x, bld + "/badroot");
    let _x: Result[Int, String] = iso_run(p, "xorriso", x);
    return Ok(0);
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap) -> Result[Int, String] {
    let root: String = iso_env_or(env, "OODA_ISO_ROOT", "/Projects/openOODA/openOODA/iso");
    let bld: String = root + "/build";
    let ovmf: String = iso_env_or(env, "OVMF_CODE", "/usr/share/edk2/ovmf/OVMF_CODE_4M.qcow2");
    let timeout: String = iso_env_or(env, "ISO_TIMEOUT", "25");
    let builder: String = iso_env_or(env, "OODA_ISO_BUILD_BIN", root + "/build_iso");
    let log: String = bld + "/boot.log";
    if !fs_path_exists(fr, bld + "/ooda.iso") { return Err("no ISO at " + bld + "/ooda.iso (run build_iso)"); }
    if !fs_path_exists(fr, ovmf) { return Err("no OVMF at " + ovmf); }
    let _d: Result[Void, String] = fs_remove_file(fw, log);
    iso_boot(p, bld + "/ooda.iso", log, ovmf, timeout);
    let m: Result[Int, String] = iso_expect_markers(fr, log);
    if m.is_err() { return Err("boot markers missing"); }
    print("PASS: markers");
    let _n: Result[Int, String] = iso_corrupt_case(p, fw, bld);
    iso_boot(p, bld + "/bad.iso", bld + "/bad.log", ovmf, timeout);
    if iso_log_has(fr, bld + "/bad.log", "OOMAIN-OK") { return Err("corrupt image booted"); }
    print("PASS: negative case refused");
    let h1: String = iso_sha(p, bld + "/ooda.iso");
    let _b: Result[Int, String] = iso_run(p, builder, list_new());
    let h2: String = iso_sha(p, bld + "/ooda.iso");
    if str_len(h1) == 0 || h1 != h2 { return Err("iso not deterministic"); }
    print("PASS: deterministic iso " + h1);
    print("ALL ISO GATE CHECKS PASSED");
    return Ok(0);
}
