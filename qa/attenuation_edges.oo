// # Attenuation Edges - Subsumption and Derived-Capability Probe
// Fixture: cross-org read-only attenuation algebra probe
//
// Logline: Verify cap_table structured subsumes edges, the attenuated_caps TLS derivation, and prose-level agreement with spec.oot.
//
// Setup: Read-only FsReadCap over spec.oot, caps.h, and ../../openOODA-core/oodar/sec/cap/cap_table.json. Pure string assertions; no subprocess, no network.
//
// Beats:
//   1. Extract caps[].subsumes child lists for FS and NET from cap_table.json.
//   2. Verify attenuated_caps holds only the TLS derivation with no lattice bit, and caps.h mints no derived defines.
//   3. Require spec.oot section 5.3 prose and subsumption_rules prose to declare the same edges.

import "oostd/fs/os/fs.oo";

fn test_ae_expect(cond: Bool, label: String) -> Bool {
    if cond { println("ok " + label);
    return true; }
    println("FAIL " + label);
    return false;
}

fn ae_in(list: List[String], nm: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(list) {
        if list_get(list, i) == nm { return true; }
        i = i + 1;
    }
    return false;
}

fn ae_region(src: String, key: String, next: String) -> String {
    let nk: String = "\"" + key + "\"";
    let np: Int = str_index_of(src, nk);
    if np < 0 { return ""; }
    let rest: String = byte_slice(src, np, bytes_len(src));
    let nn: String = "\"" + next + "\"";
    let ep: Int = str_index_of(rest, nn);
    if ep < 0 { return rest; }
    return byte_slice(rest, 0, ep);
}

fn ae_subs(src: String, parent: String) -> List[String] {
    let mut out: List[String] = list_new();
    let needle: String = "\"name\": \"" + parent + "\"";
    let np: Int = str_index_of(src, needle);
    if np < 0 { return out; }
    let rest: String = byte_slice(src, np, bytes_len(src));
    let sp: Int = str_index_of(rest, "\"subsumes\"");
    if sp < 0 { return out; }
    let after: String = byte_slice(rest, sp, bytes_len(rest));
    let lb: Int = str_index_of(after, "[");
    if lb < 0 { return out; }
    let inner: String = byte_slice(after, lb + 1, bytes_len(after));
    let rb: Int = str_index_of(inner, "]");
    let region: String = if rb < 0 { inner } else { byte_slice(inner, 0, rb) };
    let mut cur: String = region;
    while bytes_len(cur) > 0 {
        let q1: Int = str_index_of(cur, "\"");
        if q1 < 0 { break; }
        let aq: String = byte_slice(cur, q1 + 1, bytes_len(cur));
        let q2: Int = str_index_of(aq, "\"");
        if q2 < 0 { break; }
        let tok: String = byte_slice(aq, 0, q2);
        if bytes_len(tok) > 0 && !ae_in(out, tok) { out = list_push(out, tok); }
        cur = byte_slice(aq, q2 + 1, bytes_len(aq));
    }
    return out;
}

pub fn main(fs_r: &FsReadCap, _args: List[String]) -> Result[Int, String] {
    let mut n: Int = 0;
    let sr: Result[String, String] = fs_read_file(fs_r, "spec.oot");
    let hr: Result[String, String] = fs_read_file(fs_r, "../../openOODA-core/oodar/sec/cap/caps.h");
    let tr: Result[String, String] = fs_read_file(fs_r, "../../openOODA-core/oodar/sec/cap/cap_table.json");
    let spec: String = match sr { Ok(v) => v, Err(_) => "" };
    let hsrc: String = match hr { Ok(v) => v, Err(_) => "" };
    let tbl: String = match tr { Ok(v) => v, Err(_) => "" };
    let fsubs: List[String] = ae_subs(tbl, "FS");
    let nsubs: List[String] = ae_subs(tbl, "NET");
    let edges: Bool = list_len(fsubs) == 2 && ae_in(fsubs, "FSREAD") && ae_in(fsubs, "FSWRITE") &&
        list_len(nsubs) == 2 && ae_in(nsubs, "TCP") && ae_in(nsubs, "UDP") && !ae_in(nsubs, "BIND");
    if test_ae_expect(edges, "01 caps[].subsumes edges: FS->{FSREAD,FSWRITE}, NET->{TCP,UDP}") { n = n + 1; }
    let att: String = ae_region(tbl, "attenuated_caps", "");
    let derived: Bool = str_index_of(att, "\"name\": \"TLS\"") >= 0 &&
        str_index_of(att, "\"parent\": \"TCP\"") >= 0 &&
        str_index_of(att, "child_rights_hex") >= 0 &&
        str_index_of(att, "\"bit\":") < 0 && str_index_of(att, "\"value\":") < 0 &&
        str_index_of(hsrc, "OODAR_CAP_TLS") < 0 && str_index_of(hsrc, "OODAR_CAP_OOPATH") < 0;
    if test_ae_expect(derived, "02 attenuated_caps holds only TLS over TCP with no lattice bit") { n = n + 1; }
    let prose: Bool = str_index_of(tbl, "NET subsumes TCP, UDP, BIND") >= 0 &&
        str_index_of(tbl, "FS subsumes FSREAD, FSWRITE") >= 0 &&
        str_index_of(spec, "UdpCap, and BindCap") >= 0 &&
        str_index_of(spec, "FsCap satisfies FsReadCap and FsWriteCap") >= 0;
    if test_ae_expect(prose, "03 spec.oot and subsumption_rules prose declare the same edges") { n = n + 1; }
    if n == 3 {
        println("attenuation edge tests: 3/3 passed");
        return Ok(0);
    }
    println("attenuation edge tests: FAILED (" + n.to_string() + "/3)");
    return Err("attenuation edges");
}
