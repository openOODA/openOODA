// # Cap Names - Three-Source Capability Lattice Probe
// Fixture: cross-org read-only capability name parity probe
//
// Logline: Prove security.md, oodar caps.h, and cap_table.json caps[] agree on all 32 capability names.
//
// Setup: Read-only FsReadCap over security.md and ../../openOODA-core/oodar/sec/cap sources. Pure string assertions; no subprocess, no network.
//
// Beats:
//   1. Extract the 32 *Cap names from security.md and map them to runtime cap names.
//   2. Extract OODAR_CAP_* defines from caps.h and name entries from the cap_table caps array only.
//   3. Require three-way set equality plus consistent cap_count fields.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";

fn test_cn_expect(cond: Bool, label: String) -> Bool {
    if cond { println("ok " + label);
    return true; }
    println("FAIL " + label);
    return false;
}

fn cn_in(list: List[String], nm: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(list) {
        if list_get(list, i) == nm { return true; }
        i = i + 1;
    }
    return false;
}

fn cn_spec_caps(src: String) -> List[String] {
    let parts: List[String] = str_split(src, "`");
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(parts) {
        let tok: String = list_get(parts, i);
        i = i + 1;
        let cp: Int = str_index_of(tok, ":");
        if cp <= 0 || cp + 4 > bytes_len(tok) { continue; }
        let pre: String = byte_slice(tok, 0, cp);
        let nm: String = byte_slice(tok, cp + 1, bytes_len(tok));
        let ln: Int = bytes_len(nm);
        let mut digits: Bool = bytes_len(pre) > 0;
        let mut j: Int = 0;
        while j < bytes_len(pre) {
            let b: Int = byte_at(pre, j);
            if b < 48 || b > 57 { digits = false; }
            j = j + 1;
        }
        let mut ok: Bool = digits && ln > 3 && byte_slice(nm, ln - 3, ln) == "Cap";
        j = 0;
        while j < ln - 3 {
            let b: Int = byte_at(nm, j);
            if !(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) { ok = false; }
            j = j + 1;
        }
        if ok && !cn_in(out, nm) { out = list_push(out, nm); }
    }
    return out;
}

fn cn_runtime(nm: String) -> String {
    let base: String = byte_slice(nm, 0, bytes_len(nm) - 3);
    let up: String = to_uppercase(base);
    if up == "COMPILERREAD" { return "COMPILER_READ"; }
    return up;
}

fn cn_h_names(src: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = src;
    while bytes_len(cur) > 0 {
        let np: Int = str_index_of(cur, "OODAR_CAP_");
        if np < 0 { break; }
        let after: String = byte_slice(cur, np + 10, bytes_len(cur));
        let sp: Int = str_index_of(after, " ");
        let tok: String = if sp < 0 { after } else { byte_slice(after, 0, sp) };
        if !cn_in(out, tok) { out = list_push(out, tok); }
        cur = byte_slice(cur, np + 10, bytes_len(cur));
    }
    return out;
}

fn cn_region(src: String, key: String, next: String) -> String {
    let nk: String = "\"" + key + "\"";
    let np: Int = str_index_of(src, nk);
    if np < 0 { return ""; }
    let rest: String = byte_slice(src, np, bytes_len(src));
    let nn: String = "\"" + next + "\"";
    let ep: Int = str_index_of(rest, nn);
    if ep < 0 { return rest; }
    return byte_slice(rest, 0, ep);
}

fn cn_table_names(src: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = src;
    while bytes_len(cur) > 0 {
        let np: Int = str_index_of(cur, "\"name\": \"");
        if np < 0 { break; }
        let after: String = byte_slice(cur, np + 9, bytes_len(cur));
        let q: Int = str_index_of(after, "\"");
        if q < 0 { break; }
        let tok: String = byte_slice(after, 0, q);
        if !cn_in(out, tok) { out = list_push(out, tok); }
        cur = byte_slice(after, q + 1, bytes_len(after));
    }
    return out;
}

pub fn main(fs_r: &FsReadCap, _args: List[String]) -> Result[Int, String] {
    let mut n: Int = 0;
    let sr: Result[String, String] = fs_read_file(fs_r, "cards/security.md");
    let hr: Result[String, String] = fs_read_file(fs_r, "../../openOODA-core/oodar/sec/cap/caps.h");
    let tr: Result[String, String] = fs_read_file(fs_r, "../../openOODA-core/oodar/sec/cap/cap_table.json");
    let spec: String = match sr { Ok(v) => v, Err(_) => "" };
    let hsrc: String = match hr { Ok(v) => v, Err(_) => "" };
    let tbl: String = match tr { Ok(v) => v, Err(_) => "" };
    let raw: List[String] = cn_spec_caps(spec);
    let mut scaps: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(raw) {
        scaps = list_push(scaps, cn_runtime(list_get(raw, i)));
        i = i + 1;
    }
    let hn: List[String] = cn_h_names(hsrc);
    let caps_sec: String = cn_region(tbl, "caps", "subsumption_rules");
    let tn: List[String] = cn_table_names(caps_sec);
    let mut par: Bool = list_len(scaps) == 32 && list_len(hn) == 32 && list_len(tn) == 32;
    i = 0;
    while i < list_len(scaps) {
        let x: String = list_get(scaps, i);
        if !cn_in(hn, x) || !cn_in(tn, x) { par = false; }
        i = i + 1;
    }
    i = 0;
    while i < list_len(hn) {
        if !cn_in(tn, list_get(hn, i)) { par = false; }
        i = i + 1;
    }
    if test_cn_expect(par, "01 security.md, caps.h, and cap_table caps[] agree on all 32 capability names") { n = n + 1; }
    let cnt: Bool = str_index_of(tbl, "\"cap_count\": 32") >= 0 &&
        str_index_of(tbl, "\"cap_count_implemented\": 32") >= 0 &&
        str_index_of(tbl, "\"cap_count_future_state\": 0") >= 0;
    if test_cn_expect(cnt, "02 cap_table count fields match the 32-cap implemented lattice") { n = n + 1; }
    if n == 2 {
        println("cap names tests: 2/2 passed");
        return Ok(0);
    }
    println("cap names tests: FAILED (" + n.to_string() + "/2)");
    return Err("cap names");
}
