// # qa/e2e/anchor - E2E Test Suite Shared Anchor & Assertion Helpers
//
// Logline: Provides pure .oo test execution, file probing, and pass/fail tally helpers for openOODA E2E verification.
//
// Setup: Uses ProcessCap and FsReadCap to verify /Projects/openOODA and /Projects/openOODA-core invariants.
//
// Beats:
//   1. Resolve the active oodac compiler binary path at /Projects/openOODA-core/oodac/bin/oodac.
//   2. Provide assertion helpers that print structured [PASS]/[FAIL] diagnostics.
//   3. Provide line-count and function-count scanners for page-law boundary checks.
//   4. Emit canonical pass=N fail=M summary lines for master runner verification.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";

pub fn e2e_compiler_bin() -> String {
    return "/Projects/openOODA-core/oodac/bin/oodac";
}

pub fn e2e_core_root() -> String {
    return "/Projects/openOODA-core";
}

pub fn e2e_root() -> String {
    return "/Projects/openOODA";
}

pub fn e2e_check(tid: String, desc: String, cond: Bool) -> Int {
    if cond {
        println("  [PASS] " + tid + "  " + desc);
        return 1;
    }
    println("  [FAIL] " + tid + "  " + desc);
    return 0;
}

pub fn e2e_count_lines(fs_r: &FsReadCap, path: String) -> Int {
    if !path_exists(fs_r, path) { return 0; }
    let r: Result[String, String] = fs_read_file(fs_r, path);
    if r.is_err() { return 0; }
    let s: String = r.val;
    let mut n: Int = 0;
    let mut i: Int = 0;
    let len: Int = chars_len(s);
    while i < len {
        if char_at(s, i) == "\n" { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn e2e_oodac_check(sys: &ProcessCap, target: String) -> Bool {
    let oodac: String = e2e_compiler_bin();
    let mut a: List[String] = list_new();
    a = list_push(a, "-c");
    a = list_push(a, "OODA_NO_JAIL=1 OODA_FS_READDIR=/Projects:/tmp OODA_FS_WRITEDIR=/Projects:/tmp " + oodac + " check " +
        target + " >/dev/null 2>&1");
    let r: Result[Int, String] = sys_exec_wait(sys, "bash", a);
    return r.is_ok() && r.val == 0;
}

pub fn e2e_report_tier(tier_name: String, pass: Int, total: Int) -> Int {
    let fail: Int = total - pass;
    println(tier_name + ": pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 || pass != total { return 1; }
    return 0;
}
