// # qa/e2e/runner - Master E2E 4-Tier Test Runner (Pure .oo)
//
// Logline: Builds and executes all 4 E2E test tiers (Tier 1..4) in pure .oo and verifies 37/37 pass.
//
// Setup: Uses ProcessCap and FsReadCap to compile and run each tier under /Projects/openOODA/openOODA/qa/e2e/.
//
// Beats:
//   1. Resolve compiler binary at /Projects/openOODA-core/oodac/bin/oodac.
//   2. Compile and execute tier1, tier2, tier3, and tier4 fresh.
//   3. Fail closed if any tier exits nonzero.
//   4. Print final E2E summary banner.

import "openOODA/qa/e2e/anchor.oo";

fn run_one_tier(sys: &ProcessCap, tier_rel: String) -> Bool {
    let oodac: String = e2e_compiler_bin();
    let base: String = "/Projects/openOODA/openOODA/qa/e2e/" + tier_rel;
    let bin: String = "/tmp/e2e_" + str_replace(tier_rel, "/", "_") + ".bin";
    let env_pfx: String = "OODA_NO_JAIL=1 OODA_FS_READDIR=/Projects:/var/lib/ooda-buildbox:/tmp OODA_FS_WRITEDIR=/Projects:/tmp ";
    let mut a: List[String] = list_new();
    a = list_push(a, "-c");
    a = list_push(a, "cd /Projects/openOODA && " + env_pfx + oodac + " build " + base + " -o " + bin + " >/dev/null && "
        + env_pfx + bin + "; rc=$?; rm -f " + bin + "; exit $rc");
    let r: Result[Int, String] = sys_exec_wait(sys, "bash", a);
    return r.is_ok() && r.val == 0;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, _args: List[String]) -> Int {
    if !path_exists(fs_r, e2e_compiler_bin()) {
        println("FAIL: missing compiler " + e2e_compiler_bin());
        return 1;
    }
    println("================================================================================");
    println("  openOODA PURE .oo E2E MASTER TEST SUITE (TIERS 1-4)");
    println("================================================================================");
    let mut ok: Bool = true;
    if !run_one_tier(sys, "tier1/e2e_tier1.oo") { ok = false; }
    if !run_one_tier(sys, "tier2/e2e_tier2.oo") { ok = false; }
    if !run_one_tier(sys, "tier3/e2e_tier3.oo") { ok = false; }
    if !run_one_tier(sys, "tier4/e2e_tier4.oo") { ok = false; }
    if !ok {
        println("=== E2E SUITE FAILED ===");
        return 1;
    }
    println("================================================================================");
    println("=== TEST SUITE EXECUTION SUMMARY: 37/37 PASSED (0 FAILED) ===");
    println("================================================================================");
    return 0;
}
