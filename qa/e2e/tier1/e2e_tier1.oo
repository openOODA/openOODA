// # qa/e2e/tier1/e2e_tier1 - Tier 1 Feature Coverage E2E Suite
//
// Logline: Verifies R1-R5 compiler scoping, directory density, SHA-512 compaction, tree-rot prevention, and governance invariants in pure .oo.
//
// Setup: Needs ProcessCap and FsReadCap to inspect /Projects/openOODA and /Projects/openOODA-core.
//
// Beats:
//   1. R1: Verify compiler binary presence, load_import_parse L0 resolution, and clean check on anchor.oo.
//   2. R2: Verify directory density <= 8 and 4-element Academy headers on core anchors.
//   3. R3: Verify SHA-512 std implementation exists and respects line bounds.
//   4. R4: Verify struct mutability, wui vnode arena, and mcp attenuation probes exist.
//   5. R5: Verify governance rules.oot, northstar.oot, and root VERSION files.

import "std/fs/os/fs.oo";
import "std/core/primitives/str.oo";
import "openOODA/qa/e2e/anchor.oo";

fn run_r1_r2(sys: &ProcessCap, fs_r: &FsReadCap) -> Int {
    let mut p: Int = 0;
    let croot: String = e2e_core_root();
    p = p + e2e_check("T1.R1.1", "oodac binary exists in openOODA-core", path_exists(fs_r, e2e_compiler_bin()));
    let lip: Result[String, String] = fs_read_file(fs_r, croot + "/oodac/ast/load_import_parse.oo");
    p = p + e2e_check("T1.R1.2", "load_import_parse resolves /Projects/openOODA-core", lip.is_ok() && str_contains(lip.val, "/Projects/openOODA-core"));
    p = p + e2e_check("T1.R1.3", "oodac check succeeds on e2e/anchor.oo", e2e_oodac_check(sys, "/Projects/openOODA/openOODA/qa/e2e/anchor.oo"));
    let std_a: Result[String, String] = fs_read_file(fs_r, croot + "/std/anchor.oo");
    p = p + e2e_check("T1.R2.1", "std/anchor.oo carries Academy header", std_a.is_ok() && str_contains(std_a.val, "Logline:") && str_contains(std_a.val, "Beats:"));
    p = p + e2e_check("T1.R2.2", "std/anchor.oo respects <= 256 line page rule", e2e_count_lines(fs_r, croot + "/std/anchor.oo") <= 256);
    return p;
}

fn run_r3_r4_r5(fs_r: &FsReadCap) -> Int {
    let mut p: Int = 0;
    let croot: String = e2e_core_root();
    let uroot: String = e2e_root();
    p = p + e2e_check("T1.R3.1", "std sec/hash/sha512.oo module exists", path_exists(fs_r, croot + "/std/sec/hash/sha512.oo"));
    p = p + e2e_check("T1.R3.2", "sha512.oo respects <= 256 line page rule", e2e_count_lines(fs_r, croot + "/std/sec/hash/sha512.oo") <= 256);
    p = p + e2e_check("T1.R4.1", "mcp attenuation probe exists in openOODA-core", path_exists(fs_r, croot + "/mcp/qa/sec/probe_attenuation.oo"));
    p = p + e2e_check("T1.R4.2", "oodar runtime library liboodar-core.a exists", path_exists(fs_r, croot + "/oodar/scripts/lib/liboodar-core.a"));
    let ns: Result[String, String] = fs_read_file(fs_r, uroot + "/openOODA/northstar.oot");
    p = p + e2e_check("T1.R5.1", "northstar.oot defines L0 (@openOODA-core) through L7 (@openOODA-agents)", ns.is_ok() && str_contains(ns.val, "openOODA-core") && str_contains(ns.val, "openOODA-agents"));
    let rl: Result[String, String] = fs_read_file(fs_r, uroot + "/openOODA/rules.oot");
    p = p + e2e_check("T1.R5.2", "rules.oot defines 9-organization polyrepo law", rl.is_ok() && str_contains(rl.val, "openOODA-core"));
    p = p + e2e_check("T1.R5.3", "openOODA/VERSION exists", path_exists(fs_r, uroot + "/openOODA/VERSION"));
    return p;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, _fs_w: &FsWriteCap, _env: &EnvCap, _args: List[String]) -> Int {
    println("--- Tier 1: Feature Coverage (R1-R5) ---");
    let p1: Int = run_r1_r2(sys, fs_r);
    let p2: Int = run_r3_r4_r5(fs_r);
    return e2e_report_tier("qa/e2e_tier1", p1 + p2, 12);
}
