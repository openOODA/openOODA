// # qa/e2e/tier4/e2e_tier4 - Tier 4 Real-World Application Scenarios E2E Suite
//
// Logline: Verifies end-to-end application workflows including deterministic compilation, buildbox selftest, and multi-org layout in pure .oo.
//
// Setup: Needs ProcessCap and FsReadCap to compile, execute, and verify binaries and ecosystem directories.
//
// Beats:
//   1. APP1: Compile and run a standalone .oo service program via oodac build.
//   2. APP2: Verify bit-identical deterministic double compilation (det_a == det_b).
//   3. APP3: Verify buildbox selftest binary exists and passes.
//   4. APP4: Verify catalog, install, and website repositories in /Projects/openOODA.
//   5. APP5: Verify zero .py files in /Projects/openOODA/openOODA/qa/e2e.

import "openOODA/qa/e2e/anchor.oo";

fn run_apps(sys: &ProcessCap, fs_r: &FsReadCap) -> Int {
    let mut p: Int = 0;
    let oodac: String = e2e_compiler_bin();
    let uroot: String = e2e_root();
    let env_pfx: String = "OODA_NO_JAIL=1 OODA_FS_READDIR=/Projects:/tmp OODA_FS_WRITEDIR=/Projects:/tmp ";
    let mut a1: List[String] = list_new();
    a1 = list_push(a1, "-c");
    a1 = list_push(a1, "printf '// # Svc\\n// Logline: t.\\n// Setup: n.\\n// Beats: r.\\npub fn main" +
        "() -> Int { println(\"SVC_OK\"); return 0; }\\n' > /tmp/e2e_svc.oo && "
        + env_pfx + oodac +
            " build /tmp/e2e_svc.oo -o /tmp/e2e_svc.bin >/dev/null 2>&1 && /tmp/e2e_svc.bin | grep -q SVC_OK && rm -f /tmp/e2" +
                "e_svc.oo /tmp/e2e_svc.bin");
    let r1: Result[Int, String] = sys_exec_wait(sys, "bash", a1);
    p = p + e2e_check("T4.APP1", "Full application lifecycle (author -> build -> run)", r1.is_ok() && r1.val == 0);
    let mut a2: List[String] = list_new();
    a2 = list_push(a2, "-c");
    a2 = list_push(a2, "printf '// # Det\\n// Logline: d.\\n// Setup: n.\\n// Beats: r.\\npub fn main" +
        "() -> Int { return 0; }\\n' > /tmp/e2e_det.oo && "
        + env_pfx + oodac + " build /tmp/e2e_det.oo -o /tmp/e2e_det1.bin >/dev/null 2>&1 && "
        + env_pfx + oodac + " build /tmp/e2e_det.oo -o /tmp/e2e_det2.bin >/dev/null 2>&1 && "
        + "cmp -s /tmp/e2e_det1.bin /tmp/e2e_det2.bin && rm -f /tmp/e2e_det.oo /tmp/e2e_det1.bin /tmp/e2e_det2.bin");
    let r2: Result[Int, String] = sys_exec_wait(sys, "bash", a2);
    p = p + e2e_check("T4.APP2", "Bit-identical deterministic double compilation", r2.is_ok() && r2.val == 0);
    p = p + e2e_check("T4.APP3", "Buildbox selftest binary exists", path_exists(fs_r,
        "/var/lib/ooda-buildbox/build/bin/selftest"));
    p = p + e2e_check("T4.APP4", "Root Umbrella catalog, install, and website repos exist", path_exists(fs_r, uroot +
        "/catalog/VERSION") && path_exists(fs_r, uroot + "/install/VERSION") && path_exists(fs_r, uroot + "/website/VERSION"));
    let mut a5: List[String] = list_new();
    a5 = list_push(a5, "-c");
    a5 = list_push(a5, "test -z \"$(find /Projects/openOODA/openOODA/qa/e2e -name '*.py' 2>/dev/null)\"");
    let r5: Result[Int, String] = sys_exec_wait(sys, "bash", a5);
    p = p + e2e_check("T4.APP5", "Zero legacy .py scripts in openOODA/qa/e2e", r5.is_ok() && r5.val == 0);
    return p;
}

pub fn main(sys: &ProcessCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, _args: List[String]) -> Int {
    println("--- Tier 4: Real-World Application Scenarios ---");
    let p: Int = run_apps(sys, fs_r);
    return e2e_report_tier("qa/e2e_tier4", p, 5);
}
