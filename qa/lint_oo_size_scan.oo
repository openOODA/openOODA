// # Lint OO Size Scan - Per-File Function, Brace Depth, And Domain Scanner
//
// Logline: Scans a single .oo source file for line count, function count, longest function in lines, capability domain signals, and size flags.
//
// Setup: Pure functions over file lines and strings. No capabilities required.
//
// Beats:
//   1. Parse pub fn / fn declarations at line start.
//   2. Measure brace-matched function body length in lines.
//   3. Detect capability domain groups (fs, net, gpu, thread, ffi, mem, env, time).
//   4. Format a sort key + TSV row and emit the final report for lint_oo_size.oo.

import "std/core/text/num_buffer.oo";
import "std/core/primitives/str.oo";
import "buildbox/text/lines.oo";

pub fn lint_pad10(n: Int) -> String {
    let mut s: String = int_to_str(n);
    while chars_len(s) < 10 { s = "0" + s; }
    return s;
}

pub fn lint_str_lt(a: String, b: String) -> Bool {
    let na: Int = bytes_len(a);
    let nb: Int = bytes_len(b);
    let n: Int = if na < nb { na } else { nb };
    let mut i: Int = 0;
    while i < n {
        let ba: Int = byte_at(a, i);
        let bb: Int = byte_at(b, i);
        if ba < bb { return true; }
        if ba > bb { return false; }
        i = i + 1;
    }
    return na < nb;
}

pub fn lint_fn_name(line: String) -> String {
    let mut s: String = line;
    while str_starts_with(s, " ") || str_starts_with(s, "\t") {
        s = str_slice(s, 1, chars_len(s));
    }
    if str_starts_with(s, "pub ") || str_starts_with(s, "pub\t") {
        s = str_slice(s, 4, chars_len(s));
        while str_starts_with(s, " ") || str_starts_with(s, "\t") {
            s = str_slice(s, 1, chars_len(s));
        }
    }
    if !str_starts_with(s, "fn ") && !str_starts_with(s, "fn\t") { return ""; }
    s = str_slice(s, 3, chars_len(s));
    while str_starts_with(s, " ") || str_starts_with(s, "\t") {
        s = str_slice(s, 1, chars_len(s));
    }
    let n: Int = bytes_len(s);
    if n == 0 { return ""; }
    let b0: Int = byte_at(s, 0);
    if !((b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122) || b0 == 95) { return ""; }
    let mut i: Int = 1;
    while i < n {
        let b: Int = byte_at(s, i);
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { break; }
        i = i + 1;
    }
    return byte_slice(s, 0, i);
}

pub fn lint_fn_end(lines: List[String], start_idx: Int, nlines: Int) -> Int {
    let mut depth: Int = 0;
    let mut begun: Bool = false;
    let mut in_blk: Bool = false;
    let mut sloc: Int = 0;
    let mut i: Int = start_idx;
    while i < nlines {
        let ln: String = list_get(lines, i);
        let tr: String = text_trim(ln);
        if tr != "" && !str_starts_with(tr, "//") && !in_blk { sloc = sloc + 1; }
        let blen: Int = bytes_len(ln);
        let mut j: Int = 0;
        let mut in_str: Bool = false;
        while j < blen {
            let b: Int = byte_at(ln, j);
            let b2: Int = if j + 1 < blen { byte_at(ln, j + 1) } else { 0 };
            if in_blk {
                if b == 42 && b2 == 47 { in_blk = false;
                j = j + 1; }
            } else if in_str {
                if b == 92 { j = j + 1;
                } else if b == 34 { in_str = false; }
            } else {
                if b == 47 && b2 == 47 { break; }
                if b == 47 && b2 == 42 { in_blk = true;
                j = j + 1; }
                else if b == 34 { in_str = true; }
                else if b == 123 { depth = depth + 1;
                begun = true; }
                else if b == 125 { depth = depth - 1; }
            }
            j = j + 1;
        }
        if begun && depth <= 0 { return sloc; }
        i = i + 1;
    }
    return sloc;
}

pub fn lint_domains(low: String) -> String {
    let mut d: List[String] = list_new();
    let k_fs: String = "fs" + "readcap";
    let k_fw: String = "fs" + "writecap";
    let k_fc: String = "fs" + "cap";
    let k_nc: String = "net" + "cap";
    let k_tc: String = "tcp" + "cap";
    let k_uc: String = "udp" + "cap";
    let k_bc: String = "bind" + "cap";
    if str_contains(low, k_fs) || str_contains(low, k_fw) || str_contains(low, k_fc) { d = list_push(d, "fs"); }
    if str_contains(low, k_nc) || str_contains(low, k_tc) || str_contains(low, k_uc) || str_contains(low, k_bc) { d = list_push(
        d, "net"); }
    if str_contains(low, "gpu" + "cap") { d = list_push(d, "gpu"); }
    if str_contains(low, "thread" + "cap") { d = list_push(d, "thread"); }
    if str_contains(low, "ffi" + "cap") { d = list_push(d, "ffi"); }
    if str_contains(low, "alloc" + "cap") || str_contains(low, "arena" + "cap") { d = list_push(d, "mem"); }
    if str_contains(low, "env" + "cap") || str_contains(low, "process" + "cap") || str_contains(low, "sys" +
        "cap") { d = list_push(d, "env"); }
    if str_contains(low, "time" + "cap") || str_contains(low, "rand" + "cap") || str_contains(low, "metrics" + "cap") ||
        str_contains(low, "sign" + "cap") { d = list_push(d, "time"); }
    if list_len(d) == 0 { return "-"; }
    let mut out: String = list_get(d, 0);
    let mut i: Int = 1;
    while i < list_len(d) { out = out + "+" + list_get(d, i);
    i = i + 1; }
    return out;
}

pub fn lint_scan_content(raw: String, rel: String, max_l: Int, max_fns: Int, max_fn: Int, is_dense: Bool) -> String {
    let all_lines: List[String] = text_split_lines(raw);
    let mut nlines: Int = list_len(all_lines);
    if nlines > 0 && list_get(all_lines, nlines - 1) == "" { nlines = nlines - 1; }
    let mut nfns: Int = 0;
    let mut longest: Int = 0;
    let mut lname: String = "-";
    let mut i: Int = 0;
    while i < nlines {
        let nm: String = lint_fn_name(list_get(all_lines, i));
        if nm != "" {
            nfns = nfns + 1;
            let flen: Int = lint_fn_end(all_lines, i, nlines);
            if flen > longest { longest = flen;
            lname = nm; }
        }
        i = i + 1;
    }
    let dom: String = lint_domains(to_lowercase(raw));
    let mut flg_s: String = "";
    let mut nflg: Int = 0;
    if nlines > max_l { flg_s = "BIGFILE";
    nflg = nflg + 1; }
    if nfns > max_fns { flg_s = if flg_s == "" { "MANYFN" } else { flg_s + ",MANYFN" };
    nflg = nflg + 1; }
    if longest > max_fn { flg_s = if flg_s == "" { "LONGFN" } else { flg_s + ",LONGFN" };
    nflg = nflg + 1; }
    if str_contains(dom, "+") { flg_s = if flg_s == "" { "MIX" } else { flg_s + ",MIX" };
    nflg = nflg + 1; }
    if is_dense { flg_s = if flg_s == "" { "DENSE" } else { flg_s + ",DENSE" };
    nflg = nflg + 1; }
    if flg_s == "" { flg_s = "-"; }
    let skey: String = lint_pad10(999 - nflg) + "_" + lint_pad10(999999 - longest) + "_" + lint_pad10(999999 - nlines) + "_" +
        rel;
    let tsv: String = rel + "\t" + int_to_str(nlines) + "\t" + int_to_str(nfns) + "\t" + int_to_str(longest) + "\t" + lname +
        "\t" + dom + "\t" + flg_s;
    return skey + "|" + flg_s + "|" + tsv;
}

pub fn lint_extract_flag(rec: String) -> String {
    let p1: Int = str_index_of(rec, "|");
    let rest: String = str_slice(rec, p1 + 1, chars_len(rec));
    let p2: Int = str_index_of(rest, "|");
    return str_slice(rest, 0, p2);
}

type BagLintEmitReport = struct {
    c_big: Int,
    c_many: Int,
    c_long: Int,
    c_dense: Int,
    c_mix: Int,
    n_viol: Int,
};

pub fn lint_emit_report(poly: String, max_l: Int, max_fns: Int, max_fn: Int, max_d: Int, n_scanned: Int,
    sorted_rows: List[String], bag: BagLintEmitReport) -> Int {
    println("# .oo size lint inventory");
    println("# polyroot: " + poly);
    println("# thresholds: lines>" + int_to_str(max_l) + " fns>" + int_to_str(max_fns) + " longest>" + int_to_str(max_fn) +
        " dir_files>" + int_to_str(max_d));
    println("# files_scanned: " + int_to_str(n_scanned));
    println("# rows_listed: " + int_to_str(list_len(sorted_rows)));
    println("# violations: BIGFILE=" + int_to_str(bag.c_big) + " MANYFN=" + int_to_str(bag.c_many) + " LONGFN=" + int_to_str(
        bag.c_long) + " DENSE=" + int_to_str(bag.c_dense) + " files_with_size_violation=" + int_to_str(bag.n_viol));
    println("# mix_signals: MIX=" + int_to_str(bag.c_mix));
    println("file\tlines\tfns\tlongest\tlongest_fn\tdomains\tflags");
    let mut k: Int = 0;
    while k < list_len(sorted_rows) {
        let r: String = list_get(sorted_rows, k);
        k = k + 1;
        let idx1: Int = str_index_of(r, "|");
        let r2: String = str_slice(r, idx1 + 1, chars_len(r));
        let idx2: Int = str_index_of(r2, "|");
        println(str_slice(r2, idx2 + 1, chars_len(r2)));
    }
    if bag.n_viol > 0 { return 1; }
    return 0;
}
