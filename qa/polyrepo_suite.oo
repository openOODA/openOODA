// # Universal Polyrepo QA Master Suite
// Logline: Executes test suites across standard library, toolchain, and developer CLI packages.
// Setup: Pure coordinator. Takes ProcessCap, FsReadCap, EnvCap. Resolves compiler.
// Beats: Resolve compiler, build and run package suites, output report.

import "std/fs/process/env.oo";

fn suite_env_prefix(env: &EnvCap, oodac: String) -> List[String] {
    let mut pre: List[String] = list_new();
    pre = list_push(pre, "OODA_COMPILER=" + oodac);
    let rd: Result[String, String] = env_get(env, "OODA_FS_READDIR");
    if rd.is_ok() { pre = list_push(pre, "OODA_FS_READDIR=" + rd.val);
    } else { pre = list_push(pre, "OODA_FS_READDIR=."); }
    let wd: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if wd.is_ok() { pre = list_push(pre, "OODA_FS_WRITEDIR=" + wd.val);
    } else { pre = list_push(pre, "OODA_FS_WRITEDIR=."); }
    let at: Result[String, String] = env_get(env, "OODA_MCP_ATTENUATION_SECRET");
    if at.is_ok() { pre = list_push(pre, "OODA_MCP_ATTENUATION_SECRET=" + at.val);
    } else { pre = list_push(pre, "OODA_MCP_ATTENUATION_SECRET=ci-test-attenuation-secret"); }
    return pre;
}

fn suite_argv(pre: List[String], head: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(pre) {
        out = list_push(out, list_get(pre, i));
        i = i + 1;
    }
    let mut j: Int = 0;
    while j < list_len(head) {
        out = list_push(out, list_get(head, j));
        j = j + 1;
    }
    return out;
}

fn run_sub_suite(p: &ProcessCap, env: &EnvCap, oodac: String, path: String) -> Result[Int, String] {
    println("--- Executing Suite: " + path + " ---");
    let tmp_bin: String = path + ".tmp.bin";
    // 2026-10-30 audit (mcode S10): no blind shell -c. argv exec via sys_exec_wait.
    // The toolchain exposes no env setter, so the child receives its variables
    // as KEY=VALUE arguments in front of the program name under env.
    let pre: List[String] = suite_env_prefix(env, oodac);
    let mut bhead: List[String] = list_new();
    bhead = list_push(bhead, oodac);
    bhead = list_push(bhead, "build");
    bhead = list_push(bhead, path);
    bhead = list_push(bhead, "-o");
    bhead = list_push(bhead, tmp_bin);
    let b: Result[Int, String] = sys_exec_wait(p, "env", suite_argv(pre, bhead));
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let mut rhead: List[String] = list_new();
    rhead = list_push(rhead, tmp_bin);
    let r: Result[Int, String] = sys_exec_wait(p, "env", suite_argv(pre, rhead));
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    let out_text: String = match r { Ok(_) => "", Err(m) => m };
    let code: Int = match r { Ok(c) => c, Err(_) => 0 - 1 };
    if code != 0 {
        return Err("suite fail " + path + " rc=" + code.to_string() + ": " + out_text);
    }
    return Ok(0);
}

fn resolve_compiler(fs_r: &FsReadCap, env: &EnvCap) -> Result[String, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }
    return Ok(oodac);
}

fn init_suites() -> List[String] {
    let mut suites: List[String] = list_new();
    // 1. Foundational Standard Library Domain QA
    suites = list_push(suites, "std/qa/suite.oo");
    // 2. Core Toolchain CLI Driver QA
    suites = list_push(suites, "ooda/qa/suite.oo");
    // 3. Protocol & Extension QA (MCP & LSP)
    suites = list_push(suites, "mcp/qa/suite.oo");
    suites = list_push(suites, "lsp/qa/suite.oo");
    // 4. Package Manager & Registry QA
    suites = list_push(suites, "opm/qa/suite.oo");
    // 5. Self-Hosting Compiler Matrix QA
    suites = list_push(suites, "oodac/qa/suite.oo");
    // 6. Developer CLI Interface QA
    suites = list_push(suites, "cli/qa/suite.oo");
    return suites;
}

fn run_suite_dispatcher(p: &ProcessCap, env: &EnvCap, oodac: String, suites: List[String]) -> Result[Int, String] {
    let mut passed_suites: Int = 0;
    let mut i: Int = 0;
    while i < list_len(suites) {
        let path: String = list_get(suites, i);
        let r: Result[Int, String] = run_sub_suite(p, env, oodac, path);
        if r.is_err() {
            println("FATAL: Polyrepo QA stopped due to failure in " + path);
            return r;
        }
        passed_suites = passed_suites + 1;
        i = i + 1;
    }

    println("=================================================");
    println("=== openOODA UNIVERSAL QA: ALL SUITES PASSED  ===");
    println("=================================================");
    println("  Total Packages Verified: " + passed_suites.to_string() + "/" + list_len(suites).to_string());
    println("=================================================");
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let comp_res: Result[String, String] = resolve_compiler(fs_r, env);
    let oodac: String = match comp_res {
        Ok(s) => s,
        Err(e) => { return Err(e); }
    };
    let suites: List[String] = init_suites();
    return run_suite_dispatcher(p, env, oodac, suites);
}
