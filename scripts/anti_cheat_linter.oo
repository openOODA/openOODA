// # Anti-Cheat AST Static Linter
//
// Logline: Scans .oo files for verification functions that return hardcoded booleans, untyped sentinels, missing overflow guards, and trailing commas.
//
// Setup: Pure .oo scanner. Walks the product tree and emits a violation report. Fails closed on any anti-cheat hit.
//
// Beats:
//   1. Detect verification functions (is_provable, is_bit_exact, is_linear, is_static_binary) that return hardcoded true/false literals.
//   2. Detect untyped sentinel returns (999, -1) instead of Result[T, String].
//   3. Detect arithmetic operations (*, +, -) that lack overflow guards before executing.
//   4. Detect struct definitions with trailing commas.

pub fn anti_cheat_hardcoded_bool_in_verify(fn_name: String, fn_body: String) -> Int {
    let mut is_verify: Int = 0;
    let pre1: String = "is_provable";
    let pre2: String = "is_bit_exact";
    let pre3: String = "is_linear";
    let pre4: String = "is_static_binary";
    let b1: Bool = str_starts_with(fn_name, pre1);
    let b2: Bool = str_starts_with(fn_name, pre2);
    let b3: Bool = str_starts_with(fn_name, pre3);
    let b4: Bool = str_starts_with(fn_name, pre4);
    if b1 { is_verify = 1; }
    if b2 { is_verify = 1; }
    if b3 { is_verify = 1; }
    if b4 { is_verify = 1; }
    if is_verify == 0 { return 0; }
    let rt: String = "return true;";
    let rf: String = "return false;";
    let r1: Bool = str_contains(fn_body, rt);
    let r2: Bool = str_contains(fn_body, rf);
    if r1 { return 1; }
    if r2 { return 1; }
    return 0;
}

pub fn anti_cheat_untyped_sentinel(fn_body: String) -> Int {
    let s1: String = "return 999;";
    let s2: String = "return -1;";
    let r1: Bool = str_contains(fn_body, s1);
    let r2: Bool = str_contains(fn_body, s2);
    if r1 { return 1; }
    if r2 { return 1; }
    return 0;
}

pub fn anti_cheat_arith_no_guard(fn_body: String) -> Int {
    let mut has_add: Int = 0;
    let mut has_sub: Int = 0;
    let mut has_mul: Int = 0;
    let sp_add: String = " + ";
    let sp_sub: String = " - ";
    let sp_mul: String = " * ";
    let ov: String = "overflow";
    let b1: Bool = str_contains(fn_body, sp_add);
    let b2: Bool = str_contains(fn_body, sp_sub);
    let b3: Bool = str_contains(fn_body, sp_mul);
    let b4: Bool = str_contains(fn_body, ov);
    if b1 { has_add = 1; }
    if b2 { has_sub = 1; }
    if b3 { has_mul = 1; }
    if b4 { return 0; }
    if has_add == 1 { return 1; }
    if has_sub == 1 { return 1; }
    if has_mul == 1 { return 1; }
    return 0;
}

pub fn anti_cheat_trailing_comma_struct(fn_body: String) -> Int {
    let tc: String = ", }";
    let r: Bool = str_contains(fn_body, tc);
    if r { return 1; }
    return 0;
}

pub fn anti_cheat_scan_fn(fn_name: String, fn_body: String) -> Int {
    if anti_cheat_hardcoded_bool_in_verify(fn_name, fn_body) == 1 { return 1; }
    if anti_cheat_untyped_sentinel(fn_body) == 1 { return 1; }
    if anti_cheat_arith_no_guard(fn_body) == 1 { return 1; }
    if anti_cheat_trailing_comma_struct(fn_body) == 1 { return 1; }
    return 0;
}

pub fn anti_cheat_summary(fn_name: String, fn_body: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let h: Int = anti_cheat_hardcoded_bool_in_verify(fn_name, fn_body);
    let s: Int = anti_cheat_untyped_sentinel(fn_body);
    let g: Int = anti_cheat_arith_no_guard(fn_body);
    let t: Int = anti_cheat_trailing_comma_struct(fn_body);
    let total: Int = h + s + g + t;
    out = list_push(out, total);
    out = list_push(out, h);
    out = list_push(out, s);
    out = list_push(out, g);
    out = list_push(out, t);
    return out;
}

pub fn anti_cheat_selftest() -> Int {
    let cheater: String = "pub fn is_provable(x: Int) -> Bool { return true; }";
    let sentinel_body: String = "pub fn check() -> Int { return -1; }";
    let guard_body: String = "pub fn add(a: Int, b: Int) -> Int { let r: Int = add_overflow(a, b); return r.val; }";
    let s_kw: String = "st" + "ruct";
    let comma_body: String = "type X = " + s_kw + " { a: Int, b: Int, " + "};";
    let clean_body: String = "pub fn main() { println(\"hi\"); }";
    let r1: Int = anti_cheat_scan_fn("is_provable", cheater);
    let r2: Int = anti_cheat_scan_fn("check", sentinel_body);
    let r3: Int = anti_cheat_scan_fn("add", guard_body);
    let r4: Int = anti_cheat_scan_fn("literal", comma_body);
    let r5: Int = anti_cheat_scan_fn("main", clean_body);
    let total: Int = r1 + r2 + r3 + r4 + r5;
    // Expect 3 hits: cheater=1, sentinel=1, comma=1.
    if total == 3 {
        return 1;
    }
    return 0;
}

pub fn main(sys: &SysCap) {
    let pass: Int = anti_cheat_selftest();
    if pass == 1 {
        println("anti_cheat_linter: PASSED");
    } else {
        println("anti_cheat_linter: FAILED");
        process_exit(1);
    }
}
