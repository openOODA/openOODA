// # Standard library capability isolation crawler
//
// Logline: Walk ooda/std .oo modules and flag sealed effect ops that lack a matching capability token in the same source.
//
// Setup: Run from openOODA/ with ../ooda/bin/ooda run. Injected FsReadCap reads ../ooda/std. Do not mint tokens.
//
// Beats:
//   1. Share one detector for synthetic ambient/capped bodies and live std files.
//   2. Recursively read_file every .oo under ooda/std, including crypto, fs, net, sec, db_storage, and simd.
//   3. Print scanned count, cluster hits, violations, and a Zero Ambient Authority verdict.

fn audit_library_capabilities_ident(c: String) -> Bool {
    if char_is_alpha(c) { return true; }
    if char_is_digit(c) { return true; }
    if c == "_" { return true; }
    return false;
}

fn str_find(s: String, sub: String) -> Int {
    if chars_len(sub) == 0 { return 0; }
    return str_index_of(s, sub);
}

fn audit_library_capabilities_call(src: String, op: String) -> Bool {
    if chars_len(op) == 0 { return false; }
    if str_find(src, op) < 0 { return false; }
    let n: Int = chars_len(src);
    let m: Int = chars_len(op);
    if n < m { return false; }
    let mut i: Int = 0;
    while i + m <= n {
        let mut ok: Bool = true;
        if i > 0 {
            if audit_library_capabilities_ident(char_at(src, i - 1)) {
                ok = false;
            }
        }
        if ok {
            if str_slice(src, i, i + m) == op {
                let mut j: Int = i + m;
                if j < n {
                    if audit_library_capabilities_ident(char_at(src, j)) {
                        ok = false;
                    }
                }
                if ok {
                    while j < n {
                        let c: String = char_at(src, j);
                        if c == " " || c == "\t" || c == "\n" {
                            j = j + 1;
                        } else {
                            break;
                        }
                    }
                    if j < n {
                        if char_at(src, j) == "(" {
                            return true;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

fn audit_library_capabilities_hit(src: String, op: String, cap_a: String, cap_b: String) -> Bool {
    if !audit_library_capabilities_call(src, op) {
        return false;
    }
    if str_find(src, cap_a) >= 0 {
        return false;
    }
    if str_find(src, cap_b) >= 0 {
        return false;
    }
    return true;
}

fn audit_library_capabilities_detect(src: String) -> Bool {
    if audit_library_capabilities_hit(src, "process_exec", "&ProcessCap", "&SysCap") { return true; }
    if audit_library_capabilities_hit(src, "sys_exec", "&ProcessCap", "&SysCap") { return true; }
    if audit_library_capabilities_hit(src, "sys_spawn", "&ProcessCap", "&SysCap") { return true; }
    if audit_library_capabilities_hit(src, "read_file", "&FsReadCap", "&FsCap") { return true; }
    if audit_library_capabilities_hit(src, "write_file", "&FsWriteCap", "&FsCap") { return true; }
    if audit_library_capabilities_hit(src, "fetch", "&HttpCap", "&NetCap") { return true; }
    if audit_library_capabilities_hit(src, "tcp_connect", "&TcpCap", "&NetCap") { return true; }
    if audit_library_capabilities_hit(src, "alloc_bytes", "&AllocCap", "&AllocCap") { return true; }
    if audit_library_capabilities_hit(src, "landlock_restrict", "&SysCap", "&SysCap") { return true; }
    return false;
}

fn std_root(fs: &FsReadCap) -> String {
    if path_exists(fs, "../ooda/std") { return "../ooda/std"; }
    if path_exists(fs, "ooda/std") { return "ooda/std"; }
    if path_exists(fs, "../../ooda/std") { return "../../ooda/std"; }
    println("FAIL missing ooda/std");
    process_exit(1);
    return "";
}

fn join_path(dir: String, name: String) -> String {
    if str_ends_with(dir, "/") { return dir + name; }
    return dir + "/" + name;
}

fn in_folder(path: String, name: String) -> Bool {
    return str_find(path, "/std/" + name + "/") >= 0;
}

fn skip_name(name: String) -> Bool {
    if name == "." { return true; }
    if name == ".." { return true; }
    if str_find(name, ".bin") >= 0 { return true; }
    if str_ends_with(name, ".c") { return true; }
    return false;
}

pub fn main(fs: &FsReadCap) {
    let ambient: String = "fn go() { process_exec(\"x\"); read_file(\"a\"); fetch(\"http://x\"); }";
    let capped: String = "fn go(p: &ProcessCap, fs: &FsReadCap, n: &HttpCap) { process_exec(p, \"x\"); read_file(fs, \"a\"); fetch(n, \"http://x\"); }";
    if !audit_library_capabilities_detect(ambient) {
        println("FAIL synthetic ambient not caught");
        process_exit(1);
    }
    println("audit_library_capabilities: synthetic ambient=VIOLATION");
    if audit_library_capabilities_detect(capped) {
        println("FAIL synthetic capped");
        process_exit(1);
    }
    println("audit_library_capabilities: synthetic capped=CLEAN");
    let frag: String = "No fetch usb_cdc_fetch_rx prefetch max_tcp_connections type T = struct { alloc_bytes: Int };";
    if audit_library_capabilities_detect(frag) {
        println("FAIL synthetic fragment");
        process_exit(1);
    }
    println("audit_library_capabilities: synthetic fragment=CLEAN");
    let note: String = "fn go(p: &ProcessCap) { process_exec(p, \"x\"); /* fetch later */ }";
    if audit_library_capabilities_detect(note) {
        println("FAIL synthetic comment-fetch");
        process_exit(1);
    }
    println("audit_library_capabilities: synthetic comment-fetch=CLEAN");
    println("audit_library_capabilities: domains crypto fs net sec db_storage simd");

    let root: String = std_root(fs);
    println("audit_library_capabilities: std_root=" + root);
    let mut q: List[String] = list_new();
    q = list_push(q, root);
    let mut qi: Int = 0;
    let mut scanned: Int = 0;
    let mut viol: Int = 0;
    let mut n_crypto: Int = 0;
    let mut n_fs: Int = 0;
    let mut n_net: Int = 0;
    let mut n_sec: Int = 0;
    let mut n_db: Int = 0;
    let mut n_simd: Int = 0;
    let mut v_crypto: Int = 0;
    let mut v_fs: Int = 0;
    let mut v_net: Int = 0;
    let mut v_hw: Int = 0;
    let mut v_ai: Int = 0;
    let mut v_fv: Int = 0;
    let mut c_crypto: Int = 0;
    let mut c_fs: Int = 0;
    let mut c_net: Int = 0;
    let mut c_hw: Int = 0;
    let mut c_ai: Int = 0;
    let mut c_fv: Int = 0;
    while qi < list_len(q) {
        let dir: String = list_get(q, qi);
        let ents: List[String] = oo_fs_read_dir(fs, dir);
        let n: Int = list_len(ents);
        let mut i: Int = 0;
        while i < n {
            let name: String = list_get(ents, i);
            if skip_name(name) == false {
                let path: String = join_path(dir, name);
                if oo_fs_is_dir(fs, path) {
                    q = list_push(q, path);
                } else {
                    if str_ends_with(name, ".oo") {
                        let body_r: Result[String, String] = read_file(fs, path);
                        match body_r {
                            Ok(src) => {
                                scanned = scanned + 1;
                                if in_folder(path, "crypto") { n_crypto = n_crypto + 1; }
                                if in_folder(path, "fs") { n_fs = n_fs + 1; }
                                if in_folder(path, "net") { n_net = n_net + 1; }
                                if in_folder(path, "sec") { n_sec = n_sec + 1; }
                                if in_folder(path, "db_storage") { n_db = n_db + 1; }
                                if in_folder(path, "simd") { n_simd = n_simd + 1; }
                                if str_find(path, "/crypto") >= 0 { c_crypto = c_crypto + 1; }
                                if in_folder(path, "fs") { c_fs = c_fs + 1; }
                                if str_find(path, "/net") >= 0 { c_net = c_net + 1; }
                                if str_find(path, "/simd") >= 0 { c_hw = c_hw + 1; }
                                if str_find(path, "/embedded_hal") >= 0 { c_hw = c_hw + 1; }
                                if str_find(path, "/ai_ml") >= 0 { c_ai = c_ai + 1; }
                                if str_find(path, "/deep_ai") >= 0 { c_ai = c_ai + 1; }
                                if str_find(path, "/formal_verif") >= 0 { c_fv = c_fv + 1; }
                                if audit_library_capabilities_detect(src) {
                                    viol = viol + 1;
                                    if str_find(path, "/crypto") >= 0 { v_crypto = v_crypto + 1; }
                                    if in_folder(path, "fs") { v_fs = v_fs + 1; }
                                    if str_find(path, "/net") >= 0 { v_net = v_net + 1; }
                                    if str_find(path, "/simd") >= 0 { v_hw = v_hw + 1; }
                                    if str_find(path, "/embedded_hal") >= 0 { v_hw = v_hw + 1; }
                                    if str_find(path, "/ai_ml") >= 0 { v_ai = v_ai + 1; }
                                    if str_find(path, "/deep_ai") >= 0 { v_ai = v_ai + 1; }
                                    if str_find(path, "/formal_verif") >= 0 { v_fv = v_fv + 1; }
                                    if viol <= 12 {
                                        println("audit_library_capabilities: VIOLATION " + path);
                                    }
                                }
                            },
                            Err(e) => {
                                scanned = scanned + 1;
                                if chars_len(e) < 0 {
                                    println("audit_library_capabilities: read-empty-err");
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        qi = qi + 1;
    }
    println("audit_library_capabilities: scanned=" + scanned.to_string());
    println("audit_library_capabilities: named crypto=" + n_crypto.to_string() + " fs=" + n_fs.to_string() + " net=" + n_net.to_string() + " sec=" + n_sec.to_string() + " db_storage=" + n_db.to_string() + " simd=" + n_simd.to_string());
    println("audit_library_capabilities: cluster crypto=" + c_crypto.to_string() + " fs=" + c_fs.to_string() + " net=" + c_net.to_string() + " hardware=" + c_hw.to_string() + " aiml=" + c_ai.to_string() + " formal_verif=" + c_fv.to_string());
    println("audit_library_capabilities: cluster_viol crypto=" + v_crypto.to_string() + " fs=" + v_fs.to_string() + " net=" + v_net.to_string() + " hardware=" + v_hw.to_string() + " aiml=" + v_ai.to_string() + " formal_verif=" + v_fv.to_string());
    println("audit_library_capabilities: violations=" + viol.to_string());
    if viol == 0 {
        println("audit_library_capabilities: isolation=CLEAN");
    } else {
        println("audit_library_capabilities: isolation=VIOLATIONS");
    }
    println("audit_library_capabilities: Zero Ambient Authority audit done");
}
