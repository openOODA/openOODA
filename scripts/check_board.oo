// # Live board sweep
//
// Logline: Scan this folder and keep only the live openOODA boards; treat other .oot as debris.
//
// Setup: FsReadCap and FsWriteCap granted for workspace file hygiene.
//
// Beats:
//   1. List .oot files in this folder only.
//   2. Keep known openOODA board files and DINNER references.
//   3. Flag every other board file as debris.

pub fn ends_with(s: String, suffix: String) -> Bool {
    if suffix.len() > s.len() {
        return false;
    }
    let mut i = 0;
    let offset = s.len() - suffix.len();
    while i < suffix.len() {
        if s[offset + i] != suffix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn strings_equal(a: String, b: String) -> Bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn main(fs: &FsReadCap, fsW: &FsWriteCap) {
    print("Running .oot hygiene check for openOODA/...\n");
    let mut sludge_count = 0;

    let files = fs::read_dir(".");
    for file in files {
        let name = file.name();
        
        if !ends_with(name, ".oot") {
            continue;
        }

        let mut is_whitelisted = false;
        
        if strings_equal(name, "DESIGN.oot") { is_whitelisted = true; }
        if strings_equal(name, "SPRINT.oot") { is_whitelisted = true; }
        if strings_equal(name, "RULES.oot") { is_whitelisted = true; }
        if strings_equal(name, "SWARM.oot") { is_whitelisted = true; }
        if strings_equal(name, "OODA.oot") { is_whitelisted = true; }
        if strings_equal(name, "PROBE.oot") { is_whitelisted = true; }
        if strings_equal(name, "BOOTSTRAP.oot") { is_whitelisted = true; }
        if strings_equal(name, "SHIPPED.oot") { is_whitelisted = true; }
        if strings_equal(name, "PM.oot") { is_whitelisted = true; }
        if strings_equal(name, "CAPS.oot") { is_whitelisted = true; }
        if strings_equal(name, "LORE.oot") { is_whitelisted = true; }
        if strings_equal(name, "DINNER.oot") { is_whitelisted = true; }
        if strings_equal(name, "DINNER_CREATIVE.oot") { is_whitelisted = true; }
        if strings_equal(name, "DINNER_CAPS_REFERENCE.oot") { is_whitelisted = true; }
        if strings_equal(name, "DINNER_TOKENOMICS_REFERENCE.oot") { is_whitelisted = true; }
        if strings_equal(name, "SCRIPTING.oot") { is_whitelisted = true; }

        if is_whitelisted {
            continue;
        }

        print("  [PURGE] Unrecognized .oot file: {}\n", file.path());
        fs::remove_file(file.path());
        sludge_count = sludge_count + 1;
    }

    print("Hygiene complete. Purged {} illegal .oot files.\n", sludge_count);
    process_exit(0);
}
