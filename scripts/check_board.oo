// # Live board sweep
//
// Logline: Scan this folder and keep only the live openOODA boards; treat other .oot as debris.
//
// Setup: FsReadCap and FsWriteCap granted for workspace file hygiene.
//
// Beats:
//   1. List .oot files in this folder only.
//   2. Keep known openOODA board files and DINNER references.
//   3. Flag every other board file as debris.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &FsReadCap, &FsWriteCap required.
// RULES.oot 1.7: Under 256 lines.

pub fn ends_with(s: String, suffix: String) -> Bool {
    return str_ends_with(s, suffix);
}

pub fn is_whitelisted_board(name: String) -> Bool {
    if name == "DESIGN.oot" { return true; }
    if name == "SPRINT.oot" { return true; }
    if name == "RULES.oot" { return true; }
    if name == "SWARM.oot" { return true; }
    if name == "OODA.oot" { return true; }
    if name == "PROBE.oot" { return true; }
    if name == "BOOTSTRAP.oot" { return true; }
    if name == "SHIPPED.oot" { return true; }
    if name == "PM.oot" { return true; }
    if name == "CAPS.oot" { return true; }
    if name == "LORE.oot" { return true; }
    if name == "DINNER.oot" { return true; }
    if name == "DINNER_CREATIVE.oot" { return true; }
    if name == "DINNER_CAPS_REFERENCE.oot" { return true; }
    if name == "DINNER_TOKENOMICS_REFERENCE.oot" { return true; }
    if name == "SCRIPTING.oot" { return true; }
    if name == "MOONSHOTS.oot" { return true; }
    return false;
}

pub fn main(fs: &FsReadCap, fsW: &FsWriteCap) {
    println("Running .oot hygiene check for openOODA/...");
    let files: List[String] = oo_fs_read_dir(fs, ".");
    let n: Int = list_len(files);
    let mut sludge_count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let name: String = list_get(files, i);
        if str_ends_with(name, ".oot") {
            if !is_whitelisted_board(name) {
                println("  [PURGE] Unrecognized .oot file: " + name);
                let _ = oo_fs_remove_file(fsW, name);
                sludge_count = sludge_count + 1;
            }
        }
        i = i + 1;
    }

    println("Hygiene complete. Purged " + sludge_count.to_string() + " illegal .oot files.");
    process_exit(0);
}
