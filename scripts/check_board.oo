// # 13-Board Hygiene Checker (extended)
//
// Logline: Scan openOODA/ root and preserve the 13 canonical process boards while purging debris; also report audit/ size budget.
//
// Setup: Run from the repo root. FsReadCap, FsWriteCap and EnvCap. OODA_REPO_ROOT sets the repo root; OODA_FS_WRITEDIR is validated.
//
// Beats:
//   1. Use OODA_REPO_ROOT to locate openOODA/ without parent traversal.
//   2. Preserve only the 13 canonical process boards in openOODA/.
//   3. Purge unrecognized .oot files and fail closed if any remain.
//   4. Walk openOODA/audit/ and fail closed on any file > 256 lines.

fn env_or(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() { return match r { Ok(s) => s, Err(_) => fallback }; }
    return fallback;
}

pub fn is_whitelisted_board(name: String) -> Bool {
    if name == "START.oot" { return true; }
    if name == "RULES.oot" { return true; }
    if name == "NORTHSTAR.oot" { return true; }
    if name == "MOONSHOTS.oot" { return true; }
    if name == "ROADMAP.oot" { return true; }
    if name == "SHIPPED.oot" { return true; }
    if name == "FORMAT.oot" { return true; }
    if name == "SECURITY.oot" { return true; }
    if name == "WORKFLOW.oot" { return true; }
    if name == "QUICKREF.oot" { return true; }
    if name == "CONSTRAINTS.oot" { return true; }
    if name == "STRUCTURE_EM.oot" { return true; }
    if name == "REDTEAM.oot" { return true; }
    return false;
}

pub fn purge_root_sludge(fs: &FsReadCap, fsW: &FsWriteCap, base: String) -> Int {
    let files: List[String] = oo_fs_read_dir(fs, base);
    let n: Int = list_len(files);
    let mut sludge_count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let name: String = list_get(files, i);
        if str_ends_with(name, ".oot") {
            if !is_whitelisted_board(name) {
                println("  [PURGE] Unrecognized .oot file: " + name);
                let path: String = base + "/" + name;
                let rm: Result[Void, String] = oo_fs_remove_file(fsW, path);
                if rm.is_err() {
                    println("  [WARN] failed to remove " + name);
                }
                sludge_count = sludge_count + 1;
            }
        }
        i = i + 1;
    }
    return sludge_count;
}

pub fn count_lines(fs: &FsReadCap, path: String) -> Int {
    let res: Result[String, String] = oo_read_file(fs, path);
    match res {
        Ok(text) => {
            let mut n: Int = 0;
            let mut j: Int = 0;
            let len: Int = text.len();
            while j < len {
                let c: String = char_at(text, j);
                if c == "\n" {
                    n = n + 1;
                }
                j = j + 1;
            }
            return n;
        },
        Err(_) => { return -1; }
    }
}

pub fn audit_size_report(fs: &FsReadCap, base: String) -> Int {
    let audit_dir: String = base + "/audit";
    let files: List[String] = oo_fs_read_dir(fs, audit_dir);
    if list_len(files) == 0 {
        println("  [INFO] no audit/ directory found");
        return 0;
    }
    let mut total: Int = 0;
    let mut oversized: Int = 0;
    let n: Int = list_len(files);
    let mut i: Int = 0;
    println("=== audit/ size budget ===");
    while i < n {
        let name: String = list_get(files, i);
        if str_ends_with(name, ".oot") {
            let path: String = audit_dir + "/" + name;
            let lc: Int = count_lines(fs, path);
            total = total + 1;
            if lc > 256 {
                println("  [OVER]  " + path + "  " + lc.to_string() + " lines");
                oversized = oversized + 1;
            } else if lc >= 200 {
                println("  [WARN]  " + path + "  " + lc.to_string() + " lines  (near 256 cap)");
            }
        }
        i = i + 1;
    }
    println("  audit/ total: " + total.to_string() + "  oversized: " + oversized.to_string());
    return oversized;
}

pub fn main(fs: &FsReadCap, fsW: &FsWriteCap, env: &EnvCap) {
    let root: String = env_or(env, "OODA_REPO_ROOT", ".");
    let base: String = root + "/openOODA";
    if !path_exists(fs, base) {
        println("FAIL: " + base + " not found");
        process_exit(1);
    }
    println("Running .oot hygiene check for " + base + "/...");
    let sludge: Int = purge_root_sludge(fs, fsW, base);
    println("Root hygiene complete. Purged " + sludge.to_string() + " illegal .oot files.");
    let oversized: Int = audit_size_report(fs, base);
    if sludge > 0 || oversized > 0 {
        println("FAIL: found " + sludge.to_string() + " illegal .oot files and " + oversized.to_string() + " oversized audit files");
        process_exit(1);
    }
    println("check_board: OK");
    process_exit(0);
}
