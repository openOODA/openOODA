// # Repository Format & Standards Linter
//
// Logline: Enforce zero-tolerance file extension laws, 256-line limits, Academy headers across all product files, and rfcs/ template compliance.
//
// Setup: SysCap granted to execute repository format and hygiene checks.
//
// Beats:
//   1. Enforce zero-tolerance file extension laws (strictly reject .py and .sh files in product tree).
//   2. Validate 256-line maximum limit across all product .oo and .oot files.
//   3. Validate 4-element Academy headers on product .oo files.
//   4. Validate openOODA/rfcs/*.oot template compliance (RFC ID/Author/Status/Created; Implemented needs Security+Testing).
//   5. Report total metrics and fail closed on any violation.

pub fn main(sys: &SysCap) {
    let check_cmd: String = "src_root=\".\"; "
        + "if [ -d \"openOODA\" ] && [ -d \"ooda\" ]; then src_root=\".\"; "
        + "elif [ -d \"../openOODA\" ] && [ -d \"../ooda\" ]; then src_root=\"..\"; "
        + "elif [ -d \"../../openOODA\" ]; then src_root=\"../..\"; "
        + "else n=0; d=\".\"; while [ $n -lt 6 ]; do if [ -d \"$d/ooda\" ] && [ -f \"$d/ooda/cli/main.oo\" ]; then src_root=\"$d\"; break; fi; d=\"$d/..\"; n=$((n+1)); done; fi; "
        + "cd \"$src_root\" 2>/dev/null || true; set -e; fails=0; "
        + "echo '=== 1. Checking Forbidden File Extensions in Product Scope ==='; "
        + "forbidden=$(find openOODA ooda docs openOODA.github.io -type f \\( -name '*.py' -o -name '*.sh' \\) ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/target/*' ! -name 'oodac_pure_build' ! -name 'install.sh' 2>/dev/null | sort); "
        + "if [ -n \"$forbidden\" ]; then echo '[FORBIDDEN FILE FAIL] Found unauthorized .py/.sh files:'; echo \"$forbidden\"; fails=$((fails + 1)); fi; "
        + "echo '=== 2. Checking Line Limits (<= 256 lines) ==='; "
        + "oversized=$(find openOODA ooda docs openOODA.github.io -type f \\( -name '*.oo' -o -name '*.oot' \\) ! -path '*/.git/*' ! -path '*/bootstrap/corpus/*' 2>/dev/null -exec wc -l {} + | awk '$1 > 256 && $2 != \"total\" {print $1, $2}'); "
        + "if [ -n \"$oversized\" ]; then echo '[OVERSIZED FILE FAIL] Found files > 256 lines:'; echo \"$oversized\"; fails=$((fails + 1)); fi; "
        + "echo '=== 3. Checking Product .oo Academy Headers ==='; "
        + "oo_count=0; "
        + "for dir in ooda/oodac ooda/std ooda/cli ooda/scripts qa docs openOODA openOODA.github.io; do "
        + "  if [ ! -d \"$dir\" ]; then continue; fi; "
        + "  for f in $(find \"$dir\" -type f -name '*.oo' | sort); do "
        + "    case \"$f\" in *corpus*|*fixtures*) continue ;; esac; "
        + "    oo_count=$((oo_count + 1)); "
        + "    hdr=$(head -n 25 \"$f\"); "
        + "    if ! echo \"$hdr\" | grep -q '^// # '; then echo \"[FORMAT FAIL] $f: missing // # <Title>\"; fails=$((fails + 1)); fi; "
        + "    if ! echo \"$hdr\" | grep -q '^// Logline:'; then echo \"[FORMAT FAIL] $f: missing // Logline:\"; fails=$((fails + 1)); fi; "
        + "  done; "
        + "done; "
        + "echo '=== 4. RFC template compliance ==='; "
        + "if [ -d 'rfcs' ]; then "
        + "  for f in rfcs/*.oot; do "
        + "    [ \"$f\" = 'rfcs/0000-template.oot' ] && continue; "
        + "    text=$(cat \"$f\"); "
        + "    status=$(printf '%s' \"$text\" | grep -oE 'Status\\*?\\*?\\s*:?\\s*(Draft|Active|Accepted|Implemented)' | head -1 | sed 's/.*[*: ][ *]*//'); "
        + "    sec=$(printf '%s' \"$text\" | grep -c 'Security'); "
        + "    tst=$(printf '%s' \"$text\" | grep -c 'Testing'); "
        + "    auth=$(printf '%s' \"$text\" | grep -cE 'Author[*\\*]*'); "
        + "    rfc=$(printf '%s' \"$text\" | grep -cE 'RFC ID[*\\*]*'); "
        + "    if [ -z \"$status\" ] || [ \"$auth\" -eq 0 ] || [ \"$rfc\" -eq 0 ]; then echo \"[RFC FAIL] $f: missing header (status=[$status] rfc=$rfc author=$auth)\"; fails=$((fails + 1)); continue; fi; "
        + "    if [ \"$status\" = 'Implemented' ] && { [ \"$sec\" -eq 0 ] || [ \"$tst\" -eq 0 ]; }; then echo \"[RFC FAIL] $f: Implemented without Security+Testing\"; fails=$((fails + 1)); fi; "
        + "  done; "
        + "fi; "
        + "echo '=== 5. Compiler is not the product CLI ==='; "
        + "for b in ooda/oodac/oodac ooda/oodac_bin; do "
        + "  [ -e \"$b\" ] || continue; "
        + "  if grep -a -q 'pure .oo product CLI' \"$b\" 2>/dev/null; then echo \"[IDENTITY FAIL] $b is the product CLI\"; fails=$((fails + 1)); fi; "
        + "  if ! grep -a -q 'oodac: usage:' \"$b\" 2>/dev/null; then echo \"[IDENTITY FAIL] $b missing oodac usage\"; fails=$((fails + 1)); fi; "
        + "done; "
        + "if [ -e ooda/bin/ooda ] && ! grep -a -q 'pure .oo product CLI' ooda/bin/ooda 2>/dev/null; then echo '[IDENTITY FAIL] ooda/bin/ooda is not the product CLI'; fails=$((fails + 1)); fi; "
        + "if [ \"$fails\" -gt 0 ]; then echo \"FAILED: $fails total violations found.\"; exit 1; fi; "
        + "echo \"Format & 9-Board Rule 1.13 Lint OK: zero forbidden files, all line counts <= 256, all $oo_count product modules compliant, RFCs template-clean.\"";

    let res = sys_exec(sys, "sh", "-c", check_cmd);
    match res {
        Ok(msg) => {
            println(msg);
        },
        Err(err) => {
            println(err);
            process_exit(1);
        }
    }
}
