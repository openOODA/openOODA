// # Repository DINNER linter
//
// Logline: Enforce Academy headers, 256-line limits, and cleanliness across all repository .oo files.
//
// Setup: Process and filesystem capabilities granted.
//
// Beats:
//   1. Scan staged and workspace .oo files.
//   2. Validate 4-element Academy headers (Title, Logline, Setup, Beats).
//   3. Validate 256-line maximum limit.
//   4. Report results and fail closed on violations.

import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    let check_cmd = "python3 -c \"
import glob, os, re, sys

files = sorted(glob.glob('**/*.oo', recursive=True))
fails = 0

for f in files:
    if 'b8_repro.oo' in f:
        continue
    with open(f, errors='ignore') as fp:
        lines = fp.readlines()
    if len(lines) > 256:
        print(f'[DINNER FAIL] {f}: {len(lines)} lines > 256')
        fails += 1
    hdr = ''.join(lines[:25])
    if not re.search(r'^//\\s*#\\s+', hdr, re.M):
        print(f'[DINNER FAIL] {f}: missing // # <Title>')
        fails += 1
    if not re.search(r'^//\\s*Logline:\\s*.+\\.\\s*$', hdr, re.M):
        print(f'[DINNER FAIL] {f}: missing // Logline: ending in .')
        fails += 1
    if 'fixtures/' not in f and 'bootstrap/' not in f:
        if not re.search(r'^//\\s*Setup:\\s*', hdr, re.M):
            print(f'[DINNER FAIL] {f}: missing // Setup:')
            fails += 1
        if not (re.search(r'^//\\s*Beats:\\s*$', hdr, re.M) or re.search(r'^//\\s*Beats:\\s*\\d+\\.', hdr, re.M)):
            print(f'[DINNER FAIL] {f}: missing // Beats:')
            fails += 1

if fails > 0:
    print(f'Total violations: {fails}')
    sys.exit(1)
print(f'DINNER Lint OK: all {len(files)} .oo files compliant.')
\"";

    let res = process_exec(p, check_cmd);
    match res {
        Ok(msg) => {
            println(msg);
        },
        Err(err) => {
            eprintln(err);
            process_exit(1);
        }
    }
}
