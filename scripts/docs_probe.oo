// # Guide content probe
//
// Logline: Read shipped public guide .oot files and refuse when a named language or safety construct is missing.
//
// Setup: Run from openOODA/ with ../ooda/bin/ooda run. FsReadCap reads the guide tree. Do not mint tokens.
//
// Beats:
//   1. Resolve Language.oot, Safety.oot, Use.oot, and Options.oot under the public guide folder.
//   2. read_file each shipped page.
//   3. Fail closed when a KEY CONSTRUCT needle is absent.

import "std/core/str.oo";
import "util_env.oo";

fn guide_file(root: String, fs: &FsReadCap, name: String) -> String {
    let p1: String = root + "/openOODA.github.io/guide/" + name;
    if path_exists(fs, p1) {
        return p1;
    }
    println("FAIL missing guide " + name);
    process_exit(1);
    return p1;
}

fn load(fs: &FsReadCap, path: String) -> String {
    let r: Result[String, String] = read_file(fs, path);
    match r {
        Ok(s) => {
            return s;
        },
        Err(e) => {
            println("FAIL read " + path + ": " + e);
            process_exit(1);
            return "";
        }
    }
}

fn need_in(body: String, path: String, needle: String) {
    if !str_contains(body, needle) {
        println("FAIL missing in " + path + ": " + needle);
        process_exit(1);
    }
}

pub fn main(fs: &FsReadCap, env: &EnvCap) {
    let root: String = env_required_dir(fs, env, "OODA_REPO_ROOT");
    let lang_path: String = guide_file(root, fs, "Language.oot");
    let safe_path: String = guide_file(root, fs, "Safety.oot");
    let use_path: String = guide_file(root, fs, "Use.oot");
    let opt_path: String = guide_file(root, fs, "Options.oot");
    let lang: String = load(fs, lang_path);
    let safe: String = load(fs, safe_path);
    let use: String = load(fs, use_path);
    let opt: String = load(fs, opt_path);

    need_in(lang, lang_path, "p.scale(");
    need_in(lang, lang_path, "(&mut p_mut).shift_x(10);");
    need_in(lang, lang_path, "pt: &Point");
    need_in(lang, lang_path, "let y: Int = val + (if cond { a } else { b });");
    need_in(lang, lang_path, "0..(n - 1)");
    need_in(lang, lang_path, "Result[Int, String]");
    need_in(lang, lang_path, "match let");

    need_in(safe, safe_path, "Landlock");
    need_in(safe, safe_path, "&SysCap");
    need_in(safe, safe_path, "HMAC");
    need_in(safe, safe_path, "cap_attenuate");
    need_in(safe, safe_path, "SECRET");

    need_in(use, use_path, "methods");
    need_in(use, use_path, "inline `if`");
    need_in(use, use_path, "0..(n - 1)");
    need_in(use, use_path, "Result[List[String], String]");
    need_in(use, use_path, "Landlock");
    need_in(use, use_path, "HMAC attenuation");
    need_in(use, use_path, "SECRET");

    need_in(opt, opt_path, "methods");
    need_in(opt, opt_path, "inline `if`");
    need_in(opt, opt_path, "0..(n - 1)");
    need_in(opt, opt_path, "Result[List[String], String]");
    need_in(opt, opt_path, "Landlock");
    need_in(opt, opt_path, "HMAC attenuation");
    need_in(opt, opt_path, "SECRET");

    println("guide_probe: Language=" + lang_path);
    println("guide_probe: Safety=" + safe_path);
    println("guide_probe: Use=" + use_path);
    println("guide_probe: Options=" + opt_path);
    println("guide_probe: PASSED");
}
