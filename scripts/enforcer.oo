// # ENFORCER — Repository Governance Linter
//
// Logline: Enforce zero-tolerance file extension laws, 256-line limits, 4-element Academy headers, zero intermediate artifacts, zero struct trailing commas, and RFC compliance.
//
// Setup: SysCap granted to execute repository format and hygiene checks across all product trees.
//
// Beats:
//   1. Enforce zero-tolerance file extension laws (strictly reject .py, .sh, .md, and .js files in product scope).
//   2. Validate 256-line maximum limit across all product .oo and .oot files.
//   3. Assert zero residual intermediate files (*.tmp.c, *.protos.c, *.tu.c, *.bin, *.txt) in ooda/std/.
//   4. Validate 4-element Academy headers (# Title, Logline:, Setup:, Beats:) on all product .oo files.
//   5. Assert zero loose unheaded files in ooda/ root directory.
//   6. Assert zero trailing commas in struct types and struct literals.
//   7. Validate openOODA/rfcs/*.oot template compliance (RFC ID/Author/Status/Security/Testing).
//   8. Validate compiler binary identity and fail closed on any violation.

pub fn main(sys: &SysCap) {
    let check_cmd: String = "src_root=\".\"; "
        + "if [ -d \"openOODA\" ] && [ -d \"ooda\" ]; then src_root=\".\"; "
        + "elif [ -d \"../openOODA\" ] && [ -d \"../ooda\" ]; then src_root=\"..\"; "
        + "elif [ -d \"../../openOODA\" ]; then src_root=\"../..\"; "
        + "else n=0; d=\".\"; while [ $n -lt 6 ]; do if [ -d \"$d/ooda\" ] && [ -f \"$d/ooda/cli/main.oo\" ]; then src_root=\"$d\"; break; fi; d=\"$d/..\"; n=$((n+1)); done; fi; "
        + "cd \"$src_root\" 2>/dev/null || true; fails=0; "
        + "echo '=== 1. Checking Forbidden File Extensions in Product Scope ==='; "
        + "forbidden=$(find openOODA ooda qa docs -type f \\( -name '*.py' -o -name '*.sh' -o -name '*.md' -o -name '*.js' \\) ! -path '*/.agents/*' ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/target/*' ! -path '*/e2e/*' ! -path '*/tools/debugger/*' ! -path '*/tests/systems_challenge/*' ! -path '*/tests/c_backend_systems_e2e/*' ! -name 'meta_path_a_hide_rail.sh' ! -name 'oodac_pure_build' ! -name 'install.sh' ! -name 'PROJECT.md' ! -name 'TEST_READY.md' ! -name 'TEST_INFRA.md' ! -name 'coop-coep-shim.js' 2>/dev/null | sort || true); "
        + "if [ -n \"$forbidden\" ]; then echo '[FORBIDDEN FILE FAIL] Found unauthorized .py/.sh/.md/.js files:'; echo \"$forbidden\"; fails=$((fails + 1)); fi; "
        + "echo '=== 2. Checking Line Limits (<= 256 lines) ==='; "
        + "oversized=$(find openOODA ooda qa docs openOODA.github.io -type f \\( -name '*.oo' -o -name '*.oot' \\) ! -path '*/.agents/*' ! -path '*/.git/*' ! -path '*/bootstrap/corpus/*' ! -path '*/wasm_interpreter/*' ! -path '*/qa_challenger_*' 2>/dev/null -exec wc -l {} + | awk '$1 > 256 && $2 != \"total\" {print $1, $2}' || true); "
        + "if [ -n \"$oversized\" ]; then echo '[OVERSIZED FILE FAIL] Found files > 256 lines:'; echo \"$oversized\"; fails=$((fails + 1)); fi; "
        + "echo '=== 3. Checking Zero Intermediate Files in ooda/std/ ==='; "
        + "residuals=$(find ooda/std -type f \\( -name '*.tmp.c' -o -name '*.protos.c' -o -name '*.tu.c' -o -name '*.bin' -o -name '*.txt' \\) 2>/dev/null | sort || true); "
        + "if [ -n \"$residuals\" ]; then echo '[RESIDUAL INTERMEDIATE FAIL] Found intermediate artifacts in ooda/std/:'; echo \"$residuals\"; fails=$((fails + 1)); fi; "
        + "echo '=== 4. Checking Product .oo Academy Headers (4-Element) ==='; "
        + "oo_count=0; "
        + "hdr_fails=$(find ooda/oodac ooda/std ooda/cli ooda/scripts qa docs openOODA openOODA.github.io -type f -name '*.oo' 2>/dev/null | grep -v -E 'corpus|fixtures|vendor|\\.ooda-cache|\\.ooda_modules|\\.ooda_pack|\\.agents|\\.git' | xargs awk 'FNR<=25{if($0~/^\\/\\/ # /)t[FILENAME]=1; if($0~/^\\/\\/ Logline:/)l[FILENAME]=1; if($0~/^\\/\\/ Setup:/)s[FILENAME]=1; if($0~/^\\/\\/ Beats:/)b[FILENAME]=1} ENDFILE{if(!t[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // # <Title>\"; if(!l[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // Logline:\"; if(!s[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // Setup:\"; if(!b[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // Beats:\"}' || true); "
        + "if [ -n \"$hdr_fails\" ]; then echo \"$hdr_fails\"; fails=$((fails + $(echo \"$hdr_fails\" | wc -l))); fi; "
        + "echo '=== 5. Checking ooda/ Root Directory for Loose Unheaded Files ==='; "
        + "for f in ooda/*.oo; do "
        + "  [ -e \"$f\" ] || continue; "
        + "  oo_count=$((oo_count + 1)); "
        + "  hdr=$(head -n 25 \"$f\"); "
        + "  if ! echo \"$hdr\" | grep -q '^// # '; then echo \"[FORMAT FAIL] root loose $f: missing // # <Title>\"; fails=$((fails + 1)); fi; "
        + "  if ! echo \"$hdr\" | grep -q '^// Logline:'; then echo \"[FORMAT FAIL] root loose $f: missing // Logline:\"; fails=$((fails + 1)); fi; "
        + "  if ! echo \"$hdr\" | grep -q '^// Setup:'; then echo \"[FORMAT FAIL] root loose $f: missing // Setup:\"; fails=$((fails + 1)); fi; "
        + "  if ! echo \"$hdr\" | grep -q '^// Beats:'; then echo \"[FORMAT FAIL] root loose $f: missing // Beats:\"; fails=$((fails + 1)); fi; "
        + "done; "
        + "echo '=== 6. Checking Struct Trailing Commas ==='; "
        + "trailing_structs=$(find ooda/oodac ooda/std ooda/cli ooda/scripts qa docs openOODA.github.io openOODA/scripts -type f -name '*.oo' 2>/dev/null | xargs awk 'FNR==1{in_s=0;lc=0}{raw=$0;sub(\"//.*\",\"\",raw);if(raw~/struct[ \\t]*\\{/||raw~/(^|[^A-Za-z0-9_])[A-Za-z0-9_]+[ \\t]*\\{/){if(raw!~/(match|fn|if|else|while|for|enum|union|verify|audit|test)[ \\t]+/&&raw!~/=>/&&raw!~/->/&&raw!~/\\)[ \\t]*\\{/)in_s=1}if(in_s&&raw~/,([ \\t]*\\}|[ \\t]*\\};)/){print FILENAME \":\" FNR \": trailing comma in struct\"}if(in_s&&lc&&raw~/^[ \\t]*(\\}|\\};)/){print FILENAME \":\" (FNR-1) \": trailing comma before brace\"}if(raw~/,([ \\t]*|)$/){lc=1}else if(raw~/[^ \\t]/){lc=0}if(raw~/\\}/)in_s=0}' || true); "
        + "if [ -n \"$trailing_structs\" ]; then trailing_cnt=$(echo \"$trailing_structs\" | wc -l); echo \"[TRAILING COMMA FAIL] Found $trailing_cnt trailing commas in struct types/literals:\"; echo \"$trailing_structs\" | head -n 10; fails=$((fails + 1)); fi; "
        + "echo '=== 7. RFC template compliance ==='; "
        + "if [ -d 'rfcs' ] || [ -d 'openOODA/rfcs' ]; then "
        + "  for f in rfcs/*.oot openOODA/rfcs/*.oot; do "
        + "    [ -f \"$f\" ] || continue; "
        + "    case \"$f\" in *0000-template*) continue ;; esac; "
        + "    text=$(cat \"$f\"); "
        + "    status=$(printf '%s' \"$text\" | grep -oE 'Status(\\**|:|\\s)+ *(Draft|Active|Accepted|Implemented)' | head -1 | sed 's/.*[*: ][ *]*//' || true); "
        + "    sec=$(printf '%s' \"$text\" | grep -c 'Security' || true); "
        + "    tst=$(printf '%s' \"$text\" | grep -c 'Testing' || true); "
        + "    auth=$(printf '%s' \"$text\" | grep -cE 'Author[*\\*]*' || true); "
        + "    rfc=$(printf '%s' \"$text\" | grep -cE 'RFC ID[*\\*]*' || true); "
        + "    if [ -z \"$status\" ] || [ \"$auth\" -eq 0 ] || [ \"$rfc\" -eq 0 ]; then echo \"[RFC FAIL] $f: missing header (status=[$status] rfc=$rfc author=$auth)\"; fails=$((fails + 1)); continue; fi; "
        + "    if [ \"$status\" = 'Implemented' ] && { [ \"$sec\" -eq 0 ] || [ \"$tst\" -eq 0 ]; }; then echo \"[RFC FAIL] $f: Implemented without Security+Testing\"; fails=$((fails + 1)); fi; "
        + "  done; "
        + "fi; "
        + "echo '=== 8. Compiler is not the product CLI ==='; "
        + "for b in ooda/oodac/oodac ooda/oodac_bin; do "
        + "  [ -e \"$b\" ] || continue; "
        + "  if grep -a -q 'pure .oo product CLI' \"$b\" 2>/dev/null; then echo \"[IDENTITY FAIL] $b is the product CLI\"; fails=$((fails + 1)); fi; "
        + "  if ! grep -a -q 'oodac: usage:' \"$b\" 2>/dev/null; then echo \"[IDENTITY FAIL] $b missing oodac usage\"; fails=$((fails + 1)); fi; "
        + "done; "
        + "if [ -e ooda/bin/ooda ]; then if ! grep -a -q 'pure .oo product CLI' ooda/bin/ooda 2>/dev/null; then echo '[IDENTITY FAIL] ooda/bin/ooda is not the product CLI'; fails=$((fails + 1)); fi; fi; "
        + "if [ \"$fails\" -eq 0 ]; then echo \"Format & 10-Board Master Governance Lint OK: zero forbidden files, all line counts <= 256, zero intermediate files in std/, all 4-element Academy headers compliant, zero trailing commas in structs, RFCs template-clean.\"; else echo \"FAILED: $fails total violations found.\"; exit 1; fi";

    let res = sys_exec(sys, "sh", "-c", check_cmd);
    match res {
        Ok(msg) => {
            println(msg);
        },
        Err(err) => {
            println(err);
            process_exit(1);
        }
    }
}
