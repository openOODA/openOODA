// # Fleet Tick - Token-Free 10-Minute Fleet Check
//
// Logline: Run one fleet tick: host health, Forgejo snapshot of dirty repositories, local-only commit scan, and builder pane watch; write the report and any alert.
//
// Setup: ProcessCap, FsReadCap, FsWriteCap, EnvCap passed by the runtime. A systemd user timer runs the built binary every 10 minutes. No LLM, no shell.
//
// Beats:
//   1. Read HOME and XDG_RUNTIME_DIR, the host name, and the UTC clock.
//   2. Collect the host, snapshot, push, and pane sections into one report.
//   3. Write latest.txt, write or clear ALERT.txt, and append one line to ticks.log.

import "fleet/run_argv.oo";
import "fleet/check_host.oo";
import "fleet/find_repos.oo";
import "fleet/snapshot_repos.oo";
import "fleet/check_pushes.oo";
import "fleet/watch_panes.oo";
import "fleet/forge_probe.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

pub fn fleet_line(r: Result[String, String]) -> String {
    return str_replace(fleet_text(r), "\n", "");
}

pub fn fleet_join(lines: List[String]) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(lines) {
        if str_len(list_get(lines, i)) > 0 { out = out + list_get(lines, i) + "\n"; }
        i = i + 1;
    }
    return out;
}

pub fn fleet_repo_section(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: FleetEnv, host: String,
    forge_up: Bool) -> List[String] {
    let mut out: List[String] = list_new();
    if !forge_up {
        out = list_push(out, "-- snapshots SKIPPED (forge down)\n");
        out = list_push(out, "-- commits on no remote branch SKIPPED (forge down)\n");
        out = list_push(out, "0");
        return out;
    }
    let repos: List[String] = fleet_find_repos(fr, "/Projects");
    let mut snaps: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(repos) {
        snaps = list_push(snaps, fleet_snap_repo(p, fr, fw, e, list_get(repos, i), host));
        i = i + 1;
    }
    let pushes: List[String] = fleet_check_pushes(p, e, repos);
    out = list_push(out, "-- snapshots (" + list_len(repos).to_string() + " repos scanned)\n" + fleet_join(snaps));
    out = list_push(out, "-- commits on no remote branch\n" + fleet_join(pushes));
    out = list_push(out, list_len(pushes).to_string());
    return out;
}

pub fn fleet_pane_section(p: &ProcessCap, e: FleetEnv, utc: String) -> List[String] {
    let panes: List[String] = str_split("w3:p1 w4:p2 w5:p1 w6:p1 w7:p1 w8:p1 w9:p1 wA:p1 wC:p1", " ");
    let mut report: String = "-- panes\n";
    let mut alert: String = "";
    let mut i: Int = 0;
    while i < list_len(panes) {
        let pane: String = list_get(panes, i);
        let st: String = fleet_watch_pane(p, e, pane, utc);
        report = report + pane + ": " + st + "\n";
        if st == "waiting" || st == "idle" { alert = alert + pane + " " + st + "; "; }
        i = i + 1;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, report);
    out = list_push(out, alert);
    return out;
}

pub fn fleet_write_outputs(fr: &FsReadCap, fw: &FsWriteCap, now: String, report: String, alert: String) -> Void {
    let dir: String = "/Projects/openOODA/.fleet-tick";
    let _m: Result[Void, String] = fs_mkdir_p(fw, dir);
    let _o: Result[Void, String] = fs_write_file(fw, dir + "/latest.txt", report);
    let log_old: String = match fs_read_file(fr, dir + "/ticks.log") { Ok(s) => s, Err(_) => "" };
    let mut line: String = now + " ok\n";
    if str_len(alert) > 0 {
        let _a: Result[Void, String] = fs_write_file(fw, dir + "/ALERT.txt", now + "\n" + alert + "\n");
        line = now + " ALERT " + alert + "\n";
    } else if fs_path_exists(fr, dir + "/ALERT.txt") {
        let _r: Result[Void, String] = fs_remove_file(fw, dir + "/ALERT.txt");
    }
    let _l: Result[Void, String] = fs_write_file(fw, dir + "/ticks.log", log_old + line);
}

pub fn fleet_home(env: &EnvCap) -> String {
    let a: Result[String, String] = env_get(env, "OODA_FLEET_HOME");
    if a.is_ok() { return a.val; }
    let b: Result[String, String] = env_get(env, "HOME");
    if b.is_ok() { return b.val; }
    return "/root";
}

pub fn fleet_xdg(env: &EnvCap) -> String {
    let a: Result[String, String] = env_get(env, "OODA_FLEET_XDG");
    if a.is_ok() { return a.val; }
    let b: Result[String, String] = env_get(env, "XDG_RUNTIME_DIR");
    if b.is_ok() { return b.val; }
    return "";
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap) -> Result[Int, String] {
    let e: FleetEnv = FleetEnv {
        home: fleet_home(env),
        xdg: fleet_xdg(env),
        forge: match env_get(env, "OODA_FORGE_HOST") { Ok(s) => s, Err(_) => "clownhouse" }
    };
    let now: String = fleet_line(sys_exec(p, "date", "-Is"));
    let host: String = fleet_line(sys_exec(p, "hostname", "-s"));
    let utc: String = fleet_line(sys_exec(p, "date", "-u", "+%H:%M"));
    let h: HostCheck = fleet_check_host(p, fr, e);
    // The forge gate runs before every network git operation. An unreachable
    // forge must not make the tick retry one host for hundreds of repos.
    let probe: String = forge_probe_run(p, env);
    let forge_up: Bool = starts_with(probe, "up ");
    let repo: List[String] = fleet_repo_section(p, fr, fw, e, host, forge_up);
    let pane: List[String] = fleet_pane_section(p, e, utc);
    let mut alert: String = h.alert;
    if !forge_up { alert = alert + " FORGE_DOWN - forge unreachable; no network git was attempted;"; }
    if list_get(repo, 2) != "0" { alert = alert + " " + list_get(repo, 2) + " repo(s) have commits on no remote branch;"; }
    alert = alert + list_get(pane, 1);
    let report: String = "== fleet-tick " + now + "\nforge: " + probe + "\n" + h.report + "\n" + list_get(repo, 0) + list_get(
        repo, 1) + list_get(pane, 0);
    fleet_write_outputs(fr, fw, now, report, alert);
    print(report);
    return Ok(0);
}
