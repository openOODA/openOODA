// # Fleet Forge Probe - Reachability Check for the Git Remote Host
//
// Logline: Probe the configured git host over its public and direct paths and report whether the fleet may run network git operations.
//
// Setup: ProcessCap for the curl argv call. The host token and the two endpoint URLs come from
//   the environment so that no address is written into the source.
//
// Beats:
//   1. Read the host token and the two probe URLs from the environment.
//   2. Probe each URL with curl and record the HTTP code and the elapsed time.
//   3. Report up when either path answers and down when neither does.

import "oostd/core/primitives/str.oo";
import "oostd/fs/process/env.oo";

fn forge_env_or(env: &EnvCap, key: String, fallback: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    if r.is_ok() { return r.val; }
    return fallback;
}

fn forge_ms_from_time(text: String) -> Int {
    let parts: List[String] = str_split(str_replace(text, ",", "."), ".");
    if list_len(parts) == 0 { return 0; }
    let whole: Int = parse_int_digits(list_get(parts, 0));
    let mut frac: Int = 0;
    if list_len(parts) > 1 { frac = parse_int_digits(list_get(parts, 1)); }
    return whole * 1000 + frac / 1000;
}

fn forge_probe_one(p: &ProcessCap, label: String, url: String, timeout: String) -> String {
    let out: Result[String, String] = sys_exec(p, "curl", "-sS", "-o", "/dev/null",
        "-w", "%{http_code} %{time_total}", "--max-time", timeout, "-L", url);
    let raw: String = str_replace(match out { Ok(s) => s, Err(e) => e }, "\n", "");
    let parts: List[String] = str_split(raw, " ");
    let code: String = if list_len(parts) > 0 { list_get(parts, 0) } else { "000" };
    let secs: String = if list_len(parts) > 1 { list_get(parts, 1) } else { "0" };
    let ms: Int = forge_ms_from_time(secs);
    if starts_with(code, "2") || starts_with(code, "3") {
        return label + ":up:" + ms.to_string();
    }
    return label + ":down:" + ms.to_string() + ":http=" + code;
}

pub fn forge_probe_run(p: &ProcessCap, env: &EnvCap) -> String {
    let host: String = forge_env_or(env, "OODA_FORGE_HOST", "clownhouse");
    let public_url: String = forge_env_or(env, "OODA_FORGE_PUBLIC_URL", "https://git." + host + ".io/");
    let direct_url: String = forge_env_or(env, "OODA_FORGE_DIRECT_URL", "");
    let timeout: String = forge_env_or(env, "OODA_FORGE_PROBE_TIMEOUT", "5");
    let pub_res: String = forge_probe_one(p, "public", public_url, timeout);
    let mut dir_res: String = "direct:down:0:http=000";
    if str_len(direct_url) > 0 {
        dir_res = forge_probe_one(p, "direct", direct_url, timeout);
    }
    let pub_up: Bool = str_contains(pub_res, ":up:");
    let dir_up: Bool = str_contains(dir_res, ":up:");
    if pub_up || dir_up { return "up " + pub_res + " " + dir_res; }
    return "down " + pub_res + " " + dir_res;
}
