// # Fleet Job Text - Sort, Compare, and JSON Document Access
//
// Logline: Sort string lists in byte order and read fields, arrays, and task elements out of a JSON document.
//
// Setup: Pure text page. The reader walks characters so a byte-indexed search never splits a UTF-8 scalar.
//
// Beats:
//   1. Sort a list of strings in byte order.
//   2. Find a key inside a JSON text and return its raw value.
//   3. Split an array body into its top-level elements.
//   4. Return the string elements of an array field.

import "std/core/primitives/str.oo";

// Byte-wise less-than: true when a sorts before b.
fn jt_lt(a: String, b: String) -> Bool {
    let la: Int = a.len();
    let lb: Int = b.len();
    let mut m: Int = la;
    if lb < m { m = lb; }
    let mut i: Int = 0;
    while i < m {
        let ba: Int = byte_at(a, i);
        let bb: Int = byte_at(b, i);
        if ba < bb { return true; }
        if ba > bb { return false; }
        i = i + 1;
    }
    return la < lb;
}

// Sort strings in byte order and return the sorted list.
pub fn jt_sort(items: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(items) {
        let v: String = list_get(items, i);
        let mut j: Int = 0;
        while j < list_len(out) && jt_lt(list_get(out, j), v) { j = j + 1; }
        let mut next: List[String] = list_new();
        let mut k: Int = 0;
        while k < j { next = list_push(next, list_get(out, k));
        k = k + 1; }
        next = list_push(next, v);
        let mut m: Int = j;
        while m < list_len(out) { next = list_push(next, list_get(out, m));
        m = m + 1; }
        out = next;
        i = i + 1;
    }
    return out;
}

// Character-based substring search. Returns -1 when the needle is absent.
pub fn jt_find(raw: String, pat: String, from: Int) -> Int {
    let n: Int = str_len(raw);
    let m: Int = str_len(pat);
    let mut at: Int = 0 - 1;
    let mut i: Int = from;
    while i + m <= n && at < 0 {
        let mut j: Int = 0;
        let mut hit: Bool = true;
        while j < m && hit {
            if str_char_at(raw, i + j) != str_char_at(pat, j) { hit = false; }
            j = j + 1;
        }
        if hit { at = i; }
        i = i + 1;
    }
    return at;
}

// Raw value text for one key. Returns "" when the key is absent.
pub fn jt_value(raw: String, key: String) -> String {
    let n: Int = str_len(raw);
    let at: Int = jt_find(raw, "\"" + key + "\"", 0);
    if at < 0 { return ""; }
    let mut i: Int = at + str_len(key) + 2;
    while i < n && str_char_at(raw, i) != ":" { i = i + 1; }
    i = i + 1;
    while i < n && str_char_at(raw, i) == " " { i = i + 1; }
    while i < n && str_char_at(raw, i) == "\n" { i = i + 1; }
    while i < n && str_char_at(raw, i) == "\t" { i = i + 1; }
    while i < n && str_char_at(raw, i) == "\r" { i = i + 1; }
    if i >= n { return ""; }
    let start: Int = i;
    if str_char_at(raw, i) == "[" || str_char_at(raw, i) == "{" {
        let mut depth: Int = 0;
        let mut in_str: Bool = false;
        let mut esc: Bool = false;
        while i < n {
            let c: String = str_char_at(raw, i);
            if in_str {
                if esc { esc = false;
                } else if c == "\\" { esc = true;
                } else if c == "\"" { in_str = false; }
            } else if c == "\"" { in_str = true; }
            else if c == "[" || c == "{" { depth = depth + 1; }
            else if c == "]" || c == "}" {
                depth = depth - 1;
                if depth == 0 { return str_sub(raw, start, i + 1); }
            }
            i = i + 1;
        }
        return str_sub(raw, start, n);
    }
    while i < n {
        let c: String = str_char_at(raw, i);
        if c == "," || c == "}" || c == "]" { return str_sub(raw, start, i); }
        i = i + 1;
    }
    return str_sub(raw, start, n);
}

// Value of one key without its quotes. Returns "" when the key is absent.
pub fn jt_text(raw: String, key: String) -> String {
    let v: String = jt_value(raw, key);
    if str_len(v) < 2 { return ""; }
    if str_char_at(v, 0) != "\"" { return v; }
    return str_sub(v, 1, str_len(v) - 1);
}

// Remove the space and newline padding at both ends.
pub fn jt_trim(s: String) -> String {
    let n: Int = str_len(s);
    let mut a: Int = 0;
    let mut b: Int = n;
    while a < b && (str_char_at(s, a) == " " || str_char_at(s, a) == "\n") { a = a + 1; }
    while b > a && (str_char_at(s, b - 1) == " " || str_char_at(s, b - 1) == "\n") { b = b - 1; }
    return str_sub(s, a, b);
}

// Split an array body into its top-level element texts.
pub fn jt_elements(body: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = str_len(body);
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = str_char_at(body, i);
        if in_str {
            if esc { esc = false;
            } else if c == "\\" { esc = true;
            } else if c == "\"" { in_str = false; }
        } else if c == "\"" { in_str = true; }
        else if c == "[" || c == "{" { depth = depth + 1; }
        else if c == "]" || c == "}" { depth = depth - 1; }
        else if c == "," && depth == 0 {
            out = list_push(out, str_sub(body, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    let tail: String = jt_trim(str_sub(body, start, n));
    if str_len(tail) > 0 { out = list_push(out, str_sub(body, start, n)); }
    return out;
}

// String elements of an array field.
pub fn jt_array(raw: String, key: String) -> List[String] {
    let mut out: List[String] = list_new();
    let v: String = jt_value(raw, key);
    if str_len(v) < 2 { return out; }
    let elems: List[String] = jt_elements(str_sub(v, 1, str_len(v) - 1));
    let mut i: Int = 0;
    while i < list_len(elems) {
        let e: String = jt_trim(list_get(elems, i));
        if str_len(e) > 1 { out = list_push(out, jt_trim(str_sub(e, 1, str_len(e) - 1))); }
        i = i + 1;
    }
    return out;
}
