// # Fleet Queue Generator - Build the Work Queue
//
// Logline: Scan the space directories and write the ordered work-queue.json with one owner slot per task.
//
// Setup: ProcessCap runs the gate probe; FsReadCap walks the spaces; FsWriteCap writes the queue file.
//
// Beats:
//   1. Scan the eight L-spaces and the tools sweep for the reg64 campaign.
//   2. Write the queue document and print the summary counts.

import "job_text.oo";
import "queue_scan.oo";
import "std/core/primitives/str.oo";
import "std/core/format/json_writer.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

type QueueScan = struct {
    tasks: List[QueueTask], gap: List[String], gated: List[String],
    no_cap: List[String], skipped: List[String], cand: List[String]
};

// Scan the eight L-spaces for the reg64 campaign.
fn qg_scan_spaces(p: &ProcessCap, fr: &FsReadCap) -> QueueScan {
    let spaces: List[String] = str_split("openOODA-cloud|openOODA-agents|openOODA-apps|openOODA-core|"
        + "openOODA-kernel|openOODA-OS|openOODA-DE|openOODA-tools", "|");
    let mut tasks: List[QueueTask] = list_new();
    let mut gap: List[String] = list_new();
    let mut gated: List[String] = list_new();
    let mut no_cap: List[String] = list_new();
    let mut skipped: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(spaces) {
        let space: String = list_get(spaces, i);
        let keys: List[String] = qspace_repos(fr, space);
        let mut g: Int = 0;
        let mut d: Int = 0;
        let mut j: Int = 0;
        while j < list_len(keys) {
            let key: String = list_get(keys, j);
            if qlocked(key) { skipped = list_push(skipped, key); }
            else if qhas_gate(p, key) { d = d + 1; }
            else if space == "openOODA-tools" { g = g + 1; }
            else if qhas_capability(fr, key) {
                let path: String = "/Projects/" + key;
                tasks = list_push(tasks, QueueTask { id: "reg64:" + key, kind: "reg64-gate", space: space,
                    repo: key, path: path, repos: list_push(list_new(), path), repos_ids: list_new(),
                    priority: 0, priority_text: "", work_item: "", title: "", objective: "" });
                g = g + 1;
            } else { no_cap = list_push(no_cap, key); }
            j = j + 1;
        }
        gap = list_push(gap, space + "=" + g.to_string());
        gated = list_push(gated, space + "=" + d.to_string());
        i = i + 1;
    }
    return QueueScan { tasks: tasks, gap: gap, gated: gated, no_cap: no_cap, skipped: skipped, cand: list_new() };
}

// Collect the tools repos that still need the reg64 gate.
fn qg_scan_tools(p: &ProcessCap, fr: &FsReadCap, s: QueueScan) -> QueueScan {
    let keys: List[String] = qspace_repos(fr, "openOODA-tools");
    let mut cand: List[String] = list_new();
    let mut no_cap: List[String] = s.no_cap;
    let mut skipped: List[String] = s.skipped;
    let mut extra: Int = 0;
    let mut j: Int = 0;
    while j < list_len(keys) {
        let key: String = list_get(keys, j);
        if qlocked(key) { skipped = list_push(skipped, key); }
        else if qhas_gate(p, key) { extra = extra + 1; }
        else if !qhas_capability(fr, key) { no_cap = list_push(no_cap, key); }
        else { cand = list_push(cand, qtools_tier(fr, key).to_string() + "\t" + key); }
        j = j + 1;
    }
    cand = jt_sort(cand);
    let mut gap: List[String] = list_new();
    let mut gi: Int = 0;
    while gi < list_len(s.gap) - 1 { gap = list_push(gap, list_get(s.gap, gi)); gi = gi + 1; }
    gap = list_push(gap, "openOODA-tools=" + list_len(cand).to_string());
    let last: String = list_get(s.gated, list_len(s.gated) - 1);
    let eq: Int = index_of(last, "=");
    let total: Int = parse_int_digits(str_sub(last, eq + 1, str_len(last))) + extra;
    let mut gated: List[String] = list_new();
    gi = 0;
    while gi < list_len(s.gated) - 1 { gated = list_push(gated, list_get(s.gated, gi)); gi = gi + 1; }
    gated = list_push(gated, "openOODA-tools=" + total.to_string());
    return QueueScan { tasks: s.tasks, gap: gap, gated: gated, no_cap: no_cap, skipped: skipped, cand: cand };
}

// Cut the sorted tools candidates into the batch tasks.
fn qg_batch_tasks(cand: List[String], batch: Int) -> List[QueueTask] {
    let mut out: List[QueueTask] = list_new();
    let mut i: Int = 0;
    let mut n: Int = 0;
    while i < list_len(cand) {
        let mut repos: List[String] = list_new();
        let mut ids: List[String] = list_new();
        let mut k: Int = 0;
        while k < batch && i + k < list_len(cand) {
            let row: String = list_get(cand, i + k);
            let tab: Int = index_of(row, "\t");
            let key: String = str_sub(row, tab + 1, str_len(row));
            repos = list_push(repos, "/Projects/" + key);
            ids = list_push(ids, key);
            k = k + 1;
        }
        out = list_push(out, QueueTask { id: "reg64-batch:openOODA-tools#" + (n + 1).to_string(),
            kind: "reg64-gate-batch", space: "openOODA-tools", repo: "", path: "", repos: repos,
            repos_ids: ids, priority: 100 + n, priority_text: "", work_item: "", title: "", objective: "" });
        i = i + batch;
        n = n + 1;
    }
    return out;
}

// Write one task object in the queue key order.
fn qg_write_task(t: QueueTask) -> String {
    let pri: Int = t.priority;
    let mut out: String = "{\"id\":" + json_escape_str(t.id);
    out = out + ",\"kind\":" + json_escape_str(t.kind);
    out = out + ",\"space\":" + json_escape_str(t.space);
    if str_len(t.repo) == 0 { out = out + ",\"repo\":null"; } else { out = out + ",\"repo\":" + json_escape_str(t.repo); }
    if str_len(t.path) == 0 { out = out + ",\"path\":null"; } else { out = out + ",\"path\":" + json_escape_str(t.path); }
    out = out + ",\"repos\":" + qg_json_list(t.repos, 0);
    if str_len(t.repos_ids) > 0 { out = out + ",\"repos_ids\":" + qg_json_list(t.repos_ids, 0); }
    if str_len(t.work_item) > 0 {
        out = out + ",\"work_item\":" + json_escape_str(t.work_item);
        out = out + ",\"title\":" + json_escape_str(t.title);
        out = out + ",\"objective\":" + json_escape_str(t.objective);
    }
    if str_len(t.priority_text) > 0 { out = out + ",\"priority\":" + json_escape_str(t.priority_text); }
    else { out = out + ",\"priority\":" + pri.to_string(); }
    out = out + ",\"state\":\"queued\",\"owner_pane\":null,\"attempts\":0,\"last_error\":null}";
    return out;
}

// Write a string array, a count object, or a count text as the mode asks.
fn qg_json_list(items: List[String], mode: Int) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < list_len(items) {
        let item: String = list_get(items, i);
        if i > 0 { if mode == 2 { out = out + ", "; } else { out = out + ","; } }
        if mode == 0 { out = out + "\"" + json_escape_str(item) + "\""; }
        else {
            let eq: Int = index_of(item, "=");
            let key: String = str_sub(item, 0, eq);
            let val: String = str_sub(item, eq + 1, str_len(item));
            if mode == 1 { out = out + "\"" + key + "\":" + val; }
            else { out = out + "'" + key + "': " + val; }
        }
        i = i + 1;
    }
    return out;
}

// Write the whole queue document.
fn qg_write_doc(scan: QueueScan, tasks: List[QueueTask], now: String, batch: Int, reg64: Int, org: Int) -> String {
    let mut out: String = "{\"schema\":1,\"generated_at\":" + json_escape_str(now);
    out = out + ",\"tools_batch_size\":" + batch.to_string();
    out = out + ",\"counts\":{\"reg64_tasks\":" + reg64.to_string();
    out = out + ",\"org_tasks\":" + org.to_string();
    out = out + ",\"no_capability_surface\":" + list_len(scan.no_cap).to_string();
    out = out + ",\"skipped_reviewer_locked\":" + list_len(scan.skipped).to_string() + "}";
    out = out + ",\"gap_by_space\":{" + qg_json_list(scan.gap, 1) + "}";
    out = out + ",\"gated_by_space\":{" + qg_json_list(scan.gated, 1) + "}";
    out = out + ",\"no_capability_surface\":" + qg_json_list(scan.no_cap, 0);
    out = out + ",\"skipped_reviewer_locked\":" + qg_json_list(scan.skipped, 0);
    out = out + ",\"tasks\":[";
    let mut i: Int = 0;
    while i < list_len(tasks) {
        if i > 0 { out = out + ","; }
        out = out + qg_write_task(list_get(tasks, i));
        i = i + 1;
    }
    return out + "]}";
}

// Build the fleet work queue and write it to the state directory.
pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let mut state: String = "";
    let mut batch_text: String = "";
    let mut summary: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--state-dir" && i + 1 < list_len(args) { state = list_get(args, i + 1); i = i + 1; }
        else if a == "--tools-batch" && i + 1 < list_len(args) { batch_text = list_get(args, i + 1); i = i + 1; }
        else if a == "--print-summary" { summary = true; }
        i = i + 1;
    }
    if str_len(state) == 0 {
        let e: Result[String, String] = env_get(env, "OODA_FLEET_STATE_DIR");
        state = match e { Ok(s) => s, Err(_) => "/Projects/openOODA/.fleet-tick" };
    }
    let batch: Int = parse_int_digits(batch_text);
    let size: Int = if str_len(batch_text) == 0 { 12 } else if batch > 1 { batch } else { 1 };
    let scan: QueueScan = qg_scan_tools(p, fr, qg_scan_spaces(p, fr));
    let mut tasks: List[QueueTask] = scan.tasks;
    let batches: List[QueueTask] = qg_batch_tasks(scan.cand, size);
    let mut k: Int = 0;
    while k < list_len(batches) { tasks = list_push(tasks, list_get(batches, k)); k = k + 1; }
    let orgs: List[QueueTask] = qg_org_tasks();
    k = 0;
    while k < list_len(orgs) { tasks = list_push(tasks, list_get(orgs, k)); k = k + 1; }
    let reg64: Int = list_len(tasks) - list_len(orgs);
    let org: Int = list_len(orgs);
    let d: Result[String, String] = sys_exec(p, "date", "+%Y-%m-%dT%H:%M:%S%z");
    let now: String = str_replace(match d { Ok(s) => s, Err(_) => "" }, "\n", "");
    let doc: String = qg_write_doc(scan, tasks, now, size, reg64, org);
    let _m: Result[Void, String] = fs_mkdir_p(fw, state);
    let _w: Result[Void, String] = fs_write_file(fw, state + "/work-queue.json", doc + "\n");
    print("-- queue: " + list_len(tasks).to_string() + " tasks -> " + state + "/work-queue.json\n");
    if summary {
        print("   reg64 tasks   : " + reg64.to_string() + "\n");
        print("   org tasks     : " + org.to_string() + "\n");
        print("   no cap surface: " + list_len(scan.no_cap).to_string() + "\n");
        print("   gap by space  : {" + qg_json_list(scan.gap, 2) + "}\n");
    }
    return Ok(0);
}
