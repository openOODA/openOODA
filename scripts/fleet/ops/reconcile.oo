// # Fleet Reconcile - Fast-Forward Every Space Repository
//
// Logline: Fetch each space repository, classify it against origin, and fast-forward the ones that are only behind.
//
// Setup: ProcessCap runs git. FsReadCap walks /Projects. FsWriteCap writes reconcile.tsv and reconcile.json.
//
// Beats:
//   1. List the git trees one level under the nine space directories.
//   2. Classify each tree and fast-forward a pull-only tree.
//   3. Write a stable TSV and a count summary. Never push and never merge.

import "fleet/ops/git_row.oo";
import "fleet/jobs/job_text.oo";
import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "std/fs/process/env.oo";

fn rc_spaces() -> List[String] {
    return str_split("openOODA|openOODA-agents|openOODA-apps|openOODA-cloud|openOODA-core|"
        + "openOODA-DE|openOODA-kernel|openOODA-OS|openOODA-tools", "|");
}

fn rc_repos(fr: &FsReadCap) -> List[String] {
    let spaces: List[String] = rc_spaces();
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(spaces) {
        let sp: String = list_get(spaces, i);
        let root: String = "/Projects/" + sp;
        if fs_is_dir(fr, root) {
            let names: List[String] = fs_read_dir(fr, root);
            let mut j: Int = 0;
            while j < list_len(names) {
                let name: String = list_get(names, j);
                let path: String = root + "/" + name;
                if name != ".github" && fs_is_dir(fr, path + "/.git") {
                    out = list_push(out, sp + "|" + name);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn rc_state(env: &EnvCap, args: List[String]) -> String {
    let mut state: String = "";
    let mut i: Int = 0;
    while i < list_len(args) {
        if list_get(args, i) == "--state-dir" && i + 1 < list_len(args) { state = list_get(args, i + 1); }
        i = i + 1;
    }
    if str_len(state) > 0 { return state; }
    let e: Result[String, String] = env_get(env, "OODA_FLEET_STATE_DIR");
    return match e { Ok(s) => s, Err(_) => "/Projects/openOODA/.fleet-tick" };
}

fn rc_limit(env: &EnvCap) -> String {
    let e: Result[String, String] = env_get(env, "RECONCILE_GIT_TIMEOUT");
    let s: String = match e { Ok(v) => v, Err(_) => "" };
    if str_len(s) == 0 { return "25"; }
    return s;
}

fn rc_field(row: String, n: Int) -> String {
    let parts: List[String] = str_split(row, "\t");
    if n < 0 || n >= list_len(parts) { return ""; }
    return list_get(parts, n);
}

fn rc_count(rows: List[String], cls: String) -> Int {
    let mut n: Int = 0;
    let mut i: Int = 0;
    while i < list_len(rows) {
        if rc_field(list_get(rows, i), 3) == cls { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn rc_json(rows: List[String], total: Int) -> String {
    let mut out: String = "{\"schema\":1,\"total\":" + total.to_string();
    out = out + ",\"counts\":{\"SYNCED\":" + rc_count(rows, "SYNCED").to_string();
    out = out + ",\"PULL_ONLY\":" + rc_count(rows, "PULL_ONLY").to_string();
    out = out + ",\"PUSH_ONLY\":" + rc_count(rows, "PUSH_ONLY").to_string();
    out = out + ",\"DIVERGED\":" + rc_count(rows, "DIVERGED").to_string();
    out = out + ",\"FETCH_FAIL\":" + rc_count(rows, "FETCH_FAIL").to_string();
    out = out + ",\"NO_REMOTE\":" + rc_count(rows, "NO_REMOTE").to_string() + "}}";
    return out;
}

pub fn main(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let state: String = rc_state(env, args);
    let limit: String = rc_limit(env);
    let keys: List[String] = rc_repos(fr);
    let mut rows: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(keys) {
        let key: String = list_get(keys, i);
        let bar: Int = index_of(key, "|");
        let sp: String = str_sub(key, 0, bar);
        let name: String = str_sub(key, bar + 1, str_len(key));
        rows = list_push(rows, gr_classify(p, "/Projects/" + sp + "/" + name, sp, name, limit));
        i = i + 1;
    }
    rows = jt_sort(rows);
    let mut tsv: String = "";
    i = 0;
    while i < list_len(rows) { tsv = tsv + list_get(rows, i) + "\n";
    i = i + 1; }
    let _dir: Result[Void, String] = fs_mkdir_p(fw, state);
    let _w1: Result[Void, String] = fs_write_file(fw, state + "/reconcile.tsv", tsv);
    let _w2: Result[Void, String] = fs_write_file(fw, state + "/reconcile.json", rc_json(rows, list_len(keys)) + "\n");
    println("-- reconcile: " + list_len(keys).to_string() + " repos -> " + state + "/reconcile.tsv");
    println("-- reconcile summary: SYNCED=" + rc_count(rows, "SYNCED").to_string()
        + " PULL_ONLY=" + rc_count(rows, "PULL_ONLY").to_string()
        + " PUSH_ONLY=" + rc_count(rows, "PUSH_ONLY").to_string()
        + " DIVERGED=" + rc_count(rows, "DIVERGED").to_string()
        + " FETCH_FAIL=" + rc_count(rows, "FETCH_FAIL").to_string()
        + " NO_REMOTE=" + rc_count(rows, "NO_REMOTE").to_string());
    if list_len(rows) != list_len(keys) { return Err("reconcile classified a different count than it listed"); }
    return Ok(0);
}
