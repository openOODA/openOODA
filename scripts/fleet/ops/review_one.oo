// # Fleet Review One - Two-Axis Review Of One Repository
//
// Logline: Run the code review and the hat cycle against one repository and return a verdict token.
//
// Setup: ProcessCap runs mcode and the hat binary. The hat cycle writes only under the scratch directory.
//
// Beats:
//   1. Ask mcode for defects on the latest change and do not let it edit.
//   2. Run the hat cycle from the scratch directory.
//   3. Mark the verdict inconclusive when the review dirties the target.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";

fn rv_text(r: Result[String, String]) -> String {
    return match r { Ok(s) => s, Err(e) => e };
}

fn rv_hit(low: String) -> Bool {
    if str_contains(low, "defect") { return true; }
    if str_contains(low, "finding") { return true; }
    if str_contains(low, "violation") { return true; }
    if str_contains(low, "issue") { return true; }
    return str_contains(low, "bug");
}

fn rv_mask(text: String) -> Int {
    let at: Int = index_of(text, "quorum_mask");
    if at < 0 { return 0 - 1; }
    let n: Int = str_len(text);
    let mut i: Int = at;
    while i < n {
        let b: Int = byte_at(text, i);
        if b >= 48 && b <= 57 { break; }
        i = i + 1;
    }
    let mut j: Int = i;
    while j < n {
        let b: Int = byte_at(text, j);
        if b < 48 || b > 57 { break; }
        j = j + 1;
    }
    if j == i { return 0 - 1; }
    return parse_int_digits(str_sub(text, i, j));
}

fn rv_mcode(p: &ProcessCap, fr: &FsReadCap, repo: String, model: String, prompt: String) -> String {
    if !fs_path_exists(fr, prompt) { return "missing"; }
    let scope: String = "Review only the most recent change. Report defects on the Standards axis and the Spec axis. Do not m" +
        "odify any file.";
    let r: Result[String, String] = sys_exec(p, "timeout", "1800", "mcode", "exec", "--cwd", repo, "--model", model, "--mode",
        "lightweight", "--file", prompt, scope);
    let low: String = to_lowercase(rv_text(r));
    if rv_hit(low) { return "findings"; }
    if match r { Ok(_) => false, Err(_) => true } { return "mcode-fail"; }
    return "clean";
}

fn rv_hat(p: &ProcessCap, fr: &FsReadCap, repo: String, bin: String, scratch: String) -> String {
    if !fs_path_exists(fr, bin) { return "hat-absent"; }
    let r: Result[String, String] = sys_exec(p, "env", "OODA_NO_JAIL=1",
        "OO_LIST_AMBIENT_QUOTA=8589934592", "OODA_FS_READDIR=/Projects:/tmp:/usr:/lib:/lib64",
        "OODA_FS_WRITEDIR=" + scratch, "timeout", "900", bin, "cycle", repo);
    let text: String = rv_text(r);
    let low: String = to_lowercase(text);
    if str_contains(low, "black hat") { return "hat-refuse"; }
    let mask: Int = rv_mask(text);
    if match r { Ok(_) => false, Err(_) => true } { return "hat-fail"; }
    if mask >= 0 && mask != 7 { return "hat-quorum"; }
    return "clean";
}

fn rv_dirty(p: &ProcessCap, repo: String) -> Bool {
    let r: Result[String, String] = sys_exec(p, "git", "-C", repo, "status", "--porcelain");
    return str_len(str_replace(rv_text(r), "\n", "")) > 0;
}

pub fn rv_one(p: &ProcessCap, fr: &FsReadCap, repo: String, model: String, prompt: String, bin: String,
    scratch: String) -> String {
    let mut reasons: String = "";
    let m: String = rv_mcode(p, fr, repo, model, prompt);
    if m != "clean" { reasons = reasons + m + ","; }
    let h: String = rv_hat(p, fr, repo, bin, scratch);
    if h != "clean" { reasons = reasons + h + ","; }
    if rv_dirty(p, repo) { reasons = reasons + "dirty,"; }
    let fail: Bool = str_contains(reasons, "findings") || str_contains(reasons, "hat-refuse");
    let fail2: Bool = str_contains(reasons, "hat-quorum") || str_contains(reasons, "hat-fail");
    let soft: Bool = str_contains(reasons, "missing") || str_contains(reasons, "hat-absent") || str_contains(reasons,
        "mcode-fail");
    let mut verdict: String = "PASS";
    if fail || fail2 { verdict = "FAIL";
    } else if soft { verdict = "INCONCLUSIVE"; }
    if str_contains(reasons, "dirty") { verdict = "INCONCLUSIVE"; }
    return verdict + "\t" + reasons;
}
