// # Fleet Argv Runner - Shell-Free Command Execution
//
// Logline: Run git, herdr, and systemctl as explicit argv under ProcessCap with a minimal child environment.
//
// Setup: ProcessCap only. Children start with a clean environment, so HOME and XDG_RUNTIME_DIR pass through /usr/bin/env argv entries. No sh -c.
//
// Beats:
//   1. Carry the three environment values the children need in FleetEnv.
//   2. Run git with two, three, or four arguments inside one repository.
//   3. Flatten a Result into its text so callers read stdout on success and on failure.

type FleetEnv = struct {
    home: String,
    xdg: String,
    forge: String
};

pub fn fleet_text(r: Result[String, String]) -> String {
    return match r { Ok(s) => s, Err(e) => e };
}

pub fn fleet_ok(r: Result[String, String]) -> Bool {
    return match r { Ok(_) => true, Err(_) => false };
}

pub fn fleet_git2(p: &ProcessCap, e: FleetEnv, repo: String, a: String, b: String) -> Result[String, String] {
    return sys_exec(p, "/usr/bin/env", "HOME=" + e.home, "git", "-C", repo, a, b);
}

pub fn fleet_git3(p: &ProcessCap, e: FleetEnv, repo: String, a: String, b: String, c: String) -> Result[String, String] {
    return sys_exec(p, "/usr/bin/env", "HOME=" + e.home, "git", "-C", repo, a, b, c);
}

pub fn fleet_git4(p: &ProcessCap, e: FleetEnv, repo: String, a: String, b: String, c: String, d: String) -> Result[String, String] {
    return sys_exec(p, "/usr/bin/env", "HOME=" + e.home, "git", "-C", repo, a, b, c, d);
}

pub fn fleet_git_ix(p: &ProcessCap, e: FleetEnv, ix: String, repo: String, a: String, b: String) -> Result[String, String] {
    return sys_exec(p, "/usr/bin/env", "HOME=" + e.home, "GIT_INDEX_FILE=" + ix, "git", "-C", repo, a, b);
}

pub fn fleet_user_cmd(p: &ProcessCap, e: FleetEnv, prog: String, a: String, b: String, c: String) -> Result[String, String] {
    return sys_exec(p, "/usr/bin/env", "HOME=" + e.home, "XDG_RUNTIME_DIR=" + e.xdg, prog, a, b, c);
}
