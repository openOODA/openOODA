// # Fleet Snapshot - Back Up Uncommitted Work to Forgejo
//
// Logline: Copy each dirty repository's working tree into a snapshot commit on a Forgejo wip branch without touching the tree, the index, or the checked-out branch.
//
// Setup: ProcessCap for git argv; FsReadCap and FsWriteCap for the temporary index copy under /tmp. Locked repositories are skipped.
//
// Beats:
//   1. Pick the Forgejo remote: "forgejo" when present, else "origin" when it points at Forgejo.
//   2. Stage the full tree into a temporary index and write a tree object.
//   3. Push a snapshot commit to wip/autosnap-<host> only when the tree changed.

import "fleet/run_argv.oo";
import "fleet/find_repos.oo";
import "std/fs/os/fs.oo";

pub fn fleet_is_forgejo(url: String, host: String) -> Bool {
    if str_len(host) == 0 { return false; }
    return str_contains(url, host);
}

pub fn fleet_forgejo_remote(p: &ProcessCap, e: FleetEnv, repo: String) -> String {
    let fj: Result[String, String] = fleet_git3(p, e, repo, "remote", "get-url", "forgejo");
    if fleet_ok(fj) { return "forgejo"; }
    if fleet_is_forgejo(fleet_text(fleet_git3(p, e, repo, "remote", "get-url", "origin")), e.forge) { return "origin"; }
    return "";
}

pub fn fleet_snap_tree(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: FleetEnv, repo: String) -> String {
    let ix: String = "/tmp/fleet-snap-index";
    let _c: Result[Void, String] = fs_copy_file(fr, fw, repo + "/.git/index", ix);
    let _a: Result[String, String] = fleet_git_ix(p, e, ix, repo, "add", "-A");
    let tree: String = str_replace(fleet_text(sys_exec(p, "env", "HOME=" + e.home, "GIT_INDEX_FILE=" + ix, "git", "-C", repo, "write-tree")), "\n", "");
    let _r: Result[Void, String] = fs_remove_file(fw, ix);
    return tree;
}

pub fn fleet_snap_repo(p: &ProcessCap, fr: &FsReadCap, fw: &FsWriteCap, e: FleetEnv, repo: String, host: String) -> String {
    if fleet_is_locked(repo) { return ""; }
    let dirty: String = fleet_text(fleet_git2(p, e, repo, "status", "--porcelain"));
    if str_len(dirty) == 0 { return ""; }
    let rem: String = fleet_forgejo_remote(p, e, repo);
    if str_len(rem) == 0 { return "NOFJ  " + repo; }
    let tree: String = fleet_snap_tree(p, fr, fw, e, repo);
    let ref: String = "refs/heads/wip/autosnap-" + host;
    let prev: String = list_get(str_split(fleet_text(fleet_git3(p, e, repo, "ls-remote", rem, ref)), "\t"), 0);
    if str_len(prev) > 0 && str_replace(fleet_text(fleet_git2(p, e, repo, "rev-parse", prev + "^{tree}")), "\n", "") == tree { return ""; }
    let msg: String = "autosnap " + host;
    let commit: String = str_replace(fleet_text(sys_exec(p, "env", "HOME=" + e.home, "git", "-C", repo, "commit-tree", tree, "-p", "HEAD", "-m", msg)), "\n", "");
    let pushed: Result[String, String] = sys_exec(p, "env", "HOME=" + e.home, "git", "-C", repo, "push", "-q", "-f", rem, commit + ":" + ref);
    if !fleet_ok(pushed) { return "FAIL  " + repo + " " + fleet_text(pushed); }
    return "SNAP  " + repo + " " + str_sub(commit, 0, 7);
}
