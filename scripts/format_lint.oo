// # Repository Format & Standards Linter
//
// Logline: Enforce zero-tolerance file extension laws, 256-line limits, and Academy headers across all product files.
//
// Setup: ProcessCap granted to execute repository format and hygiene checks.
//
// Beats:
//   1. Enforce zero-tolerance file extension laws (strictly reject .py and .sh files in product tree).
//   2. Validate 256-line maximum limit across all product .oo and .oot files.
//   3. Validate 4-element Academy headers on product .oo files.
//   4. Report total metrics and fail closed on any violation.

pub fn main(proc: &ProcessCap) {
    let check_cmd: String = "set -e; fails=0; "
        + "echo '=== 1. Checking Forbidden File Extensions in Product Scope ==='; "
        + "forbidden=$(find openOODA ooda docs openOODA.github.io -type f \\( -name '*.py' -o -name '*.sh' \\) ! -path '*/.agents/*' ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/target/*' ! -path '*/e2e/*' ! -name 'oodac_pure_build' ! -name 'install.sh' 2>/dev/null | sort); "
        + "if [ -n \"$forbidden\" ]; then echo '[FORBIDDEN FILE FAIL] Found unauthorized .py/.sh files:'; echo \"$forbidden\"; fails=$((fails + 1)); fi; "
        + "echo '=== 2. Checking Line Limits (<= 256 lines) ==='; "
        + "oversized=$(find openOODA ooda docs openOODA.github.io -type f \\( -name '*.oo' -o -name '*.oot' \\) ! -path '*/.agents/*' ! -path '*/.git/*' ! -path '*/bootstrap/corpus/*' ! -path '*/qa_challenger_*' 2>/dev/null -exec wc -l {} + | awk '$1 > 256 && $2 != \"total\" {print $1, $2}'); "
        + "if [ -n \"$oversized\" ]; then echo '[OVERSIZED FILE FAIL] Found files > 256 lines:'; echo \"$oversized\"; fails=$((fails + 1)); fi; "
        + "echo '=== 3. Checking Product .oo Academy Headers ==='; "
        + "hdr_fails=$(find ooda/oodac ooda/std ooda/cli ooda/scripts qa docs openOODA openOODA.github.io -type f -name '*.oo' 2>/dev/null | grep -v -E 'corpus|fixtures|vendor|\\.ooda-cache|\\.ooda_modules|\\.ooda_pack|\\.agents|\\.git' | xargs awk 'FNR<=25{if($0~/^\\/\\/ # /)t[FILENAME]=1; if($0~/^\\/\\/ Logline:/)l[FILENAME]=1} ENDFILE{if(!t[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // # <Title>\"; if(!l[FILENAME])print \"[FORMAT FAIL] \" FILENAME \": missing // Logline:\"}' || true); "
        + "if [ -n \"$hdr_fails\" ]; then echo \"$hdr_fails\"; fails=$((fails + $(echo \"$hdr_fails\" | wc -l))); fi; "
        + "if [ \"$fails\" -gt 0 ]; then echo \"FAILED: $fails total violations found.\"; exit 1; fi; "
        + "echo \"Format & 10-Board Rule 1.13 Lint OK: zero forbidden files, all line counts <= 256, all product modules compliant.\"";

    let res = sys_exec(proc, "sh", "-c", check_cmd);
    match res {
        Ok(msg) => {
            println(msg);
        },
        Err(err) => {
            println(err);
            process_exit(1);
        }
    }
}
