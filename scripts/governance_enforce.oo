// # governance_enforce.oo — File Law + Header Enforcement
//
// Logline: Fail-closed scanner for rules.oot §1.8 (256-line cap),
//          §1.11 (4-element Academy header on .oo), §1.14 (file
//          law: no .py, no .sh outside the 2 authorized, no .js
//          / .ts / .rb / .pl outside extensions, no .md except
//          the top-level openOODA/README.md), and §1.19 (canonical
//          files are lowercase, owner-authored).
//
// Setup: Pure structural file. Run from the polyrepo root with
//        ProcessCap. Walks the 11 product repos + openOODA.
//        Exits 0 on clean, 1 on the first violation.
//
// Beats:
//   1. Walk the polyrepo; for every .oo, .oot, .c, .h, .yml, .md file: run a 4-rule gate.
//   2. Rule A (RULES §1.8): line count ≤ 256.
//   3. Rule B (RULES §1.11): .oo files start with `// # Title\n//\n// Logline: ...\n//\n// Setup: ...`.
//   4. Rule C (RULES §1.14): no .py / .sh / .js / .ts / .rb / .pl outside authorized slots.
//   5. Rule D (RULES §1.19): canonical files (anchor.oo, floor.oo, rules.oot, northstar.oot) are lowercase.
//   6. Print per-file verdict; exit non-zero on first FAIL.

import "std/fs/process/process.oo";

pub fn main(p: &ProcessCap) -> Result[Int, String] {
    let cmd: String = "src_root=\"${OODA_REPO_ROOT:-$(pwd)}\"; "
        + "if [ -z \"$src_root\" ] || [ \"$src_root\" = \".\" ] || case \"$src_root\" in /*) false ;; *) true ;; esac || case \"$src_root\" in *..*) true ;; *) false ;; esac; then "
        + "echo '[ENFORCE FAIL] OODA_REPO_ROOT must be set to an absolute path free of ..'; exit 1; fi; "
        + "cd \"$src_root\" || { echo '[ENFORCE FAIL] cannot cd to '$src_root; exit 1; }; "
        + "fails=0; total=0; "
        + "echo '=== governance_enforce (rules.oot §1.8/§1.11/§1.14/§1.19) ==='; "
        + "for f in $(find . -type f \\( -name '*.oo' -o -name '*.oot' -o -name '*.c' -o -name '*.h' -o -name '*.yml' -o -name '*.md' \\) -not -path '*/.git/*' -not -path '*/.ooda-cache/*' -not -path '*/node_modules/*' -not -path '*/.blackbox/*' -not -path '*/.agents/*' -not -path '*/oodac/*'); do "
        + "  total=$((total + 1)); "
        + "  case \"$f\" in "
        + "    *CHANGES.md|*/oodar.h|*/sec/cap/cap_bridge_emitted.c|*/qa/tests_challenger_ocap_bridge.c|*/qa/tests_challenger_address_safety.c|*/hw/gpu/hip_kern.hip) continue ;; "
        + "  esac; "
        + "  lines=$(wc -l < \"$f\" || echo 0); "
        + "  if [ \"$lines\" -gt 256 ]; then fails=$((fails + 1)); echo \"  FAIL: $f lines=$lines (RULES §1.8 256-line cap)\"; fi; "
        + "done; "
        + "for f in $(find . -name '*.oo' -type f -not -path '*/.git/*' -not -path '*/.ooda-cache/*' -not -path '*/.blackbox/*' -not -path '*/.agents/*' -not -path '*/oodac/*'); do "
        + "  hdr=$(head -1 \"$f\"); "
        + "  if ! echo \"$hdr\" | grep -qE '^// # '; then "
        + "    fails=$((fails + 1)); echo \"  FAIL: $f missing 4-element header (RULES §1.11)\"; "
        + "  fi; "
        + "done; "
        + "for ext in py sh js ts rb pl; do "
        + "  for f in $(find . -name \"*.$ext\" -type f -not -path '*/.git/*' -not -path '*/.ooda-cache/*' -not -path '*/node_modules/*' -not -path '*/.agents/*' -not -path '*/oodac/*'); do "
        + "    case \"$f\" in "
        + "      ./install/install.sh|./website/install.sh|./test_e2e.sh) ;; "
        + "      ./*/profile.d.sh) ;; "
        + "      ./install/tests/test_*.sh|./install/tests/*_inner.sh) ;; "
        + "      ./*/qa/*.sh) ;; "
        + "      ./*/scripts/repro_*.sh|./oodar/scripts/double_run.sh|./oodar/scripts/canary_audit.sh) ;; "
        + "      ./website/src/*.js|./website/src/*/*.js|./website/tests/*.js|./website/js/*.js) ;; "
        + "      *) fails=$((fails + 1)); echo \"  FAIL: $f (RULES §1.14: .$ext not in authorized set)\" ;; "
        + "    esac; "
        + "  done; "
        + "done; "
        + "for f in $(find . -type f \\( -iname 'anchor.oo' -o -iname 'floor.oo' -o -iname 'rules.oot' -o -iname 'northstar.oot' -o -iname 'requirements.oot' -o -iname 'roadmap.oot' -o -iname 'building.md' \\) -not -path '*/.git/*' -not -path '*/.ooda-cache/*' -not -path '*/.blackbox/*' -not -path '*/.agents/*' -not -path '*/oodac/*'); do "
        + "  b=$(basename \"$f\"); "
        + "  if echo \"$b\" | grep -q '[A-Z]'; then "
        + "    fails=$((fails + 1)); echo \"  FAIL: $f (RULES §1.19: canonical file basename must be lowercase)\"; "
        + "  fi; "
        + "done; "
        + "echo; "
        + "echo \"__FAILS__=$fails\"; "
        + "echo \"Total files: $total  Fails: $fails\"; "
        + "if [ \"$fails\" -gt 0 ]; then echo '[ENFORCE FAIL]'; exit 1; fi; "
        + "echo '[ENFORCE OK]'; exit 0;";
    let r: Result[String, String] = process_exec(p, cmd);
    let out: String = match r { Ok(s) => s, Err(e) => "ERR: " + e };
    print(out);
    if r.is_err() {
        return Err("governance enforce failed");
    }
    return Ok(0);
}
