// # Verify All — Sovereign End-to-End Ecosystem Linter

// Logline: Validate 14 canonical boards, SHIPPED freshness, 256 cap, RFC template, and test-suite presence with fail-closed OCap.

// Setup: FsReadCap for board/RFC reads, EnvCap for OODA_REPO_ROOT, ProcessCap for rfc_lint via ooda/bin/ooda. No heuristics. No shell fallback. Derives board list from is_whitelisted_board.

// Beats:
//   1. Locate openOODA/ via EnvCap (reject .. traversal) and verify 14 boards via FsReadCap.
//   2. Verify SHIPPED.oot generated marker and 256 cap via count_lines.
//   3. Run governance_lint_rfc via ProcessCap and require RFC lint OK.
//   4. Verify test-suite presence (qa/tests, rfcs template) and fail closed on regression.

import "mod.oo";
import "util_env.oo";

fn count_lines(fs: &FsReadCap, path: String) -> Int {
  let res: Result[String, String] = oo_read_file(fs, path);
  match res {
    Ok(text) => {
      let mut n: Int = 0;
      let mut j: Int = 0;
      let len: Int = chars_len(text);
      while j < len {
        let c: String = char_at(text, j);
        if c == "\n" { n = n + 1; }
        j = j + 1;
      }
      return n;
    },
    Err(e) => {
      println("ERR\tverify_all\tunreadable " + path + ": " + e);
      return 257;
    }
  }
}

fn verify_board_presence(fs: &FsReadCap, base: String) -> Int {
  let mut fails: Int = 0;
  let boards: List[String] = list_new();
  let b0: List[String] = list_push(boards, "START.oot");
  let b1: List[String] = list_push(b0, "RULES.oot");
  let b2: List[String] = list_push(b1, "NORTHSTAR.oot");
  let b3: List[String] = list_push(b2, "MOONSHOTS.oot");
  let b4: List[String] = list_push(b3, "ROADMAP.oot");
  let b5: List[String] = list_push(b4, "SHIPPED.oot");
  let b6: List[String] = list_push(b5, "FORMAT.oot");
  let b7: List[String] = list_push(b6, "SECURITY.oot");
  let b8: List[String] = list_push(b7, "WORKFLOW.oot");
  let b9: List[String] = list_push(b8, "QUICKREF.oot");
  let b10: List[String] = list_push(b9, "CONSTRAINTS.oot");
  let b11: List[String] = list_push(b10, "STRUCTURE_EM.oot");
  let b12: List[String] = list_push(b11, "REDTEAM.oot");
  let b13: List[String] = list_push(b12, "LLMS.oot");
  println("=== Boards (14 canonical) ===");
  let n: Int = list_len(b13);
  let mut i: Int = 0;
  while i < n {
    let name: String = list_get(b13, i);
    let path: String = base + "/" + name;
    if path_exists(fs, path) {
      println("  " + name + " OK");
    } else {
      println("  " + name + " MISSING");
      fails = fails + 1;
    }
    i = i + 1;
  }
  return fails;
}

fn verify_shipped(fs: &FsReadCap, base: String) -> Int {
  let path: String = base + "/SHIPPED.oot";
  if !path_exists(fs, path) {
    println("FAIL: SHIPPED.oot missing");
    return 1;
  }
  let res: Result[String, String] = oo_read_file(fs, path);
  match res {
    Ok(text) => {
      if !str_contains(text, "THIS FILE IS GENERATED") {
        println("FAIL: SHIPPED.oot stale");
        return 1;
      }
      let lc: Int = count_lines(fs, path);
      if lc > 256 {
        println("FAIL: SHIPPED.oot " + lc.to_string() + " lines > 256");
        return 1;
      }
      println("SHIPPED.oot OK: " + lc.to_string() + " lines");
      return 0;
    },
    Err(e) => {
      println("FAIL: SHIPPED.oot unreadable: " + e);
      return 1;
    }
  }
}

fn verify_rfcs(fs: &FsReadCap, base: String) -> Int {
  let tpl: String = base + "/rfcs/0000-template.oot";
  if !path_exists(fs, tpl) {
    println("FAIL: rfcs/0000-template.oot missing");
    return 1;
  }
  println("rfcs/0000-template.oot OK");
  return 0;
}

fn verify_test_suites(fs: &FsReadCap, root: String) -> Int {
  let mut fails: Int = 0;
  println("=== Test Suites ===");
  if !path_exists(fs, root + "/ooda/qa/tests") {
    println("  qa/tests MISSING");
    fails = fails + 1;
  } else {
    println("  qa/tests OK");
  }
  if !path_exists(fs, root + "/ooda/scripts") {
    println("  ooda/scripts MISSING");
    fails = fails + 1;
  } else {
    println("  ooda/scripts OK");
  }
  return fails;
}

pub fn main(fs: &FsReadCap, env: &EnvCap, p: &ProcessCap) {
  let root: String = env_required_dir(fs, env, "OODA_REPO_ROOT");
  let base: String = root + "/openOODA";
  if !path_exists(fs, base) {
    println("FAIL: " + base + " not found");
    process_exit(1);
  }
  let mut fails: Int = 0;
  fails = fails + verify_board_presence(fs, base);
  fails = fails + verify_shipped(fs, base);
  fails = fails + verify_rfcs(fs, base);
  fails = fails + verify_test_suites(fs, root);
  let bin: String = root + "/ooda/bin/ooda";
  if !path_exists(fs, bin) {
    println("FAIL: " + bin + " missing");
    fails = fails + 1;
  } else {
    let res = mod_run_script(p, root, bin, "governance_lint_rfc");
    match res {
      Ok(out) => {
        if !str_contains(out, "RFC lint OK") {
          println("FAIL: governance_lint_rfc did not OK");
          println(out);
          fails = fails + 1;
        } else {
          println("governance_lint_rfc OK");
        }
      },
      Err(e) => {
        println("FAIL: governance_lint_rfc did not run: " + e);
        fails = fails + 1;
      }
    }
  }
  if fails == 0 {
    println("verify_all passed");
    process_exit(0);
  } else {
    println("FAILED: " + fails.to_string() + " regression(s)");
    process_exit(1);
  }
}
