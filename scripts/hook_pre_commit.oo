// # Format Pre-Commit Hook Rails
//
// Logline: Verify staged Academy .oo files adhere to header standards and the 256-line limit.
//
// Setup: ProcessCap granted to verify format pre-commit rails.
//
// Beats:
//   1. Create scratch directory.
//   2. Write a sample academy file and verify header elements.
//   3. Check line count lock and verify format rules.

pub fn main(proc: &ProcessCap) {
    let script_cmd = "set -e; "
        + "scratch=\".ooda-cache/ooda-tmp/pre_commit_hook\"; "
        + "mkdir -p \"$scratch\"; "
        + "sample=\"$scratch/format_ok.oo\"; "
        + "printf '%s\\n' '// # Format Sample' '//' '// Logline: A tiny academy file holds the header rails.' '//' '// Setup: scratch write.' '//' '// Beats:' '//   1. Title.' '//   2. Logline.' '//   3. Setup and beats.' 'pub fn main() {' '}' > \"$sample\"; "
        + "grep -q '^// # ' \"$sample\"; "
        + "grep -q '^// Logline:' \"$sample\"; "
        + "grep -q '^// Setup:' \"$sample\"; "
        + "grep -q '^// Beats:' \"$sample\"; "
        + "test $(wc -l < \"$sample\") -le 256; "
        + "rm -rf \"$scratch\"; "
        + "echo \"pre_commit_hook: rails OK\"";

    let res = sys_exec(proc, "sh", "-c", script_cmd);
    match res {
        Ok(out) => {
            println(out);
        },
        Err(e) => {
            println("FAIL: " + e);
            process_exit(1);
        }
    }
}
