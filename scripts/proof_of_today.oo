// # Proof of Today
//
// Logline: Run the SHIPPED.oot named lock list and print pass/fail per smoke today.
//
// Setup: ProcessCap to run smokes, FsReadCap for env. CWD must be ooda/.
//
// Beats:
//   1. Load the hardcoded lock table from this file.
//   2. For each lock, run `./bin/ooda run <path>`; classify by exit code.
//   3. Skip env-bound locks (aarch64, llvm, x86) and report them separately.
//   4. Print a rollup: passed, failed, skipped, total.
//
// residual: Per-smoke timeout (no sys_exec timeout in std yet). Long hangs must be killed by the caller.

struct Lock {
    path: String,
    group: String,
    skip: String,
}

fn lock(p: String, g: String) -> Lock {
    return Lock { path: p, group: g, skip: "" };
}

fn skip(p: String, g: String, reason: String) -> Lock {
    return Lock { path: p, group: g, skip: reason };
}

fn lock_table() -> List[Lock] {
    let rows: List[Lock] = [
        // Compiler floor
        lock("scripts/c_line_smoke.oo", "compiler"),
        lock("scripts/c_line_ctrl_smoke.oo", "compiler"),
        lock("scripts/c_line_multi_smoke.oo", "compiler"),
        lock("scripts/c_line_secret_smoke.oo", "compiler"),
        lock("scripts/diag_caret_smoke.oo", "compiler"),
        lock("scripts/bit_identical_emit_lock.oo", "compiler"),
        // Caret diagnostics
        lock("scripts/cmp_caret_smoke.oo", "diags"),
        lock("scripts/diag_path_smoke.oo", "diags"),
        lock("scripts/type_caret_println_smoke.oo", "diags"),
        lock("scripts/type_caret_class_batch_smoke.oo", "diags"),
        // Capability model
        lock("scripts/hostile_cap_probe_smoke.oo", "caps"),
        lock("scripts/cap_scope_smoke.oo", "caps"),
        // x402 / pay
        lock("scripts/x402_parse_smoke.oo", "pay"),
        lock("scripts/pay_handshakes_smoke.oo", "pay"),
        // Autofix + install
        lock("scripts/emust_autofix_smoke.oo", "tooling"),
        lock("scripts/install_xdg_smoke.oo", "tooling"),
        // CI + bench
        lock("scripts/ci_open_run.oo", "tooling"),
        lock("scripts/bench_smoke.oo", "tooling"),
        // Sum types (compiler mid-flight)
        lock("fixtures/sum_string_smoke.oo", "sum"),
        lock("fixtures/sum_unit_smoke.oo", "sum"),
        lock("fixtures/sum_shape_smoke.oo", "sum"),
        // Lists
        lock("fixtures/list_set_smoke.oo", "list"),
        lock("fixtures/list_first_prod.oo", "list"),
        // Mut struct
        lock("fixtures/mut_struct_smoke.oo", "mut"),
        // Option / Result emit
        lock("fixtures/option_int_smoke.oo", "opt"),
        lock("fixtures/option_str_smoke.oo", "opt"),
        lock("fixtures/result_int_smoke.oo", "result"),
        lock("fixtures/result_bool_smoke.oo", "result"),
        // Env-bound side emits
        skip("scripts/aarch64_hello_smoke.oo", "aarch64", "needs aarch64 host"),
        skip("scripts/x86_hello_smoke.oo", "x86", "needs aarch64 toolchain"),
        skip("scripts/open68_cold_hello_smoke.oo", "llvm", "needs llvm toolchain"),
    ];
    return rows;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap) {
    println("PROOF OF TODAY");
    let cwd_check: Result[String, String] = env_get(fs, "PWD");
    match cwd_check {
        Ok(pwd) => println("cwd: " + pwd),
        Err(_) => println("cwd: <env not exposed>"),
    }
    println("");

    let rows: List[Lock] = lock_table();
    let total: Int = list_len(rows);
    let mut passed: Int = 0;
    let mut failed: Int = 0;
    let mut skipped: Int = 0;
    let mut i: Int = 0;

    while i < total {
        let r: Lock = list_get(rows, i);
        if r.skip != "" {
            println("SKIP  [" + r.group + "] " + r.path + "  ( " + r.skip + " )");
            skipped = skipped + 1;
        } else {
            let cmd: String = "./bin/ooda run " + r.path;
            let res: Result[String, String] = process_exec(p, cmd);
            match res {
                Ok(_) => {
                    println("PASS  [" + r.group + "] " + r.path);
                    passed = passed + 1;
                },
                Err(err) => {
                    println("FAIL  [" + r.group + "] " + r.path);
                    println("      err: " + err);
                    failed = failed + 1;
                }
            }
        }
        i = i + 1;
    }

    println("");
    println("TOTAL: " + total.to_string() + "  PASS: " + passed.to_string() + "  FAIL: " + failed.to_string() + "  SKIP: " + skipped.to_string());
    if failed > 0 {
        process_exit(1);
    }
    process_exit(0);
}
