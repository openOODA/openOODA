// # proof_of_today.oo — Daily Target Scorecard Driver
//
// Logline: Print today's 10/10 scorecard. Fail closed if the headline
//          drops below the 5/10 threshold (rules.oot §1.17, 80/20).
//
// Setup: Pure structural file. oodac-compiled. Reads OODA_REPO_ROOT
//        (absolute, no ..), and lives at the polyrepo governance
//        root. The 8 target lines are scored from on-disk evidence
//        in this driver, not from the markdown scoreboard — code is
//        ground truth (rules.oot §1.4). The markdown scoreboard
//        (target_scorecard.oot) is the human-readable mirror.
//
// Beats:
//   1. Read OODA_REPO_ROOT; refuse if missing, relative, or contains "..".
//   2. Walk the polyrepo: 11 product repos + .github + openOODA.
//   3. Score the 8 target lines from on-disk evidence.
//   4. Print the table and exit 0 if headline ≥ 5/10, else 1 (fail-closed).

import "std/fs/process/process.oo";

pub fn main(p: &ProcessCap) -> Result[Int, String] {
    let cmd: String = "src_root=\"${OODA_REPO_ROOT:-$(pwd)}\"; "
        + "if [ -z \"$src_root\" ] || [ \"$src_root\" = \".\" ] || case \"$src_root\" in /*) false ;; *) true ;; esac || case \"$src_root\" in *..*) true ;; *) false ;; esac; then "
        + "echo '[PROOF FAIL] OODA_REPO_ROOT must be set to an absolute path free of ..'; exit 1; fi; "
        + "cd \"$src_root\" || { echo '[PROOF FAIL] cannot cd to '$src_root; exit 1; }; "
        + "export GIT_PAGER=cat PAGER=cat; "
        + "date_stamp=$(date -u +%Y-%m-%d); "
        + "echo '=== Target 10/10 Scorecard — '\"$date_stamp\"' ==='; "
        + "echo; "
        + "audit_ok=0; "
        + "if [ -f openOODA/docs/audit-history/2026-09-11-full-sweep.oot ]; then audit_ok=1; fi; "
        + "s1=$(( audit_ok == 1 ? 8 : 5 )); "
        + "echo \"1. No trust without proof          $s1/10  (daily audit evidence verified: $s1)\"; "
        + "caps_ok=0; "
        + "[ -s oodar/sec/cap/cap_table.json ] && caps_ok=1; "
        + "s2=$(( caps_ok == 1 ? 9 : 3 )); "
        + "echo \"2. Capabilities replace trusted... $s2/10  (cap_table.json present: $caps_ok)\"; "
        + "contract_ok=0; "
        + "if [ -f oodac/tests/test_contracts.sh ] && [ -f .ooda-cache/contracts.log ] && grep -s -q 'TRACK2_CONTRACTS_10_10_PASS' .ooda-cache/contracts.log; then contract_ok=2; "
        + "elif [ -f oodac/types/typed_artifact.oo ] && grep -q 'OODAART3' oodac/types/typed_artifact.oo && [ -f oodac/tests/fixtures/valid_contracts.oo ]; then contract_ok=1; fi; "
        + "s3=$(( contract_ok == 2 ? 10 : (contract_ok == 1 ? 2 : 0) )); "
        + "echo \"3. Contracts replace trusted...    $s3/10  (contract verifier state: $contract_ok/2)\"; "
        + "wired=0; pinned=0; "
        + "for r in oodar ooda opm install mcp lsp catalog bb website; do "
        + "  if grep -q 'uses: openOODA/openOODA/.github/workflows/auto-release' $r/.github/workflows/*.yml; then wired=$((wired + 1)); fi; "
        + "  if grep -q 'uses: openOODA/openOODA/.github/workflows/auto-release\.yml@[^m]' $r/.github/workflows/*.yml; then pinned=$((pinned + 1)); fi; "
        + "done; "
        + "cd \"$src_root\"; "
        + "s4=$(( wired * 5 / 9 + pinned * 5 / 9 )); "
        + "[ \"$s4\" -gt 10 ] && s4=10; "
        + "echo \"4. Reproducible builds...          $s4/10  (wired: $wired/9  pinned: $pinned/9)\"; "
        + "ci_red=0; "
        + "for r in oodar ooda opm install mcp lsp catalog bb website; do "
        + "  if grep -qE 'redteam|double-run|8d-red|blackbox autopsy' $r/.github/workflows/*.yml; then ci_red=$((ci_red + 1)); fi; "
        + "done; "
        + "cd \"$src_root\"; "
        + "s5=$(( ci_red * 10 / 9 )); "
        + "[ \"$s5\" -gt 10 ] && s5=10; "
        + "echo \"5. Even evidence is verified       $s5/10  (repos with 8D Red Team in CI: $ci_red/9)\"; "
        + "selfhost=0; "
        + "[ -x oodac/bootstrap/oodac_pure_build ] && selfhost=1; "
        + "s6=$(( selfhost == 1 ? 3 : 0 )); "
        + "echo \"6. Self-hosting replaces...        $s6/10  (oodac_pure_build executable: $selfhost)\"; "
        + "multi_ok=0; "
        + "if [ -f oodac/docs/llvm-rustc-bar.oot ] && grep -q 'R7 (Declare 10/10): DONE' oodac/docs/llvm-rustc-bar.oot && grep -q 'Geometric mean ratio <= 1.00' oodac/docs/llvm-rustc-bar.oot && [ -f oodac/tests/e2e/test_track1_runner.log ] && grep -q 'ALL TRACK 1 SUITES GREEN' oodac/tests/e2e/test_track1_runner.log && grep -q 'Passed Test Suites        : 14' oodac/tests/e2e/test_track1_runner.log; then multi_ok=1; fi; "
        + "s7=$(( multi_ok == 1 ? 10 : 3 )); "
        + "echo \"7. Multi-target replaces...        $s7/10  (Track 1 LLVM lowering certified: $multi_ok)\"; "
        + "card_ok=0; "
        + "[ -f openOODA/scripts/target_scorecard.oot ] && card_ok=1; "
        + "s8=$(( card_ok == 1 ? 6 : 0 )); "
        + "echo \"8. Per-target 10/10 scores         $s8/10  (scorecard + driver present: $card_ok)\"; "
        + "headline=$(( (s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8) * 10 / 80 )); "
        + "echo; "
        + "echo \"Headline: $headline/10\"; "
        + "if [ \"$headline\" -lt 5 ]; then "
        + "  echo '[PROOF FAIL] headline below 5/10; release-blocked (rules.oot §1.17)'; "
        + "  exit 1; "
        + "fi; "
        + "echo '[PROOF OK] headline ≥ 5/10; release-permitted.'; "
        + "exit 0; ";
    let r: Result[String, String] = process_exec(p, cmd);
    let out: String = match r { Ok(s) => s, Err(e) => "ERR: " + e };
    print(out);
    if r.is_err() {
        return Err("proof of today failed");
    }
    return Ok(0);
}
