// # Purge audit debris
//
// Logline: Delete scratch, temporary C, and intermediate log leftovers under audit/ while keeping .oot files.
//
// Setup: SysCap granted to execute audit directory cleanup.
//
// Beats:
//   1. Remove legacy scratch and intermediate files in audit.
//   2. Preserve all .oot audit logs and specifications.
//   3. Report clean status.

pub fn main(sys: &SysCap) {
    let clean_cmd: String = "find audit -type f ! -name '*.oot' -exec rm -f {} + 2>/dev/null || true";
    let res = sys_exec(sys, "sh", "-c", clean_cmd);
    println("audit_clean: non-.oot audit debris purged.");
}
