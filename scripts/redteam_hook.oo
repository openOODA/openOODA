// # Red Team Continuous Adversarial Pre-Commit Verification Hook
//
// Logline: Run the 8 Red Team falsification gates fail-closed, then run the
// 9th structural-integrity gate that actually probes the source tree for the
// post-audit invariants (32-byte SIMD prologue, TRAP_0x20 alignment check,
// branchless ct_primitives, Landlock-fallback deletion). The 9th gate is
// real — it is a falsifiable source-lint probe and the master release
// verifier. A failure on either vetoes the hook even if the 8 synthetic
// gates all reported "PASS".
//
// Setup: SysCap granted to execute bin/ooda tests from the canonical repo root.
//
// Beats:
//   1. Use OODA_REPO_ROOT for the repo root; no parent traversal.
//   2. Run each Red Team test via ooda/bin/ooda and fail closed on any veto.
//   3. Run the 9th structural-integrity gate (real probes).
//   4. Print a neutral summary on success.

pub fn main(sys: &SysCap) {
    let script_cmd: String = "set -e; "
        + "root=\"${OODA_REPO_ROOT:-.}\"; "
        + "if [ ! -d \"$root/openOODA\" ] || [ ! -d \"$root/ooda\" ]; then echo \"[ROOT FAIL] missing openOODA or ooda\"; exit 1; fi; "
        + "cd \"$root\"; OODA=\"$root/ooda/bin/ooda\"; "
        + "if [ ! -x \"$OODA\" ]; then echo \"ERR	redteam	$OODA not executable\"; exit 1; fi; "
        + "export OODA_FS_READDIR=\"$root\"; "
        + "echo '=== Red Team pre-commit gates ==='; "
        + "\"$OODA\" run ooda/qa/tests_challenger_1/test_c1_red1_red2_falsification.oo; "
        + "(cd ooda && \"$OODA\" run scripts/hip_red1_keyword_trap_smoke.oo); "
        + "(cd ooda && \"$OODA\" run scripts/math_red1_heuristic_smoke.oo); "
        + "\"$OODA\" run ooda/qa/tests_challenger_2/test_c2_red3_red4_falsification.oo; "
        + "(cd ooda && \"$OODA\" run scripts/std_red3_datapath_smoke.oo); "
        + "(cd ooda && \"$OODA\" run scripts/std_red4_hermetic_smoke.oo); "
        + "\"$OODA\" run ooda/qa/tests_challenger_3/test_c3_red5_temporal_saboteur.oo; "
        + "\"$OODA\" run ooda/qa/tests_challenger_3/test_c3_red6_drag_assassin.oo; "
        + "\"$OODA\" run ooda/qa/tests_challenger_4/test_c4_red7_semantic_subverter.oo; "
        + "\"$OODA\" run ooda/qa/tests_challenger_4/test_c4_red8_byzantine_infiltrator.oo; "
        + "echo '=== 9th Gate: Structural Integrity (real probes) ==='; "
        + "\"$OODA\" run ooda/qa/prove/simd_codegen_probe.oo; "
        + "\"$OODA\" run ooda/qa/prove/ct_primitives_smoke.oo; "
        + "\"$OODA\" run ooda/qa/prove/dudect_real.oo; "
        + "\"$OODA\" run ooda/qa/prove/master_release_verifier.oo; "
        + "echo 'redteam_hook: OK';";

    let res = sys_exec(sys, "sh", "-c", script_cmd);
    match res {
        Ok(out) => { println(out); },
        Err(e) => { println("RED TEAM VETO: " + e); process_exit(1); }
    }
}
