// # redteam_orchestrate.oo — 8-D Red Team Polyrepo Orchestrator
//
// Logline: Run the 8-D Red Team across the polyrepo. Each of the
//          8 dimensions probes a different moonshot claim. The
//          orchestrator fails closed if any single dimension's
//          gate returns non-zero.
//
// Setup: Pure structural file. Run from the polyrepo root with
//        ProcessCap. The 8 dimensions come from
//        practices/8d-red-team.oot. This orchestrator is the
//        mechanism — the practice defines what each dimension
//        means; this file wires them to actual probes.
//
// Beats:
//   1. D1 Capability fence: oodar/sec/cap/cap_table.json parses with 26 slots.
//   2. D2 Contract proof: oodac/check/smt/ exists and contains at least one .oo harness.
//   3. D3 Reproducible build: at least 1 consumer ci.yml pins the auto-release reusable.
//   4. D4 Double-run: the blackbox-gate CI job is present in ≥ 1 consumer ci.yml.
//   5. D5 Self-host: oodac/bootstrap/oodac_pure_build exists, executable, and is a host script.
//   6. D6 Multi-target: oodac/emit/ contains c/ and llvm/ as a minimum floor.
//   7. D7 Honesty: every RFC Implemented-claim cites a code path; the audit script passes.
//   8. D8 Scorecard: openOODA/scripts/moonshot_scorecard.oot exists and is current.
//   9. Print per-dimension verdict; exit 1 if any FAIL.

pub fn main(p: &ProcessCap) {
    let cmd: String = "src_root=\"${OODA_REPO_ROOT:-}\"; "
        + "if [ -z \"$src_root\" ] || [ \"$src_root\" = \".\" ] || case \"$src_root\" in /*) false ;; *) true ;; esac || case \"$src_root\" in *..*) true ;; *) false ;; esac; then "
        + "echo '[REDTEAM FAIL] OODA_REPO_ROOT must be set to an absolute path free of ..'; exit 1; fi; "
        + "cd \"$src_root\" 2>/dev/null || { echo '[REDTEAM FAIL] cannot cd to '$src_root; exit 1; }; "
        + "fails=0; total=0; "
        + "echo '=== redteam_orchestrate (8-D Red Team) ==='; "
        + "total=$((total + 1)); "
        + "slots=$(python3 -c 'import json,sys; print(len(json.load(open(\"oodar/sec/cap/cap_table.json\"))))' 2>/dev/null || echo 0); "
        + "if [ \"$slots\" -lt 20 ]; then fails=$((fails + 1)); echo \"  FAIL D1: cap_table slots=$slots (need ≥ 20, RULES §1.18)\"; else echo \"  PASS D1: cap_table slots=$slots\"; fi; "
        + "total=$((total + 1)); "
        + "smt_harnesses=$(find oodac/check/smt -name '*.oo' -type f 2>/dev/null | wc -l); "
        + "if [ \"$smt_harnesses\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D2: SMT harness count=$smt_harnesses (need ≥ 1, RFC 0002)\"; else echo \"  PASS D2: SMT harnesses=$smt_harnesses\"; fi; "
        + "total=$((total + 1)); "
        + "pinned=0; "
        + "for r in oodar ooda opm install mcp lsp catalog blackbox website; do "
        + "  if grep -qE 'uses: openOODA/openOODA/\\.github/workflows/auto-release\.yml@[^m]' $r/.github/workflows/ci.yml 2>/dev/null; then pinned=$((pinned + 1)); fi; "
        + "done; "
        + "if [ \"$pinned\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D3: zero consumer ci.yml pin a non-main tag (need ≥ 1, RFC 0006 §4)\"; else echo \"  PASS D3: pinned consumers=$pinned/9\"; fi; "
        + "total=$((total + 1)); "
        + "gated=0; "
        + "for r in oodar ooda opm install mcp lsp catalog blackbox website; do "
        + "  if grep -q 'blackbox-gate:' $r/.github/workflows/ci.yml 2>/dev/null; then gated=$((gated + 1)); fi; "
        + "done; "
        + "if [ \"$gated\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D4: zero consumer ci.yml has blackbox-gate (need ≥ 1, RULES §1.10)\"; else echo \"  PASS D4: blackbox-gated consumers=$gated/9\"; fi; "
        + "total=$((total + 1)); "
        + "if [ ! -x oodac/bootstrap/oodac_pure_build ]; then fails=$((fails + 1)); echo \"  FAIL D5: oodac_pure_build not executable\"; else echo \"  PASS D5: oodac_pure_build executable\"; fi; "
        + "total=$((total + 1)); "
        + "backends=0; "
        + "for be in c llvm; do [ -d oodac/emit/$be ] && backends=$((backends + 1)); done; "
        + "if [ \"$backends\" -lt 2 ]; then fails=$((fails + 1)); echo \"  FAIL D6: emit/ floor=$backends (need ≥ 2, c + llvm)\"; else echo \"  PASS D6: emit/ backends=$backends (c + llvm)\"; fi; "
        + "total=$((total + 1)); "
        + "if [ ! -f openOODA/scripts/governance_verify.oo ]; then fails=$((fails + 1)); echo \"  FAIL D7: governance_verify.oo missing\"; else echo \"  PASS D7: governance_verify.oo present (run separately)\"; fi; "
        + "total=$((total + 1)); "
        + "if [ ! -f openOODA/scripts/moonshot_scorecard.oot ]; then fails=$((fails + 1)); echo \"  FAIL D8: moonshot_scorecard.oot missing (NORTHSHOT 8th line)\"; else echo \"  PASS D8: moonshot_scorecard.oot present\"; fi; "
        + "echo; "
        + "echo \"Dimensions: $total  Fails: $fails\"; "
        + "if [ \"$fails\" -gt 0 ]; then echo '[REDTEAM FAIL]'; exit 1; fi; "
        + "echo '[REDTEAM OK]'; exit 0;";
    return p.exec(cmd);
}
