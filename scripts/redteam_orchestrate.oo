// # redteam_orchestrate.oo — 7 Automated Governance Gates (8-Axis Red Team Support)
//
// Logline: Run 7 automated structural gates across the polyrepo.
//          These gates are tripwires supporting the 8-axis Red Team
//          doctrine (practices/8d-red-team.oot) — they are NOT the
//          Red Team itself. The orchestrator fails closed if any
//          single gate returns non-zero.
//
// Setup: Pure structural file. Run from the polyrepo root with
//        ProcessCap. The 8 axes (e1-e8) define the adversarial
//        doctrine (manual audit); the 7 gates below automate only
//        structural pre-checks. Coverage: D1->e4, D2->e7, D3+D4+D5
//        ->e5 (all partial); D6 is backend hygiene (no axis); D7
//        ->e7 via governance_verify. NO gate covers e1, e2, e3,
//        e6, e8 — those axes stay manual per the practice.
//
// Beats:
//   1. D1 Capability fence: cap_table.json parses with >= 20 slots (RULES 1.18; 26 tokens total, 20 implemented).
//   2. D2 Contract proof: oodac/check/ contains SMT modules (>= 1 smt_*.oo tripwire).
//   3. D3 Reproducible build: >= 1 consumer ci.yml pins auto-release to a tag, not floating master (RFC 0006 4).
//   4. D4 Double-run: the blackbox-gate CI job is present in >= 1 consumer ci.yml (RULES 1.10).
//   5. D5 Self-host: oodac_pure_build exists, is executable, and has a #! host-script header.
//   6. D6 Multi-target: oodac/emit/ contains llvm/, elf/, and wasm/ (floor of 3).
//   7. D7 Honesty: governance_verify.oo present; CI runs it separately to cite Implemented-claims.
//   8. Print per-gate verdict; exit 1 on any FAIL.

import "std/fs/process/process.oo";

pub fn main(p: &ProcessCap) -> Result[Int, String] {
    let cmd: String = "src_root=\"${OODA_REPO_ROOT:-$(pwd)}\"; "
        + "if [ -z \"$src_root\" ] || [ \"$src_root\" = \".\" ] || case \"$src_root\" in /*) false ;; *) true ;; esac || case \"$src_root\" in *..*) true ;; *) false ;; esac; then "
        + "echo '[REDTEAM FAIL] OODA_REPO_ROOT must be set to an absolute path free of ..'; exit 1; fi; "
        + "cd \"$src_root\" || { echo '[REDTEAM FAIL] cannot cd to '$src_root; exit 1; }; "
        + "fails=0; total=0; "
        + "echo '=== redteam_orchestrate (7 automated gates; 8-axis doctrine is manual) ==='; "
        + "total=$((total + 1)); "
        + "slots=$(python3 -c 'import json,sys; print(len(json.load(open(\"oodar/sec/cap/cap_table.json\")).get(\"caps\", [])))' || echo 0); "
        + "if [ \"$slots\" -lt 20 ]; then fails=$((fails + 1)); echo \"  FAIL D1: cap_table slots=$slots (need ≥ 20, RULES §1.18)\"; else echo \"  PASS D1: cap_table slots=$slots\"; fi; "
        + "total=$((total + 1)); "
        + "smt_harnesses=$(find oodac/check -name 'smt_*.oo' -type f | wc -l); "
        + "if [ \"$smt_harnesses\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D2: SMT harness count=$smt_harnesses (need ≥ 1, RFC 0002)\"; else echo \"  PASS D2: SMT harnesses=$smt_harnesses\"; fi; "
        + "total=$((total + 1)); "
        + "pinned=0; "
        + "for r in oodar ooda opm install mcp lsp catalog bb website cli tui std oodac; do "
        + "  if grep -qE 'uses: openOODA/openOODA/\\.github/workflows/auto-release\.yml@[^m]' $r/.github/workflows/ci.yml; then pinned=$((pinned + 1)); fi; "
        + "done; "
        + "if [ \"$pinned\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D3: zero consumer ci.yml pin a tag (need >= 1, RFC 0006 s4)\"; else echo \"  PASS D3: pinned consumers=$pinned/13\"; fi; "
        + "total=$((total + 1)); "
        + "gated=0; "
        + "for r in oodar ooda opm install mcp lsp catalog bb website cli tui std oodac; do "
        + "  if grep -qE '(blackbox|bb)-gate:' $r/.github/workflows/ci.yml; then gated=$((gated + 1)); fi; "
        + "done; "
        + "if [ \"$gated\" -lt 1 ]; then fails=$((fails + 1)); echo \"  FAIL D4: zero consumer ci.yml has blackbox-gate (need >= 1, RULES s1.10)\"; else echo \"  PASS D4: blackbox-gated consumers=$gated/13\"; fi; "
        + "total=$((total + 1)); "
        + "if [ ! -x oodac/bootstrap/oodac_pure_build ]; then fails=$((fails + 1)); echo \"  FAIL D5: oodac_pure_build not executable\"; elif ! head -1 oodac/bootstrap/oodac_pure_build | grep -q \"^#!/\"; then fails=$((fails + 1)); echo \"  FAIL D5: oodac_pure_build has no host-script header\"; else echo \"  PASS D5: oodac_pure_build executable host script\"; fi; "
        + "total=$((total + 1)); "
        + "backends=0; "
        + "for be in llvm elf wasm; do [ -d oodac/emit/$be ] && backends=$((backends + 1)); done; "
        + "if [ \"$backends\" -lt 3 ]; then fails=$((fails + 1)); echo \"  FAIL D6: emit/ floor=$backends (need 3: llvm + elf + wasm)\"; else echo \"  PASS D6: emit/ backends=$backends (llvm + elf + wasm)\"; fi; "
        + "total=$((total + 1)); "
        + "if [ ! -f openOODA/scripts/governance_verify.oo ]; then fails=$((fails + 1)); echo \"  FAIL D7: governance_verify.oo missing\"; else echo \"  PASS D7: governance_verify.oo present (run separately)\"; fi; "
        + "echo; "
        + "echo \"Total gates: $total  Fails: $fails\"; "
        + "if [ \"$fails\" -gt 0 ]; then echo '[REDTEAM FAIL]'; exit 1; fi; "
        + "echo '[REDTEAM OK]'; exit 0;";
    let r: Result[String, String] = process_exec(p, cmd);
    let out: String = match r { Ok(s) => s, Err(e) => "ERR: " + e };
    print(out);
    if r.is_err() {
        return Err("redteam orchestrate failed");
    }
    return Ok(0);
}
