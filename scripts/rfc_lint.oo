// # RFC Linter — Fail-Closed Template Compliance
//
// Logline: Validate every rfcs/*.oot file against the 0000-template header and mandatory sections.
//
// Setup: Run from openOODA/ with ProcessCap.
//
// Beats:
//   1. Walk every rfcs/*.oot and parse RFC ID / Author / Status / Created.
//   2. Reject `Implemented` without Security + Testing sections.
//   3. Reject Status not in {Draft, Active, Accepted, Implemented}.
//   4. Print per-RFC verdict and exit non-zero on first violation.

pub fn main(p: &ProcessCap) {
    let cmd: String = "cd openOODA 2>/dev/null || cd /home/jeryd/Projects/openOODA/openOODA; "
        + "fails=0; total=0; "
        + "echo '=== RFC Lint ==='; "
        + "for f in rfcs/*.oot; do "
        + "  total=$((total + 1)); "
        + "  name=$(basename \"$f\"); "
        + "  if [ \"$f\" = \"rfcs/0000-template.oot\" ]; then echo \"$f OK (template, skipped)\"; continue; fi; "
        + "  status=$(printf '%s' \"$(cat \"$f\")\" | grep -oE 'Status\\*\\*: (Draft|Active|Accepted|Implemented)' | head -1 | sed 's/.*: //'); "
        + "  status=$(printf '%s' \"$(cat \"$f\")\" | grep -oE 'Status[*\\*]*:[ \\*]*(Draft|Active|Accepted|Implemented)' | head -1 | sed 's/.*[*: ][ *]*//'); "
        + "  sec=$(printf '%s' \"$(cat \"$f\")\" | grep -c 'Security'); "
        + "  tst=$(printf '%s' \"$(cat \"$f\")\" | grep -c 'Testing'); "
        + "  auth=$(printf '%s' \"$(cat \"$f\")\" | grep -cE 'Author[*\\*]*:[ \\*]*|Authors[*\\*]*:[ \\*]*'); "
        + "  rfc=$(printf '%s' \"$(cat \"$f\")\" | grep -cE 'RFC ID[*\\*]*:[ \\*]*'); "
        + "  echo \"$f status=[$status] rfc_id=$rfc author=$auth security=$sec testing=$tst\"; "
        + "  if [ \"$rfc\" -eq 0 ] || [ \"$auth\" -eq 0 ] || [ -z \"$status\" ]; then fails=$((fails + 1)); echo '  FAIL: missing header'; continue; fi; "
        + "  if [ \"$status\" = 'Implemented' ]; then "
        + "    if [ \"$sec\" -eq 0 ] || [ \"$tst\" -eq 0 ]; then fails=$((fails + 1)); echo '  FAIL: Implemented without Security & Testing'; continue; fi; "
        + "  fi; "
        + "  echo '  OK'; "
        + "done; "
        + "echo \"Total: $total Failed: $fails\"; "
        + "if [ \"$fails\" -gt 0 ]; then echo 'RFC lint FAILED'; exit 1; fi; "
        + "echo 'RFC lint OK'";

    let res = sys_exec(p, "sh", "-c", cmd);
    match res {
        Ok(out) => {
            println(out);
        },
        Err(e) => {
            println("rfc_lint error: " + e);
            process_exit(1);
        }
    }
}

