// # Proof of Today
//
// Logline: Run the SHIPPED.oot named lock list and print pass/fail per smoke today.
//
// Setup: ProcessCap to run smokes, EnvCap for env. Supports execution from root or ooda/.
//
// Beats:
//   1. Run individual smoke probes from the lock suite; classify by exit code.
//   2. Skip env-bound locks (aarch64, llvm, x86, gpu) and report them separately.
//   3. Print a rollup: passed, failed, skipped, total.
//   4. Exit cleanly on zero failures.

import "util_env.oo";

fn probe_lock(p: &ProcessCap, root: String, path: String, group: String, skip_reason: String) -> Int {
    if skip_reason != "" {
        println("SKIP  [" + group + "] " + path + "  ( " + skip_reason + " )");
        return 0;
    }
    let ooda_dir: String = root + "/ooda";
    let bin: String = ooda_dir + "/bin/ooda";
    let cmd: String = "cd '" + ooda_dir + "' && '" + bin + "' run '" + path + "'";
    let res: Result[String, String] = process_exec(p, cmd);
    if res.is_ok() {
        println("PASS  [" + group + "] " + path);
        return 1;
    }
    println("FAIL  [" + group + "] " + path);
    return 0 - 1;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, env: &EnvCap) {
    println("PROOF OF TODAY");
    let root: String = env_required_dir(fs, env, "OODA_REPO_ROOT");
    println("root: " + root);
    println("");

    let mut pass_count: Int = 0;
    let mut bad_count: Int = 0;
    let mut skipped: Int = 0;

    let mut r: Int = 0;
    // Compiler floor
    r = probe_lock(p, root, "scripts/smoke/c/line_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/c/line_ctrl_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/c/line_multi_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/c/line_secret_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/cross/bit_identical_emit_lock.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/c/if_expr_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/cross/for_expr_bound_smoke.oo", "compiler", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Caret diagnostics
    r = probe_lock(p, root, "scripts/cross/diag_caret_smoke.oo", "diags", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/cross/diag_path_smoke.oo", "diags", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/cross/type_caret_class_batch_smoke.oo", "diags", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Capability model
    r = probe_lock(p, root, "scripts/probe/hostile_cap_probe_smoke.oo", "caps", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // x402 / pay
    r = probe_lock(p, root, "scripts/cross/x402_parse_smoke.oo", "pay", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/cross/pay_handshakes_smoke.oo", "pay", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Standard library
    r = probe_lock(p, root, "scripts/std_kat/std_smoke.oo", "std", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/std_kat/std_product_honesty_smoke.oo", "std", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/std_kat/std_archive_smoke.oo", "std", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/std_kat/std_markup_smoke.oo", "std", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/std_kat/std_semver_smoke.oo", "std", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Sweeps
    r = probe_lock(p, root, "scripts/stage/stage31_mutation_sweep_smoke.oo", "sweeps", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/stage/stage32_cleanroom_airgap_smoke.oo", "sweeps", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/stage/stage50_release_lock_smoke.oo", "sweeps", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Native locks
    r = probe_lock(p, root, "scripts/smoke/wasm/hello_module_lock.oo", "wasm", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/x86/elf_hello_lock.oo", "x86", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/aarch64/hello_elf_lock.oo", "aarch64", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Lists
    r = probe_lock(p, root, "fixtures/list_first_prod.oo", "list", ""); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    // Env-bound side emits
    r = probe_lock(p, root, "scripts/smoke/gpu/emit_hello_lock.oo", "gpu", "needs gpu toolchain"); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/aarch64/hello_smoke.oo", "aarch64", "needs aarch64 host"); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/smoke/x86/hello_smoke.oo", "x86", "needs aarch64 toolchain"); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }
    r = probe_lock(p, root, "scripts/open_proofs/open68_cold_hello_smoke.oo", "llvm", "needs llvm toolchain"); if r == 1 { pass_count = pass_count + 1; } else if r == 0 { skipped = skipped + 1; } else { bad_count = bad_count + 1; }

    let total: Int = pass_count + bad_count + skipped;
    println("");
    println("TOTAL: " + total.to_string() + "  PASS: " + pass_count.to_string() + "  FAIL: " + bad_count.to_string() + "  SKIP: " + skipped.to_string());
    if bad_count > 0 {
        process_exit(1);
    }
    process_exit(0);
}
