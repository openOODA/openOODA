// # Language Specification Suite Automated QA Verification Harness
// Logline: Probes and asserts specification file invariants, bit-parity, and determinism.
// Setup: Requires &FsReadCap, &SysCap, &ProcessCap.
// Beats:
//   1. Validate file existence and line count ceiling (wc -l <= 256).
//   2. Validate 4-element Academy and 2-line Clean headers.
//   3. Assert bit-parity between 01_lexical.oot and oodac/types/token_typed.oo.
//   4. Assert bit-parity between 04_capabilities.oot and oodar/sec/cap/caps.h.
//   5. Execute double-run determinism verification (Run 1 == Run 2 == 0).

import "std/fs/process/process.oo";

pub fn main(fs: &FsReadCap, sys: &SysCap, p: &ProcessCap) -> Result[Int, String] {
    let cmd: String = "src_root=\"${OODA_REPO_ROOT:-$(pwd)}\"; "
        + "if [ -z \"$src_root\" ] || [ \"$src_root\" = \".\" ] || case \"$src_root\" in /*) false ;; *) true ;; esac || case \"$src_root\" in *..*) true ;; *) false ;; esac; then "
        + "printf 'ERR\\tenv\\tOODA_REPO_ROOT must be an absolute path free of ..\\n'; exit 2; fi; "
        + "cd \"$src_root\" || { printf 'ERR\\tfs\\tcannot cd to %s\\n' \"$src_root\"; exit 2; }; "
        + "run_pass() { "
        + "  local fails=0; "
        + "  local targets=("
        + "    'openOODA/spec.oot' "
        + "    'openOODA/docs/spec/anchor.oo' "
        + "    'openOODA/docs/spec/01_lexical.oot' "
        + "    'openOODA/docs/spec/02_grammar.oot' "
        + "    'openOODA/docs/spec/03_types.oot' "
        + "    'openOODA/docs/spec/04_capabilities.oot' "
        + "    'openOODA/docs/spec/05_contracts.oot' "
        + "    'openOODA/docs/spec/06_memory.oot' "
        + "    'openOODA/docs/spec/07_machine_wire.oot' "
        + "    'openOODA/docs/spec/08_runtime_abi.oot'"
        + "  ); "
        + "  for f in \"${targets[@]}\"; do "
        + "    if [ -f \"$f\" ]; then "
        + "      lines=$(wc -l < \"$f\"); "
        + "      if [ \"$lines\" -gt 256 ]; then "
        + "        printf 'ERR\\tloc\\t%s lines=%d exceeds 256 ceiling\\n' \"$f\" \"$lines\"; "
        + "        fails=$((fails + 1)); "
        + "      else "
        + "        printf 'OK\\tloc\\t%s lines=%d (<= 256)\\n' \"$f\" \"$lines\"; "
        + "      fi; "
        + "      case \"$f\" in "
        + "        *.oo) "
        + "          hdr=$(head -n 1 \"$f\"); "
        + "          if echo \"$hdr\" | grep -qE '^// # ' && grep -q 'Logline:' \"$f\" && grep -q 'Setup:' \"$f\" && grep -q 'Beats:' \"$f\"; then "
        + "            printf 'OK\\theader\\t%s valid 4-element Academy header\\n' \"$f\"; "
        + "          else "
        + "            printf 'ERR\\theader\\t%s malformed Academy header\\n' \"$f\"; "
        + "            fails=$((fails + 1)); "
        + "          fi; ;; "
        + "        *.oot) "
        + "          h1=$(sed -n '1p' \"$f\"); "
        + "          h2=$(sed -n '2p' \"$f\"); "
        + "          if echo \"$h1\" | grep -qE '^# ' && echo \"$h2\" | grep -qE '^File: openOODA/'; then "
        + "            printf 'OK\\theader\\t%s valid 2-line Clean header\\n' \"$f\"; "
        + "          else "
        + "            printf 'ERR\\theader\\t%s malformed Clean header\\n' \"$f\"; "
        + "            fails=$((fails + 1)); "
        + "          fi; ;; "
        + "      esac; "
        + "    else "
        + "      printf 'OK\\twait\\t%s pending milestone authoring\\n' \"$f\"; "
        + "    fi; "
        + "  done; "
        + "  tok_src='oodac/types/token_typed.oo'; "
        + "  if [ -f \"$tok_src\" ]; then "
        + "    tok_err=0; "
        + "    for tok in IDENT INT FLOAT STRING KW_FN KW_LET KW_PUB KW_MUT KW_IMPORT KW_REQUIRES KW_ENSURES KW_VERIFY KW_IF KW_ELSE KW_MATCH KW_FOR KW_IN KW_WHILE KW_RETURN KW_TYPE KW_TRUE KW_FALSE KW_GPU KW_BREAK KW_CONTINUE PLUS MINUS STAR SLASH EQEQ FATARROW EQ NEQ LSHIFT RSHIFT LTE LT GTE GT ANDAND AMP OROR PIPE CARET COLON SEMI COMMA DOTDOTEQ DOTDOT DOT LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET QUESTION AT BANG EOF; do "
        + "      if ! grep -q \"\\\"$tok\\\"\" \"$tok_src\"; then "
        + "        printf 'ERR\\tbit_parity\\t%s missing token mapping %s\\n' \"$tok_src\" \"$tok\"; "
        + "        tok_err=$((tok_err + 1)); "
        + "      fi; "
        + "    done; "
        + "    if [ \"$tok_err\" -eq 0 ]; then "
        + "      printf 'OK\\tbit_parity\\t%s 53 canonical tokens certified\\n' \"$tok_src\"; "
        + "    else "
        + "      fails=$((fails + tok_err)); "
        + "    fi; "
        + "    if [ -f 'openOODA/docs/spec/01_lexical.oot' ]; then "
        + "      if grep -q 'IDENT' 'openOODA/docs/spec/01_lexical.oot' && grep -q 'KW_FN' 'openOODA/docs/spec/01_lexical.oot' && grep -q 'FATARROW' 'openOODA/docs/spec/01_lexical.oot'; then "
        + "        printf 'OK\\tbit_parity\\t01_lexical.oot matches token_typed.oo\\n'; "
        + "      else "
        + "        printf 'ERR\\tbit_parity\\t01_lexical.oot token definitions incomplete\\n'; "
        + "        fails=$((fails + 1)); "
        + "      fi; "
        + "    fi; "
        + "  else "
        + "    printf 'ERR\\tbit_parity\\t%s not found\\n' \"$tok_src\"; "
        + "    fails=$((fails + 1)); "
        + "  fi; "
        + "  cap_src='oodar/sec/cap/caps.h'; "
        + "  if [ -f \"$cap_src\" ]; then "
        + "    cap_err=0; "
        + "    for cap in NET PROCESS FSWRITE FSREAD SYS FS TIME RAND ALLOC ARENA FFI METRICS SIGN TCP UDP BIND THREAD GPU ENV COMPILER_READ; do "
        + "      if ! grep -q \"OODAR_CAP_$cap\" \"$cap_src\"; then "
        + "        printf 'ERR\\tbit_parity\\t%s missing capability %s\\n' \"$cap_src\" \"$cap\"; "
        + "        cap_err=$((cap_err + 1)); "
        + "      fi; "
        + "    done; "
        + "    for dead in HITL SYNC MEM HTTP; do "
        + "      if ! grep -q \"OODAR_CAP_$dead\" \"$cap_src\"; then "
        + "        printf 'ERR\\tbit_parity\\t%s missing dead cap guard for %s\\n' \"$cap_src\" \"$dead\"; "
        + "        cap_err=$((cap_err + 1)); "
        + "      fi; "
        + "    done; "
        + "    if [ \"$cap_err\" -eq 0 ]; then "
        + "      printf 'OK\\tbit_parity\\t%s 20 normative caps + 4 dead guards certified\\n' \"$cap_src\"; "
        + "    else "
        + "      fails=$((fails + cap_err)); "
        + "    fi; "
        + "    if [ -f 'openOODA/docs/spec/04_capabilities.oot' ]; then "
        + "      if grep -q 'FsReadCap' 'openOODA/docs/spec/04_capabilities.oot' && grep -q 'NetCap' 'openOODA/docs/spec/04_capabilities.oot' && grep -q 'CompilerReadCap' 'openOODA/docs/spec/04_capabilities.oot'; then "
        + "        printf 'OK\\tbit_parity\\t04_capabilities.oot matches caps.h\\n'; "
        + "      else "
        + "        printf 'ERR\\tbit_parity\\t04_capabilities.oot capability definitions incomplete\\n'; "
        + "        fails=$((fails + 1)); "
        + "      fi; "
        + "    fi; "
        + "  else "
        + "    printf 'ERR\\tbit_parity\\t%s not found\\n' \"$cap_src\"; "
        + "    fails=$((fails + 1)); "
        + "  fi; "
        + "  return $fails; "
        + "}; "
        + "printf '=== spec_verify pass 1 ===\\n'; "
        + "run_pass; "
        + "r1_code=$?; "
        + "printf '=== spec_verify pass 2 ===\\n'; "
        + "run_pass; "
        + "r2_code=$?; "
        + "if [ \"$r1_code\" -ne \"$r2_code\" ]; then "
        + "  printf 'ERR\\tdeterminism\\tRun 1 (%d) != Run 2 (%d)\\n' \"$r1_code\" \"$r2_code\"; "
        + "  exit 1; "
        + "fi; "
        + "if [ \"$r1_code\" -ne 0 ]; then "
        + "  printf 'ERR\\tsuite\\tspecification suite verification failed (errors: %d)\\n' \"$r1_code\"; "
        + "  exit 1; "
        + "fi; "
        + "printf 'OK\\tdeterminism\\tRun 1 == Run 2 == 0 bit-identical clean pass\\n'; "
        + "printf 'OK\\tsuite\\tall specification suite invariants certified\\n'; "
        + "exit 0;";
    let r: Result[String, String] = process_exec(p, cmd);
    let out: String = match r { Ok(s) => s, Err(e) => e };
    print(out);
    if r.is_err() {
        process_exit(1);
        return Err("specification verification failed");
    }
    return Ok(0);
}
