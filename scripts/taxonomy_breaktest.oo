// # Generational Drift Breaktest
//
// Logline: Negative-trust regression test that fails if the public generational taxonomy or version pins drift.
//
// Setup: ProcessCap runs grep; reads project pkg version.
//
// Beats:
//   1. Assert no public .oot claims only Gen 1 to Gen 6.
//   2. Assert no stale v2.6.5 pins remain on public surfaces.
//   3. Assert templates and SSG JSON-LD match project pkg version.
//
// Exit 0 = no drift. Exit 1 = drift detected.

import "util_env.oo";

fn cmd_found(p: &ProcessCap, cmd: String) -> Bool {
    return process_exec(p, cmd).is_ok();
}

fn fail(msg: String) {
    println("DRIFT FAIL: " + msg);
    process_exit(1);
}

fn extract_version(t: String) -> String {
    let marker: String = "version =";
    let mlen: Int = chars_len(marker);
    let n: Int = chars_len(t);
    let mut i: Int = 0;
    while i <= n - mlen {
        if str_slice(t, i, i + mlen) == marker {
            let mut j: Int = i + mlen;
            while j < n && char_at(t, j) == " " { j = j + 1; }
            let mut k: Int = j;
            while k < n && char_at(t, k) != "\n" { k = k + 1; }
            return str_slice(t, j, k);
        }
        i = i + 1;
    }
    return "";
}

fn pkg_version(fs: &FsReadCap, path: String) -> String {
    if !path_exists(fs, path) { fail("pkg missing: " + path); }
    let r: Result[String, String] = read_file(fs, path);
    if r.is_err() { fail("cannot read " + path); }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let ver: String = strip(extract_version(raw));
    if ver == "" { fail("empty pkg version"); }
    if str_slice(ver, 0, 1) != "v" { return "v" + ver; }
    return ver;
}

fn strip(s: String) -> String {
    let mut n: Int = chars_len(s);
    while n > 0 && (str_slice(s, n - 1, n) == "\n" || str_slice(s, n - 1, n) == "\r") {
        n = n - 1;
        s = str_slice(s, 0, n);
    }
    return s;
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, env: &EnvCap) {
    let root: String = env_required_dir(fs, env, "OODA_REPO_ROOT");

    let pkg_ver: String = pkg_version(fs, root + "/openOODA/ooda.pkg");

    // 1. No public .oot should regress to a Gen 1-6 model (allow Gen 1-4, 5-7, 1-7, but not 1-6).
    if cmd_found(p, "grep -rIE 'Gen 1[^0-9]*[-–][^0-9]*6($|[^0-9])' " + root + "/openOODA.github.io/guide/*.oot " + root + "/openOODA/QUICKREF.oot " + root + "/openOODA/CONSTRAINTS.oot " + root + "/openOODA/NORTHSTAR.oot " + root + "/openOODA/STRUCTURE_EM.oot") {
        fail("public generation count regressed to Gen 1-6");
        return;
    }

    // 2. Stale v2.6.5 must not reappear in public .oot or templates.
    if cmd_found(p, "grep -rIE 'v2\.6\.5' " + root + "/openOODA.github.io/guide/QuickRef.oot " + root + "/openOODA.github.io/guide/Std.oot " + root + "/openOODA.github.io/templates/shell.html") {
        fail("stale v2.6.5 pin in public surface");
        return;
    }

    // 3. SSG JSON-LD must match the canonical product pkg version.
    let routes_path: String = root + "/openOODA/scripts/site_routes.oo";
    let routes_r: Result[String, String] = read_file(fs, routes_path);
    if routes_r.is_err() { fail("cannot read site_routes.oo"); }
    let routes_text: String = match routes_r { Ok(s) => s, Err(_) => "" };
    if !str_contains(routes_text, pkg_ver) {
        fail("site_routes.oo JSON-LD version does not match " + pkg_ver);
        return;
    }

    println("OK\ttaxonomy_breaktest\tversion=" + pkg_ver + "\tgenerations=Gen 1-7 (Gen 8 unknowable)");
}