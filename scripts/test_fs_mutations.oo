// # Board FS mutation smoke
//
// Logline: Mkdir, write, and remove a temp file from the openOODA scripts tree.
//
// Setup: SysCap granted for file creation and removal smoke test.
//
// Beats:
//   1. Make a scratch directory.
//   2. Write a test file into it.
//   3. Remove the file and directory.

pub fn main(sys: &SysCap) {
    let script_cmd = "set -e; "
        + "scratch=\".ooda-cache/ooda-tmp/test_fs_mut_dir\"; "
        + "mkdir -p \"$scratch\"; "
        + "printf 'test' > \"$scratch/file.txt\"; "
        + "test -f \"$scratch/file.txt\"; "
        + "rm -rf \"$scratch\"; "
        + "echo \"fs_mutations: OK\"";

    let res = sys_exec(sys, "sh", "-c", script_cmd);
    match res {
        Ok(out) => {
            println(out);
        },
        Err(e) => {
            println("FAIL: " + e);
            process_exit(1);
        }
    }
}
