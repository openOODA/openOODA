// # Environment Variable Validation Utilities
//
// Logline: Fail-closed helpers for reading required environment tokens and validating absolute directory paths.
//
// Setup: &EnvCap to read keys; &FsReadCap to verify directory existence. No fallback values are provided.
//
// Beats:
//   1. env_required: return the exact value of a mandatory env var or exit.
//   2. env_required_dir: validate the value is an absolute path free of traversal and shell metacharacters and is an existing directory.
//   3. env_required_path: validate the value is an absolute path free of traversal and shell metacharacters and exists on disk.

fn has_shell_metachar(s: String) -> Bool {
  let n: Int = chars_len(s);
  let mut i: Int = 0;
  while i < n {
    let c: String = str_slice(s, i, i + 1);
    if c == ";" || c == "|" || c == "$" || c == "`" || c == "&" || c == "<" || c == ">" || c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]" || c == "*" || c == "?" || c == "\"" || c == "'" || c == "\\" || c == "\n" || c == " " || c == "\t" || c == "~" || c == "#" || c == "!" {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub fn env_required(env: &EnvCap, key: String) -> String {
  let r: Result[String, String] = env_get(env, key);
  match r {
    Ok(v) => {
      if chars_len(v) == 0 {
        println("FAIL " + key + " is empty");
        process_exit(1);
      }
      return v;
    },
    Err(_) => {
      println("FAIL " + key + " is unset");
      process_exit(1);
    }
  }
  return "";
}

pub fn env_required_path(fs: &FsReadCap, env: &EnvCap, key: String) -> String {
  let v: String = env_required(env, key);
  if !str_starts_with(v, "/") {
    println("FAIL " + key + " is not an absolute path: " + v);
    process_exit(1);
  }
  if str_contains(v, "..") {
    println("FAIL " + key + " contains path traversal: " + v);
    process_exit(1);
  }
  if has_shell_metachar(v) {
    println("FAIL " + key + " contains shell metacharacters: " + v);
    process_exit(1);
  }
  if !path_exists(fs, v) {
    println("FAIL " + key + " does not exist: " + v);
    process_exit(1);
  }
  return v;
}

pub fn env_required_dir(fs: &FsReadCap, env: &EnvCap, key: String) -> String {
  let v: String = env_required_path(fs, env, key);
  if !oo_fs_is_dir(fs, v) {
    println("FAIL " + key + " is not a directory: " + v);
    process_exit(1);
  }
  return v;
}
