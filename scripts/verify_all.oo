// # Verify all standard modules
//
// Logline: Find standard library modules, run oodac check on each, and report results.
//
// Setup: SysCap granted to run oodac check on standard library modules.
//
// Beats:
//   1. Locate standard library .oo modules.
//   2. Run oodac check against each module.
//   3. Tally failures and report clean status.

pub fn main(sys: &SysCap) {
    let check_cmd: String = "set -e; fails=0; total=0; "
        + "oodac_cmd=\"oodac\"; "
        + "if command -v oodac >/dev/null 2>&1; then oodac_cmd=\"oodac\"; elif [ -x \"../ooda/oodac/oodac\" ]; then oodac_cmd=\"../ooda/oodac/oodac\"; fi; "
        + "for f in $(find ../ooda/std ../std ooda/std -type f -name '*.oo' 2>/dev/null | sort -u); do "
        + "  total=$((total + 1)); "
        + "  if ! $oodac_cmd check \"$f\" >/dev/null 2>&1; then "
        + "    echo \"Fail: $f\"; fails=$((fails + 1)); "
        + "  fi; "
        + "done; "
        + "echo \"Checked $total files. Failed: $fails\"; "
        + "if [ \"$fails\" -gt 0 ]; then exit 1; fi";

    let res = sys_exec(sys, "sh", "-c", check_cmd);
    match res {
        Ok(out) => {
            println(out);
        },
        Err(e) => {
            println("Error: " + e);
            process_exit(1);
        }
    }
}
