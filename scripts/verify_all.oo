// # Verify all — SHIPPED freshness + RFC lint
//
// Logline: Validate SHIPPED freshness and run rfc_lint fail-closed.
//
// Setup: SysCap granted to invoke rfc_lint via ooda/bin/ooda. Root is OODA_REPO_ROOT.
//
// Beats:
//   1. Use OODA_REPO_ROOT for canonical root; no parent traversal.
//   2. Verify 13 canonical boards and SHIPPED.oot generated marker + line count.
//   3. Run scripts/rfc_lint.oo and confirm "RFC lint OK".
//   4. Print summary and fail closed on any regression.

pub fn main(sys: &SysCap) {
    let check_cmd: String = "set -e; "
        + "root=\"${OODA_REPO_ROOT:-.}\"; ws_root=\"$(cd \"$root\" 2>/dev/null && pwd || echo \"$root\")\"; src_root=\"$ws_root/openOODA\"; "
        + "if [ ! -d \"$src_root\" ]; then echo \"[ROOT FAIL] $src_root missing\"; exit 1; fi; "
        + "cd \"$src_root\"; fails=0; "
        + "echo '=== Boards (13 canonical) ==='; "
        + "for b in START.oot RULES.oot NORTHSTAR.oot MOONSHOTS.oot ROADMAP.oot SHIPPED.oot FORMAT.oot SECURITY.oot WORKFLOW.oot QUICKREF.oot CONSTRAINTS.oot STRUCTURE_EM.oot REDTEAM.oot; do "
        + "  if [ -f \"$b\" ]; then echo \"  $b OK\"; else echo \"  $b MISSING\"; fails=$((fails + 1)); fi; "
        + "done; "
        + "if [ ! -f \"SHIPPED.oot\" ]; then echo \"FAIL: SHIPPED.oot missing\"; fails=$((fails + 1)); else "
        + "  if ! grep -q 'THIS FILE IS GENERATED' \"SHIPPED.oot\"; then echo \"FAIL: SHIPPED.oot stale\"; fails=$((fails + 1)); fi; "
        + "  lc=$(wc -l < \"SHIPPED.oot\" | tr -d ' '); if [ \"$lc\" -gt 256 ]; then echo \"FAIL: SHIPPED.oot $lc lines > 256\"; fails=$((fails + 1)); else echo \"SHIPPED.oot OK: $lc lines\"; fi; "
        + "fi; "
        + "if [ ! -f \"scripts/rfc_lint.oo\" ]; then echo \"FAIL: scripts/rfc_lint.oo missing\"; fails=$((fails + 1)); fi; "
        + "if [ ! -f \"rfcs/0000-template.oot\" ]; then echo \"FAIL: rfcs/0000-template.oot missing\"; fails=$((fails + 1)); fi; "
        + "bin=\"$ws_root/ooda/bin/ooda\"; "
        + "if [ ! -x \"$bin\" ]; then echo \"FAIL: $bin missing\"; fails=$((fails + 1)); else "
        + "  if ! (cd \"$ws_root\" && timeout 60 \"$bin\" run \"openOODA/scripts/rfc_lint.oo\") > \".rfc_lint.out\" 2>&1; then "
        + "    echo \"FAIL: rfc_lint did not run\"; cat \".rfc_lint.out\"; fails=$((fails + 1)); "
        + "  elif ! grep -qE 'RFC lint OK' \".rfc_lint.out\"; then "
        + "    echo \"FAIL: rfc_lint did not OK\"; cat \".rfc_lint.out\"; fails=$((fails + 1)); "
        + "  else echo \"rfc_lint OK\"; fi; "
        + "fi; "
        + "rm -f \".rfc_lint.out\"; "
        + "if [ \"$fails\" -eq 0 ]; then echo \"verify_all passed\"; exit 0; else echo \"FAILED: $fails regression(s)\"; exit 1; fi";

    let res = sys_exec(sys, "sh", "-c", check_cmd);
    match res {
        Ok(out) => { println(out); },
        Err(e) => { println("Error: " + e); process_exit(1); }
    }
}
