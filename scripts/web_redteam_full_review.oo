// # Web Red Team Full Review
//
// Logline: Executes comprehensive adversarial analysis of openOODA public web surface.
//
// Setup: SysCap granted to execute full 4-gate security review on openOODA.github.io.
//
// Beats:
//   1. Enumerate web surface files, HTML pages, and JavaScript assets.
//   2. Validate Gate 1 Heuristic Hunter scheme whitelist and regex usage.
//   3. Validate Gate 2 Boundary Falsifier form validation and routing state.
//   4. Validate Gate 3 Data-Path Tracer error logging and WASM instantiation.
//   5. Validate Gate 4 Hermetic Jailor CSP, framing, install URLs, and origin security.

pub fn main(sys: &SysCap) {
    let check_cmd: String = "set -euo pipefail; "
        + "src_root=\".\"; "
        + "if [ -d \"openOODA.github.io\" ]; then src_root=\".\"; "
        + "elif [ -d \"../openOODA.github.io\" ]; then src_root=\"..\"; "
        + "elif [ -d \"../../openOODA.github.io\" ]; then src_root=\"../..\"; "
        + "else n=0; d=\".\"; while [ $n -lt 6 ]; do if [ -d \"$d/openOODA.github.io\" ]; then src_root=\"$d\"; break; fi; d=\"$d/..\"; n=$((n+1)); done; fi; "
        + "cd \"$src_root\" 2>/dev/null || true; "
        + "WEBROOT=\"openOODA.github.io\"; "
        + "echo '=== REDTEAM FULL WEB REVIEW ==='; "
        + "echo 'Methodology: First Principles, Negative Trust, Adversarial Testing, 4-Gate Protocol'; "
        + "echo ''; "
        + "fail=0; warning=0; "
        + "echo '0. Web Surface Enumeration'; "
        + "echo \"   Files examined: $(find \"$WEBROOT\" -type f \\( -name '*.html' -o -name '*.js' -o -name '*.oot' \\) | wc -l)\"; "
        + "echo \"   HTML pages: $(find \"$WEBROOT\" -type f -name '*.html' | wc -l)\"; "
        + "echo \"   JS files: $(find \"$WEBROOT\" -type f -name '*.js' | wc -l)\"; "
        + "echo ''; "
        + "echo '================================'; "
        + "echo 'Gate 1: Heuristic Hunter'; "
        + "echo '================================'; "
        + "echo 'Objective: Find string matching, token bags, and heuristics used for security decisions'; "
        + "echo ''; "
        + "echo 'Checking for security-relevant string matching in app.js...'; "
        + "if grep -q 'isExternalUrl\\|allowedSchemes' \"$WEBROOT/app.js\"; then "
        + "  echo 'OK: app.js now uses explicit allowed-scheme whitelist for external links'; "
        + "else "
        + "  echo 'WARNING: app.js may still use string heuristics for URL validation'; "
        + "  fail=$((fail + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for regex heuristics on user inputs...'; "
        + "if grep -qE '\\.test\\(.*\\)|\\.search\\(.*\\)|match\\(' \"$WEBROOT/app.js\"; then "
        + "  echo 'INFO: Regex/string matching found in app.js'; "
        + "  warning=$((warning + 1)); "
        + "  grep -nE '\\.test\\(.*\\)|\\.search\\(.*\\)|match\\(' \"$WEBROOT/app.js\" | head -5 || true; "
        + "else "
        + "  echo 'OK: No obvious regex/string matching on user inputs'; "
        + "fi; "
        + "echo ''; "
        + "echo '================================'; "
        + "echo 'Gate 2: Boundary Falsifier'; "
        + "echo '================================'; "
        + "echo 'Objective: Find boundary violations, unvalidated inputs, oversized parameters'; "
        + "echo ''; "
        + "echo 'Checking for input validation on email form...'; "
        + "if grep -q 'type=\"email\"' \"$WEBROOT/index.html\" && grep -q 'required' \"$WEBROOT/index.html\"; then "
        + "  echo 'OK: Email form has type and required validation'; "
        + "else "
        + "  echo 'WARNING: Email form lacks validation'; "
        + "  fail=$((fail + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for path traversal in routing...'; "
        + "if grep -q 'location.pathname' \"$WEBROOT/app.js\"; then "
        + "  echo 'NOTE: app.js uses location.pathname for routing'; "
        + "  warning=$((warning + 1)); "
        + "  grep -n 'location.pathname' \"$WEBROOT/app.js\" | head -5 || true; "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for localStorage without validation...'; "
        + "if grep -q 'localStorage' \"$WEBROOT/app.js\"; then "
        + "  echo 'INFO: app.js uses localStorage for theme/WASM state'; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo '================================'; "
        + "echo 'Gate 3: Data-Path Tracer'; "
        + "echo '================================'; "
        + "echo 'Objective: Find silent failures, stubs, and incomplete verification'; "
        + "echo ''; "
        + "echo 'Checking for silent error suppression...'; "
        + "if grep -q 'console.warn\\|console.error' \"$WEBROOT/app.js\"; then "
        + "  echo 'OK: Errors are logged to console (not silently swallowed)'; "
        + "  grep -c 'console.warn\\|console.error' \"$WEBROOT/app.js\"; "
        + "else "
        + "  echo 'WARNING: No error logging found'; "
        + "  fail=$((fail + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for fallbacks in WASM loading...'; "
        + "if grep -q 'WebAssembly.instantiateStreaming' \"$WEBROOT/app.js\"; then "
        + "  echo 'OK: WASM has fallback from streaming to buffer instantiation'; "
        + "else "
        + "  echo 'INFO: No WASM streaming found'; "
        + "fi; "
        + "echo ''; "
        + "echo '================================'; "
        + "echo 'Gate 4: Hermetic Jailor'; "
        + "echo '================================'; "
        + "echo 'Objective: Find XSS, CSRF, clickjacking, unsafe origins, malicious links'; "
        + "echo ''; "
        + "echo 'Checking for Content-Security-Policy...'; "
        + "if grep -q 'Content-Security-Policy' \"$WEBROOT/index.html\"; then "
        + "  echo 'OK: CSP header/meta found'; "
        + "else "
        + "  echo 'WARNING: No CSP found in HTML'; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for X-Frame-Options/Clickjacking protection...'; "
        + "if grep -q 'X-Frame-Options\\|frame-ancestors' \"$WEBROOT\"/*html \"$WEBROOT\"/*.oot 2>/dev/null; then "
        + "  echo 'OK: Clickjacking protection found'; "
        + "else "
        + "  echo 'WARNING: No X-Frame-Options or frame-ancestors in source files'; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for unsafe inline scripts...'; "
        + "INLINE_SCRIPTS=$(grep -c '<script[^>]*>' \"$WEBROOT/index.html\" || true); "
        + "echo \"   Found $INLINE_SCRIPTS inline script blocks\"; "
        + "if [ \"$INLINE_SCRIPTS\" -gt 0 ]; then "
        + "  echo \"NOTE: Inline scripts present; CSP would need 'unsafe-inline' unless nonces/hashes used\"; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking all public install links...'; "
        + "BAD_LINKS=$(grep -rlE \"https://openooda\\.org/install_[^'\\\"<>[:space:]]+\\.sh\" \"$WEBROOT\" --include=\"*.html\" --include=\"*.js\" 2>/dev/null || true); "
        + "if [ -n \"$BAD_LINKS\" ]; then "
        + "  echo \"FAIL: Public files reference non-canonical installer URLs: $BAD_LINKS\"; "
        + "  fail=$((fail + 1)); "
        + "fi; "
        + "GOOD_LINKS=$(grep -r \"https://openooda.org/install.sh\" \"$WEBROOT\" --include=\"*.html\" --include=\"*.js\" -l 2>/dev/null || true); "
        + "if [ -n \"$GOOD_LINKS\" ]; then "
        + "  echo \"OK: install.sh is the canonical public URL in: $GOOD_LINKS\"; "
        + "else "
        + "  echo 'WARNING: install.sh not referenced in public web files'; "
        + "  fail=$((fail + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for external script sources...'; "
        + "EXTERNAL=$(grep -oP 'src=\"https?://[^\"]+\"' \"$WEBROOT/index.html\" | sort -u || true); "
        + "if [ -n \"$EXTERNAL\" ]; then "
        + "  echo \"   External script sources: $EXTERNAL\"; "
        + "  echo 'NOTE: External scripts increase supply-chain risk'; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for form actions to external endpoints...'; "
        + "if grep -q 'action=\"https://' \"$WEBROOT/index.html\"; then "
        + "  echo 'INFO: Form submits to external endpoint'; "
        + "  grep -o 'action=\"[^\"]*\"' \"$WEBROOT/index.html\"; "
        + "  warning=$((warning + 1)); "
        + "fi; "
        + "echo ''; "
        + "echo 'Checking for target=_blank without rel=noopener...'; "
        + "NO_OPENER=$(grep -o '<a[^>]*target=\"_blank\"[^>]*>' \"$WEBROOT/index.html\" | grep -v 'rel=\"noopener' | head -5 || true); "
        + "if [ -n \"$NO_OPENER\" ]; then "
        + "  echo \"WARNING: Some _blank links lack rel=noopener: $NO_OPENER\"; "
        + "  warning=$((warning + 1)); "
        + "else "
        + "  echo 'OK: External links use proper rel attributes'; "
        + "fi; "
        + "echo ''; "
        + "echo '=== REDTEAM FULL WEB REVIEW SUMMARY ==='; "
        + "echo \"Failures: $fail\"; "
        + "echo \"Warnings: $warning\"; "
        + "if [ \"$fail\" -eq 0 ]; then "
        + "  echo \"Status: CERTIFIED for web deployment (with $warning advisory warnings)\"; "
        + "else "
        + "  echo \"Status: BLOCKED - $fail gate violations require remediation\"; "
        + "  exit 1; "
        + "fi;";

    let res = sys_exec(sys, "sh", "-c", check_cmd);
    match res {
        Ok(out) => {
            println(out);
        },
        Err(e) => {
            println("web_redteam_full_review error: " + e);
            process_exit(1);
        }
    }
}
