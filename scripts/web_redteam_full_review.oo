// # Web REDTEAM full review
//
// Logline: 4-gate adversarial review of the public website surface.
//
// Setup: ProcessCap, FsCap, EnvCap. Run from repo root.
//
// Beats:
//   1. Heuristic Hunter: flag security-critical string matching in app.js.
//   2. Boundary Falsifier: check input validation and routing boundaries.
//   3. Data-Path Tracer: verify error logging and fallbacks.
//   4. Hermetic Jailor: check CSP, X-Frame, install links, rel noopener.

fn strip(s: String) -> String {
    let mut n: Int = chars_len(s);
    while n > 0 && str_slice(s, n - 1, n) == "\n" { n = n - 1; s = str_slice(s, 0, n); }
    while n > 0 && str_slice(s, n - 1, n) == "\r" { n = n - 1; s = str_slice(s, 0, n); }
    return s;
}

fn sh_out(p: &ProcessCap, fs: &FsCap, cmd: String, out: String) -> String {
    if process_exec(p, cmd + " > " + out).is_err() { return ""; }
    let r: Result[String, String] = read_file(fs, out);
    if r.is_err() { return ""; }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    return strip(raw);
}

fn has(p: &ProcessCap, cmd: String) -> Bool {
    return process_exec(p, cmd).is_ok();
}

fn grep_count(p: &ProcessCap, fs: &FsCap, path: String, pattern: String) -> Int {
    let out: String = "/tmp/ooda_web_grep.txt";
    if process_exec(p, "grep -cE '" + pattern + "' " + path + " > " + out + " 2>/dev/null || echo 0 > " + out).is_err() { return 0; }
    let r: Result[String, String] = read_file(fs, out);
    if r.is_err() { return 0; }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    let raw_s: String = strip(raw);
    let n: Int = chars_len(raw_s);
    if n == 0 { return 0; }
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(raw_s, i, i + 1);
        if c == "0" { v = v * 10 + 0; }
        if c == "1" { v = v * 10 + 1; }
        if c == "2" { v = v * 10 + 2; }
        if c == "3" { v = v * 10 + 3; }
        if c == "4" { v = v * 10 + 4; }
        if c == "5" { v = v * 10 + 5; }
        if c == "6" { v = v * 10 + 6; }
        if c == "7" { v = v * 10 + 7; }
        if c == "8" { v = v * 10 + 8; }
        if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v;
}

pub fn main(p: &ProcessCap, fs: &FsCap, env: &EnvCap) {
    let root_r: Result[String, String] = env_get(env, "OODA_REPO_ROOT");
    let root_raw: String = if root_r.is_ok() { match root_r { Ok(s) => s, Err(_) => "" } } else { "" };
    let root: String = if root_raw != "" { strip(root_raw) } else { "/home/jeryd/Projects/openOODA" };
    let webroot: String = root + "/openOODA.github.io";
    let appjs: String = webroot + "/app.js";
    let index: String = webroot + "/index.html";

    let mut failures: Int = 0;
    let mut warnings: Int = 0;

    println("=== REDTEAM FULL WEB REVIEW ===");
    println("Methodology: First Principles, Negative Trust, Adversarial Testing, 4-Gate Protocol");
    println("");

    let files: String = sh_out(p, fs, "find " + webroot + " -type f | wc -l", "/tmp/ooda_web_files.txt");
    let htmls: String = sh_out(p, fs, "find " + webroot + " -name '*.html' | wc -l", "/tmp/ooda_web_htmls.txt");
    let jss: String = sh_out(p, fs, "find " + webroot + " -name '*.js' | wc -l", "/tmp/ooda_web_jss.txt");
    println("0. Web Surface Enumeration");
    println("   Files examined: " + files);
    println("   HTML pages: " + htmls);
    println("   JS files: " + jss);
    println("");

    // Gate 1: Heuristic Hunter
    println("================================");
    println("Gate 1: Heuristic Hunter");
    println("================================");
    println("Objective: Find string matching, token bags, and heuristics used for security decisions");
    println("");
    if has(p, "grep -qE 'isExternalUrl|allowedSchemes' " + appjs) {
        println("OK: app.js uses explicit allowed-scheme whitelist for external links");
    } else if has(p, "grep -qE 'indexOf.*://|search\\(|match\\(|\\.test\\(' " + appjs) {
        warnings = warnings + 1;
        println("WARNING: app.js may use string heuristics for URL validation");
    } else {
        println("OK: no obvious security-critical string matching heuristics found");
    }
    let regex_count: Int = grep_count(p, fs, appjs, "\\.test\\(.*\\)|\\.search\\(.*\\)|match\\(");
    if regex_count > 0 {
        warnings = warnings + 1;
        println("INFO: Regex/string matching found in app.js (" + regex_count.to_string() + " occurrences)");
    }
    println("");

    // Gate 2: Boundary Falsifier
    println("================================");
    println("Gate 2: Boundary Falsifier");
    println("================================");
    println("Objective: Find boundary violations, unvalidated inputs, oversized parameters");
    println("");
    if has(p, "grep -q 'type=\"email\"' " + webroot + "/index.html") {
        println("OK: Email form has type and required validation");
    } else {
        warnings = warnings + 1;
        println("WARNING: Email form missing type validation");
    }
    if has(p, "grep -q 'class=\"hp\"' " + webroot + "/index.html") {
        println("OK: Email form uses honeypot field (.hp)");
    } else {
        warnings = warnings + 1;
        println("WARNING: Email form missing honeypot field");
    }
    if has(p, "grep -q 'location.pathname' " + appjs) {
        warnings = warnings + 1;
        println("NOTE: app.js uses location.pathname for routing");
    }
    if has(p, "grep -q 'localStorage' " + appjs) {
        warnings = warnings + 1;
        println("INFO: app.js uses localStorage for theme/WASM state");
    }
    println("");

    // Gate 3: Data-Path Tracer
    println("================================");
    println("Gate 3: Data-Path Tracer");
    println("================================");
    println("Objective: Find silent failures, stubs, and incomplete verification");
    println("");
    if has(p, "grep -q 'console.warn\\|console.error' " + appjs) {
        println("OK: Errors are logged to console (not silently swallowed)");
    } else {
        warnings = warnings + 1;
        println("WARNING: No console.warn/error found in app.js");
    }
    if has(p, "grep -q 'WebAssembly.instantiateStreaming' " + appjs) {
        println("OK: WASM has fallback from streaming to buffer instantiation");
    } else {
        warnings = warnings + 1;
        println("WARNING: No WASM streaming fallback found");
    }
    println("");

    // Gate 4: Hermetic Jailor
    println("================================");
    println("Gate 4: Hermetic Jailor");
    println("================================");
    println("Objective: Find XSS, CSRF, clickjacking, unsafe origins, malicious links");
    println("");
    if has(p, "grep -q 'Content-Security-Policy' " + index) {
        println("OK: CSP header/meta found");
    } else {
        failures = failures + 1;
        println("FAIL: No CSP found in HTML");
    }
    if has(p, "grep -q 'X-Frame-Options\\|frame-ancestors' " + index) {
        println("OK: Clickjacking protection found");
    } else {
        failures = failures + 1;
        println("FAIL: No X-Frame-Options or frame-ancestors in source files");
    }
    let inline_count: Int = grep_count(p, fs, index, "<script");
    if inline_count > 0 {
        warnings = warnings + 1;
        println("NOTE: Inline scripts present (" + inline_count.to_string() + "); CSP needs 'unsafe-inline' unless nonces/hashes used");
    }
    if has(p, "grep -qRl 'install.sh' " + webroot) {
        println("OK: install.sh is the canonical public URL");
    } else {
        failures = failures + 1;
        println("FAIL: install.sh not found in public site");
    }
    if has(p, "grep -q 'target=\"_blank\"' " + index) {
        if has(p, "grep -qE 'target=\"_blank\".*rel=.*noopener|rel=.*noopener.*target=\"_blank\"' " + index) {
            println("OK: External links use proper rel attributes");
        } else {
            warnings = warnings + 1;
            println("WARNING: target=_blank without rel=noopener");
        }
    }
    if has(p, "grep -q 'action=\"https://collect.openooda.org' " + index) {
        println("INFO: Form submits to external endpoint");
    }
    println("");

    println("=== REDTEAM FULL WEB REVIEW SUMMARY ===");
    println("Failures: " + failures.to_string());
    println("Warnings: " + warnings.to_string());
    if failures == 0 {
        println("Status: CERTIFIED for web deployment (with " + warnings.to_string() + " advisory warnings)");
    } else {
        println("Status: NOT CERTIFIED");
        process_exit(1);
    }
}
