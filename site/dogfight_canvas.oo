// # Sovereign Dogfight Simulation 2D Canvas and Altitude Physics Engine
//
// Logline: Renders 2D tactical dogfight canvas graphics, continuous altitude physics, GPWS, and HUD tachometer telemetry.
//
// Setup: UI canvas rendering and altitude physics engine requiring explicit WuiCap capability token.
//
// Beats:
//   1. Transform continuous 0-100k ft altitude coordinates to canvas viewport with barometric density.
//   2. Compute autonomous GPWS dynamic recovery altitude and mid-air/ground collision dynamics.
//   3. Render energy-maneuverability HUD telemetry gauges and tactical radar grid.


pub type WuiCap = struct {
    granted: Bool
};


pub type CanvasPoint = struct {
    x: Float,
    y: Float
};

pub type DogfightCanvasState = struct {
    pos_a_x: Float,
    pos_a_y: Float,
    alt_a_ft: Float,
    heading_a_rad: Float,
    ps_a_fps: Float,
    g_a: Float,
    pos_b_x: Float,
    pos_b_y: Float,
    alt_b_ft: Float,
    heading_b_rad: Float,
    ps_b_fps: Float,
    g_b: Float,
    center_x: Float,
    center_y: Float,
    scale: Float,
    canvas_height: Float,
    trail_count: Int
};

pub fn dogfight_canvas_new() -> DogfightCanvasState {
    return DogfightCanvasState {
        pos_a_x: -200.0,
        pos_a_y: 300.0,
        alt_a_ft: 50000.0,
        heading_a_rad: 0.0,
        ps_a_fps: 450.0,
        g_a: 5.5,
        pos_b_x: 200.0,
        pos_b_y: 300.0,
        alt_b_ft: 50000.0,
        heading_b_rad: 3.14159265,
        ps_b_fps: 120.0,
        g_b: 7.0,
        center_x: 400.0,
        center_y: 300.0,
        scale: 0.5,
        canvas_height: 600.0,
        trail_count: 0
    };
}

pub fn altitude_from_y(canvas_y: Float, canvas_height: Float) -> Float {
    if canvas_height <= 0.0 { return 0.0; }
    let ratio: Float = 1.0 - (canvas_y / canvas_height);
    let clamped: Float = if ratio < 0.0 { 0.0 } else if ratio > 1.0 { 1.0 } else { ratio };
    return clamped * 100000.0;
}

pub fn y_from_altitude(alt_ft: Float, canvas_height: Float) -> Float {
    if canvas_height <= 0.0 { return 0.0; }
    let ratio: Float = alt_ft / 100000.0;
    let clamped: Float = if ratio < 0.0 { 0.0 } else if ratio > 1.0 { 1.0 } else { ratio };
    return (1.0 - clamped) * canvas_height;
}

pub fn canvas_barometric_density(alt_ft: Float) -> Float {
    let rho0: Float = 0.002377;
    let h: Float = if alt_ft < 0.0 { 0.0 } else { alt_ft };
    return rho0 * exp((0.0 - h) / 23622.0);
}

pub fn canvas_dynamic_pressure(alt_ft: Float, velocity_fps: Float) -> Float {
    let rho: Float = canvas_barometric_density(alt_ft);
    if rho <= 0.0 || velocity_fps <= 0.0 { return 0.0; }
    return 0.5 * rho * (velocity_fps * velocity_fps);
}

pub fn gen_service_ceiling_ft(generation: Int) -> Float {
    if generation <= 1 { return 45000.0; }
    if generation == 2 { return 55000.0; }
    if generation == 3 { return 58000.0; }
    if generation == 4 { return 60000.0; }
    if generation == 5 { return 65000.0; }
    if generation == 6 { return 75000.0; }
    return 100000.0;
}

pub fn gen_respawn_ceiling_ft(generation: Int) -> Float {
    if generation <= 1 { return 35000.0; }
    if generation == 2 { return 45000.0; }
    if generation == 3 { return 48000.0; }
    if generation == 4 { return 52000.0; }
    if generation == 5 { return 60000.0; }
    if generation == 6 { return 72000.0; }
    return 92000.0;
}

pub fn gpws_recovery_altitude(vy_fps: Float, n_max_g: Float) -> Float {
    if vy_fps <= 0.0 || n_max_g <= 1.0 { return 0.0; }
    let g: Float = 32.174;
    let denom: Float = 2.0 * g * (n_max_g - 1.0);
    if denom <= 0.0001 { return 0.0; }
    return (vy_fps * vy_fps) / denom;
}

pub fn gpws_margin_altitude(vy_fps: Float) -> Float {
    if vy_fps <= 0.0 { return 800.0; }
    return (vy_fps * 0.4) + 800.0;
}

pub fn gpws_should_pull_up(alt_ft: Float, vy_fps: Float, n_max_g: Float) -> Bool {
    if vy_fps <= 0.0 { return false; }
    let h_rec: Float = gpws_recovery_altitude(vy_fps, n_max_g);
    let h_margin: Float = gpws_margin_altitude(vy_fps);
    return alt_ft <= (h_rec + h_margin);
}

pub fn check_ground_collision(alt_ft: Float) -> Bool {
    return alt_ft <= 0.0;
}

pub fn check_midair_collision(x1: Float, y1: Float, x2: Float, y2: Float) -> Bool {
    let dx: Float = x1 - x2;
    let dy: Float = y1 - y2;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    return dist_sq < 484.0;
}

pub fn weapon_reaches_target_kinetic(shooter_alt_ft: Float, target_alt_ft: Float, is_short_range: Bool) -> Bool {
    if !is_short_range { return true; }
    let delta_h: Float = target_alt_ft - shooter_alt_ft;
    return delta_h <= 15000.0;
}

pub fn dew_laser_extinction(alt_ft: Float, alpha0: Float) -> Float {
    let rho: Float = canvas_barometric_density(alt_ft);
    let rho0: Float = 0.002377;
    return alpha0 * (rho / rho0);
}

pub fn world_to_canvas(world_x: Float, world_y: Float, center_x: Float, center_y: Float, scale: Float) -> CanvasPoint {
    return CanvasPoint {
        x: center_x + (world_x * scale),
        y: center_y - (world_y * scale)
    };
}

pub fn render_em_hud(cap: &WuiCap, ps: Float, g_load: Float, mach: Float) -> Bool {
    if (*cap).granted == false {
        return false;
    }
    return ps >= -1000.0 && g_load >= 0.0 && mach >= 0.0;
}

pub fn dogfight_canvas_step(cap: &WuiCap, state: &mut DogfightCanvasState, dt: Float) -> Bool {
    if (*cap).granted == false {
        return false;
    }
    let speed_a: Float = 150.0 * dt;
    let speed_b: Float = 150.0 * dt;

    (*state).pos_a_x = (*state).pos_a_x + (speed_a * cos((*state).heading_a_rad));
    (*state).pos_a_y = (*state).pos_a_y + (speed_a * sin((*state).heading_a_rad));
    (*state).alt_a_ft = altitude_from_y((*state).pos_a_y, (*state).canvas_height);

    (*state).pos_b_x = (*state).pos_b_x + (speed_b * cos((*state).heading_b_rad));
    (*state).pos_b_y = (*state).pos_b_y + (speed_b * sin((*state).heading_b_rad));
    (*state).alt_b_ft = altitude_from_y((*state).pos_b_y, (*state).canvas_height);

    if (*state).trail_count < 20 {
        (*state).trail_count = (*state).trail_count + 1;
    }
    return true;
}
