// # Sovereign Dogfight Simulation 2D Canvas and HUD Tachometer Engine
//
// Logline: Renders 2D tactical dogfight canvas graphics, aircraft vectors, and HUD tachometer telemetry.
//
// Setup: UI canvas rendering engine requiring explicit WuiCap capability token.
//
// Beats:
//   1. Transform aircraft world coordinates to 2D canvas viewport with inverted-Y mapping.
//   2. Render energy-maneuverability HUD telemetry gauges and tachometer indicators.
//   3. Draw tactical aircraft positions, headings, and relative engagement vectors.


pub type WuiCap = struct {
    granted: Bool
};


pub type CanvasPoint = struct {
    x: Float,
    y: Float
};

pub type DogfightCanvasState = struct {
    pos_a_x: Float,
    pos_a_y: Float,
    heading_a_rad: Float,
    ps_a_fps: Float,
    g_a: Float,
    pos_b_x: Float,
    pos_b_y: Float,
    heading_b_rad: Float,
    ps_b_fps: Float,
    g_b: Float,
    center_x: Float,
    center_y: Float,
    scale: Float,
    trail_count: Int
};

pub fn dogfight_canvas_new() -> DogfightCanvasState {
    return DogfightCanvasState {
        pos_a_x: -200.0,
        pos_a_y: 0.0,
        heading_a_rad: 0.0,
        ps_a_fps: 450.0,
        g_a: 5.5,
        pos_b_x: 200.0,
        pos_b_y: 0.0,
        heading_b_rad: 3.14159265,
        ps_b_fps: 120.0,
        g_b: 7.0,
        center_x: 400.0,
        center_y: 300.0,
        scale: 0.5,
        trail_count: 0
    };
}

pub fn world_to_canvas(world_x: Float, world_y: Float, center_x: Float, center_y: Float, scale: Float) -> CanvasPoint {
    return CanvasPoint {
        x: center_x + (world_x * scale),
        y: center_y - (world_y * scale)
    };
}

pub fn render_em_hud(cap: &WuiCap, ps: Float, g_load: Float, mach: Float) -> Bool {
    if (*cap).granted == false {
        return false;
    }
    return ps >= -1000.0 && g_load >= 0.0 && mach >= 0.0;
}

pub fn dogfight_canvas_step(cap: &WuiCap, state: &mut DogfightCanvasState, dt: Float) -> Bool {
    if (*cap).granted == false {
        return false;
    }
    let speed_a: Float = 150.0 * dt;
    let speed_b: Float = 150.0 * dt;

    (*state).pos_a_x = (*state).pos_a_x + (speed_a * cos((*state).heading_a_rad));
    (*state).pos_a_y = (*state).pos_a_y + (speed_a * sin((*state).heading_a_rad));

    (*state).pos_b_x = (*state).pos_b_x + (speed_b * cos((*state).heading_b_rad));
    (*state).pos_b_y = (*state).pos_b_y + (speed_b * sin((*state).heading_b_rad));

    if (*state).trail_count < 20 {
        (*state).trail_count = (*state).trail_count + 1;
    }
    return true;
}
