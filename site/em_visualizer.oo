// # Boyd E-M Tachometer & Telemetry Visualizer
//
// Logline: Energy-Maneuverability state engine computing specific excess power (P_s) and dual-ring OODA frequency telemetry.
//
// Setup: Evaluates John Boyd's E-M formulation P_s = V * (T - D) / W across openOODA microsecond cycles vs legacy stacks.
//
// Beats:
//   1. Compute specific excess power (P_s) and instantaneous OODA loop frequencies.
//   2. Advance dual-ring angular simulation state (openOODA high-frequency vs legacy sluggish).
//   3. Render declarative Virtual DOM container and telemetry badges.
//   4. Verify mathematical invariants and boost transition thresholds.

import "std/wui/wui_vnode.oo";
import "std/wui/wui_vdom_builder.oo";

pub type EmState = struct {
    thrust: Int,
    drag_coeff: Int,
    weight: Int,
    airspeed: Int,
    boost: Bool,
    zero_drag: Bool,
    zero_weight: Bool,
    time_ms: Int,
    legacy_angle: Int,
    ooda_angle: Int
};

pub type EmTelemetry = struct {
    ps_value: Int,
    ooda_freq_hz: Int,
    legacy_freq_mhz: Int,
    thrust_lines_per_sec: Int,
    drag_ms_pause: Int,
    status_text: String
};

pub fn em_state_init() -> EmState {
    return EmState {
        thrust: 75000,
        drag_coeff: 20,
        weight: 90000,
        airspeed: 450,
        boost: false,
        zero_drag: false,
        zero_weight: false,
        time_ms: 0,
        legacy_angle: 0,
        ooda_angle: 0
    };
}

pub fn em_calculate_ps(thrust: Int, drag: Int, weight: Int, speed: Int) -> Int {
    let safe_w: Int = if weight > 0 { weight } else { 1 };
    let net_force: Int = thrust - drag;
    let ps: Int = (speed * net_force) / safe_w;
    return ps;
}

pub fn em_node_label(node_idx: Int) -> String {
    let idx: Int = (node_idx % 4 + 4) % 4;
    if idx == 0 {
        return "OBSERVE";
    } else if idx == 1 {
        return "ORIENT";
    } else if idx == 2 {
        return "DECIDE";
    } else {
        return "ACT";
    }
}

pub fn em_state_tick(em_st: &mut EmState, boost: Bool, zero_drag: Bool) -> EmTelemetry {
    em_st.boost = boost;
    em_st.zero_drag = zero_drag;
    em_st.time_ms = em_st.time_ms + 16;

    let mut eff_drag: Int = em_st.drag_coeff * 100;
    if zero_drag { eff_drag = 0; }

    let mut eff_thrust: Int = em_st.thrust;
    if boost { eff_thrust = eff_thrust + 35000; }

    let mut eff_weight: Int = em_st.weight;
    if em_st.zero_weight { eff_weight = 28200; }

    let ps: Int = em_calculate_ps(eff_thrust, eff_drag, eff_weight, em_st.airspeed);

    let mut ooda_freq: Int = 2500;
    if boost {
        ooda_freq = 4500;
    } else if zero_drag {
        ooda_freq = 3200;
    }

    let legacy_speed: Int = 8;
    let mut ooda_speed: Int = 40;
    if boost {
        ooda_speed = 75;
    } else if zero_drag {
        ooda_speed = 55;
    }

    em_st.legacy_angle = (em_st.legacy_angle + legacy_speed) % 6283;
    em_st.ooda_angle = (em_st.ooda_angle + ooda_speed) % 6283;

    let mut thrust_lines: Int = 850000;
    if boost { thrust_lines = 1400000; }

    let mut drag_pause: Int = 18;
    if zero_drag { drag_pause = 0; }

    let status_str: String = "P_s = V*(T-D)/W: " + ooda_freq.to_string() + " Hz";

    return EmTelemetry {
        ps_value: ps,
        ooda_freq_hz: ooda_freq,
        legacy_freq_mhz: 20,
        thrust_lines_per_sec: thrust_lines,
        drag_ms_pause: drag_pause,
        status_text: status_str
    };
}

pub fn em_render_view(em_st: &EmState) -> VNode {
    let mut root_props: List[VProp] = list_new();
    root_props = list_push(root_props, prop_class("em-visualizer"));
    let mut children: List[VNode] = list_new();
    children = list_push(children, h_text("Tachometer: " + (em_st.ooda_angle).to_string()));
    return h_div(root_props, children);
}

verify em_visualizer_engine {
    let mut em_st: EmState = em_state_init();
    assert_eq!(em_st.thrust, 75000);
    assert_eq!(em_st.airspeed, 450);

    let ps_base: Int = em_calculate_ps(75000, 2000, 90000, 450);
    assert_eq!(ps_base, 365);

    let telem_normal: EmTelemetry = em_state_tick(&mut em_st, false, false);
    assert_eq!(telem_normal.ooda_freq_hz, 2500);
    assert_eq!(telem_normal.legacy_freq_mhz, 20);

    let telem_boost: EmTelemetry = em_state_tick(&mut em_st, true, false);
    assert_eq!(telem_boost.ooda_freq_hz, 4500);

    let telem_zero: EmTelemetry = em_state_tick(&mut em_st, false, true);
    assert_eq!(telem_zero.ooda_freq_hz, 3200);

    assert_eq!(em_node_label(0), "OBSERVE");
    assert_eq!(em_node_label(1), "ORIENT");
    assert_eq!(em_node_label(2), "DECIDE");
    assert_eq!(em_node_label(3), "ACT");

    let em_vdom: VNode = em_render_view(&em_st);
    assert_eq!(em_vdom.node_kind, 1);
}
