// # openOODA WebAssembly Sovereign Application Engine
//
// Logline: Central application lifecycle, state hydration, Model-Update-View bridge, and reactive event loop.
//
// Setup: Integrates theme controller, 18-route dispatcher, playground simulator, and physics visualizers into Virtual DOM.
//
// Beats:
//   1. Initialize composite application state (routes, themes, presets, visualizers).
//   2. Dispatch UI events and compute deterministic state transitions.
//   3. Render reactive Virtual DOM component trees for browser host micro-shim hydration.
//   4. Expose zero ambient authority WebAssembly entry points and verify application invariants.

import "theme.oo";
import "routes.oo";
import "playground.oo";
import "em_visualizer.oo";
import "cap_visualizer.oo";
import "std/ui/wui/wui_vnode.oo";
import "std/ui/wui/wui_vdom_builder.oo";

pub type AppState = struct {
    current_route_id: Int,
    current_theme_id: Int,
    active_preset_id: Int,
    init_timestamp: Int,
    em_state: EmState,
    cap_state: CapGateState,
    wasm_active: Bool,
    render_count: Int
};

pub fn app_create_state() -> AppState {
    return AppState {
        current_route_id: 1, // Home
        current_theme_id: 0, // Night
        active_preset_id: 1, // Hello
        init_timestamp: 1724688000,
        em_state: em_state_init(),
        cap_state: cap_gate_init(),
        wasm_active: true,
        render_count: 0
    };
}

pub fn app_set_route(state: &mut AppState, route_id: Int) -> Int {
    if route_id >= 1 && route_id <= 18 {
        state.current_route_id = route_id;
        return route_id;
    } else {
        state.current_route_id = 1;
        return 1;
    }
}

pub fn app_cycle_theme(state: &mut AppState) -> Int {
    let next_id: Int = theme_next(state.current_theme_id);
    state.current_theme_id = next_id;
    return next_id;
}

pub fn app_set_preset(state: &mut AppState, preset_id: Int) -> Int {
    if preset_id >= 1 && preset_id <= 5 {
        state.active_preset_id = preset_id;
        return preset_id;
    } else {
        state.active_preset_id = 1;
        return 1;
    }
}

pub fn app_toggle_wasm(state: &mut AppState) -> Bool {
    let new_val: Bool = !state.wasm_active;
    state.wasm_active = new_val;
    return new_val;
}

pub fn app_update(state: &mut AppState, action: String, payload: String) -> Int {
    if action == "route" {
        let rid: Int = route_id_from_name(payload);
        return app_set_route(state, rid);
    } else if action == "theme_cycle" {
        return app_cycle_theme(state);
    } else if action == "preset" {
        let mut pid: Int = 1;
        if payload == "pqc" { pid = 2; }
        else if payload == "l3" { pid = 3; }
        else if payload == "sgp4" { pid = 4; }
        else if payload == "defense" { pid = 5; }
        return app_set_preset(state, pid);
    } else if action == "em_boost" {
        let telem: EmTelemetry = em_state_tick(&mut state.em_state, true, false);
        return telem.ooda_freq_hz;
    } else if action == "cap_untrusted" {
        let pkt: CapPacket = cap_packet_new(100, false, "FsReadCap");
        let dec: CapDecision = cap_gate_process_packet(&mut state.cap_state, pkt);
        return dec.status_code;
    } else if action == "cap_grant" {
        let pkt: CapPacket = cap_packet_new(101, true, "FsReadCap");
        let dec: CapDecision = cap_gate_process_packet(&mut state.cap_state, pkt);
        return dec.status_code;
    } else {
        return 0;
    }
}

pub fn app_view(app_st: &AppState) -> VNode {
    let mut root_props: List[VProp] = list_new();
    let theme_cls: String = "theme-" + theme_name(app_st.current_theme_id);
    root_props = list_push(root_props, prop_class("openooda-app " + theme_cls));
    let mut children: List[VNode] = list_new();
    let em_node: VNode = em_render_view(&app_st.em_state);
    let cap_node: VNode = cap_render_view(&app_st.cap_state);
    children = list_push(children, em_node);
    children = list_push(children, cap_node);
    return h_div(root_props, children);
}

pub fn ooda_app_init() -> Int {
    return 1;
}

pub fn ooda_app_route(route_id: Int) -> Int {
    if route_id >= 1 && route_id <= 18 {
        return route_id;
    } else {
        return 1;
    }
}

pub fn ooda_app_theme_next(theme_id: Int) -> Int {
    return theme_next(theme_id);
}

pub fn ooda_app_eval(preset_id: Int) -> Int {
    if preset_id >= 1 && preset_id <= 5 {
        return preset_id;
    } else {
        return 1;
    }
}

pub fn wui_init() -> Int {
    return 1;
}

pub fn wui_on_event(node_id: Int, event_kind: Int, payload_ptr: Int, payload_len: Int) -> Int {
    return event_kind + node_id;
}

pub fn wui_render_frame() -> Int {
    return 1;
}

pub fn main() {
    let mut state: AppState = app_create_state();
    let init_r: Int = app_set_route(&mut state, 2);
    let init_t: Int = app_cycle_theme(&mut state);
    let init_p: Int = app_set_preset(&mut state, 3);
    let init_u1: Int = app_update(&mut state, "em_boost", "");
    let init_u2: Int = app_update(&mut state, "cap_untrusted", "");
    let init_v: VNode = app_view(&state);
    println("openOODA WebAssembly Engine Initialized.");
}

verify app_lifecycle_and_vdom {
    let mut app_st: AppState = app_create_state();
    assert_eq!(app_st.current_route_id, 1);
    assert_eq!(app_st.current_theme_id, 0);
    assert_eq!(app_set_route(&mut app_st, 6), 6);
    assert_eq!(app_cycle_theme(&mut app_st), 1);
    assert_eq!(app_set_preset(&mut app_st, 4), 4);
    assert_eq!(app_toggle_wasm(&mut app_st), false);

    let freq: Int = app_update(&mut app_st, "em_boost", "");
    assert_eq!(freq, 4500);

    let trap_code: Int = app_update(&mut app_st, "cap_untrusted", "");
    assert_eq!(trap_code, 7);

    let grant_code: Int = app_update(&mut app_st, "cap_grant", "");
    assert_eq!(grant_code, 200);

    assert_eq!(ooda_app_init(), 1);
    assert_eq!(ooda_app_route(17), 17);
    assert_eq!(wui_init(), 1);
    assert_eq!(wui_render_frame(), 1);

    let app_vnode: VNode = app_view(&app_st);
    assert_eq!(app_vnode.node_kind, 1);
}
