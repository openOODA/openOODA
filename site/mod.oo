// # openOODA Site Module Public Facade
//
// Logline: Discoverable manifest and path resolver for the openOODA/site interactive WebAssembly modules.
//
// Setup: Pure directory catalog; no capability tokens required. Callers receive relative paths and dispatch through the product CLI or import directly.
//
// Beats:
//   1. Enumerate the public site modules as a stable, ordered list.
//   2. Resolve a module name to its canonical relative path under openOODA/site/.
//   3. Reject unknown names fail-closed with a descriptive error.

pub fn site_module_list() -> List[String] {
  let mut names: List[String] = list_new();
  names = list_push(names, "cap_visualizer");
  names = list_push(names, "dogfight_canvas");
  names = list_push(names, "em_visualizer");
  names = list_push(names, "gen7_swarm_renderer");
  names = list_push(names, "main");
  names = list_push(names, "playground");
  names = list_push(names, "routes");
  names = list_push(names, "theme");
  return names;
}

fn site_rel(name: String) -> Result[String, String] {
  if name == "cap_visualizer" { return Ok("openOODA/site/cap_visualizer.oo"); }
  if name == "dogfight_canvas" { return Ok("openOODA/site/dogfight_canvas.oo"); }
  if name == "em_visualizer" { return Ok("openOODA/site/em_visualizer.oo"); }
  if name == "gen7_swarm_renderer" { return Ok("openOODA/site/gen7_swarm_renderer.oo"); }
  if name == "main" { return Ok("openOODA/site/main.oo"); }
  if name == "playground" { return Ok("openOODA/site/playground.oo"); }
  if name == "routes" { return Ok("openOODA/site/routes.oo"); }
  if name == "theme" { return Ok("openOODA/site/theme.oo"); }
  return Err("ERR\tsite_mod\tunknown module: " + name);
}

pub fn site_module_rel(name: String) -> Result[String, String] {
  return site_rel(name);
}
