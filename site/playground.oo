// # Interactive Playground Evaluator
//
// Logline: In-memory openOODA playground preset compiler simulator and execution engine.
//
// Setup: Validates preset IDs, code source templates, and simulated execution output telemetry.
//
// Beats:
//   1. Resolve preset metadata (name, title, code snippet) for all 5 preset suites.
//   2. Compute simulated execution stdout streams and exit codes.
//   3. Provide full PresetResult records for reactive WUI display.
//   4. Verify preset evaluator determinism and fallback behavior.

pub type PresetResult = struct {
    id: Int,
    name: String,
    title: String,
    code_snippet: String,
    stdout_output: String,
    exit_code: Int,
    verified: Bool
};

pub fn preset_count() -> Int {
    return 5;
}

pub fn preset_name(id: Int) -> String {
    if id == 1 {
        return "hello";
    } else if id == 2 {
        return "pqc";
    } else if id == 3 {
        return "l3";
    } else if id == 4 {
        return "sgp4";
    } else if id == 5 {
        return "defense";
    } else {
        return "hello";
    }
}

pub fn preset_title(id: Int) -> String {
    if id == 1 { return "Hello"; }
    if id == 2 { return "PQC"; }
    if id == 3 { return "L3"; }
    if id == 4 { return "SGP4"; }
    return "Defense";
}

pub fn preset_code(id: Int) -> String {
    if id == 1 { return "main();"; }
    if id == 2 { return "ml_kem();"; }
    if id == 3 { return "l3_book();"; }
    if id == 4 { return "sgp4();"; }
    return "mtd();";
}

pub fn preset_output(id: Int) -> String {
    if id == 1 { return "PASS"; }
    if id == 2 { return "KYBER"; }
    if id == 3 { return "MATCH"; }
    if id == 4 { return "ORBIT"; }
    return "MTD_OK";
}

pub fn playground_eval_preset(preset_id: Int) -> PresetResult {
    let valid_id: Int = if preset_id >= 1 && preset_id <= 5 { preset_id } else { 1 };
    return PresetResult {
        id: valid_id,
        name: preset_name(valid_id),
        title: preset_title(valid_id),
        code_snippet: preset_code(valid_id),
        stdout_output: preset_output(valid_id),
        exit_code: 0,
        verified: true
    };
}

verify playground_evaluator {
    assert_eq!(preset_count(), 5);
    assert_eq!(preset_name(1), "hello");
    assert_eq!(preset_name(2), "pqc");
    assert_eq!(preset_name(3), "l3");
    assert_eq!(preset_name(4), "sgp4");
    assert_eq!(preset_name(5), "defense");
    assert_eq!(preset_name(99), "hello");

    let pr1: PresetResult = playground_eval_preset(1);
    assert_eq!(pr1.id, 1);
    assert_eq!(pr1.name, "hello");
    assert_eq!(pr1.exit_code, 0);
    assert_eq!(pr1.verified, true);

    let pr2: PresetResult = playground_eval_preset(2);
    assert_eq!(pr2.id, 2);
    assert_eq!(pr2.name, "pqc");
    assert_eq!(pr2.title, "PQC (ML-KEM-1024 Lattice)");
}
