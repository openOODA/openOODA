// # Web Application Route Dispatcher
//
// Logline: Bidirectional 18-route resolver and document mapping engine for openOODA SPA navigation.
//
// Setup: Pure string matching and integer code translation with deterministic fallback to home.
//
// Beats:
//   1. Resolve route numeric identifiers and canonical names across all 18 routes.
//   2. Map documentation filenames and guide section flags.
//   3. Provide full RouteInfo descriptors and hash-to-route resolver.
//   4. Verify bidirectional route mapping invariants and fallback behavior.

pub type RouteInfo = struct {
    id: Int,
    name: String,
    title: String,
    is_guide: Bool,
    doc_file: String
};

pub fn route_count() -> Int {
    return 18;
}

pub fn route_id_from_name(name: String) -> Int {
    if name == "404" || name == "not_found" { return 18; }
    let mut i: Int = 1;
    while i <= 18 {
        if route_name_from_id(i) == name {
            return i;
        }
        i = i + 1;
    }
    return 1;
}

pub fn route_name_from_id(id: Int) -> String {
    if id == 1 {
        return "home";
    } else if id == 2 {
        return "manifesto";
    } else if id == 3 {
        return "play";
    } else if id == 4 {
        return "overview";
    } else if id == 5 {
        return "start";
    } else if id == 6 {
        return "syntax";
    } else if id == 7 {
        return "stdlib";
    } else if id == 8 {
        return "cli";
    } else if id == 9 {
        return "packages";
    } else if id == 10 {
        return "security";
    } else if id == 11 {
        return "defense";
    } else if id == 12 {
        return "internals";
    } else if id == 13 {
        return "pay";
    } else if id == 14 {
        return "qa";
    } else if id == 15 {
        return "quickref";
    } else if id == 16 {
        return "registry";
    } else if id == 17 {
        return "wasm";
    } else if id == 18 {
        return "not_found";
    } else {
        return "home";
    }
}

pub fn route_title_from_id(id: Int) -> String {
    return route_name_from_id(id);
}

pub fn route_is_guide(id: Int) -> Bool {
    if id >= 4 && id <= 15 {
        return true;
    } else {
        return false;
    }
}

pub fn route_doc_filename(id: Int) -> String {
    if route_is_guide(id) {
        return route_name_from_id(id) + ".oot";
    }
    return "";
}

pub fn route_info_from_id(id: Int) -> RouteInfo {
    let valid_id: Int = if id >= 1 && id <= 18 { id } else { 1 };
    return RouteInfo {
        id: valid_id,
        name: route_name_from_id(valid_id),
        title: route_title_from_id(valid_id),
        is_guide: route_is_guide(valid_id),
        doc_file: route_doc_filename(valid_id)
    };
}

pub fn route_resolve(hash: String) -> RouteInfo {
    let clean_hash: String = if hash == "" { "home" } else { hash };
    let id: Int = route_id_from_name(clean_hash);
    return route_info_from_id(id);
}

verify route_dispatcher {
    assert_eq!(route_count(), 18);
    assert_eq!(route_id_from_name("home"), 1);
    assert_eq!(route_id_from_name("manifesto"), 2);
    assert_eq!(route_id_from_name("syntax"), 6);
    assert_eq!(route_id_from_name("registry"), 16);
    assert_eq!(route_id_from_name("wasm"), 17);
    assert_eq!(route_id_from_name("not_found"), 18);
    assert_eq!(route_id_from_name("invalid_route"), 1);

    assert_eq!(route_name_from_id(1), "home");
    assert_eq!(route_name_from_id(17), "wasm");
    assert_eq!(route_name_from_id(18), "not_found");

    assert_eq!(route_is_guide(6), true);
    assert_eq!(route_is_guide(1), false);
    assert_eq!(route_is_guide(16), false);

    assert_eq!(route_doc_filename(6), "syntax.oot");
    assert_eq!(route_doc_filename(1), "");

    let r_info: RouteInfo = route_resolve("defense");
    assert_eq!(r_info.id, 11);
    assert_eq!(r_info.name, "defense");
    assert_eq!(r_info.is_guide, true);
    assert_eq!(r_info.doc_file, "Morpher.oot");
}
