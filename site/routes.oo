// # Web Application Route Dispatcher
//
// Logline: Resolves route strings, identifiers, and metadata for openOODA SPA navigation.
//
// Setup: Pure string matching and integer code translation with fallback to home.
//
// Beats:
//   1. Resolve route ID from hash route string.
//   2. Resolve route string from ID.
//   3. Resolve page document filename for guide sections.
//   4. Verify bidirectional route mapping.

pub fn route_id_from_name(name: String) -> Int {
    if name == "home" {
        return 1;
    } else if name == "manifesto" {
        return 2;
    } else if name == "play" {
        return 3;
    } else if name == "overview" {
        return 4;
    } else if name == "start" {
        return 5;
    } else if name == "syntax" {
        return 6;
    } else if name == "stdlib" {
        return 7;
    } else if name == "cli" {
        return 8;
    } else if name == "packages" {
        return 9;
    } else if name == "security" {
        return 10;
    } else if name == "defense" {
        return 11;
    } else if name == "internals" {
        return 12;
    } else if name == "pay" {
        return 13;
    } else if name == "qa" {
        return 14;
    } else if name == "quickref" {
        return 15;
    } else {
        return 1;
    }
}

pub fn route_name_from_id(id: Int) -> String {
    if id == 1 {
        return "home";
    } else if id == 2 {
        return "manifesto";
    } else if id == 3 {
        return "play";
    } else if id == 4 {
        return "overview";
    } else if id == 5 {
        return "start";
    } else if id == 6 {
        return "syntax";
    } else if id == 7 {
        return "stdlib";
    } else if id == 8 {
        return "cli";
    } else if id == 9 {
        return "packages";
    } else if id == 10 {
        return "security";
    } else if id == 11 {
        return "defense";
    } else if id == 12 {
        return "internals";
    } else if id == 13 {
        return "pay";
    } else if id == 14 {
        return "qa";
    } else if id == 15 {
        return "quickref";
    } else {
        return "home";
    }
}

pub fn route_is_guide(id: Int) -> Bool {
    if id >= 4 && id <= 15 {
        return true;
    } else {
        return false;
    }
}

pub fn route_doc_filename(id: Int) -> String {
    if id == 4 {
        return "Home.oot";
    } else if id == 5 {
        return "Use.oot";
    } else if id == 6 {
        return "Language.oot";
    } else if id == 7 {
        return "Std.oot";
    } else if id == 8 {
        return "Options.oot";
    } else if id == 9 {
        return "Packages.oot";
    } else if id == 10 {
        return "Safety.oot";
    } else if id == 11 {
        return "Morpher.oot";
    } else if id == 12 {
        return "Limits.oot";
    } else if id == 13 {
        return "Pay.oot";
    } else if id == 14 {
        return "QA.oot";
    } else if id == 15 {
        return "QuickRef.oot";
    } else {
        return "";
    }
}

verify route_id_from_name {
    assert_eq!(route_id_from_name("home"), 1);
    assert_eq!(route_id_from_name("syntax"), 6);
    assert_eq!(route_id_from_name("unknown"), 1);
    assert_eq!(route_name_from_id(2), "manifesto");
    assert_eq!(route_is_guide(6), true);
    assert_eq!(route_is_guide(1), false);
    assert_eq!(route_doc_filename(6), "Language.oot");
}
