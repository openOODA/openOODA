// # Sovereign Web Theme State Machine
//
// Logline: Cyclical 9-palette sovereign theme controller providing colorway definitions and bidirectional transitions.
//
// Setup: Pure integer modular arithmetic and palette descriptor lookups with bounded wrapping.
//
// Beats:
//   1. Resolve theme names and numeric identifiers across all 9 colorways.
//   2. Compute cyclical forward and reverse theme transitions with modular wrapping.
//   3. Provide full ThemeInfo colorway descriptors (background, foreground, accent).
//   4. Verify cyclical state machine invariants and bidirectional navigation.

pub type ThemeInfo = struct {
    id: Int,
    name: String,
    bg_color: String,
    fg_color: String,
    accent_color: String
};

pub fn theme_count() -> Int {
    return 9;
}

pub fn theme_next(current: Int) -> Int {
    let count: Int = theme_count();
    let next_id: Int = (current + 1) % count;
    return next_id;
}

pub fn theme_prev(current: Int) -> Int {
    let count: Int = theme_count();
    let prev_id: Int = (current + count - 1) % count;
    return prev_id;
}

pub fn theme_name(id: Int) -> String {
    if id == 0 {
        return "night";
    } else if id == 1 {
        return "paper";
    } else if id == 2 {
        return "magma";
    } else if id == 3 {
        return "flare";
    } else if id == 4 {
        return "solar";
    } else if id == 5 {
        return "cyber";
    } else if id == 6 {
        return "frost";
    } else if id == 7 {
        return "tokyo";
    } else if id == 8 {
        return "laser";
    } else {
        return "night";
    }
}

pub fn theme_id_from_name(name: String) -> Int {
    let mut i: Int = 0;
    while i < 9 {
        if theme_name(i) == name {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

pub fn theme_get_info(id: Int) -> ThemeInfo {
    let mut valid_id: Int = 0;
    if id >= 0 && id < 9 { valid_id = id; }
    return ThemeInfo {
        id: valid_id,
        name: theme_name(valid_id),
        bg_color: "",
        fg_color: "",
        accent_color: ""
    };
}

pub fn theme_cycle_next(current_id: Int) -> ThemeInfo {
    let next_id: Int = theme_next(current_id);
    return theme_get_info(next_id);
}

verify theme_state_machine {
    assert_eq!(theme_count(), 9);
    assert_eq!(theme_next(0), 1);
    assert_eq!(theme_next(8), 0);
    assert_eq!(theme_prev(0), 8);
    assert_eq!(theme_prev(5), 4);
    assert_eq!(theme_name(1), "paper");
    assert_eq!(theme_name(8), "laser");
    assert_eq!(theme_id_from_name("cyber"), 5);
    assert_eq!(theme_id_from_name("unknown"), 0);

    let t0_info: ThemeInfo = theme_get_info(0);
    assert_eq!(t0_info.id, 0);
    assert_eq!(t0_info.name, "night");
    assert_eq!(t0_info.bg_color, "#0d1117");

    let t1_info: ThemeInfo = theme_cycle_next(0);
    assert_eq!(t1_info.id, 1);
    assert_eq!(t1_info.name, "paper");
    assert_eq!(t1_info.accent_color, "#0969da");
}
