// # Web Theme Manager
//
// Logline: Sovereign theme state controller providing 9 colorway indexes and names.
//
// Setup: Pure arithmetic and string lookups with bounded index wrapping.
//
// Beats:
//   1. Resolve theme name by ID.
//   2. Wrap theme index across the 9 sovereign palettes.
//   3. Provide theme change verification.

pub fn theme_count() -> Int {
    return 9;
}

pub fn theme_next(current: Int) -> Int {
    let count: Int = theme_count();
    let next_id: Int = (current + 1) % count;
    return next_id;
}

pub fn theme_prev(current: Int) -> Int {
    let count: Int = theme_count();
    let prev_id: Int = (current + count - 1) % count;
    return prev_id;
}

pub fn theme_name(id: Int) -> String {
    if id == 0 {
        return "night";
    } else if id == 1 {
        return "paper";
    } else if id == 2 {
        return "magma";
    } else if id == 3 {
        return "flare";
    } else if id == 4 {
        return "solar";
    } else if id == 5 {
        return "cyber";
    } else if id == 6 {
        return "frost";
    } else if id == 7 {
        return "tokyo";
    } else if id == 8 {
        return "laser";
    } else {
        return "night";
    }
}

pub fn theme_id_from_name(name: String) -> Int {
    if name == "night" {
        return 0;
    } else if name == "paper" {
        return 1;
    } else if name == "magma" {
        return 2;
    } else if name == "flare" {
        return 3;
    } else if name == "solar" {
        return 4;
    } else if name == "cyber" {
        return 5;
    } else if name == "frost" {
        return 6;
    } else if name == "tokyo" {
        return 7;
    } else if name == "laser" {
        return 8;
    } else {
        return 0;
    }
}

verify theme_next {
    assert_eq!(theme_next(0), 1);
    assert_eq!(theme_next(8), 0);
    assert_eq!(theme_name(1), "paper");
    assert_eq!(theme_id_from_name("cyber"), 5);
}
