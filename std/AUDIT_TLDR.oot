//   cli            YES     17          compliant (Batch 4, Sept 1 2026)
//   collections    YES     74          compliant (Batch 1, Sept 1 2026)
//   compression    NO      17          violation
//   compile        NO      11          violation
//   core           YES     18          compliant (Batch 1, Sept 1 2026)
//   crypto         YES     61          compliant (FIXED -- see Beat 4)
//   data           YES     17          compliant (Batch 3, Sept 1 2026)
//   diag           YES     33          compliant (Batch 4, Sept 1 2026)
//   econ           NO      20          violation
//   encoding       YES     37          compliant (Batch 3, Sept 1 2026)
//   formal_proofs  NO       8          violation
//   fs             YES     22          compliant (Batch 3, Sept 1 2026)
//   hash           YES     41          compliant (Batch 1, Sept 1 2026)
//   hw             NO      14          violation
//   io             YES     39          compliant (Batch 1, Sept 1 2026)
//   markup         NO      28          violation
//   math           YES     91          compliant (Batch 1, Sept 1 2026)
//   net            YES     71          compliant
//   os             YES     42          compliant (Batch 4, Sept 1 2026)
//   phys           YES     12          compliant (Batch 2 stub upgrade, Sept 1 2026)
//   principles     NO      23          violation
//   proof_verifiers NO      8          violation
//   robot          NO      54          violation
//   sec            YES     51          compliant (Batch 3, Sept 1 2026)
