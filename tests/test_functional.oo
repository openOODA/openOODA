// # openOODA Cards Functional Suite - Positive-Trust Assertions
//
// Logline: Positive assertions that all eight canonical quick cards exist with real content,
//          rules.md keeps the full power-of-two ladder, and VERSION parses as semver digits.
// Setup: Imports the card conformance checker; FsReadCap bounds every read inside the jail.
// Beats:
//   1. Each of the eight cards opens with a title and at least eight lines.
//   2. card_ladder_ok proves every ladder power is documented.
//   3. card_repo_ok folds VERSION, cards, and ladder into one verdict.

import "core/card_check.oo";
import "core/card_law.oo";

fn t_expect(cond: Bool, label: String, p: Int) -> Int {
    if cond {
        println("ok " + label);
        return p + 1;
    }
    println("FAIL " + label);
    return p;
}

fn t_cards(fs: &FsReadCap) -> Int {
    let mut p: Int = 0;
    p = t_expect(card_shape("# t\n" + str_concat("a\nb\nc\nd\ne\nf\ng\n", "h\n")) &&
        card_shape("# rules\nl1\nl2\nl3\nl4\nl5\nl6\nl7\n"), "shape accepts real cards", p);
    p = t_expect(card_ver_num("2.11.137") >= 0 && card_ver_num("0.0.1") == 1,
        "semver parses", p);
    p = t_expect(card_ok(fs, "ooda") && card_ok(fs, "rules") && card_ok(fs, "spec") &&
        card_ok(fs, "security"), "core cards conform", p);
    p = t_expect(card_ok(fs, "layers") && card_ok(fs, "ui") && card_ok(fs, "privacy") &&
        card_ok(fs, "defense"), "remaining cards conform", p);
    p = t_expect(card_ladder_ok(fs) && card_repo_ok(fs), "ladder + repo verdict", p);
    let zsrc: String = "`97` `105` `110` `39` `16` Repos `L7` `@openOODA-agents` (`9` Repos)" +
        " ooagent-hud +ooquota ootheme oobench";
    p = t_expect(card_powers("`1` `2` `4` `8` `16` `32` `64` `128` `256`") == 9 &&
        card_census(zsrc) == 10, "all nine rungs + ten census needles", p);
    p = t_expect(card_census_ok(fs) && card_root_ok(fs) && card_docs_ok(fs) &&
        card_law_ok(fs), "census + constitutional law hold", p);
    return p;
}

pub fn main(fs: &FsReadCap, _args: List[String]) -> Result[Int, String] {
    let p: Int = t_cards(fs);
    if p == 7 {
        println("PASS: functional suite (7/7 assertions)");
        return Ok(0);
    }
    println("FAIL: functional suite (" + p.to_string() + "/7 assertions)");
    return Ok(2);
}
